<div id="blogReportModal" class="blog-report-backdrop" hidden onclick="if(event.target===this)closeBlogReportModal()">
  <div class="blog-report-dialog" role="dialog" aria-modal="true" aria-labelledby="blogReportTitle">
    <div class="blog-report-header">
      <div>
        <span class="blog-report-eyebrow">Community moderation</span>
        <h2 id="blogReportTitle">Report comment</h2>
      </div>
      <button type="button" class="blog-report-close" onclick="closeBlogReportModal()" aria-label="Close report dialog">×</button>
    </div>
    <p class="blog-report-description">Tell us what is wrong with this comment. Reports help keep the community safe.</p>
    <div class="blog-report-preview" id="blogReportPreview"></div>
    <form onsubmit="submitBlogReport(event)">
      <label class="blog-report-label" for="blogReportReason">Reason</label>
      <select id="blogReportReason" class="blog-report-select" onchange="toggleBlogReportDetails(this)">
        <option value="">Choose a reason</option>
        <option value="Harassment or bullying">Harassment or bullying</option>
        <option value="Hate or discriminatory content">Hate or discriminatory content</option>
        <option value="Spam or scams">Spam or scams</option>
        <option value="Threats or dangerous content">Threats or dangerous content</option>
        <option value="Private information">Private information</option>
        <option value="Other">Other</option>
      </select>
      <label class="blog-report-label" for="blogReportDetails">Additional details <span>(optional)</span></label>
      <textarea id="blogReportDetails" class="blog-report-details" maxlength="160" placeholder="Add context for the moderators..."></textarea>
      <p class="blog-report-error" id="blogReportError" aria-live="polite"></p>
      <div class="blog-report-actions">
        <button type="button" class="blog-report-cancel" onclick="closeBlogReportModal()">Cancel</button>
        <button type="submit" class="blog-report-submit" id="blogReportSubmit">Send report</button>
      </div>
    </form>
  </div>
</div>

<style>
  /* ── Blog report modal ── */
