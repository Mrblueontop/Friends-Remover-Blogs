          <button class="lang-menu-item" data-lang="NL" data-flag="🇳🇱" onclick="selectLang(this)"><span class="li-flag">🇳🇱</span><span class="li-name">Nederlands</span
          <button class="lang-menu-item" data-lang="IT" data-flag="🇮🇹" onclick="selectLang(this)"><span class="li-flag">🇮🇹</span><span class="li-name">Italiano</span><span class="li-code">IT</span></button>
          <button class="lang-menu-item" data-lang="HI" data-flag="🇮🇳" onclick="selectLang(this)"><span class="li-flag">🇮🇳</span><span class="li-name">हिन्दी</span><span class="li-code">HI</span></button>
