      <div id="support-queue-notice" style="display:none;"></div>
      <div id="ai-quick-chips"       style="display:none;"></div>
      <div id="ai-reply-quote-text"  style="display:none;"></div>
      <div id="support-name-prompt"  style="display:none;"></div>
      <div id="support-name-input"   style="display:none;"></div>
      <div id="support-name-error"   style="display:none;"></div>

      <!-- ══ VIEW 1: INTAKE (shown on first open) ══ -->
      <div id="wb3-view-intake" style="display:none;">

        <!-- Header: back arrow + logo + name + status -->
        <div class="wb3-intake-header">
          <button class="wb3-intake-back-btn" onclick="frChatToggle()" title="Close" aria-label="Close chat">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <div class="wb3-intake-logo-sm">
            <img src="icon.png" alt="FR" style="width:100%;height:100%;object-fit:cover;border-radius: 0;" onerror="this.style.display='none'">
          </div>
          <div class="wb3-intake-header-info">
            <div class="wb3-intake-header-name">Friends Remover <span class="wb3-intake-online-dot"></span></div>
            <div class="wb3-intake-header-sub">Typically replies in a few hours</div>
          </div>
        </div>

        <!-- Description -->
        <div class="wb3-intake-desc">
          Submit appeals, report issues, or ask questions about Friends Remover.
        </div>

        <!-- Form -->
        <div class="wb3-intake-form-body" id="wb3-intake-form">
          <div>
            <label class="wb3-intake-label" for="wb3-intake-email">Email Address</label>
            <input class="wb3-intake-input" id="wb3-intake-email" type="email"
              placeholder="Get notified for new messages" maxlength="254"
              onkeydown="if(event.key==='Enter'){event.preventDefault();document.getElementById('wb3-intake-msg')?.focus();}">
          </div>
          <div>
            <label class="wb3-intake-label" for="wb3-intake-msg">Message</label>
            <textarea class="wb3-intake-textarea" id="wb3-intake-msg"
              placeholder="Please enter your message" maxlength="500"
              onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();wb3SubmitIntake();}"></textarea>
          </div>
          <div class="wb3-intake-error" id="wb3-intake-error"></div>
          <button class="wb3-intake-submit-btn" id="wb3-intake-btn" onclick="wb3SubmitIntake()">Start Conversation</button>
        </div>
      </div>

      <!-- ══ VIEW 1b: EMAIL VERIFICATION (OTP) ══ -->
      <div id="wb3-view-verify" style="display:none; flex-direction:column; flex:1; background:var(--ck-bg); overflow-y:auto;">
        <div class="wb3-intake-header">
          <button class="wb3-intake-back-btn" onclick="wb3BackToIntakeFromVerify()" title="Back" aria-label="Back">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <div class="wb3-intake-logo-sm">
            <img src="icon.png" alt="FR" style="width:100%;height:100%;object-fit:cover;border-radius:0;" onerror="this.style.display='none'">
          </div>
          <div class="wb3-intake-header-info">
            <div class="wb3-intake-header-name">Verify your email</div>
            <div class="wb3-intake-header-sub">Check your inbox or spam folder</div>
          </div>
        </div>
        <div class="wb3-verify-email-wrap">
          <div class="wb3-verify-email-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div class="wb3-verify-email-title">Check your inbox</div>
          <div class="wb3-verify-email-sub">We sent a 6-digit code to</div>
