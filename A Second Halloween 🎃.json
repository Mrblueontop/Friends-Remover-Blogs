  .wm-header {
    display: flex; align-items: center; gap: 12px;
    padding: 22px 24px;
    background: rgba(245,158,11,0.1);
    border-bottom: 1px solid rgba(245,158,11,0.2);
  }
  body.dark-mode .wm-header { background: rgba(245,158,11,0.08); border-bottom-color: rgba(245,158,11,0.15); }
  .wm-header-icon {
    display: flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: 0;
    background: rgba(245,158,11,0.18);
    border: 1px solid rgba(245,158,11,0.35);
    color: #f59e0b; flex-shrink: 0;
  }
  .wm-header-label { font-size: 0.88rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #d97706; }
  body.dark-mode .wm-header-label { color: #fbbf24; }
  .wm-body { padding: 24px 28px 0; text-align: center; }
  .wm-desc { font-size: 0.92rem; line-height: 1.7; color: var(--text-secondary, #64748b); margin-bottom: 20px; }
  .wm-desc strong { color: #ef4444; font-weight: 700; }
  .wm-checklist {
    display: flex; flex-direction: column; gap: 8px;
    background: var(--bg-secondary, #f8fafc);
    border: 1px solid var(--border-color, #e2e8f0);
    padding: 14px 16px; text-align: left; margin-bottom: 24px;
  }
  body.dark-mode .wm-checklist { background: rgba(255,255,255,0.03); }
  .wm-check-item { display: flex; align-items: center; gap: 10px; font-size: 0.82rem; font-weight: 500; color: var(--text-secondary, #64748b); }
  .wm-check-item svg { color: #10b981; flex-shrink: 0; }
  .wm-actions { display: flex; gap: 10px; padding: 0 28px 16px; }
  .wm-btn-dismiss {
    flex: 1; padding: 12px 20px;
    font-family: inherit; font-size: 0.9rem; font-weight: 700;
    cursor: pointer; border-radius: 0;
    border: 1.5px solid var(--border-color, #e2e8f0);
    background: transparent; color: var(--text-secondary, #64748b);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .wm-btn-dismiss:hover { background: var(--bg-secondary, #f8fafc); color: var(--text-primary, #1e293b); border-color: var(--text-muted, #94a3b8); }
  .wm-btn-ok {
    flex: 2; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 12px 20px; font-family: inherit; font-size: 0.9rem; font-weight: 700;
    cursor: pointer; border-radius: 0; border: none;
    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    color: #fff; box-shadow: 0 4px 16px rgba(var(--primary-rgb),0.4);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .wm-btn-ok:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(var(--primary-rgb),0.55); }
  .wm-footnote { font-size: 0.75rem; color: var(--text-muted, #94a3b8); text-align: center; padding: 0 28px 20px; }
  .wm-link { color: var(--primary-color, var(--primary-color)); cursor: pointer; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 480px) {
    .wm-body { padding: 16px 20px 0; }
    .wm-actions { padding: 0 20px 14px; flex-direction: column; }
    .wm-btn-dismiss, .wm-btn-ok { flex: unset; width: 100%; }
    .wm-footnote { padding: 0 20px 16px; }
    .np-panel { top: 68px; right: 8px; }
  }
</style>

<script>
  // ═══════════════════════════════════════════════
  // NOTIFICATION DATA — edit this array to add/update notifications
  // Types: 'warning' | 'info' | 'update' | 'success'
  // ═══════════════════════════════════════════════
  const NOTIFICATIONS = [];

  // Type styles
  const NOTIF_STYLES = {
    warning: { color: '#f59e0b', bg: 'rgba(245,158,11,0.1)',  border: 'rgba(245,158,11,0.25)', icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>' },
    info:    { color: getComputedStyle(document.documentElement).getPropertyValue('--primary-color').trim()||'#2196f3', bg: 'rgba(var(--primary-rgb),0.1)',   border: 'rgba(var(--primary-rgb),0.25)',  icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' },
    update:  { color: '#10b981', bg: 'rgba(16,185,129,0.1)',   border: 'rgba(16,185,129,0.25)',  icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-.08-6.49"/></svg>' },
    success: { color: '#22c55e', bg: 'rgba(34,197,94,0.1)',    border: 'rgba(34,197,94,0.25)',   icon: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>' },
  };

  // ── State ──
  let npCurrentIdx = 0;
  let wmCurrentIdx = 0;
  let panelOpen = false;

  function getStorageKey(id) { return 'fr-notif-dismissed-' + id; }
  function isDismissed(id) { try { return !!localStorage.getItem(getStorageKey(id)); } catch(e) { return false; } }
  function setDismissed(id) { try { localStorage.setItem(getStorageKey(id), '1'); } catch(e) {} }

  // Active notifications = not dismissed
  function getActiveNotifs() { return NOTIFICATIONS.filter(n => !isDismissed(n.id)); }

  // ── Build a notification HTML block ──
  function buildNotifHTML(n, forModal) {
    const st = NOTIF_STYLES[n.type] || NOTIF_STYLES.info;
    const checkHTML = (n.checklist || []).map(item =>
      `<div class="${forModal ? 'wm-check-item' : 'np-notif-check'}">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        ${item}
      </div>`
    ).join('');
    const listWrapper = checkHTML ? `<div class="${forModal ? 'wm-checklist' : 'np-notif-checklist'}">${checkHTML}</div>` : '';
    return `
      <div class="np-notif-header">
        <div class="np-notif-icon" style="background:${st.bg};border:1px solid ${st.border};color:${st.color};">${st.icon}</div>
        <span class="np-notif-type" style="color:${st.color};">${n.label || n.type}</span>
      </div>
      <div class="np-notif-title">${n.title}</div>
      <div class="${forModal ? 'wm-desc' : 'np-notif-desc'}">${n.desc || ''}</div>
      ${listWrapper}
    `;
  }

  // ── NOTIFICATION PANEL ──
  function renderPanel() {
    const active = getActiveNotifs();
    const body = document.getElementById('npBody');
    const dots = document.getElementById('npDots');
    const footer = document.getElementById('npFooter');
    const count = document.getElementById('npCount');
    if (!body) return;

    if (active.length === 0) {
      const dismissed = NOTIFICATIONS.filter(n => isDismissed(n.id));
      body.innerHTML = `<div class="np-empty"><div class="np-empty-icon">🔔</div><div class="np-empty-title">All caught up!</div><div>No new notifications.</div></div>`;
      dots.innerHTML = '';
      footer.innerHTML = dismissed.length > 0
        ? `<button class="np-restore-btn" onclick="restoreDismissed()">&#8635; Restore dismissed notifications</button>`
        : '';
      count.style.display = 'none';
      return;
    }

    count.textContent = active.length;
    count.style.display = '';

    // Build notification cards
    body.innerHTML = active.map((n, i) =>
      `<div class="np-notif${i === npCurrentIdx ? ' active' : ''}" data-idx="${i}">${buildNotifHTML(n, false)}</div>`
    ).join('');

    // Dots
    if (active.length > 1) {
      dots.innerHTML = active.map((_, i) =>
        `<button class="np-dot${i === npCurrentIdx ? ' active' : ''}" onclick="npGoTo(${i})" aria-label="Notification ${i+1}"></button>`
      ).join('');
    } else {
      dots.innerHTML = '';
    }

    // Footer
    footer.innerHTML = `<button class="np-dismiss-all" onclick="npDismissCurrent()">Dismiss this notification</button>`;
  }

  function npGoTo(idx) {
    npCurrentIdx = idx;
    document.querySelectorAll('#npBody .np-notif').forEach((el, i) => el.classList.toggle('active', i === idx));
    document.querySelectorAll('#npDots .np-dot').forEach((el, i) => el.classList.toggle('active', i === idx));
  }

  function npDismissCurrent() {
    const active = getActiveNotifs();
    if (!active[npCurrentIdx]) return;
    setDismissed(active[npCurrentIdx].id);
    npCurrentIdx = Math.max(0, npCurrentIdx - 1);
    renderPanel();
    updateBadge();
  }

  function restoreDismissed() {
    NOTIFICATIONS.forEach(n => {
      try { localStorage.removeItem('fr-notif-dismissed-' + n.id); } catch(e) {}
    });
    npCurrentIdx = 0;
    renderPanel();
    updateBadge();
  }

  function toggleNotifPanel() {
    panelOpen = !panelOpen;
    const panel = document.getElementById('notifPanel');
    if (!panel) return;
    if (panelOpen) {
      npCurrentIdx = 0;
      renderPanel();
      panel.classList.remove('np-hidden');
    } else {
      panel.classList.add('np-hidden');
    }
  }

  function closeNotifPanel() {
    panelOpen = false;
    const panel = document.getElementById('notifPanel');
    if (panel) panel.classList.add('np-hidden');
  }

  // Close panel on outside click
  document.addEventListener('click', (e) => {
    const panel = document.getElementById('notifPanel');
    const btn = document.getElementById('notifNavBtn');
    if (panelOpen && panel && !panel.contains(e.target) && btn && !btn.contains(e.target)) {
      closeNotifPanel();
    }
  });

  // ── MODAL ──
  function renderModal() {
    const active = getActiveNotifs();
    const modal = document.getElementById('warningModal');
    if (!modal) return;

    if (active.length === 0) {
      modal.style.display = 'none';
      return;
    }

    const n = active[wmCurrentIdx] || active[0];
    const st = NOTIF_STYLES[n.type] || NOTIF_STYLES.warning;

    // Header
    document.getElementById('wmHeaderIcon').style.background = st.bg;
    document.getElementById('wmHeaderIcon').style.borderColor = st.border;
    document.getElementById('wmHeaderIcon').style.color = st.color;
    document.getElementById('wmHeaderIcon').innerHTML = st.icon.replace('width="14"','width="16"').replace('height="14"','height="16"');
    document.getElementById('wmHeaderLabel').textContent = n.label || n.type;
    document.getElementById('wmHeader').style.background = st.bg;
    document.getElementById('wmHeader').style.borderBottomColor = st.border;

    // Body
    document.getElementById('wmBody').innerHTML = `
      <p class="wm-desc">${n.desc || ''}</p>
      ${(n.checklist||[]).length ? `<div class="wm-checklist">${(n.checklist).map(item=>`<div class="wm-check-item"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>${item}</div>`).join('')}</div>` : ''}
    `;

    // Dots
    const dotsEl = document.getElementById('wmDots');
    if (active.length > 1) {
      dotsEl.innerHTML = active.map((_, i) =>
        `<button class="wm-dot${i === wmCurrentIdx ? ' active' : ''}" onclick="wmGoTo(${i})" aria-label="Notification ${i+1}"></button>`
      ).join('');
    } else {
      dotsEl.innerHTML = '';
    }

    // Actions
    document.getElementById('wmActions').innerHTML = `
      <button class="wm-btn-dismiss" onclick="dismissModal()">Dismiss</button>
      <button class="wm-btn-ok" onclick="acceptModal()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        I Understand
      </button>
    `;

    // Footnote
    document.getElementById('wmFootnote').innerHTML = n.footnote || '';

    modal.style.display = 'flex';
  }

  function wmGoTo(idx) {
    wmCurrentIdx = idx;
    const active = getActiveNotifs();
    if (!active[idx]) return;
    renderModal();
  }

  function closeWarningModal() {
    const modal = document.getElementById('warningModal');
    if (!modal) return;
    modal.classList.add('hiding');
    setTimeout(() => { modal.style.display = 'none'; modal.classList.remove('hiding'); }, 280);
  }

  function dismissModal() {
    const active = getActiveNotifs();
    if (active[wmCurrentIdx]) setDismissed(active[wmCurrentIdx].id);
    const remaining = getActiveNotifs();
    if (remaining.length === 0) {
      closeWarningModal();
    } else {
      wmCurrentIdx = Math.max(0, wmCurrentIdx - 1);
      renderModal();
    }
    updateBadge();
  }

  function acceptModal() {
    dismissModal();
  }

  // Legacy aliases for any inline calls
  function dismissWarning() { dismissModal(); }
  function acceptWarning() { acceptModal(); }

  function updateBadge() {
    const badge = document.getElementById('notifBadge');
    if (!badge) return;
    const count = getActiveNotifs().length;
    badge.style.display = count > 0 ? 'block' : 'none';
  }

  // ── Init on page load ──
  (function init() {
    updateBadge();
    const active = getActiveNotifs();
    if (active.length > 0) {
      wmCurrentIdx = 0;
      renderModal();
    }
  })();
</script>

<!-- ═══ STATUS PAGE JS ═══ -->
<script>
(function() {
  'use strict';

  // ── Config ──────────────────────────────────────────────────────
  const WORKER       = 'https://fmstoragekv.zaggloob.workers.dev';
  const POLL_SEC     = 30;

  const KV_DEFS = [
    { key:'FR_PINNED_FRIENDS_KV',   name:'Pinned Friends',           desc:'Each user\'s pinned friend list',             endpoint:'/pins'     },
    { key:'FR_UNFRIEND_HISTORY_KV', name:'Unfriend History',         desc:'Per-user history of removed friends',         endpoint:'/history'  },
    { key:'FR_BLOCKED_HISTORY_KV',  name:'Blocked History',          desc:'Per-user history of blocked users',           endpoint:'/blocked'  },
    { key:'FR_SETTINGS_KV',         name:'Settings & Discord Users', desc:'Extension settings + Discord link records',   endpoint:'/settings' },
    { key:'FR_USERBASE_KV',         name:'User Base Registry',       desc:'First/last-seen tracking for all users',      endpoint:'/userbase' },
    { key:'FR_USER_NOTES_KV',       name:'Friend Notes',             desc:'Per-user notes attached to friends',          endpoint:'/notes'    },
    { key:'SHARED_SECRET',          name:'API Auth Secret',          desc:'HMAC-SHA-256 key for request signing',        endpoint:null        },
  ];

  const EP_DEFS = [
    { method:'GET',    path:'/status',        desc:'Health check — all KV bindings',          cdMs:0,     auth:false },
    { method:'GET',    path:'/history/all',   desc:'Global unfriend stats aggregation',        cdMs:5000,  auth:false },
    { method:'GET',    path:'/find-random',   desc:'Random short-name user finder',            cdMs:3000,  auth:false },
    { method:'GET',    path:'/pins',          desc:'Fetch pinned friends list',               cdMs:0,     auth:true  },
    { method:'PUT',    path:'/pins',          desc:'Save pinned friends list',                cdMs:500,   auth:true  },
    { method:'GET',    path:'/history',       desc:'Fetch personal unfriend history',          cdMs:0,     auth:true  },
    { method:'PUT',    path:'/history',       desc:'Append to unfriend history',              cdMs:500,   auth:true  },
    { method:'GET',    path:'/settings',      desc:'Fetch extension settings',                cdMs:0,     auth:true  },
    { method:'PUT',    path:'/settings',      desc:'Save extension settings',                 cdMs:500,   auth:true  },
    { method:'GET',    path:'/notifications', desc:'Fetch active notifications',              cdMs:0,     auth:true  },
    { method:'GET',    path:'/discord-user',  desc:'Look up Discord link by Roblox ID',       cdMs:1000,  auth:false },
    { method:'GET',    path:'/userbase',      desc:'List all registered users',               cdMs:10000, auth:false },
    { method:'POST',   path:'/userbase/sync', desc:'Sync/discover users from KV sources',     cdMs:30000, auth:false },
  ];

  // ── State ────────────────────────────────────────────────────────
  let pingHistory = [];
  try { pingHistory = JSON.parse(sessionStorage.getItem('fr-st-pings') || '[]'); } catch(e) {}
  let cdLastCall = {};
  let countdownVal = POLL_SEC;
  let countdownTimer = null;
  let isRefreshing = false;
  const REFRESH_CD_SEC = 5;
  let refreshCdTimer = null;
  let pageInitDone = false;

  // ── Initialise when status page is shown ────────────────────────
  function stInit() {
    if (pageInitDone) return;
    pageInitDone = true;
    stBuildCdGrid();
    stBuildPingBars();
    stFetchStatus();
    stStartCountdown();
  }

  // Hook into showPage: when 'status' is shown, init
  const _origShowPage = window.showPage;
  if (typeof _origShowPage === 'function') {
    window.showPage = function(id, pushState) {
      _origShowPage(id, pushState);
      if (id === 'status') {
        // slight delay so page DOM is visible
        setTimeout(stInit, 50);
      }
    };
  }

  // Also init if page loads directly on #status
  document.addEventListener('DOMContentLoaded', function() {
    const hash = location.hash.replace('#','');
    if (hash === 'status') setTimeout(stInit, 200);
  });

  // ── Fetch ────────────────────────────────────────────────────────
  async function stFetchStatus() {
    if (isRefreshing) return;
    isRefreshing = true;
    const btn = document.getElementById('stRefreshBtn');
    if (btn) btn.classList.add('spinning');

    let data = null, ok = false, ms = null;
    try {
      const t0 = performance.now();
      const res = await fetch(WORKER + '/status', { cache:'no-store' });
      ms = Math.round(performance.now() - t0);
      if (res.ok) { data = await res.json(); ok = true; }
    } catch(e) { ok = false; }

    if (ms !== null) {
      pingHistory.push({ ms, ok });
      if (pingHistory.length > 30) pingHistory = pingHistory.slice(-30);
      try { sessionStorage.setItem('fr-st-pings', JSON.stringify(pingHistory)); } catch(e) {}
    }

    stUpdateBanner(data, ok, ms);
    stUpdateKv(data);
    stBuildPingBars();
    cdLastCall['GET:/status'] = Date.now();
    stRefreshCd();

    const el = document.getElementById('stLastChecked');
    if (el) el.textContent = new Date().toLocaleTimeString() + ', ' + new Date().toLocaleDateString();

    isRefreshing = false;
    if (btn) btn.classList.remove('spinning');
    countdownVal = POLL_SEC;
  }

  // ── Banner ───────────────────────────────────────────────────────
  function stUpdateBanner(data, ok, ms) {
    const banner = document.getElementById('stBanner');
    const main   = document.getElementById('stBannerMain');
    const sub    = document.getElementById('stBannerSub');
    const meta   = document.getElementById('stBannerMeta');
    const dot    = document.getElementById('stMasterDot');
    const badge  = document.getElementById('stMasterBadgeText');
    const icon   = document.getElementById('stBannerIcon');
    if (!banner) return;

    if (!ok || !data) {
      banner.className = 'st-banner err';
      main.textContent = 'Worker Unreachable';
      sub.textContent  = 'Could not connect to the worker';
      if (meta) meta.textContent = ms ? ms+'ms' : 'timeout';
      if (dot)   { dot.style.background='#ef4444'; dot.style.animation='none'; }
      if (badge) badge.textContent = 'DEGRADED';
      if (icon)  icon.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
      return;
    }

    const checks  = data.checks || {};
    const allOk   = data.status === 'ok';
    const total   = Object.keys(checks).length;
    const failed  = Object.values(checks).filter(v => !v).length;

    if (allOk) {
      banner.className = 'st-banner ok';
      main.textContent = 'All Systems Operational';
      sub.textContent  = total + '/' + total + ' checks passing · ' + ms + 'ms response time';
      if (meta) meta.innerHTML = '<span style="color:#22c55e">'+ms+'ms</span><br>'+new Date().toLocaleTimeString();
      if (dot)   { dot.style.background='#22c55e'; dot.style.animation=''; }
      if (badge) badge.textContent = 'OPERATIONAL';
      if (icon)  icon.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>';
    } else {
      banner.className = 'st-banner warn';
      main.textContent = 'Degraded — ' + failed + ' service' + (failed > 1 ? 's' : '') + ' down';
      sub.textContent  = (total - failed) + '/' + total + ' checks passing';
      if (meta) meta.innerHTML = '<span style="color:#f59e0b">'+ms+'ms</span><br>'+new Date().toLocaleTimeString();
      if (dot)   { dot.style.background='#f59e0b'; dot.style.animation='none'; }
      if (badge) badge.textContent = 'DEGRADED';
      if (icon)  icon.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
    }
  }

  // ── KV Table ─────────────────────────────────────────────────────
  function stUpdateKv(data) {
    const checks = data ? (data.checks || {}) : null;
    const table  = document.getElementById('stKvTable');
    if (!table) return;
    table.innerHTML = KV_DEFS.map(function(kv) {
      const bound = checks !== null ? !!checks[kv.key] : null;
      const state = checks === null ? 'loading' : (bound ? 'ok' : 'err');
      const label = state === 'loading' ? '—' : (bound ? 'Bound' : 'Unbound');
      const pathTag = kv.endpoint ? '<span class="st-kv-path">'+kv.endpoint+'</span>' : '';
      return '<div class="st-kv-row">' +
        '<div class="st-kv-dot '+state+'"></div>' +
        '<div><div class="st-kv-name">'+kv.name+'</div>' +
        '<div style="font-size:0.72rem;color:var(--text-muted);margin-top:1px;">'+kv.desc+'</div></div>' +
        pathTag +
        '<div class="st-kv-badge '+state+'">'+label+'</div>' +
        '</div>';
    }).join('');
  }

  // ── Ping bars ────────────────────────────────────────────────────
  function stBuildPingBars() {
    const container = document.getElementById('stPingBars');
    const avgEl     = document.getElementById('stAvgLabel');
    if (!container) return;
    const SLOTS = 30;
    const MAX_MS = 2000;
    const padded = Array(SLOTS - pingHistory.length).fill(null).concat(pingHistory);
    container.innerHTML = padded.map(function(p) {
      if (!p) return '<div class="st-ping-bar empty" style="height:3px;"></div>';
      const h   = Math.round(3 + Math.min(1, p.ms / MAX_MS) * 37);
      const cls = !p.ok ? 'err' : (p.ms > 800 ? 'slow' : 'ok');
      return '<div class="st-ping-bar '+cls+'" style="height:'+h+'px;" title="'+(p.ok ? p.ms+'ms' : 'error')+'"></div>';
    }).join('');
    const valid = pingHistory.filter(function(p) { return p.ok && p.ms != null; });
    if (valid.length > 0) {
      const avg = Math.round(valid.reduce(function(a,b){ return a+b.ms; }, 0) / valid.length);
      const cls = avg < 400 ? 'color:#22c55e' : avg < 900 ? 'color:#f59e0b' : 'color:#ef4444';
      if (avgEl) avgEl.innerHTML = 'avg <span style="font-family:\'JetBrains Mono\',monospace;font-weight:600;'+cls+'">'+avg+'ms</span>';
    } else {
      if (avgEl) avgEl.textContent = 'avg — ms';
    }
  }

  // ── Cooldown grid ────────────────────────────────────────────────
  function stBuildCdGrid() {
    const grid = document.getElementById('stCdGrid');
    if (!grid) return;
    grid.innerHTML = EP_DEFS.map(function(ep, i) {
      const authTag = ep.auth
        ? '<span style="font-family:\'JetBrains Mono\',monospace;font-size:0.62rem;color:#d97706;background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.2);padding:1px 6px;">AUTH</span>'
        : '';
      const cdLabel = ep.cdMs === 0 ? 'No cooldown'
        : ep.cdMs < 1000 ? ep.cdMs+'ms cooldown'
        : (ep.cdMs/1000).toFixed(0)+'s cooldown';
      return '<div class="st-cd-card" id="stCd-'+i+'">' +
        '<div class="st-cd-header">' +
          '<span class="st-cd-method '+ep.method.toLowerCase()+'">'+ep.method+'</span>' +
          '<span class="st-cd-path">'+ep.path+'</span>' +
          authTag +
        '</div>' +
        '<div class="st-cd-desc">'+ep.desc+'</div>' +
        '<div class="st-cd-bar-wrap"><div class="st-cd-bar full" id="stCdBar-'+i+'" style="width:100%"></div></div>' +
        '<div class="st-cd-meta">' +
          '<span class="st-cd-label">'+cdLabel+'</span>' +
          '<span class="st-cd-val ready" id="stCdVal-'+i+'">Ready</span>' +
        '</div>' +
        '</div>';
    }).join('');
  }

  function stRefreshCd() {
    EP_DEFS.forEach(function(ep, i) {
      if (ep.cdMs === 0) return;
      const key     = ep.method+':'+ep.path;
      const last    = cdLastCall[key] || 0;
      const elapsed = Date.now() - last;
      const pct     = last === 0 ? 1 : Math.min(1, elapsed / ep.cdMs);
      const ready   = pct >= 1;
      const bar = document.getElementById('stCdBar-'+i);
      const val = document.getElementById('stCdVal-'+i);
      if (!bar || !val) return;
      bar.style.width   = Math.round(pct * 100) + '%';
      bar.className     = 'st-cd-bar ' + (ready ? 'full' : 'limited');
      if (ready) {
        val.textContent = 'Ready';
        val.className   = 'st-cd-val ready';
      } else {
        val.textContent = Math.ceil((ep.cdMs - elapsed) / 1000) + 's';
        val.className   = 'st-cd-val active';
      }
    });
  }
  setInterval(stRefreshCd, 1000);

  // ── Countdown ────────────────────────────────────────────────────
  function stStartCountdown() {
    countdownVal = POLL_SEC;
    if (countdownTimer) clearInterval(countdownTimer);
    countdownTimer = setInterval(function() {
      countdownVal--;
      const el  = document.getElementById('stCountdown');
      const bar = document.getElementById('stTimerBar');
      if (el)  el.textContent = Math.max(0, countdownVal);
      if (bar) bar.style.transform = 'scaleX(' + (countdownVal / POLL_SEC) + ')';
      if (countdownVal <= 0) {
        stFetchStatus();
        countdownVal = POLL_SEC;
      }
    }, 1000);
  }

  function stStartRefreshCooldown() {
    const btn   = document.getElementById('stRefreshBtn');
    const label = document.getElementById('stRefreshBtnLabel');
    if (!btn || !label) return;
    let remaining = REFRESH_CD_SEC;
    btn.disabled = true;
    label.textContent = 'Refresh (' + remaining + 's)';
    if (refreshCdTimer) clearInterval(refreshCdTimer);
    refreshCdTimer = setInterval(function() {
      remaining--;
      if (remaining <= 0) {
        clearInterval(refreshCdTimer);
        refreshCdTimer = null;
        btn.disabled = false;
        label.textContent = 'Refresh';
      } else {
        label.textContent = 'Refresh (' + remaining + 's)';
      }
    }, 1000);
  }

  window.stTriggerRefresh = function() {
    const btn = document.getElementById('stRefreshBtn');
    if (btn && btn.disabled) return;
    countdownVal = POLL_SEC;
    if (countdownTimer) clearInterval(countdownTimer);
    stStartRefreshCooldown();
    stFetchStatus().then(function() { stStartCountdown(); });
  };

})();
</script>

<!-- ═══════════════════════════════════════════════════
     SETTINGS MODAL
═══════════════════════════════════════════════════ -->
<div id="settingsModal" class="sm-backdrop" onclick="smBackdropClick(event)">
  <div class="sm-modal" role="dialog" aria-modal="true" aria-label="Settings">
    <div class="sm-header">
      <div class="sm-header-left">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span>Settings</span>
      </div>
      <button class="sm-close" onclick="closeSettingsModal()" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div class="sm-body">

      <!-- ── APPEARANCE ── -->
      <div class="sm-section-label">Appearance</div>

      <!-- Dark / Light toggle -->
      <div class="sm-row">
        <div class="sm-row-icon">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </div>
        <div class="sm-row-info">
          <div class="sm-row-title">Theme</div>
          <div class="sm-row-sub">Switch between light and dark mode</div>
        </div>
        <div class="sm-theme-toggle">
          <button class="sm-theme-opt" id="smThemeLight" onclick="smSetTheme(false)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            Light
          </button>
          <button class="sm-theme-opt" id="smThemeDark" onclick="smSetTheme(true)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            Dark
          </button>
        </div>
      </div>

      <!-- Accent color -->
