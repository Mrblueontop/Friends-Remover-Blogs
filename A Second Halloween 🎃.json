    let currentLang = 'EN';

    function applyLang(lang) {
      const t = TRANSLATIONS[lang] || TRANSLATIONS.EN;
      const en = TRANSLATIONS.EN;
      currentLang = lang;

      // Apply all data-i18n elements — fall back to EN if key missing in chosen lang
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        const val = t[key] !== undefined ? t[key] : en[key];
        if (val !== undefined) el.innerHTML = val;
      });

      // Apply placeholder translations — fall back to EN if key missing
      document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
        const key = el.getAttribute('data-i18n-placeholder');
        const val = t[key] !== undefined ? t[key] : en[key];
        if (val !== undefined) el.placeholder = val;
      });

      // Update topbar label
      const topbarLabel = document.querySelector('.lang-topbar-label');
      if (topbarLabel) topbarLabel.textContent = t.lang_topbar_label || en.lang_topbar_label;

      // Fix dark/light toggle label — depends on current theme, not just data-i18n key
      const isDark = document.body.classList.contains('dark-mode');
      document.querySelectorAll('.theme-btn-label').forEach(el => {
        el.textContent = isDark ? (t.btn_light || en.btn_light) : (t.btn_dark || en.btn_dark);
        el.setAttribute('data-i18n', isDark ? 'btn_light' : 'btn_dark');
      });

      // Save preference
      try { localStorage.setItem('fr-lang', lang); } catch(e) {}
    }

    // ── Language dropdown ─────────────────────────────────────
    function toggleLangMenu() {
      // Toggle the footer dropdown (the visible one)
      document.getElementById('footerLangDropdown').classList.toggle('open');
      // Keep hidden stub closed
      document.getElementById('langDropdown').classList.remove('open');
    }
    function selectLang(btn) {
      const lang = btn.dataset.lang;
      // Update hidden stubs (used by existing JS references)
      document.getElementById('langFlag').textContent = btn.dataset.flag;
      document.getElementById('langCode').textContent = lang;
      // Update footer pill
      const footerFlag = document.getElementById('footerLangFlag');
      const footerCode = document.getElementById('footerLangCode');
      if (footerFlag) footerFlag.textContent = btn.dataset.flag;
      if (footerCode) footerCode.textContent = lang;
      document.querySelectorAll('.lang-menu-item').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('footerLangDropdown').classList.remove('open');
      document.getElementById('langDropdown').classList.remove('open');
      applyLang(lang);
    }
    document.addEventListener('click', (e) => {
      const dd = document.getElementById('langDropdown');
      if (dd && !dd.contains(e.target)) dd.classList.remove('open');
      const fdd = document.getElementById('footerLangDropdown');
      if (fdd && !fdd.contains(e.target)) fdd.classList.remove('open');
    });

    // Load saved language
    try {
      const savedLang = localStorage.getItem('fr-lang');
      if (savedLang && TRANSLATIONS[savedLang]) {
        const btn = document.querySelector(`.lang-menu-item[data-lang="${savedLang}"]`);
        if (btn) selectLang(btn);
      }
    } catch(e) {}

    // ── Blog filter & search ─────────────────────────────────────
    let blogActiveCat = 'all';

    // ── Article data (loaded from GitHub) ──────────────────────
    // !! UPDATE THIS to your own repo raw base URL !!
    const BLOG_BASE_URL = 'https://raw.githubusercontent.com/Mrblueontop/Friends-Remover-Blogs/main';
    // index.json lives at BLOG_BASE_URL/index.json
    // each article lives at BLOG_BASE_URL/{id}.json

    let ARTICLES = {};       // card metadata, keyed by id (populated from index.json)
    const ARTICLE_CACHE = {}; // full article data cache, keyed by id

    const CAT_ICONS = {
      'Announcements': `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 17H2a3 3 0 0 0 3-3V9a7 7 0 0 1 14 0v5a3 3 0 0 0 3 3z"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>`,
      'Updates':       `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-.08-5.96"/></svg>`,
      'Dev Notes':     `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
      'Mobile':        `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`
    };

    const BADGE_CLASS = {
      'NEW': 'new', 'UPDATE': 'update', 'COMING SOON': 'update', 'DEV': 'dev', 'COUNTDOWN': 'countdown'
    };

    // ── Server-synced clock (all countdowns use this, not the visitor's own clock) ──
    var frClockOffset = 0;
    function frNow() { return Date.now() + frClockOffset; }
    function frSyncClock() {
      try {
        const t0 = Date.now();
        fetch(location.href.split('#')[0], { method: 'HEAD', cache: 'no-store' })
          .then(function (r) {
            const t1 = Date.now(), srv = Date.parse(r.headers.get('date'));
            // the Date header only has whole seconds, so aim for the middle of that second and allow for travel time
            if (!isNaN(srv)) frClockOffset = (srv + 500) - (t0 + t1) / 2;
          }).catch(function () {});
      } catch (e) {}
    }
    frSyncClock(); setInterval(frSyncClock, 300000);

    // ── Countdown badge helper ──
    // Returns a live-updating badge label if article has badgeTimestamp.
    // Format: "2d 14h 33m" or "TODAY" or "OUT NOW"
    function getCountdownLabel(article) {
      if (!article.badgeTimestamp) return article.badge || '';
      const target = new Date(article.badgeTimestamp);
      const diffMs = target - frNow();
      if (diffMs <= 0) return article.badgeAfter || 'OUT NOW';
      const totalSecs = Math.ceil(diffMs / 1000);
      const days  = Math.floor(totalSecs / 86400);
      const hours = Math.floor((totalSecs % 86400) / 3600);
      const mins  = Math.floor((totalSecs % 3600) / 60);
      if (days > 0)  return days + 'd ' + hours + 'h ' + mins + 'm';
      if (hours > 0) return hours + 'h ' + mins + 'm';
      return mins + 'm';
    }

    // Kick off live countdown ticks — runs every second, reads timestamp from data attr
    function startCountdownTicks() {
      function tick() {
        document.querySelectorAll('[data-countdown-ts]').forEach(function(el) {
          const ts     = el.dataset.countdownTs;
          const after  = el.dataset.countdownAfter || 'OUT NOW';
          const target = new Date(ts);
          const diffMs = target - frNow();
          if (diffMs <= 0) {
            el.textContent = after;
            el.classList.remove('countdown');
            el.classList.add('update');
            unlockBlogCard(el.closest('.blog-card'));
            return;
          }
          const totalSecs = Math.ceil(diffMs / 1000);
          const days  = Math.floor(totalSecs / 86400);
          const hours = Math.floor((totalSecs % 86400) / 3600);
          const mins  = Math.floor((totalSecs % 3600) / 60);
          const secs  = totalSecs % 60;
          const pad   = n => String(n).padStart(2, '0');
          if (days > 0)  el.textContent = days + 'd ' + pad(hours) + 'h ' + pad(mins) + 'm ' + pad(secs) + 's';
          else if (hours > 0) el.textContent = pad(hours) + 'h ' + pad(mins) + 'm ' + pad(secs) + 's';
          else el.textContent = pad(mins) + 'm ' + pad(secs) + 's';
        });
      }
      (function loop() { tick(); setTimeout(loop, 1000 - (frNow() % 1000) + 8); })();   // flips on the server's second
    }
    startCountdownTicks();

    // ── Blog hero: while an update is scheduled, the logo is replaced by a big live countdown ──
    let bhcDefault = null, bhcTarget = null, bhcBound = false, bhcAudio = null, bhcMaster = null, bhcTick = 0;
    const bhcSoundOn = () => { try { return localStorage.getItem('fr-cd-sound') !== '0'; } catch (e) { return true; } };
    const BHC_ICON_ON  = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M19 5a10 10 0 0 1 0 14"/></svg>';
    const BHC_ICON_OFF = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>';
    function bhcUnlockAudio() {
      try {
        if (!bhcAudio) {
          const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return;
          bhcAudio = new AC(); bhcMaster = bhcAudio.createGain(); bhcMaster.gain.value = 0.5; bhcMaster.connect(bhcAudio.destination);
        }
        if (bhcAudio.state === 'suspended') bhcAudio.resume().catch(() => {});
      } catch (e) {}
    }
    ['pointerdown', 'keydown', 'touchstart'].forEach(ev => addEventListener(ev, bhcUnlockAudio, { passive: true }));
    // clock "tick" / lower "tock" on alternate seconds: a short filtered click plus a tiny wooden tone
    function bhcClockTick() {
      if (!bhcAudio || !bhcMaster || bhcAudio.state !== 'running') return;
      const t = bhcAudio.currentTime, tock = (bhcTick++ % 2) === 1;
      const len = Math.ceil(bhcAudio.sampleRate * 0.04), buf = bhcAudio.createBuffer(1, len, bhcAudio.sampleRate), d = buf.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 3);
      const src = bhcAudio.createBufferSource(); src.buffer = buf;
      const f = bhcAudio.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = tock ? 1500 : 2300; f.Q.value = 3;
      const g = bhcAudio.createGain(); g.gain.value = 1.4;
      src.connect(f); f.connect(g); g.connect(bhcMaster); src.start(t);
      const o = bhcAudio.createOscillator(), og = bhcAudio.createGain();
      o.type = 'triangle'; o.frequency.setValueAtTime(tock ? 620 : 880, t);
      og.gain.setValueAtTime(0.0001, t); og.gain.exponentialRampToValueAtTime(0.35, t + 0.004); og.gain.exponentialRampToValueAtTime(0.0001, t + 0.07);
      o.connect(og); og.connect(bhcMaster); o.start(t); o.stop(t + 0.09);
    }
    function bhcNextScheduled() {
      let best = null; const n = frNow();
      Object.keys(ARTICLES).forEach(function (k) {
        const a = ARTICLES[k]; if (!a || !a.badgeTimestamp) return;
        const t = new Date(a.badgeTimestamp).getTime();
        if (t > n && (best === null || t < best)) best = t;
      });
      return best;
    }
    function bhcRefresh() {
      const hero = document.querySelector('#page-blog .blog-hero'); if (!hero) return false;
      if (bhcDefault === null) bhcDefault = hero.innerHTML;
      const target = bhcNextScheduled();
      if (target === null) {
        if (bhcTarget !== null) { hero.innerHTML = bhcDefault; bhcTarget = null; }
        return false;
      }
      if (target !== bhcTarget) {
        bhcTarget = target;
        const seg = (id, unit) => '<div class="bhc-seg"><div class="bhc-num" id="' + id + '">00</div><div class="bhc-unit">' + unit + '</div></div>';
        const sep = '<div class="bhc-sep">:</div>';
        hero.innerHTML = '<div class="blog-hero-cd" role="timer" aria-label="Time until the next update">' +
          '<div class="bhc-label">Next update drops in</div>' +
          '<div class="bhc-row"><span id="bhcDaysWrap" style="display:contents">' + seg('bhcD', 'Days') + sep + '</span>' + seg('bhcH', 'Hours') + sep + seg('bhcM', 'Min') + sep + seg('bhcS', 'Sec') + '</div>' +
          '<button class="bhc-sound" id="bhcSound" type="button" aria-label="Toggle tick sound">' + (bhcSoundOn() ? BHC_ICON_ON : BHC_ICON_OFF) + '</button></div>';
        if (!bhcBound) {
          bhcBound = true;
          hero.addEventListener('click', function (e) {
            const b = e.target.closest('#bhcSound'); if (!b) return;
            const on = !bhcSoundOn();
            try { localStorage.setItem('fr-cd-sound', on ? '1' : '0'); } catch (err) {}
            b.innerHTML = on ? BHC_ICON_ON : BHC_ICON_OFF;
            if (on) bhcUnlockAudio();
          });
        }
      }
      const left = Math.max(0, Math.ceil((target - frNow()) / 1000));
      const days = Math.floor(left / 86400), pad = n => String(n).padStart(2, '0');
      const set = (id, v) => { const el = document.getElementById(id); if (el && el.textContent !== v) el.textContent = v; };
      const dw = document.getElementById('bhcDaysWrap'); if (dw) dw.style.display = days > 0 ? 'contents' : 'none';
      set('bhcD', pad(days)); set('bhcH', pad(Math.floor(left % 86400 / 3600))); set('bhcM', pad(Math.floor(left % 3600 / 60))); set('bhcS', pad(left % 60));
      return true;
    }
    (function bhcLoop() {
      const showing = bhcRefresh();
      const page = document.getElementById('page-blog');
      if (showing && bhcSoundOn() && !document.hidden && page && page.classList.contains('active')) bhcClockTick();
      setTimeout(bhcLoop, 1000 - (frNow() % 1000) + 8);
    })();

    const SVG_CAL   = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`;
    const SVG_CLOCK = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`;
    const SVG_ARROW = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;

    // Resolve a thumb URL: if relative (no protocol), prefix with BLOG_BASE_URL
    function resolveThumbUrl(url) {
      if (!url) return url;
      if (/^https?:\/\//i.test(url)) {
        // raw.githubusercontent.com rejects un-encoded parens/spaces in filenames.
        // Re-encode just the last path segment to fix URLs like:
        //   .../main/New%20Project(94)(1).png  →  .../main/New%20Project%2894%29%281%29.png
        if (url.indexOf('raw.githubusercontent.com') !== -1) {
          var qIdx  = url.indexOf('?');
          var base  = qIdx !== -1 ? url.slice(0, qIdx) : url;
          var query = qIdx !== -1 ? url.slice(qIdx)    : '';
          var slash = base.lastIndexOf('/');
          var dir   = base.slice(0, slash + 1);
          var file  = base.slice(slash + 1);
          // Decode first (in case already partially encoded), then re-encode cleanly
          try { file = decodeURIComponent(file); } catch(e) {}
          return dir + encodeURIComponent(file).replace(/\(/g,'%28').replace(/\)/g,'%29') + query;
        }
        return url;
      }
      // Relative path — resolve against BLOG_BASE_URL, encoding each segment
      var parts = url.split('/');
      var encoded = parts.map(function(p) {
        try { p = decodeURIComponent(p); } catch(e) {}
        return encodeURIComponent(p).replace(/\(/g,'%28').replace(/\)/g,'%29');
      }).join('/');
      return BLOG_BASE_URL + '/' + encoded;
    }

    // Scheduled (still-counting-down) articles never put their real image in the page. We load it once,
    // shrink it to ~64px wide (shapes and colors only, no readable detail), smooth it, draw a sharp white "?" on top, and use only that
    // flattened picture. Removing CSS / editing the DOM in devtools therefore reveals nothing.
    const CdLock = (function () {
      const srcs = {}, made = {};
      let n = 0;
      const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
      function isLocked(a) { return !!(a && a.badgeTimestamp && new Date(a.badgeTimestamp).getTime() > frNow()); }
      function render(img) {
        const W = 960;
        let H = Math.round(W * 9 / 16);
        if (img && img.naturalWidth) H = Math.max(240, Math.min(1400, Math.round(W * img.naturalHeight / img.naturalWidth)));
        const c = document.createElement('canvas'); c.width = W; c.height = H;
        const g = c.getContext('2d');
        if (img) {
          const sm = document.createElement('canvas'); sm.width = 64; sm.height = Math.max(2, Math.round(64 * H / W));
          sm.getContext('2d').drawImage(img, 0, 0, sm.width, sm.height);
          g.imageSmoothingEnabled = true; g.imageSmoothingQuality = 'high';
          g.drawImage(sm, 0, 0, W, H);
          if ('filter' in g) {
            const t = document.createElement('canvas'); t.width = W; t.height = H; t.getContext('2d').drawImage(c, 0, 0);
            g.filter = 'blur(7px)'; g.drawImage(t, -14, -14, W + 28, H + 28); g.filter = 'none';
          }
          g.fillStyle = 'rgba(8,4,20,.18)'; g.fillRect(0, 0, W, H);
        } else {
          const gr = g.createLinearGradient(0, 0, W, H); gr.addColorStop(0, '#1b1033'); gr.addColorStop(1, '#3b1d6e');
          g.fillStyle = gr; g.fillRect(0, 0, W, H);
        }
        g.fillStyle = '#fff'; g.textAlign = 'center'; g.textBaseline = 'middle';
        g.font = '900 ' + Math.round(Math.min(W, H) * 0.78) + 'px system-ui, -apple-system, "Segoe UI", Arial, sans-serif';
        g.shadowColor = 'rgba(0,0,0,.55)'; g.shadowBlur = 40;
        g.fillText('?', W / 2, H / 2 + Math.round(Math.min(W, H) * 0.04));
        return c.toDataURL('image/jpeg', 0.88);        // throws if the image was cross-origin without CORS
      }
      function make(src) {
        if (made[src]) return made[src];
        return made[src] = new Promise(function (res) {
          function plain() { try { res(render(null)); } catch (e) { res(BLANK); } }
          if (!src) return plain();
          const im = new Image(); im.crossOrigin = 'anonymous';
          im.onload = function () { try { res(render(im)); } catch (e) { plain(); } };
          im.onerror = plain;
          im.src = src;
        });
      }
      // While an article is still counting down, show a "?" in place of the title, description, excerpt and update text.
      // view() returns a masked copy for display; the real article object is never touched.
      function view(a) {
        if (!isLocked(a)) return a;
        const v = Object.assign({}, a);
        v.title = '?'; v.excerpt = '?'; v.desc = '?'; v.summary = '?';
        v.body = '<div class="cd-lock-q">?</div>';
        v.changes = {};
        v.version = ''; v.prev = ''; v.download = null; v.breaking = false; v.platforms = null;
        return v;
      }
      function slug(id, a) {
        if (a && isLocked(a)) return '???';
        const t = (a && a.title) ? a.title : id;
        return String(t).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      }
      return {
        isLocked: isLocked,
        view: view,
        slug: slug,
        html: function (a, firstSrc, isCard) {
          const key = 'l' + (++n); srcs[key] = firstSrc || '';
          return '<img class="cd-lock-img" data-cd-key="' + key + '" alt="" draggable="false" src="' + BLANK + '">';
        },
        hydrate: function (root) {
          root.querySelectorAll('img[data-cd-key]').forEach(function (im) {
            const key = im.getAttribute('data-cd-key');
            make(srcs[key]).then(function (url) { im.src = url; im.style.aspectRatio = 'auto'; im.removeAttribute('data-cd-key'); });
          });
        }
      };
    })();

    function buildThumbHTML(a, isCard) {
      if (CdLock.isLocked(a)) {
        const first = (Array.isArray(a.thumbImages) && a.thumbImages.length ? a.thumbImages : Array.isArray(a.thumbImage) ? a.thumbImage : (a.thumbImage ? [a.thumbImage] : []))[0];
        if (first || a.thumbStyle || a.thumbContent) return CdLock.html(a, first ? resolveThumbUrl(first) : '', isCard);
      }
      const fit      = 'contain';
      const position = a.thumbPosition || 'center';
      const imgStyle = `width:100%;height:auto;object-fit:${fit};object-position:${position};display:block;`;

      // Support both thumbImages (array) and thumbImage (string or array)
      // Relative paths are resolved against BLOG_BASE_URL automatically
      const rawImgs = Array.isArray(a.thumbImages) && a.thumbImages.length
        ? a.thumbImages
        : Array.isArray(a.thumbImage)
          ? a.thumbImage
          : (a.thumbImage ? [a.thumbImage] : []);
      const imgs = rawImgs.map(resolveThumbUrl);

      if (imgs.length === 1) {
        return `<img src="${imgs[0]}" alt="${a.title}" style="${imgStyle}">`;
      }
      if (imgs.length > 1) {
        const sliderId = 'slider-' + (a._file || a.id) + (isCard ? '-card' : '-hero');
        const imgTags = imgs.map(function(src) {
          return `<img src="${src}" alt="${a.title}" style="${imgStyle}">`;
        }).join('');
        const dots = imgs.map(function(_, i) {
          return `<button class="img-slider-dot${i === 0 ? ' active' : ''}" onclick="sliderGo('${sliderId}',${i})"></button>`;
        }).join('');
        const isAutoPlay = isCard; // blog cards auto-cycle; article hero uses arrows
        return `<div class="img-slider${isAutoPlay ? ' img-slider-auto' : ''}" id="${sliderId}">
          <div class="img-slider-track">${imgTags}</div>
          ${!isAutoPlay ? `<button class="img-slider-btn prev" onclick="sliderStep('${sliderId}',-1)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="img-slider-btn next" onclick="sliderStep('${sliderId}',1)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </button>` : ''}
          <div class="img-slider-dots">${dots}</div>
        </div>`;
      }
      if (a.thumbStyle || a.thumbContent) {
        return `<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;${a.thumbStyle || ''}">${a.thumbContent || ''}</div>`;
      }
      return null;
    }

    function buildBlogCard(realArticle) {
      const a = CdLock.view(realArticle);
      const isCd       = !!a.badgeTimestamp;
      const badgeClass = isCd ? 'countdown' : (BADGE_CLASS[a.badge] || 'update');
      const badgeLabel = isCd ? getCountdownLabel(a) : (a.badge || '');
      const badgeHTML  = (a.badge || isCd) ? `<span class="blog-card-badge ${badgeClass}"${isCd ? ` data-countdown-ts="${a.badgeTimestamp}" data-countdown-after="${a.badgeAfter || 'OUT NOW'}"` : ''}>${badgeLabel}</span>` : '';
      const readHTML   = a.read  ? `<span class="blog-card-read">${SVG_CLOCK} ${a.read}</span>` : '';
      const viewHTML   = `<span class="blog-card-views" data-blog-card-view-count="${escapeAttr(String(a._file || a.id || ''))}" aria-label="Article views">${getConfiguredViewCount(a, a._file || a.id)} views</span>`;
      const thumbInner = buildThumbHTML(a, true);
      const thumbBg    = a.thumbBg ? `background:${a.thumbBg};` : '';
      const thumbHTML  = thumbInner
        ? `<div class="blog-card-thumb" style="${thumbBg}">${thumbInner}${badgeHTML}</div>`
        : (badgeHTML ? `<div class="blog-card-thumb blog-card-thumb-empty">${badgeHTML}</div>` : '');
      const fileId = a._file || a.id;
      const card = document.createElement('div');
      card.id        = 'blog-card-' + fileId;
      card.className = 'blog-card' + (thumbInner ? '' : ' blog-card-no-thumb') + (a.pinned ? ' blog-card-pinned' : '');
      card.dataset.cat     = a.cat;
      card.dataset.title   = a.title;
      card.dataset.excerpt = a.excerpt;
      card.dataset.pinned  = a.pinned ? '1' : '';
      card._article = realArticle;
      card._locked  = CdLock.isLocked(realArticle);
      card.onclick = function() { openArticle(fileId); };
      card.innerHTML = `
        
        ${thumbHTML}
        <div class="blog-card-body">
          <h3 class="blog-card-title">${a.title}</h3>
          <p class="blog-card-excerpt">${a.excerpt}</p>
          <div class="blog-card-meta">
            <span class="blog-card-date">${SVG_CAL} ${a.date}</span>
            ${readHTML}
            ${viewHTML}
          </div>
          <a class="blog-card-readmore">Read more ${SVG_ARROW}</a>
        </div>
      `;
      CdLock.hydrate(card);
      return card;
    }

    // Countdown reached zero: rebuild the card with the real image
    function unlockBlogCard(card) {
      if (!card || !card._locked || !card._article) return;
      const fresh = buildBlogCard(card._article);
      fresh.style.display = card.style.display;
      card.replaceWith(fresh);
      try { renderUpdateLog(null, _ulPlatformFilter); } catch (e) {}
      if (typeof initAutoSliders === 'function') setTimeout(initAutoSliders, 50);
    }

    function renderBlogCards(articles) {
      const grid = document.getElementById('blogGrid');
      if (!grid) return;
      grid.innerHTML = '';

      // Sort: pinned first, then by date — all in one flat list
      const sorted = articles.slice().sort(function(a, b) {
        if (a.pinned && !b.pinned) return -1;
        if (!a.pinned && b.pinned) return 1;
        return 0;
      });
      sorted.forEach(function(a) { grid.appendChild(buildBlogCard(a)); });

      // Remove loading state if still present
      const loadingState = document.getElementById('blogLoadingState');
      if (loadingState) loadingState.remove();
      // Remove any stale no-results from previous render
      const stale = document.getElementById('blogNoResults');
      if (stale) stale.remove();

      buildFilterButtons(articles);
      setTimeout(initAutoSliders, 100);

      const bar = document.getElementById('blogCountBar');
      if (bar) bar.textContent = articles.length + ' article' + (articles.length !== 1 ? 's' : '') + ' found';
      filterBlog();
    }

    function refreshBlogCardViewUI(id) {
      const views = getConfiguredViewCount(ARTICLES[id] || ARTICLE_CACHE[id] || {}, id);
      document.querySelectorAll('[data-blog-card-view-count]').forEach(function(el) {
        if (el.dataset.blogCardViewCount === String(id)) el.textContent = views + ' views';
      });
    }

    async function prefetchBlogStates(articles) {
      if (!Array.isArray(articles) || !BLOG_API_URL) return;
      await Promise.allSettled(articles.map(function(article) {
        const id = article._file || article.id;
        return loadRemoteBlogState(id, { recordView: false }).then(function() {
          refreshBlogCardViewUI(id);
        }).catch(function() {});
      }));
    }

    // ── Image slider ────────────────────────────────────────────
    const _sliderIndex = {};
    function sliderGo(id, idx) {
      const el = document.getElementById(id);
      if (!el) return;
      const track = el.querySelector('.img-slider-track');
      const imgs  = track ? track.querySelectorAll('img') : [];
      const dots  = el.querySelectorAll('.img-slider-dot');
      if (!imgs.length) return;
      idx = ((idx % imgs.length) + imgs.length) % imgs.length;
      _sliderIndex[id] = idx;
      track.style.transform = 'translateX(-' + (idx * 100) + '%)';
      dots.forEach(function(d, i) { d.classList.toggle('active', i === idx); });
    }
    function sliderStep(id, dir) {
      sliderGo(id, (_sliderIndex[id] || 0) + dir);
    }

    // ── Auto-cycle for blog card sliders ────────────────────────
    var _sliderTimers = {};
    function startSliderAutoPlay(el) {
      var id = el.id;
      if (!id || _sliderTimers[id]) return;
      var imgs = el.querySelectorAll('.img-slider-track img');
      if (imgs.length < 2) return;
      _sliderTimers[id] = setInterval(function() {
        sliderGo(id, (_sliderIndex[id] || 0) + 1);
      }, 2800);
    }
    function stopSliderAutoPlay(id) {
      if (_sliderTimers[id]) { clearInterval(_sliderTimers[id]); delete _sliderTimers[id]; }
    }
    // Start auto-play on all .img-slider-auto elements after cards render
    function initAutoSliders() {
      document.querySelectorAll('.img-slider-auto').forEach(function(el) {
        startSliderAutoPlay(el);
      });
    }

    // Shared helpers for the hover/tap tooltips on the feature-history badges
    function escapeAttr(str) {
      return String(str).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // Tap-to-show tooltip support for touch devices (CSS :hover is unreliable on mobile)
    function toggleStatusTooltip(el) {
      const wasOpen = el.classList.contains('tt-show');
      document.querySelectorAll('.ch-item-status.tt-show').forEach(function(o) { o.classList.remove('tt-show'); });
      if (!wasOpen) el.classList.add('tt-show');
    }
    document.addEventListener('click', function(e) {
      if (!e.target.closest || !e.target.closest('.ch-item-status')) {
        document.querySelectorAll('.ch-item-status.tt-show').forEach(function(o) { o.classList.remove('tt-show'); });
      }
    });

    // ── Feature history across updates ───────────────────────────
    // Looks at every released update and, for each item in an update, works out whether that
    // feature was LATER removed and/or brought back. Matching is by item.id (the change's name, e.g.
    // "beta-assistant-chat"): the same id in another update means the same feature. Falls back to the text. A gray badge with a hover tooltip is shown.
    function _lcNorm(s) {
      return String(s == null ? '' : s).toLowerCase().replace(/<[^>]*>/g, ' ').replace(/[^a-z0-9]+/g, ' ').trim();
    }
    function _lcVerParts(v) {
      return String(v == null ? '' : v).replace(/^v/i, '').split('.').map(function(n) { return parseInt(n, 10) || 0; });
    }
    function _lcVerCmp(a, b) {
      var x = _lcVerParts(a), y = _lcVerParts(b), n = Math.max(x.length, y.length);
      for (var i = 0; i < n; i++) { var d = (x[i] || 0) - (y[i] || 0); if (d) return d; }
      return 0;
    }
    function _lcArticleCmp(a, b) {
      var da = Date.parse(a.date), db = Date.parse(b.date);
      if (!isNaN(da) && !isNaN(db) && da !== db) return da - db;
      return _lcVerCmp(a.version, b.version);
    }
    function _lcKey(item) {
      var isObj = item && typeof item === 'object';
      var text = isObj ? item.text : item;
      var id   = isObj ? (item.id || '') : '';
      var plat = isObj ? String(item.platform || '').toLowerCase().trim() : '';
      if (plat === 'all' || plat === 'pc') plat = '';
      var base = _lcNorm(id || text);   // id is the change's name ("beta-assistant-chat"); same id in another update = same feature
      return base ? base + '@' + plat : '';
    }
    function _lcBuildTimeline() {
      var arts = Object.keys(ARTICLES).map(function(k) { return ARTICLES[k]; }).filter(function(a) {
        return a && a.changes && typeof a.changes === 'object' && !CdLock.isLocked(a);   // never leak unreleased updates
      }).sort(_lcArticleCmp);
      var timeline = {}, order = {};
      arts.forEach(function(a, i) {
        order[a._file || a.id] = i;
        [['added', true], ['removed', false]].forEach(function(pair) {
          var list = a.changes[pair[0]];
          if (!Array.isArray(list)) return;
          list.forEach(function(item) {
            var k = _lcKey(item); if (!k) return;
            (timeline[k] = timeline[k] || []).push({ present: pair[1], idx: i, version: a.version, title: a.title });
          });
        });
      });
      return { timeline: timeline, order: order };
    }
    // Events that happened AFTER `article` for this item: [{type:'removed'|'returned', label:'v1.4'}]
    function _lcEventsAfter(item, srcKey, article, tl) {
      var k = _lcKey(item); if (!k || !tl.timeline[k]) return [];
      var fid = article && (article._file || article.id);
      if (!Object.prototype.hasOwnProperty.call(tl.order, fid)) return [];
      var myIdx = tl.order[fid];
      var present = srcKey !== 'removed';       // state of the feature right after this update
      var out = [];
      tl.timeline[k].forEach(function(e) {
        if (e.idx <= myIdx || e.present === present) return;   // ignore older updates and no-op repeats
        present = e.present;
        out.push({ type: present ? 'returned' : 'removed', label: e.version ? 'v' + e.version : (e.title || 'a later update') });
      });
      return out;
    }
    const _LC_ICON_REMOVED  = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="8" y1="12" x2="16" y2="12"/></svg>';
    const _LC_ICON_RETURNED = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>';
    function buildLifecycleBadgeHTML(events) {
      if (!events || !events.length) return '';
      var lines = events.map(function(e) { return (e.type === 'removed' ? 'Removed in ' : 'Returned in ') + e.label; });
      var last = events[events.length - 1];
      var tip = escapeAttr(lines.join('\n')).replace(/\n/g, '&#10;');
      return '<span class="ch-item-status" data-status="' + (last.type === 'removed' ? 'lc-removed' : 'lc-returned') + '" data-lc="1" ' +
        'data-tooltip="' + tip + '" tabindex="0" role="img" aria-label="' + escapeAttr(lines.join('. ')) + '" ' +
        'onclick="event.stopPropagation(); toggleStatusTooltip(this);">' +
        (last.type === 'removed' ? _LC_ICON_REMOVED : _LC_ICON_RETURNED) + '</span>';
    }

    // ── Render structured changes field ─────────────────────────
    const CHANGE_GROUPS = [
      { key: '_mobile',      icon: '📱', label: 'Mobile',      cls: 'mobile',      sym: '📱', mobileGroup: true },
      { key: '_frplus',      icon: '⭐', label: 'FR Plus',     cls: 'frplus',      sym: '⭐', frPlusGroup: true },
      { key: '_translation', icon: '🌐', label: 'Translation', cls: 'translation', sym: '🌐', translationGroup: true },
      { key: 'added',    icon: '🆕', label: 'New',          cls: 'added',    sym: '+' },
      { key: 'removed',  icon: '❌', label: 'Removed',      cls: 'removed',  sym: '−' },
      { key: 'fixed',    icon: '🐛', label: 'Bug Fixes',    cls: 'fixed',    sym: '✓' },
      { key: 'improved', icon: '⚡', label: 'Improvements', cls: 'improved', sym: '↑' },
      { key: 'security', icon: '🔒', label: 'Security',     cls: 'other',    sym: '🔒' },
      { key: 'other',    icon: '📝', label: 'Other',        cls: 'other',    sym: '·' },
    ];

    function copyArticleLink(btn) {
      const url = location.href;
      navigator.clipboard.writeText(url).then(function() {
        const svg = btn.querySelector('svg');
        const original = btn.innerHTML;
        btn.innerHTML = (svg ? svg.outerHTML : '') + ' Copied!';
        btn.style.color = '#22c55e';
        btn.style.borderColor = '#22c55e';
        setTimeout(function() {
          btn.innerHTML = original;
          btn.style.color = '';
          btn.style.borderColor = '';
        }, 2000);
      }).catch(function() {
        // Fallback for older browsers
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none;';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      });
    }

    // ── Blog like / dislike system ─────────────────────────────
    function getConfiguredReactionCount(article, keys) {
      for (let i = 0; i < keys.length; i++) {
        const value = Number(article && article[keys[i]]);
        if (Number.isFinite(value) && value >= 0) return Math.floor(value);
      }
      return 0;
    }

    function getConfiguredViewCount(article, id) {
      const remote = BLOG_REMOTE_STATE && BLOG_REMOTE_STATE[String(id)];
      if (remote && remote.loaded) return remote.views;
      return getConfiguredReactionCount(article, ['views', 'viewCount', 'view_count']);
    }

    function getBlogReactionState(article, id) {
      return getLocalBlogReaction(article, id);
    }

    const BLOG_COMMENTS_PAGE_SIZE = 3;
    const BLOG_MIN_COMMENT_LENGTH = 4;
    const BLOG_COMMENTS_VISIBLE = Object.create(null);
    let activeBlogCommentsId = null;
    let blogCommentIdentityState = null;
    let blogCommentIdentityRequest = null;
    let blogCommentIdentitySequence = 0;
    const BLOG_COMMENT_IDENTITY_CACHE_KEY = 'fr-blog-comment-identity-v1';
    const BLOG_COMMENT_IDENTITY_CACHE_TTL = 24 * 60 * 60 * 1000;
    const BLOG_LOCAL_REACTIONS_KEY = 'fr-blog-local-reactions-v2';
    const BLOG_LOCAL_COMMENT_REACTIONS_KEY = 'fr-blog-local-comment-reactions-v1';
    const BLOG_COMMENT_ACTION_CACHE_COOKIE = 'fr_blog_comment_actions_v1';
    const BLOG_COMMENT_ACTION_CACHE_MAX = 40;
    const BLOG_BLOCKED_COMMENT_TEXTS_KEY = 'fr-blog-blocked-comment-texts-v1';
    const BLOG_BLOCKED_COMMENT_TERMS = [
      'nigger', 'nigga', 'faggot', 'tranny', 'kike', 'chink',
      'spic', 'wetback', 'coon', 'gook', 'raghead', 'retard'
    ];

    function readBlogLocalJson(key, fallback) {
      try {
        const parsed = JSON.parse(localStorage.getItem(key) || 'null');
        return parsed && typeof parsed === 'object' ? parsed : fallback;
      } catch (_) {
        return fallback;
      }
    }

    function saveBlogLocalJson(key, value) {
      try { localStorage.setItem(key, JSON.stringify(value)); } catch (_) {}
    }

    function getBlogCommentActionCache() {
      try {
        const cookie = document.cookie.split('; ').find(function(item) {
          return item.indexOf(BLOG_COMMENT_ACTION_CACHE_COOKIE + '=') === 0;
        });
        if (!cookie) return {};
        const raw = decodeURIComponent(cookie.slice(BLOG_COMMENT_ACTION_CACHE_COOKIE.length + 1));
        const parsed = JSON.parse(raw);
        return parsed && typeof parsed === 'object' ? parsed : {};
      } catch (_) {
        return {};
      }
    }

    function saveBlogCommentActionCache(cache) {
      try {
        const entries = Object.entries(cache || {}).slice(-BLOG_COMMENT_ACTION_CACHE_MAX);
        let compact = {};
        while (entries.length) {
          compact = Object.fromEntries(entries);
          if (encodeURIComponent(JSON.stringify(compact)).length <= 3600) break;
          entries.shift();
        }
        document.cookie = BLOG_COMMENT_ACTION_CACHE_COOKIE + '=' +
          encodeURIComponent(JSON.stringify(compact)) +
          '; Max-Age=31536000; Path=/; SameSite=Lax' +
          (location.protocol === 'https:' ? '; Secure' : '');
      } catch (_) {}
    }

    function getBlogCommentActionCacheKey(articleId, commentId) {
      return getBlogReactionClientId() + ':' + String(articleId) + ':' + String(commentId);
    }

    function getLocalBlogCommentAction(articleId, commentId) {
      const cache = getBlogCommentActionCache();
      const stored = cache[getBlogCommentActionCacheKey(articleId, commentId)];
      return stored && typeof stored === 'object' ? stored : {};
    }

    function saveLocalBlogCommentAction(articleId, commentId, action) {
      const cache = getBlogCommentActionCache();
      const key = getBlogCommentActionCacheKey(articleId, commentId);
      cache[key] = Object.assign({}, cache[key] || {}, action || {});
      saveBlogCommentActionCache(cache);
    }

    function normalizeBlogModerationText(value) {
      return String(value || '')
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[013457@$]/g, function(character) {
          return ({
            '0': 'o', '1': 'i', '3': 'e', '4': 'a',
            '5': 's', '7': 't', '@': 'a', '$': 's'
          })[character] || character;
        })
        .replace(/[^a-z0-9]+/g, '');
    }

    function getLocalBlogReaction(article, id) {
      const saved = readBlogLocalJson(BLOG_LOCAL_REACTIONS_KEY, {});
      const stored = saved[String(id)];
      if (!stored || typeof stored !== 'object') {
        return {
          likes: getConfiguredReactionCount(article, ['likes', 'likeCount', 'like_count']),
          dislikes: getConfiguredReactionCount(article, ['dislikes', 'dislikeCount', 'dislike_count']),
          vote: null
        };
      }
      return {
        likes: Math.max(0, Math.floor(Number(stored.likes) || 0)),
        dislikes: Math.max(0, Math.floor(Number(stored.dislikes) || 0)),
        vote: stored.vote === 'like' || stored.vote === 'dislike' ? stored.vote : null
      };
    }

    function saveLocalBlogReaction(article, id, reactionState) {
      const saved = readBlogLocalJson(BLOG_LOCAL_REACTIONS_KEY, {});
      saved[String(id)] = {
        likes: Math.max(0, Math.floor(Number(reactionState.likes) || 0)),
        dislikes: Math.max(0, Math.floor(Number(reactionState.dislikes) || 0)),
        vote: reactionState.vote === 'like' || reactionState.vote === 'dislike' ? reactionState.vote : null
      };
      saveBlogLocalJson(BLOG_LOCAL_REACTIONS_KEY, saved);
    }

    function clearLocalBlogReaction(id) {
      const saved = readBlogLocalJson(BLOG_LOCAL_REACTIONS_KEY, {});
      delete saved[String(id)];
      saveBlogLocalJson(BLOG_LOCAL_REACTIONS_KEY, saved);
    }

    function getLocalBlogCommentReaction(articleId, commentId) {
      const saved = readBlogLocalJson(BLOG_LOCAL_COMMENT_REACTIONS_KEY, {});
      const key = String(articleId) + ':' + String(commentId);
      const stored = saved[key];
      if (stored && typeof stored === 'object' &&
          (stored.reaction === 'like' || stored.reaction === 'dislike' || stored.reaction === null)) {
        return stored.reaction;
      }
      const cached = getLocalBlogCommentAction(articleId, commentId);
      return cached.reaction === 'like' || cached.reaction === 'dislike' || cached.reaction === null
        ? cached.reaction
        : undefined;
    }

    function saveLocalBlogCommentReaction(articleId, commentId, reaction) {
      const saved = readBlogLocalJson(BLOG_LOCAL_COMMENT_REACTIONS_KEY, {});
      saved[String(articleId) + ':' + String(commentId)] = {
        reaction: reaction === 'like' || reaction === 'dislike' ? reaction : null
      };
      saveBlogLocalJson(BLOG_LOCAL_COMMENT_REACTIONS_KEY, saved);
      saveLocalBlogCommentAction(articleId, commentId, {
        reaction: reaction === 'like' || reaction === 'dislike' ? reaction : null
      });
    }

    function clearLocalBlogCommentReaction(articleId, commentId) {
      const saved = readBlogLocalJson(BLOG_LOCAL_COMMENT_REACTIONS_KEY, {});
      delete saved[String(articleId) + ':' + String(commentId)];
      saveBlogLocalJson(BLOG_LOCAL_COMMENT_REACTIONS_KEY, saved);
    }

    function getLocalBlogCommentReported(articleId, commentId) {
      return getLocalBlogCommentAction(articleId, commentId).reported === true;
    }

    function rememberLocalBlogCommentReported(articleId, commentId) {
      saveLocalBlogCommentAction(articleId, commentId, { reported: true });
    }

    function rememberBlockedBlogCommentText(text) {
      const normalized = normalizeBlogModerationText(text);
      if (!normalized) return;
      const saved = readBlogLocalJson(BLOG_BLOCKED_COMMENT_TEXTS_KEY, []);
      const list = Array.isArray(saved) ? saved.filter(Boolean) : [];
      if (!list.includes(normalized)) list.push(normalized);
      saveBlogLocalJson(BLOG_BLOCKED_COMMENT_TEXTS_KEY, list.slice(-50));
    }

    function getBlogCommentBlockReason(text) {
      const normalized = normalizeBlogModerationText(text);
      if (!normalized) return '';
      const blockedTexts = readBlogLocalJson(BLOG_BLOCKED_COMMENT_TEXTS_KEY, []);
      if (Array.isArray(blockedTexts) && blockedTexts.includes(normalized)) {
        return 'That comment was already blocked by moderation.';
      }
      if (BLOG_BLOCKED_COMMENT_TERMS.some(function(term) {
        return normalized.includes(normalizeBlogModerationText(term));
      })) {
        return 'That word or phrase is not allowed in comments.';
      }
      return '';
    }

    function blogIdentityLog(event, details) {
      try {
        console.info('[Friends Remover identity][website]', event, details || '');
      } catch (_) {}
    }

    /*
     * Frontend-only Roblox identity contract for comments.
     *
     * The extension bridge supplies the ID of the currently logged-in Roblox
     * account. It stays in memory only. The Worker resolves the authoritative
     * display name and avatar from Roblox before saving a comment.
     */
    function getBlogCommentAuthState() {
      const state = blogCommentIdentityState;
      if (!state || state.isAuthenticated !== true) return null;
      if (state.source !== 'friends-remover-extension') return null;
      const user = state.user || state;
      const userId = user && (user.userId || user.robloxId || user.id);
      return /^\d{1,20}$/.test(String(userId || '')) ? user : null;
    }

    function isBlogCommentAuthenticated() {
      return !!getBlogCommentAuthState();
    }

    function readBlogCommentIdentityCache() {
      try {
        const cached = JSON.parse(localStorage.getItem(BLOG_COMMENT_IDENTITY_CACHE_KEY) || 'null');
        if (!cached || !Number.isFinite(cached.cachedAt) ||
            Date.now() - cached.cachedAt > BLOG_COMMENT_IDENTITY_CACHE_TTL) {
          blogIdentityLog('cache_empty_or_expired');
          localStorage.removeItem(BLOG_COMMENT_IDENTITY_CACHE_KEY);
          return null;
        }
        const user = cached.user || {};
        const userId = String(user.userId || user.robloxId || user.id || '');
        if (!/^\d{1,20}$/.test(userId)) return null;
        blogIdentityLog('cache_restored', { userId });
        return {
          isAuthenticated: true,
          source: 'friends-remover-extension',
          user: {
            userId: userId,
            username: String(user.username || '').slice(0, 80),
            displayName: String(user.displayName || user.username || '').slice(0, 80),
          },
        };
      } catch (_) {
        return null;
      }
    }

    function cacheBlogCommentIdentity(state) {
      const user = state && state.user;
      if (!user) return;
      try {
        localStorage.setItem(BLOG_COMMENT_IDENTITY_CACHE_KEY, JSON.stringify({
          cachedAt: Date.now(),
          user: {
            userId: String(user.userId || user.robloxId || user.id || ''),
            username: String(user.username || '').slice(0, 80),
            displayName: String(user.displayName || user.username || '').slice(0, 80),
          },
        }));
      } catch (_) {}
    }

    function clearBlogCommentIdentityCache() {
      try { localStorage.removeItem(BLOG_COMMENT_IDENTITY_CACHE_KEY); } catch (_) {}
    }

    function syncBlogCommentComposerVisibility() {
      document.querySelectorAll('[data-blog-comments-composer]').forEach(function(composer) {
        const visible = !!getBlogCommentAuthState();
        composer.style.display = visible ? '' : 'none';
        composer.setAttribute('aria-hidden', String(!visible));
      });
    }

    function setBlogCommentAuthState(state) {
      blogCommentIdentityState = state || null;
      if (state) cacheBlogCommentIdentity(state);
      blogIdentityLog('identity_state_changed', {
        authenticated: !!getBlogCommentAuthState(),
        userId: state?.user ? String(state.user.userId || '') : '',
      });
      syncBlogCommentComposerVisibility();
      syncBlogCommentComposerAvatar();
      if (activeBlogCommentsId) renderBlogComments(activeBlogCommentsId);
      // Re-read any already-open article after the Roblox identity arrives.
      // This switches the reaction key from the browser cookie to the stable
      // Roblox user ID, so clearing site data cannot create a second vote.
      document.querySelectorAll('[data-reaction-panel]').forEach(function(panel) {
        const articleId = panel.dataset.articleId;
        if (!articleId || !BLOG_REMOTE_STATE[articleId]?.loaded) return;
        delete BLOG_REMOTE_STATE[articleId];
        loadRemoteBlogState(articleId, { recordView: false })
          .then(function() { refreshBlogReactionUI(articleId); })
          .catch(function() {});
      });
    }

    function getBlogCommentUserId() {
      const user = getBlogCommentAuthState();
      const userId = String(user?.userId || user?.robloxId || user?.id || '');
      return /^\d{1,20}$/.test(userId) ? userId : '';
    }

    function getBlogCommentHeadshotUrl(userId) {
      return 'https://www.roblox.com/headshot-thumbnail/image?userId=' +
        encodeURIComponent(userId) + '&width=150&height=150&format=png';
    }

    function setBlogCommentComposerAvatarElement(element, userId) {
      if (!element) return;
      if (!userId) {
        element.textContent = 'Y';
        return;
      }
      const image = document.createElement('img');
      image.alt = 'Your Roblox profile picture';
      image.src = getBlogCommentHeadshotUrl(userId);
      image.addEventListener('error', function() {
        element.textContent = 'Y';
      }, { once: true });
      element.replaceChildren(image);
    }

    function syncBlogCommentComposerAvatar() {
      const userId = getBlogCommentUserId();
      document.querySelectorAll('[data-blog-comments-composer-avatar]').forEach(function(element) {
        setBlogCommentComposerAvatarElement(element, userId);
      });
    }

    const BLOG_EXTENSION_IDENTITY_REQUEST = 'FR_EXTENSION_IDENTITY_REQUEST';
    const BLOG_EXTENSION_IDENTITY_RESPONSE = 'FR_EXTENSION_IDENTITY_RESPONSE';

    function requestFriendsRemoverExtensionIdentity() {
      if (blogCommentIdentityRequest) return blogCommentIdentityRequest;

      blogCommentIdentityRequest = new Promise(function(resolve) {
        const requestId = 'fr-identity-' + (++blogCommentIdentitySequence) + '-' + Date.now().toString(36);
        blogIdentityLog('identity_request_sent', { requestId });

        let settled = false;
        function finish(state) {
          if (settled) return;
          settled = true;
          window.removeEventListener('message', onMessage);
          clearTimeout(timeout);
          setBlogCommentAuthState(state);
          resolve(state);
        }
        function onMessage(event) {
          if (event.source !== window || event.origin !== location.origin) return;
          const response = event.data;
          if (!response || response.type !== BLOG_EXTENSION_IDENTITY_RESPONSE ||
              response.requestId !== requestId) return;

          const responseUser = response.user || {};
          const userId = String(responseUser.id || responseUser.userId || '');
          blogIdentityLog('identity_response_received', {
            requestId,
            success: response.success === true,
            userId,
            error: response.error || null,
          });
          if (response.success !== true || !/^\d{1,20}$/.test(userId)) {
            blogIdentityLog('identity_response_rejected', { requestId, reason: response.error || 'invalid_user_id' });
            clearBlogCommentIdentityCache();
            finish(null);
            return;
          }

          finish({
            isAuthenticated: true,
            source: 'friends-remover-extension',
            user: {
              userId: userId,
              username: String(responseUser.name || '').slice(0, 80),
              displayName: String(responseUser.displayName || responseUser.name || '').slice(0, 80),
            },
          });
        }

        const timeout = setTimeout(function() {
          // Keep a fresh cached identity during a temporary extension timeout.
          const fallback = blogCommentIdentityState || readBlogCommentIdentityCache();
          blogIdentityLog('identity_request_timeout', {
            requestId,
            usingCachedIdentity: !!fallback,
          });
          finish(fallback);
        }, 3500);
        window.addEventListener('message', onMessage);
        window.postMessage({
          type: BLOG_EXTENSION_IDENTITY_REQUEST,
          requestId: requestId,
        }, location.origin);
      }).finally(function() {
          blogCommentIdentityRequest = null;
      });

      return blogCommentIdentityRequest;
    }

    // The bridge keeps the Roblox ID in memory only; it is never put in
    // localStorage, sessionStorage, the URL, or a cookie.
    function initFriendsRemoverExtensionIdentityBridge() {
      const cached = readBlogCommentIdentityCache();
      if (cached) setBlogCommentAuthState(cached);
      requestFriendsRemoverExtensionIdentity();
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFriendsRemoverExtensionIdentityBridge, { once: true });
    } else {
      setTimeout(initFriendsRemoverExtensionIdentityBridge, 0);
    }

    function getBlogComments(id) {
      return [];
    }

    function getBlogCommentAvatarHtml(comment, initials) {
      const avatarUrl = String(comment && comment.avatarUrl || '');
      // Only render the Roblox CDN host returned by the Worker. In
      // particular, never turn a browser-supplied URL into an <img> tag.
      if (/^https:\/\/tr\.rbxcdn\.com\//i.test(avatarUrl)) {
        return '<img src="' + escapeBlogCommentHtml(avatarUrl) + '" alt="" loading="lazy">';
      }
      return escapeBlogCommentHtml(initials);
    }

    function escapeBlogCommentHtml(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, function(char) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
      });
    }

    function getBlogCommentDate(value) {
      try {
        return new Date(value).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
      } catch (e) {
        return '';
      }
    }

    function getBlogCommentAge(value) {
      const timestamp = new Date(value).getTime();
      if (!Number.isFinite(timestamp)) return 'Just now';
      const seconds = Math.max(0, Math.floor((Date.now() - timestamp) / 1000));
      if (seconds < 60) return 'Just now';
      const minutes = Math.floor(seconds / 60);
      if (minutes < 60) return minutes + 'm ago';
      const hours = Math.floor(minutes / 60);
      if (hours < 24) return hours + 'h ago';
      const days = Math.floor(hours / 24);
      if (days < 7) return days + 'd ago';
      return Math.floor(days / 7) + 'w ago';
    }

    function orderBlogCommentsForDisplay(comments) {
      const childrenByParent = Object.create(null);
      const roots = [];
      comments.forEach(function(comment) {
        const parentId = comment.parentId ? String(comment.parentId) : '';
        if (!parentId) {
          roots.push(comment);
          return;
        }
        (childrenByParent[parentId] || (childrenByParent[parentId] = [])).push(comment);
      });

      const ordered = [];
      const visited = Object.create(null);
      function append(comment, depth) {
        const commentId = String(comment.id || '');
        if (!commentId || visited[commentId]) return;
        visited[commentId] = true;
        ordered.push(Object.assign({}, comment, {
          replyDepth: Math.min(Math.max(depth, 1), 5)
        }));
        (childrenByParent[commentId] || []).forEach(function(child) {
          append(child, depth + 1);
        });
      }
      roots.forEach(function(comment) { append(comment, 0); });
      // Keep malformed/orphaned historical replies visible rather than
      // dropping them if their parent was deleted.
      comments.forEach(function(comment) { append(comment, 0); });
      return ordered;
    }

    function renderBlogComments(id) {
      activeBlogCommentsId = String(id);
      const comments = getBlogComments(id);
      document.querySelectorAll('[data-blog-comments-list]').forEach(function(list) {
        if (list.dataset.articleId !== String(id)) return;
        if (!comments.length) {
          list.innerHTML = '<div class="blog-comments-empty">No comments yet. Start the conversation.</div>';
          return;
        }
        const visibleLimit = BLOG_COMMENTS_VISIBLE[String(id)] || BLOG_COMMENTS_PAGE_SIZE;
        const orderedComments = orderBlogCommentsForDisplay(comments);
        const visibleComments = orderedComments.slice(0, visibleLimit);
        list.innerHTML = visibleComments.map(function(comment) {
          const author = String(comment.displayName || comment.author || 'Roblox user').slice(0, 80);
          const initials = author.trim().split(/\s+/).filter(Boolean).map(function(part) { return part[0]; }).join('').slice(0, 2).toUpperCase() || 'Y';
          const likes = Math.max(0, Number(comment.likes) || 0);
          const dislikes = Math.max(0, Number(comment.dislikes) || 0);
          const parent = comment.parentId
            ? comments.find(function(item) { return String(item.id) === String(comment.parentId); })
            : null;
          const parentAuthor = parent
            ? String(parent.displayName || parent.author || 'this comment').slice(0, 80)
            : '';
          const replyContext = comment.parentId && parent
            ? '<div class="blog-comment-reply-context">Replying to <strong>' + escapeBlogCommentHtml(parentAuthor) + '</strong></div>'
            : '';
          const viewerId = getBlogCommentUserId();
          const isOwnComment = !!viewerId && viewerId === String(comment.robloxUserId || '');
          const menuHtml = isOwnComment
            ? '<div class="blog-comment-menu-wrap">' +
              '<button type="button" class="blog-comment-more" data-comment-id="' + escapeBlogCommentHtml(comment.id) + '" onclick="toggleBlogCommentMenu(this)" aria-haspopup="menu" aria-expanded="false" aria-label="More comment options">⋮</button>' +
              '<div class="blog-comment-menu" role="menu">' +
              '<button type="button" data-comment-menu-action="edit" onclick="handleBlogCommentMenuAction(this)">Edit</button>' +
              '<button type="button" data-comment-menu-action="remove" onclick="handleBlogCommentMenuAction(this)">Remove</button>' +
              '</div></div>'
            : '';
          const reportHtml = !isOwnComment && !comment.reported
            ? '<button type="button" class="blog-comment-action blog-comment-report" data-comment-id="' + escapeBlogCommentHtml(comment.id) + '" onclick="handleBlogCommentReport(this)" aria-label="Report comment">Report</button>'
            : (!isOwnComment && comment.reported
              ? '<span class="blog-comment-reported" aria-label="You already reported this comment">Reported</span>'
              : '');
          return '<div class="blog-comment' + (comment.parentId ? ' blog-comment-reply' : '') + (comment.isHidden ? ' blog-comment-hidden' : '') + '" data-comment-id="' + escapeBlogCommentHtml(comment.id) + '"' + (comment.parentId ? ' data-parent-comment-id="' + escapeBlogCommentHtml(comment.parentId) + '" data-reply-depth="' + String(comment.replyDepth || 1) + '"' : '') + '>' +
            '<span class="blog-comment-avatar" aria-hidden="true">' + getBlogCommentAvatarHtml(comment, initials) + '</span>' +
            '<div class="blog-comment-content">' +
              '<div class="blog-comment-meta"><span class="blog-comment-byline"><span class="blog-comment-author">' +
              escapeBlogCommentHtml(author) + '</span><span class="blog-comment-separator">·</span><span class="blog-comment-time">' +
              escapeBlogCommentHtml(getBlogCommentAge(comment.createdAt)) + '</span>' +
              (comment.editedAt ? '<span class="blog-comment-separator">·</span><span class="blog-comment-time">edited</span>' : '') +
              '</span>' +
              menuHtml + '</div>' +
              replyContext +
              '<div class="blog-comment-text">' + escapeBlogCommentHtml(comment.text) + '</div>' +
              '<div class="blog-comment-actions">' +
                '<button type="button" class="blog-comment-action' + (comment.vote === 'like' ? ' selected' : '') + '" data-comment-action="like" data-comment-id="' + escapeBlogCommentHtml(comment.id) + '" onclick="handleBlogCommentAction(this)" aria-pressed="' + String(comment.vote === 'like') + '" aria-label="Like comment"><svg viewBox="0 0 24 24" fill="' + (comment.vote === 'like' ? 'currentColor' : 'none') + '" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 1 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z"/></svg><span>' + likes + '</span></button>' +
                '<button type="button" class="blog-comment-action' + (comment.vote === 'dislike' ? ' selected' : '') + '" data-comment-action="dislike" data-comment-id="' + escapeBlogCommentHtml(comment.id) + '" onclick="handleBlogCommentAction(this)" aria-pressed="' + String(comment.vote === 'dislike') + '" aria-label="Dislike comment"><svg viewBox="0 0 24 24" fill="' + (comment.vote === 'dislike' ? 'currentColor' : 'none') + '" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 14V2"/><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 1-1.79 1.11L12 22h0a3.13 3.13 0 0 1-3-3.88Z"/></svg><span>' + dislikes + '</span></button>' +
                '<button type="button" class="blog-comment-action" data-comment-action="reply" data-comment-id="' + escapeBlogCommentHtml(comment.id) + '" data-comment-author="' + escapeBlogCommentHtml(author) + '" onclick="handleBlogCommentAction(this)" aria-label="Reply to comment"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 17 4 12l5-5"/><path d="M4 12h10a6 6 0 0 1 6 6v1"/></svg><span>Reply</span></button>' +
                reportHtml +
              '</div>' +
            '</div>' +
            '</div>';
        }).join('') + (comments.length > visibleLimit
          ? '<button type="button" class="blog-comments-load-more" onclick="loadMoreBlogComments(this)">Load More Comments <span aria-hidden="true">⌄</span></button>'
          : '');
      });
      refreshBlogCommentsCount(id);
      syncBlogCommentComposerAvatar();
    }

    function refreshBlogCommentsCount(id) {
      const total = getBlogComments(id).length;
      document.querySelectorAll('[data-blog-comments-section]').forEach(function(section) {
        if (section.dataset.articleId !== String(id)) return;
        const count = section.querySelector('[data-blog-comments-count]');
        if (count) count.textContent = '(' + total + ')';
      });
    }

    function loadMoreBlogComments(button) {
      const list = button && button.closest ? button.closest('[data-blog-comments-list]') : null;
      if (!list) return;
      const id = list.dataset.articleId;
      BLOG_COMMENTS_VISIBLE[String(id)] = (BLOG_COMMENTS_VISIBLE[String(id)] || BLOG_COMMENTS_PAGE_SIZE) + BLOG_COMMENTS_PAGE_SIZE;
      renderBlogComments(id);
    }

    function updateBlogCommentLength(input) {
      const form = input && input.closest ? input.closest('.blog-comments-form') : null;
      const counter = form && form.querySelector('[data-blog-comments-char-count]');
      if (counter) counter.textContent = String(input.value.length) + ' / 200';
      const text = input ? input.value.trim() : '';
      const blockReason = getBlogCommentBlockReason(text);
      const tooShort = text.length > 0 && text.length < BLOG_MIN_COMMENT_LENGTH;
      input.setCustomValidity(blockReason || (tooShort
        ? 'Comments must be at least ' + BLOG_MIN_COMMENT_LENGTH + ' characters.'
        : ''));
      input.setAttribute('aria-invalid', String(Boolean(blockReason || tooShort)));
    }

    function handleBlogCommentInput(input) {
      const previous = input.dataset.lastAllowedValue || '';
      const reason = getBlogCommentBlockReason(input.value);
      if (reason) {
        input.value = previous;
        setBlogCommentsStatus(reason, true, input.closest('[data-blog-comments-section]')?.dataset.articleId);
      } else {
        input.dataset.lastAllowedValue = input.value;
      }
      updateBlogCommentLength(input);
    }

    function submitBlogComment(event) {
      event.preventDefault();
      const form = event.currentTarget;
      const section = form && form.closest ? form.closest('[data-blog-comments-section]') : null;
      if (section) activeBlogCommentsId = section.dataset.articleId;
      if (!activeBlogCommentsId) return;
      if (!isBlogCommentAuthenticated()) {
        setBlogCommentsStatus('Open Roblox with the Friends Remover extension installed to comment.', true, activeBlogCommentsId);
        return;
      }
      const input = form ? form.querySelector('textarea') : null;
      const text = input ? input.value.trim() : '';
      if (!text) {
        if (input) input.focus();
        return;
      }
      if (text.length < BLOG_MIN_COMMENT_LENGTH) {
        setBlogCommentsStatus('Comments must be at least ' + BLOG_MIN_COMMENT_LENGTH + ' characters.', true, activeBlogCommentsId);
        if (input) input.focus();
        return;
      }
      const blockReason = getBlogCommentBlockReason(text);
      if (blockReason) {
        setBlogCommentsStatus(blockReason, true, activeBlogCommentsId);
        if (input) input.focus();
        return;
      }
    }
    window.submitBlogComment = submitBlogComment;
    window.updateBlogCommentLength = updateBlogCommentLength;
    window.handleBlogCommentInput = handleBlogCommentInput;
    window.loadMoreBlogComments = loadMoreBlogComments;

    function buildArticleFeedbackHTML(article, id) {
      const state = getBlogReactionState(article, id);
      const articleId = escapeAttr(String(id));
      const viewCount = getConfiguredViewCount(article, id);
      return `
        <div class="article-feedback-inline" data-reaction-panel data-article-id="${articleId}" aria-label="Article feedback">
            <button type="button" class="article-reaction-btn${state.vote === 'like' ? ' selected-like' : ''}" data-reaction="like" onclick="handleBlogReaction(this)" aria-pressed="${state.vote === 'like'}" aria-label="Like this article">
              <svg viewBox="0 0 24 24" fill="${state.vote === 'like' ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z"/></svg>
              <span>Like</span><span class="article-reaction-count">${state.likes}</span>
            </button>
            <button type="button" class="article-reaction-btn${state.vote === 'dislike' ? ' selected-dislike' : ''}" data-reaction="dislike" onclick="handleBlogReaction(this)" aria-pressed="${state.vote === 'dislike'}" aria-label="Dislike this article">
              <svg viewBox="0 0 24 24" fill="${state.vote === 'dislike' ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 14V2"/><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22h0a3.13 3.13 0 0 1-3-3.88Z"/></svg>
              <span>Dislike</span><span class="article-reaction-count">${state.dislikes}</span>
            </button>
            <span class="article-view-count" data-blog-view-count aria-label="${viewCount} article views">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
              <span>${viewCount} views</span>
            </span>
            <span class="article-reaction-status" data-reaction-status aria-live="polite"></span>
        </div>
      `;
    }

    function buildBlogCommentsHTML(article, id) {
      const articleId = escapeAttr(String(id));
      return `
        <section class="blog-comments-inline" data-blog-comments-section data-article-id="${articleId}" aria-label="Comments">
          <div class="blog-comments-composer" data-blog-comments-composer style="display:none" aria-hidden="true">
            <span class="blog-comments-composer-icon" data-blog-comments-composer-avatar aria-hidden="true">Y</span>
            <div class="blog-comments-composer-main">
              <form class="blog-comments-form" onsubmit="submitBlogComment(event)">
                <div class="blog-comments-input-row">
                  <div class="blog-comments-textarea-wrap">
                    <textarea minlength="4" maxlength="200" placeholder="Write a comment..." aria-label="Write a comment" oninput="handleBlogCommentInput(this)"></textarea>
                    <span class="blog-comments-char-count" data-blog-comments-char-count>0 / 200</span>
                  </div>
                  <button type="submit" class="blog-comments-submit">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>
                    </svg>
                    <span>Post Comment</span>
                  </button>
                </div>
                <div class="blog-comments-form-row">
                  <div class="blog-comments-form-meta">
                    <span class="blog-comments-note" data-blog-comments-note aria-live="polite">Be respectful and follow our <a class="blog-comments-guidelines-link" href="#community-guidelines" onclick="event.preventDefault();showPage('community-guidelines')">Community Guidelines</a>.</span>
                  </div>
                </div>
              </form>
            </div>
          </div>
          <div class="blog-comments-list" data-blog-comments-list data-article-id="${articleId}">
            <div class="blog-comments-empty">Loading comments…</div>
          </div>
        </section>
      `;
    }

    function refreshBlogReactionUI(id, statusText) {
      document.querySelectorAll('[data-reaction-panel]').forEach(function(panel) {
        if (panel.dataset.articleId !== String(id)) return;
        const state = getBlogReactionState(ARTICLES[id] || ARTICLE_CACHE[id] || {}, id);
        panel.querySelectorAll('[data-reaction]').forEach(function(button) {
          const selected = button.dataset.reaction === state.vote;
          button.classList.toggle('selected-like', selected && state.vote === 'like');
          button.classList.toggle('selected-dislike', selected && state.vote === 'dislike');
          button.setAttribute('aria-pressed', String(selected));
          const icon = button.querySelector('svg');
          if (icon) icon.setAttribute('fill', selected ? 'currentColor' : 'none');
          const count = button.querySelector('.article-reaction-count');
          if (count) count.textContent = button.dataset.reaction === 'like' ? state.likes : state.dislikes;
        });
        const viewWrap = panel.querySelector('[data-blog-view-count]');
        const viewText = viewWrap && viewWrap.querySelector('span');
        if (viewText) {
          const views = getConfiguredViewCount(ARTICLES[id] || ARTICLE_CACHE[id] || {}, id);
          viewText.textContent = views + ' views';
          viewWrap.setAttribute('aria-label', views + ' article views');
        }
        const status = panel.querySelector('[data-reaction-status]');
        if (status) status.textContent = statusText || (state.vote ? 'Thanks for your feedback.' : '');
      });
    }

    function handleBlogReaction(button) {
      const panel = button.closest('[data-reaction-panel]');
      if (!panel) return;
      const id = panel.dataset.articleId;
      const reaction = button.dataset.reaction;
      const article = ARTICLES[id] || ARTICLE_CACHE[id] || {};
      const state = getBlogReactionState(article, id);

      if (state.vote === reaction) {
        state[reaction === 'like' ? 'likes' : 'dislikes'] = Math.max(0, state[reaction === 'like' ? 'likes' : 'dislikes'] - 1);
        state.vote = null;
        refreshBlogReactionUI(id, 'Feedback removed.');
        return;
      }

      if (state.vote) {
        const previousKey = state.vote === 'like' ? 'likes' : 'dislikes';
        state[previousKey] = Math.max(0, state[previousKey] - 1);
      }
      const nextKey = reaction === 'like' ? 'likes' : 'dislikes';
      state[nextKey] += 1;
      state.vote = reaction;
      refreshBlogReactionUI(id, 'Thanks for your feedback.');
    }
    window.handleBlogReaction = handleBlogReaction;

    // ── Optional Cloudflare Worker sync ─────────────────────────
    // Leave this blank while developing locally. Once the Worker is deployed,
    // set the URL in a small script before this file's scripts run:
    // window.FRIENDS_REMOVER_BLOG_API_URL = 'https://your-worker.workers.dev';
    //
    // Do not put a private secret in this browser file. Anything shipped to
    // visitors is public. The Worker source below uses its KV binding and
    // origin allow-list instead.
    const BLOG_API_URL = String(
      window.FRIENDS_REMOVER_BLOG_API_URL || 'https://blogs.bluemakeslogos.workers.dev'
    ).replace(/\/+$/, '');
    const BLOG_CLIENT_ID_KEY = 'fr-blog-client-id-v1';
    const BLOG_CLIENT_COOKIE_KEY = 'fr_blog_client_id';
    const BLOG_REMOTE_STATE = Object.create(null);

    function getBlogClientId() {
      try {
        let id = localStorage.getItem(BLOG_CLIENT_ID_KEY);
        if (!id) {
          const cookie = document.cookie.split('; ').find(function(item) {
            return item.indexOf(BLOG_CLIENT_COOKIE_KEY + '=') === 0;
          });
          if (cookie) id = decodeURIComponent(cookie.slice(BLOG_CLIENT_COOKIE_KEY.length + 1));
        }
        if (!id) {
          id = (window.crypto && typeof window.crypto.randomUUID === 'function')
            ? window.crypto.randomUUID()
            : 'client-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2);
        }
        localStorage.setItem(BLOG_CLIENT_ID_KEY, id);
        document.cookie = BLOG_CLIENT_COOKIE_KEY + '=' + encodeURIComponent(id) +
          '; Max-Age=31536000; Path=/; SameSite=Lax' +
          (location.protocol === 'https:' ? '; Secure' : '');
        return id;
      } catch (e) {
        return 'anonymous-client';
      }
    }

    function getBlogReactionClientId() {
      const robloxUserId = getBlogCommentUserId();
      return robloxUserId ? 'roblox-user-' + robloxUserId : getBlogClientId();
    }

    function blogApiEndpoint(id) {
      return BLOG_API_URL
        ? BLOG_API_URL + '/api/blog/' + encodeURIComponent(String(id))
        : '';
    }

    function normalizeRemoteBlogState(payload, id) {
      const data = payload && payload.data && typeof payload.data === 'object' ? payload.data : (payload || {});
      return {
        articleId: String(data.articleId || id),
        likes: Math.max(0, Math.floor(Number(data.likes) || 0)),
        dislikes: Math.max(0, Math.floor(Number(data.dislikes) || 0)),
        views: Math.max(0, Math.floor(Number(data.views) || 0)),
        vote: data.vote === 'like' || data.vote === 'dislike' ? data.vote : null,
        comments: Array.isArray(data.comments) ? data.comments.map(function(comment) {
          const displayName = String(comment.displayName || comment.author || 'Roblox user').slice(0, 80);
          const normalizedComment = {
            id: String(comment.id || ''),
            parentId: comment.parentId ? String(comment.parentId) : null,
            text: String(comment.text || '').slice(0, 200),
            robloxUserId: String(comment.robloxUserId || '').slice(0, 32),
            displayName: displayName,
            author: displayName,
            avatarUrl: String(comment.avatarUrl || '').slice(0, 500),
            likes: Math.max(0, Math.floor(Number(comment.likes) || 0)),
            dislikes: Math.max(0, Math.floor(Number(comment.dislikes) || 0)),
            vote: comment.vote === 'like' || comment.vote === 'dislike' ? comment.vote : null,
            reported: comment.reported === true || getLocalBlogCommentReported(id, String(comment.id || '')),
            createdAt: comment.createdAt || new Date().toISOString(),
            editedAt: comment.editedAt || null,
            isHidden: comment.isHidden === true
          };
          const localVote = getLocalBlogCommentReaction(id, normalizedComment.id);
          if (localVote !== undefined) {
            if (normalizedComment.vote === 'like') normalizedComment.likes = Math.max(0, normalizedComment.likes - 1);
            if (normalizedComment.vote === 'dislike') normalizedComment.dislikes = Math.max(0, normalizedComment.dislikes - 1);
            if (localVote === 'like') normalizedComment.likes += 1;
            if (localVote === 'dislike') normalizedComment.dislikes += 1;
            normalizedComment.vote = localVote;
          }
          return normalizedComment;
        }) : [],
        loaded: true
      };
    }

    function setBlogCommentsStatus(text, isError, id) {
      document.querySelectorAll('[data-blog-comments-section]').forEach(function(section) {
        if (id && section.dataset.articleId !== String(id)) return;
        const note = section.querySelector('[data-blog-comments-note]');
        if (!note) return;
        note.textContent = text || '';
        note.style.color = isError ? '#dc2626' : '';
      });
    }

    function applyRemoteBlogState(id, payload) {
      const state = normalizeRemoteBlogState(payload, id);
      BLOG_REMOTE_STATE[String(id)] = state;
      return state;
    }

    async function loadRemoteBlogState(id, options) {
      options = options || {};
      const recordView = options.recordView !== false;
      const endpoint = blogApiEndpoint(id);
      if (!endpoint) return null;
      if (BLOG_REMOTE_STATE[String(id)] && BLOG_REMOTE_STATE[String(id)].loaded) {
        if (recordView) registerBlogView(id).catch(function() {});
        return BLOG_REMOTE_STATE[String(id)];
      }
      const response = await fetch(endpoint + '?clientId=' + encodeURIComponent(getBlogReactionClientId()), {
        method: 'GET',
        headers: { 'Accept': 'application/json' },
        cache: 'no-store'
      });
      if (!response.ok) throw new Error('Blog API returned HTTP ' + response.status);
      const state = applyRemoteBlogState(id, await response.json());
      // Count at most one view per article per UTC day in this browser.
      if (recordView) registerBlogView(id).catch(function() {});
      return state;
    }

    async function writeRemoteBlogState(id, body) {
      const endpoint = blogApiEndpoint(id);
      if (!endpoint) return null;
      const action = body && body.action ? String(body.action) : '';
      const requestBody = { action: action, clientId: getBlogReactionClientId() };
      // Copy only fields understood by the API. Identity fields are
      // deliberately impossible to send through this helper.
      if (action === 'add-comment') {
        requestBody.text = String(body.text || '').slice(0, 200);
        requestBody.parentId = body.parentId ? String(body.parentId) : null;
        const identity = getBlogCommentAuthState();
        if (!identity) throw new Error('A logged-in Roblox account is required');
        requestBody.robloxUserId = String(identity.userId || identity.robloxId || identity.id);
      } else if (action === 'set-comment-reaction') {
        requestBody.commentId = String(body.commentId || '');
        requestBody.reaction = body.reaction === 'like' || body.reaction === 'dislike' ? body.reaction : null;
      } else if (action === 'edit-comment' || action === 'delete-comment') {
        requestBody.commentId = String(body.commentId || '');
        const identity = getBlogCommentAuthState();
        if (!identity) throw new Error('A logged-in Roblox account is required');
        requestBody.robloxUserId = String(identity.userId || identity.robloxId || identity.id || '');
        if (action === 'edit-comment') requestBody.text = String(body.text || '').slice(0, 200);
      } else if (action === 'report-comment') {
        requestBody.commentId = String(body.commentId || '');
        requestBody.reason = String(body.reason || '').slice(0, 160);
        const identity = getBlogCommentAuthState();
        if (identity) {
          requestBody.robloxUserId = String(identity.userId || identity.robloxId || identity.id || '');
        }
      } else if (action === 'set-reaction') {
        requestBody.reaction = body.reaction === 'like' || body.reaction === 'dislike' ? body.reaction : null;
      } else if (action !== 'record-view') {
        throw new Error('Unsupported blog action');
      }
      const headers = { 'Content-Type': 'application/json', 'Accept': 'application/json' };
      const response = await fetch(endpoint + '?clientId=' + encodeURIComponent(getBlogReactionClientId()), {
        method: 'POST',
        headers: headers,
        body: JSON.stringify(requestBody)
      });
      if (!response.ok) {
        let message = 'Blog API returned HTTP ' + response.status;
        try {
          const errorPayload = await response.json();
          if (errorPayload && errorPayload.error) message = String(errorPayload.error).slice(0, 180);
        } catch (_) {}
        throw new Error(message);
      }
      return applyRemoteBlogState(id, await response.json());
    }

    const BLOG_VIEW_CACHE_KEY = 'fr-blog-view-cache-v1';
    const BLOG_VIEW_CACHE_MAX = 500;

    function getBlogViewCache() {
      try {
        const raw = localStorage.getItem(BLOG_VIEW_CACHE_KEY);
        const parsed = raw ? JSON.parse(raw) : {};
        return parsed && typeof parsed === 'object' ? parsed : {};
      } catch (e) {
        return {};
      }
    }

    function saveBlogViewCache(cache) {
      try {
        const entries = Object.entries(cache)
          .sort(function(a, b) { return String(b[1]).localeCompare(String(a[1])); })
          .slice(0, BLOG_VIEW_CACHE_MAX);
        localStorage.setItem(BLOG_VIEW_CACHE_KEY, JSON.stringify(Object.fromEntries(entries)));
      } catch (e) {}
    }

    async function registerBlogView(id) {
      const endpoint = blogApiEndpoint(id);
      if (!endpoint) return null;
      const key = String(id);
      const today = new Date().toISOString().slice(0, 10);
      const cache = getBlogViewCache();
      if (cache[key] === today) return BLOG_REMOTE_STATE[key] || null;

      // Set the local guard before the network request so rapid reloads
      // cannot create duplicate view writes.
      cache[key] = today;
      saveBlogViewCache(cache);
      try {
        const state = await writeRemoteBlogState(id, { action: 'record-view' });
        refreshBlogReactionUI(id);
        return state;
      } catch (error) {
        // Allow a later visit to retry if the Worker was unavailable.
        const latest = getBlogViewCache();
        if (latest[key] === today) {
          delete latest[key];
          saveBlogViewCache(latest);
        }
        throw error;
      }
    }

    // Prefer the Worker for shared totals, but keep reactions usable when the
    // Worker is temporarily unavailable by falling back to this browser.
    getBlogReactionState = function(article, id) {
      const remote = BLOG_REMOTE_STATE[String(id)];
      if (remote && remote.loaded && !remote.offline) {
        return { likes: remote.likes, dislikes: remote.dislikes, vote: remote.vote };
      }
      return getLocalBlogReaction(article, id);
    };

    getBlogComments = function(id) {
      const remote = BLOG_REMOTE_STATE[String(id)];
      return remote && remote.loaded ? remote.comments.slice() : [];
    };

    submitBlogComment = async function(event) {
      event.preventDefault();
      const form = event.currentTarget;
      const section = form && form.closest ? form.closest('[data-blog-comments-section]') : null;
      if (section) activeBlogCommentsId = section.dataset.articleId;
      if (!activeBlogCommentsId) return;
      const id = activeBlogCommentsId;
      if (!isBlogCommentAuthenticated()) {
        blogIdentityLog('submit_waiting_for_identity', { articleId: id });
        const identity = await requestFriendsRemoverExtensionIdentity();
        if (!identity || !isBlogCommentAuthenticated()) {
          setBlogCommentsStatus('Open Roblox with the Friends Remover extension installed to comment.', true, id);
          return;
        }
      }
      const input = form ? form.querySelector('textarea') : null;
      const submit = form ? form.querySelector('button[type="submit"]') : null;
      const parentId = section && section.dataset.replyParentId ? section.dataset.replyParentId : null;
      const text = input ? input.value.trim().slice(0, 200) : '';
      if (!text) {
        if (input) input.focus();
        return;
      }
      if (text.length < BLOG_MIN_COMMENT_LENGTH) {
        setBlogCommentsStatus('Comments must be at least ' + BLOG_MIN_COMMENT_LENGTH + ' characters.', true, id);
        if (input) input.focus();
        return;
      }
      const blockReason = getBlogCommentBlockReason(text);
      if (blockReason) {
        setBlogCommentsStatus(blockReason, true, id);
        if (input) input.focus();
        return;
      }

      if (!blogApiEndpoint(id)) {
        setBlogCommentsStatus('Comments are temporarily unavailable. Please try again shortly.', true, id);
        return;
      }

      setBlogCommentsStatus('Posting…', false, id);
      if (submit) submit.disabled = true;

      try {
        await writeRemoteBlogState(id, { action: 'add-comment', text: text, parentId: parentId });
        if (input) {
          input.value = '';
          input.placeholder = 'Write a comment...';
          updateBlogCommentLength(input);
          input.focus();
        }
        if (section) delete section.dataset.replyParentId;
        renderBlogComments(id);
        refreshBlogCommentsCount(id);
        setBlogCommentsStatus('Comment posted', false, id);
      } catch (error) {
        if (error && /blocked|moderation|meaningful|nonsense/i.test(String(error.message || ''))) {
          rememberBlockedBlogCommentText(text);
          if (input) {
            input.value = '';
            input.dataset.lastAllowedValue = '';
            updateBlogCommentLength(input);
          }
        }
        const message = error && error.message ? String(error.message) : '';
        setBlogCommentsStatus(message || 'Could not post comment to the server.', true, id);
      } finally {
        if (submit) submit.disabled = false;
      }
    };

    toggleBlogCommentMenu = function(button) {
      const menu = button && button.parentElement
        ? button.parentElement.querySelector('.blog-comment-menu')
        : null;
      if (!menu) return;
      document.querySelectorAll('.blog-comment-menu.is-open').forEach(function(openMenu) {
        if (openMenu !== menu) {
          openMenu.classList.remove('is-open');
          const trigger = openMenu.parentElement && openMenu.parentElement.querySelector('.blog-comment-more');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
        }
      });
      const isOpen = menu.classList.toggle('is-open');
      button.setAttribute('aria-expanded', String(isOpen));
    };

    let blogReportTarget = null;

    function closeBlogReportModal() {
      const modal = document.getElementById('blogReportModal');
      if (!modal) return;
      modal.hidden = true;
      blogReportTarget = null;
      const form = modal.querySelector('form');
      if (form) form.reset();
      const error = document.getElementById('blogReportError');
      if (error) error.textContent = '';
    }

    function toggleBlogReportDetails(select) {
      const details = document.getElementById('blogReportDetails');
      if (!details) return;
      details.placeholder = select && select.value === 'Other'
        ? 'Please describe what happened...'
        : 'Add context for the moderators...';
    }

    function openBlogReportModal(button) {
      const card = button && button.closest ? button.closest('[data-comment-id]') : null;
      const section = button && button.closest ? button.closest('[data-blog-comments-section]') : null;
      const id = section ? section.dataset.articleId : activeBlogCommentsId;
      const commentId = card ? card.dataset.commentId : '';
      if (!id || !commentId) return;
      const remote = BLOG_REMOTE_STATE[String(id)];
      const comment = remote && Array.isArray(remote.comments)
        ? remote.comments.find(function(item) { return item.id === commentId; })
        : null;
      if (!comment) return;
      if (comment.reported) {
        setBlogCommentsStatus('You already reported this comment.', true, id);
        return;
      }
      const viewerId = getBlogCommentUserId();
      if (viewerId && viewerId === String(comment.robloxUserId || '')) {
        setBlogCommentsStatus('You cannot report your own comment.', true, id);
        return;
      }
      blogReportTarget = { id: id, commentId: commentId };
      const preview = document.getElementById('blogReportPreview');
      if (preview) {
        const author = String(comment.displayName || comment.author || 'Roblox user').slice(0, 80);
        preview.textContent = author + ': “' + String(comment.text || '').slice(0, 180) + '”';
      }
      const error = document.getElementById('blogReportError');
      if (error) error.textContent = '';
      const modal = document.getElementById('blogReportModal');
      if (!modal) return;
      modal.hidden = false;
      const reason = document.getElementById('blogReportReason');
      if (reason) reason.focus();
    }

    async function submitBlogReport(event) {
      event.preventDefault();
      if (!blogReportTarget) return;
      const id = blogReportTarget.id;
      const commentId = blogReportTarget.commentId;
      const reasonSelect = document.getElementById('blogReportReason');
      const detailsInput = document.getElementById('blogReportDetails');
      const error = document.getElementById('blogReportError');
      const submit = document.getElementById('blogReportSubmit');
      const selectedReason = reasonSelect ? reasonSelect.value : '';
      const details = detailsInput ? detailsInput.value.trim() : '';
      if (!selectedReason) {
        if (error) error.textContent = 'Choose a reason before sending the report.';
        if (reasonSelect) reasonSelect.focus();
        return;
      }
      const reason = (selectedReason + (details ? ': ' + details : '')).slice(0, 160);
      if (error) error.textContent = '';
      if (submit) submit.disabled = true;
      setBlogCommentsStatus('Sending report…', false, id);
      try {
        await writeRemoteBlogState(id, {
          action: 'report-comment',
          commentId: commentId,
          reason: reason
        });
        rememberLocalBlogCommentReported(id, commentId);
        closeBlogReportModal();
        renderBlogComments(id);
        setBlogCommentsStatus('Thanks. The comment was reported for moderation.', false, id);
      } catch (error) {
        const message = error && error.message ? String(error.message) : 'Could not report this comment.';
        if (document.getElementById('blogReportError')) {
          document.getElementById('blogReportError').textContent = message;
        }
      } finally {
        if (submit) submit.disabled = false;
      }
    }

    handleBlogCommentReport = function(button) {
      openBlogReportModal(button);
    };

    handleBlogCommentMenuAction = async function(button) {
      const menu = button && button.closest ? button.closest('.blog-comment-menu') : null;
      const card = button && button.closest ? button.closest('[data-comment-id]') : null;
      const section = button && button.closest ? button.closest('[data-blog-comments-section]') : null;
      const id = section ? section.dataset.articleId : activeBlogCommentsId;
      const commentId = card ? card.dataset.commentId : '';
      const action = button && button.dataset ? button.dataset.commentMenuAction : '';
      const remote = BLOG_REMOTE_STATE[String(id)];
      const comment = remote && Array.isArray(remote.comments)
        ? remote.comments.find(function(item) { return item.id === commentId; })
        : null;
      if (menu) menu.classList.remove('is-open');
      if (!id || !commentId || !comment) return;

      let userId = getBlogCommentUserId();
      if (!userId) {
        await requestFriendsRemoverExtensionIdentity();
        userId = getBlogCommentUserId();
      }
      if (!userId) {
        setBlogCommentsStatus('Open Roblox with the Friends Remover extension installed to manage your comments.', true, id);
        return;
      }
      if (String(comment.robloxUserId || '') !== userId) {
        setBlogCommentsStatus('You can only edit or remove your own comments.', true, id);
        return;
      }

      let text = null;
      if (action === 'edit') {
        text = window.prompt('Edit your comment:', comment.text || '');
        if (text === null) return;
        text = text.trim();
        if (!text) {
          setBlogCommentsStatus('A comment cannot be empty.', true, id);
          return;
        }
        if (text.length < BLOG_MIN_COMMENT_LENGTH) {
          setBlogCommentsStatus('Comments must be at least ' + BLOG_MIN_COMMENT_LENGTH + ' characters.', true, id);
          return;
        }
        if (text.length > 200) {
          setBlogCommentsStatus('Comments are limited to 200 characters.', true, id);
          return;
        }
        const blockReason = getBlogCommentBlockReason(text);
        if (blockReason) {
          setBlogCommentsStatus(blockReason, true, id);
          return;
        }
      } else if (action === 'remove') {
        if (!window.confirm('Remove this comment and its replies?')) return;
      } else {
        return;
      }

      setBlogCommentsStatus(action === 'edit' ? 'Saving edit…' : 'Removing comment…', false, id);
      try {
        await writeRemoteBlogState(id, {
          action: action === 'edit' ? 'edit-comment' : 'delete-comment',
          commentId: commentId,
          text: text
        });
        if (section && section.dataset.replyParentId === commentId) delete section.dataset.replyParentId;
        renderBlogComments(id);
        refreshBlogCommentsCount(id);
        setBlogCommentsStatus(action === 'edit' ? 'Comment updated.' : 'Comment removed.', false, id);
      } catch (error) {
        if (action === 'edit' && text && /blocked|moderation|meaningful|nonsense/i.test(String(error.message || ''))) {
          rememberBlockedBlogCommentText(text);
        }
        setBlogCommentsStatus(
          error && error.message ? String(error.message) : 'Could not update your comment.',
          true,
          id
        );
      }
    };

    handleBlogCommentAction = async function(button) {
      const action = button && button.dataset ? button.dataset.commentAction : '';
      const commentId = button && button.dataset ? button.dataset.commentId : '';
      const section = button && button.closest ? button.closest('[data-blog-comments-section]') : null;
      const id = section ? section.dataset.articleId : activeBlogCommentsId;
      const remote = id ? BLOG_REMOTE_STATE[id] : null;
      const comment = commentId && remote
        ? remote.comments.find(function(item) { return item.id === commentId; })
        : null;
      if (!id || !commentId) return;

      if (action === 'reply') {
        const input = section && section.querySelector('textarea');
        if (section) section.dataset.replyParentId = commentId;
        if (input) {
          input.placeholder = 'Reply to ' + (button.dataset.commentAuthor || 'this comment') + '...';
          input.focus();
        }
        setBlogCommentsStatus('Replying to ' + (button.dataset.commentAuthor || 'this comment') + '.', false, id);
        return;
      }
      if (action !== 'like' && action !== 'dislike') return;
      if (!comment) {
        setBlogCommentsStatus('That comment is no longer available.', true, id);
        return;
      }

      const previousVote = comment.vote || null;
      const nextVote = previousVote === action ? null : action;
      if (previousVote === 'like') comment.likes = Math.max(0, comment.likes - 1);
      if (previousVote === 'dislike') comment.dislikes = Math.max(0, comment.dislikes - 1);
      if (nextVote === 'like') comment.likes += 1;
      if (nextVote === 'dislike') comment.dislikes += 1;
      comment.vote = nextVote;
      // Keep the durable cookie-backed cache in sync with the server request.
      // This survives localStorage and site-cache clearing.
      saveLocalBlogCommentReaction(id, commentId, nextVote);
      renderBlogComments(id);
      setBlogCommentsStatus('Saving comment feedback…', false, id);
      button.disabled = true;
      try {
        if (!blogApiEndpoint(id)) throw new Error('offline');
        await writeRemoteBlogState(id, { action: 'set-comment-reaction', commentId: commentId, reaction: nextVote });
        clearLocalBlogCommentReaction(id, commentId);
        renderBlogComments(id);
        setBlogCommentsStatus('Comment feedback saved.', false, id);
      } catch (error) {
        saveLocalBlogCommentReaction(id, commentId, nextVote);
        renderBlogComments(id);
        setBlogCommentsStatus('Feedback saved on this device. We’ll sync it when the server is back.', false, id);
      } finally {
        button.disabled = false;
      }
    };

    handleBlogReaction = async function(button) {
      const panel = button && button.closest ? button.closest('[data-reaction-panel]') : null;
      if (!panel) return;
      const id = panel.dataset.articleId;

      const reaction = button.dataset.reaction;
      const article = ARTICLES[id] || ARTICLE_CACHE[id] || {};
      const previous = getBlogReactionState(article, id);
      const next = {
        likes: previous.likes,
        dislikes: previous.dislikes,
        vote: previous.vote
      };
      if (next.vote === reaction) {
        next[reaction === 'like' ? 'likes' : 'dislikes'] = Math.max(0, next[reaction === 'like' ? 'likes' : 'dislikes'] - 1);
        next.vote = null;
      } else {
        if (next.vote) {
          const previousKey = next.vote === 'like' ? 'likes' : 'dislikes';
          next[previousKey] = Math.max(0, next[previousKey] - 1);
        }
        next[reaction === 'like' ? 'likes' : 'dislikes'] += 1;
        next.vote = reaction;
      }

      const oldRemote = BLOG_REMOTE_STATE[String(id)];
      BLOG_REMOTE_STATE[String(id)] = Object.assign({}, oldRemote || normalizeRemoteBlogState({}, id), next, { loaded: true });
      refreshBlogReactionUI(id, 'Saving feedback…');
      button.disabled = true;
      try {
        if (!blogApiEndpoint(id)) throw new Error('offline');
        await writeRemoteBlogState(id, { action: 'set-reaction', reaction: next.vote });
        clearLocalBlogReaction(id);
        refreshBlogReactionUI(id, 'Thanks for your feedback.');
      } catch (error) {
        saveLocalBlogReaction(article, id, next);
        BLOG_REMOTE_STATE[String(id)] = Object.assign({}, BLOG_REMOTE_STATE[String(id)], next, {
          loaded: true,
          offline: true
        });
        refreshBlogReactionUI(id, 'Feedback saved on this device. We’ll sync it when the server is back.');
      } finally {
        button.disabled = false;
      }
    };

    window.submitBlogComment = submitBlogComment;
    window.toggleBlogCommentMenu = toggleBlogCommentMenu;
    window.handleBlogCommentReport = handleBlogCommentReport;
    window.closeBlogReportModal = closeBlogReportModal;
    window.toggleBlogReportDetails = toggleBlogReportDetails;
    window.submitBlogReport = submitBlogReport;
    window.handleBlogCommentMenuAction = handleBlogCommentMenuAction;
    window.handleBlogReaction = handleBlogReaction;
    window.handleBlogCommentAction = handleBlogCommentAction;

    var _chMoreInfoId = 0;
    var _ulPlatformFilter = 'all'; // 'all' | 'Mobile' | 'PC' | 'FR Plus' | 'Translation'
    var _ulArticlesCache = [];

    // platformFilter: 'all' | 'Mobile' | 'PC' | 'FR Plus' | 'Translation'
    // article (optional): the update these changes belong to — enables the "removed/returned later" badges
    function buildChangesHTML(changes, platformFilter, article) {
      if (!changes || typeof changes !== 'object') return '';
      const _lcTl = article ? _lcBuildTimeline() : null;
      // Collect all mobile items across every change type for the mobile group
      const allMobileItems = [];
      if (!platformFilter || platformFilter === 'all' || platformFilter === 'Mobile') {
        ['added','removed','fixed','improved','security','other'].forEach(function(key) {
          if (Array.isArray(changes[key])) {
            changes[key].forEach(function(item) {
              if (typeof item === 'object' && item !== null && (item.platform || '').toLowerCase() === 'mobile') {
                allMobileItems.push(Object.assign({}, item, { _sourceKey: key }));
              }
            });
          }
        });
      }
      // Collect all FR Plus items across every change type for the FR Plus group
      const allFRPlusItems = [];
      if (!platformFilter || platformFilter === 'all' || platformFilter === 'FR Plus') {
        ['added','removed','fixed','improved','security','other'].forEach(function(key) {
          if (Array.isArray(changes[key])) {
            changes[key].forEach(function(item) {
              if (typeof item === 'object' && item !== null && (item.platform || '').toLowerCase() === 'fr plus') {
                allFRPlusItems.push(Object.assign({}, item, { _sourceKey: key }));
              }
            });
          }
        });
      }
      // Collect all Translation items across every change type for the Translation group
      const allTranslationItems = [];
      if (!platformFilter || platformFilter === 'all' || platformFilter === 'Translation') {
        ['added','removed','fixed','improved','security','other'].forEach(function(key) {
          if (Array.isArray(changes[key])) {
            changes[key].forEach(function(item) {
              if (typeof item === 'object' && item !== null && (item.platform || '').toLowerCase() === 'translation') {
                allTranslationItems.push(Object.assign({}, item, { _sourceKey: key }));
              }
            });
          }
        });
      }
      const groups = CHANGE_GROUPS
        .filter(function(g) {
          if (g.mobileGroup) return allMobileItems.length > 0 && (platformFilter === 'all' || platformFilter === 'Mobile' || !platformFilter);
          if (g.frPlusGroup) return allFRPlusItems.length > 0 && (platformFilter === 'all' || platformFilter === 'FR Plus' || !platformFilter);
          if (g.translationGroup) return allTranslationItems.length > 0 && (platformFilter === 'all' || platformFilter === 'Translation' || !platformFilter);
          return Array.isArray(changes[g.key]) && changes[g.key].length;
        })
        .map(function(g) {
          // Mobile group: show all mobile items collected above
          // FR Plus group: show all FR Plus items collected above
          // Translation group: show all translation items collected above
          const rawItems = g.mobileGroup ? allMobileItems : (g.frPlusGroup ? allFRPlusItems : (g.translationGroup ? allTranslationItems : changes[g.key]));
          // Apply platform filter (non-special groups: exclude mobile-only, fr-plus-only, and translation-only items when filtered)
          const filteredItems = (g.mobileGroup || g.frPlusGroup || g.translationGroup) ? rawItems : rawItems.filter(function(item) {
              if (typeof item !== 'object' || item === null) return true;
              const p = (item.platform || '').toLowerCase();
              // Always exclude mobile, fr plus, and translation items from non-special groups
              if (p === 'mobile') return false;
              if (p === 'fr plus') return false;
              if (p === 'translation') return false;
              if (!platformFilter || platformFilter === 'all') return true;
              if (platformFilter === 'PC') return p === 'pc' || p === '';
              if (platformFilter === 'FR Plus') return false; // FR Plus items only appear in frPlusGroup
              if (platformFilter === 'Translation') return false; // Translation items only appear in translationGroup
              return true;
            });
          if (!filteredItems.length) return '';
          const items = filteredItems.map(function(item) {
            const text     = (typeof item === 'object' && item !== null) ? (item.text || '') : item;
            const moreInfo = (typeof item === 'object' && item !== null) ? (item.moreInfo || '') : '';
            const lcBadge = _lcTl
              ? buildLifecycleBadgeHTML(_lcEventsAfter(item, (item && item._sourceKey) || g.key, article, _lcTl)) : '';
            const uid = 'chi-' + (_chMoreInfoId++);
            // For mobile/fr-plus/translation group items, use the sym/cls of their source change type
            var itemSym = g.sym;
            var itemCls = g.cls;
            if ((g.mobileGroup || g.frPlusGroup || g.translationGroup) && item._sourceKey) {
              const srcGroup = CHANGE_GROUPS.find(function(x) { return x.key === item._sourceKey; });
              if (srcGroup) { itemSym = srcGroup.sym; itemCls = srcGroup.cls; }
            }
            if (moreInfo) {
              return '<div class="ch-item ch-item-expandable" onclick="toggleChItem(\'' + uid + '\')">' +
                '<span class="ch-item-sym ' + itemCls + '">' + itemSym + '</span>' +
                '<div class="ch-item-inner">' +
                  '<div class="ch-item-row">' +
                    '<span>' + text + lcBadge + '</span>' +
                    '<span class="ch-item-more-icon" id="' + uid + '-icon">' +
                      '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>' +
                    '</span>' +
                  '</div>' +
                  '<div class="ch-item-more" id="' + uid + '">' + moreInfo + '</div>' +
                '</div>' +
              '</div>';
            }
            return '<div class="ch-item">' +
              '<span class="ch-item-sym ' + itemCls + '">' + itemSym + '</span>' +
              '<span>' + text + lcBadge + '</span>' +
            '</div>';
          }).join('');
          return '<div class="ch-group">' +
            '<div class="ch-group-header ' + g.cls + '">' +
              '<span class="ch-group-icon">' + g.icon + '</span>' +
              '<span class="ch-group-label ' + g.cls + '">' + g.label + '</span>' +
            '</div>' +
            items +
          '</div>';
        }).join('');
      if (!groups) return '';
      return '<div class="changes-section" style="margin-top:32px;">' + groups + '</div>';
    }

    function toggleChItem(uid) {
      var el   = document.getElementById(uid);
      var icon = document.getElementById(uid + '-icon');
      if (!el) return;
      var open = el.classList.toggle('open');
      if (icon) icon.style.transform = open ? 'rotate(180deg)' : '';
    }
    window.toggleChItem = toggleChItem;


    // ── Update Log page ─────────────────────────────────────────
    function renderUpdateLog(articles, platformFilter) {
      const container = document.getElementById('updatesLog');
      if (!container) return;

      // Cache articles for filter re-renders
      if (articles) _ulArticlesCache = articles;
      const pf = platformFilter || _ulPlatformFilter || 'all';

      // Only show articles with changes field, sorted newest first
      const updates = _ulArticlesCache
        .filter(function(a) { return a.changes && typeof a.changes === 'object'; })
        .sort(function(a, b) { return (new Date(b.date) || 0) - (new Date(a.date) || 0); })
        .map(function(a) { return CdLock.view(a); });

      if (!updates.length) {
        container.innerHTML = '<div style="text-align:center;padding:60px 0;color:var(--text-muted);">No update logs yet.</div>';
        return;
      }

      container.innerHTML = updates.map(function(a, idx) {
        const fileId = a._file || a.id;

        // version + platform + breaking badges
        const versionBadge = a.version
          ? '<span class="ul-version-badge">v' + a.version + '</span>' : '';
        const breakingBadge = a.breaking
          ? '<span class="ul-breaking-badge">⚠ Breaking</span>' : '';
        const platformBadges = Array.isArray(a.platforms)
          ? a.platforms.map(function(p) { return '<span class="ul-platform-badge">' + p + '</span>'; }).join('') : '';

        // Breaking change banner
        const breakingBanner = a.breaking
          ? '<div class="ul-breaking-banner"><strong>⚠ Breaking change:</strong>&nbsp;This update contains changes that may affect existing behaviour. Please read before updating.</div>' : '';

        // Download links
        let downloadBar = '';
        if (a.download && typeof a.download === 'object') {
          const links = [];
          if (a.download.chrome) links.push('<a class="ul-download-btn" href="' + a.download.chrome + '" target="_blank" rel="noopener"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2z"/><circle cx="12" cy="12" r="4"/><line x1="12" y1="8" x2="12" y2="2"/><line x1="17.2" y1="10.8" x2="22.4" y2="7.6"/><line x1="17.2" y1="13.2" x2="22.4" y2="16.4"/></svg>Chrome</a>');
          if (a.download.firefox) links.push('<a class="ul-download-btn" href="' + a.download.firefox + '" target="_blank" rel="noopener"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>Firefox</a>');
          if (links.length) downloadBar = '<div class="ul-download-bar">' + links.join('') + '</div>';
        }

        // Intro body
        const introHTML = a.body
          ? '<div class="ul-intro">' + a.body + '</div>' : '';

        // Changes list (filtered by platform)
        const groupsHTML = buildChangesHTML(a.changes, pf, a);

        // Count total changes for badge (filtered)
        let totalChanges = 0;
        if (a.changes && typeof a.changes === 'object') {
          Object.values(a.changes).forEach(function(arr) {
            if (!Array.isArray(arr)) return;
            const filtered = (!pf || pf === 'all') ? arr : arr.filter(function(item) {
              if (typeof item !== 'object' || item === null) return true;
              const p = (item.platform || '').toLowerCase();
              if (pf === 'Mobile') return p === 'mobile';
              if (pf === 'PC') return p === 'pc';
              if (pf === 'FR Plus') return p === 'fr plus';
              if (pf === 'Translation') return p === 'translation';
              return true;
            });
            totalChanges += filtered.length;
          });
        }
        const changeBadge = totalChanges > 0
          ? '<span class="ul-entry-change-count">' + totalChanges + ' change' + (totalChanges !== 1 ? 's' : '') + '</span>' : '';

        // Summary: first sentence of body or first change item
        let summaryText = '';
        if (a.body) {
          const tmp = document.createElement('div');
          tmp.innerHTML = a.body;
          summaryText = (tmp.textContent || '').split('.')[0].trim();
          if (summaryText) summaryText = summaryText + '.';
        }
        if (!summaryText && a.changes) {
          const firstGroup = Object.values(a.changes).find(function(arr) { return Array.isArray(arr) && arr.length; });
          if (firstGroup) summaryText = firstGroup[0];
        }
        const summaryEl = summaryText
          ? '<div class="ul-entry-summary">' + summaryText + '</div>' : '';

        // Chevron icon
        const chevron = '<div class="ul-entry-chevron"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></div>';

        const divider = idx < updates.length - 1
          ? '<div class="ul-divider"><div class="ul-divider-line"></div><div class="ul-divider-text">Older</div><div class="ul-divider-line"></div></div>' : '';

        return '<div class="ul-entry" id="ul-entry-' + idx + '">' +
          '<div class="ul-entry-header" onclick="toggleUlEntry(' + idx + ')">' +
            '<div class="ul-entry-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg></div>' +
            '<div style="flex:1;min-width:0;">' +
              '<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">' +
                '<span class="ul-entry-title">' + a.title + '</span>' +
                versionBadge + breakingBadge + changeBadge +
              '</div>' +
              '<div class="ul-entry-meta">' +
                '<span class="ul-entry-date">' + a.date + '</span>' +
                platformBadges +
              '</div>' +
              summaryEl +
            '</div>' +
            chevron +
          '</div>' +
          '<div class="ul-entry-body">' +
            breakingBanner +
            downloadBar +
            introHTML +
            groupsHTML +
          '</div>' +
        '</div>' + divider;
      }).join('');

      // Open the first (latest) entry by default
      var firstEntry = document.getElementById('ul-entry-0');
      if (firstEntry) firstEntry.classList.add('expanded');
    }

    // ── Toggle collapsible update entry ─────────────────────────
    function toggleUlEntry(idx) {
      var entry = document.getElementById('ul-entry-' + idx);
      if (!entry) return;
      entry.classList.toggle('expanded');
    }
    window.toggleUlEntry = toggleUlEntry;

    // ── Platform filter for Update Log ────────────────────────────────────────
    function ulSetFilter(filter) {
      _ulPlatformFilter = filter || 'all';
      var tabs = document.querySelectorAll('.ul-ptab');
      tabs.forEach(function(t) {
        t.classList.toggle('active', t.getAttribute('data-filter') === _ulPlatformFilter);
      });
      renderUpdateLog(null, _ulPlatformFilter);
    }
    window.ulSetFilter = ulSetFilter;

    // ── Article new fields render helper ────────────────────────
    function buildArticleMetaExtra(a) {
      let html = '';
      if (a.version) html += '<span class="ul-version-badge" style="font-size:0.68rem;padding:3px 10px;">v' + a.version + '</span>';
      if (a.breaking) html += '<span class="ul-breaking-badge" style="font-size:0.68rem;padding:3px 10px;">⚠ Breaking</span>';
      if (Array.isArray(a.platforms)) {
