        <a href="/#status">Status</a>
      </nav>
    </header>
    <div class="removal-count-content">
      <div class="removal-count-glow" aria-hidden="true"></div>
      <section class="removal-count-card">
        <h1 class="removal-count-number" id="removal-count-number">0</h1>
        <p class="removal-count-label">friends removed on <strong>Roblox</strong></p>
        <p class="removal-count-meta" id="removal-count-meta">Connecting to live data…</p>
        <section class="removal-count-recent" aria-label="Recent removers">
          <div class="removal-count-recent-title">Latest removers</div>
          <div class="removal-count-removers" id="removal-count-removers">
            <div class="removal-count-remover-count">Loading recent removers…</div>
          </div>
        </section>
      </section>
    </div>
    <div class="removal-count-brand">Friends Remover</div>
  </main>

  <script>
    (function initStandaloneRemovalCount() {
      if (!/^\/(removalcount|stream)\/?$/.test(location.pathname)) return;
      document.title = 'Live Removal Count — Friends Remover';
      var isStream = /^\/stream\/?$/.test(location.pathname);
      var numberEl = document.getElementById(isStream ? 'stream-count-number' : 'removal-count-number');
      var metaEl = document.getElementById(isStream ? 'stream-count-meta' : 'removal-count-meta');
      var removersEl = document.getElementById(isStream ? 'stream-removers' : 'removal-count-removers');
      var endpoint = 'https://fmstoragekv.zaggloob.workers.dev/history/all';
      var recentEndpoint = 'https://fmstoragekv.zaggloob.workers.dev/history/recent-removers';
      var lastValue = null;
      var timer = null;
      var knownRemoverIds = null;

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function (char) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
        });
      }

      async function hydrateRemoverProfiles(removers) {
        if (!Array.isArray(removers)) return removers;
        var ids = removers.map(function (user) {
          return String(user && user.userId || '');
        }).filter(function (id) { return /^\d+$/.test(id); });
        if (!ids.length) return removers;

        // Use the same Roblox profile/headshot endpoints used by the
        // website's Robloxians strip, rather than trusting placeholder names
        // from an older Worker deployment.
        try {
          var profileResponse = await fetch('https://users.roblox.com/v1/users', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              userIds: ids.map(Number),
              excludeBannedUsers: false
            })
          });
          if (profileResponse.ok) {
            var profileData = await profileResponse.json();
            (profileData.data || []).forEach(function (profile) {
              removers.forEach(function (user) {
                if (String(user.userId) === String(profile.id)) {
                  user.name = profile.name || user.name;
                  user.username = profile.name || user.username;
                  user.displayName = profile.displayName || profile.name || user.displayName;
                }
              });
            });
          }
        } catch (_) {}

        try {
          var thumbResponse = await fetch(
            'https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=' +
            ids.join(',') + '&size=150x150&format=Png&isCircular=false'
          );
          if (thumbResponse.ok) {
            var thumbData = await thumbResponse.json();
            (thumbData.data || []).forEach(function (thumb) {
              removers.forEach(function (user) {
                if (String(user.userId) === String(thumb.targetId) && thumb.imageUrl) {
                  user.avatarUrl = thumb.imageUrl;
                }
              });
            });
          }
        } catch (_) {}

        // Fall back to Roblox's per-user profile endpoint when the live
        // Worker returns its legacy "User <id>" placeholder.
        await Promise.all(removers.map(async function (user) {
          if (!/^\d+$/.test(String(user.userId || ''))) return;
          if (user.username && !/^User \d+$/.test(user.username)) return;
          try {
            var singleResponse = await fetch(
              'https://users.roblox.com/v1/users/' + encodeURIComponent(user.userId),
              { headers: { 'Accept': 'application/json' } }
            );
            if (!singleResponse.ok) return;
            var profile = await singleResponse.json();
            user.name = profile.name || user.name;
            user.username = profile.name || user.username;
            user.displayName = profile.displayName || profile.name || user.displayName;
          } catch (_) {}
        }));
        return removers;
      }

      function buildHomeStyleNumber(value, animate) {
        var formatted = Math.max(0, Math.floor(value)).toLocaleString();
        if (!numberEl) return;
        var oldStructure = Array.from(numberEl.children).map(function (node) {
          return node.classList.contains('removal-count-separator') ? ',' : 'd';
        }).join('');
        var newStructure = formatted.replace(/[0-9]/g, 'd');
        if (oldStructure !== newStructure) {
          numberEl.innerHTML = '';
          formatted.split('').forEach(function (character) {
            if (character === ',') {
              var separator = document.createElement('span');
              separator.className = 'removal-count-separator';
              separator.textContent = ',';
              numberEl.appendChild(separator);
              return;
            }
            var slot = document.createElement('span');
            slot.className = 'removal-count-digit';
            slot.dataset.digit = character;
            var reel = document.createElement('span');
            reel.className = 'removal-count-digit-reel';
            for (var digit = 0; digit <= 9; digit++) {
              var item = document.createElement('span');
              item.textContent = digit;
              reel.appendChild(item);
            }
            reel.style.transform = 'translateY(-' + Number(character) * 1.2 + 'em)';
            slot.appendChild(reel);
            numberEl.appendChild(slot);
          });
          return;
        }
        formatted.split('').forEach(function (character, index) {
          if (character === ',') return;
          var slot = numberEl.children[index];
          var reel = slot.querySelector('.removal-count-digit-reel');
          var oldDigit = Number(slot.dataset.digit);
          var newDigit = Number(character);
          slot.dataset.digit = character;
          reel.style.transition = animate && oldDigit !== newDigit
            ? 'transform .55s cubic-bezier(.22,1,.36,1)' : 'none';
          reel.style.transform = 'translateY(-' + newDigit * 1.2 + 'em)';
        });
      }

      function burstCounterParticles() {
        if (!numberEl) return;
        var rect = numberEl.getBoundingClientRect();
        var cx = rect.left + rect.width / 2;
        var cy = rect.top + rect.height / 2;
        for (var i = 0; i < 12; i++) {
          var particle = document.createElement('span');
          var angle = (i / 12) * Math.PI * 2;
          var distance = 55 + Math.random() * 75;
          particle.style.cssText = 'position:fixed;z-index:5;left:' + cx + 'px;top:' + cy +
            'px;width:7px;height:7px;pointer-events:none;background:#f05a37;' +
            'animation:removalCountParticle .95s cubic-bezier(.22,1,.36,1) forwards;' +
            '--tx:' + Math.cos(angle) * distance + 'px;--ty:' + Math.sin(angle) * distance + 'px;';
          document.body.appendChild(particle);
          setTimeout(function (node) { return function () { node.remove(); }; }(particle), 1100);
        }
      }

      function animateNumber(value) {
        var next = Number.isFinite(value) && value >= 0 ? Math.floor(value) : 0;
        var increased = lastValue !== null && next > lastValue;
        if (lastValue === null) {
          buildHomeStyleNumber(next, false);
        } else if (next !== lastValue) {
          var start = lastValue;
          var difference = next - start;
          var started = performance.now();
          var duration = Math.min(2500, Math.max(1000, Math.abs(difference) * 4));
          function step(now) {
            var progress = Math.min(1, (now - started) / duration);
            var eased = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
            buildHomeStyleNumber(Math.round(start + difference * eased), true);
            if (progress < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
          if (increased && numberEl) {
            numberEl.classList.remove('count-bump');
            void numberEl.offsetWidth;
            numberEl.classList.add('count-bump');
            burstCounterParticles();
          }
        }
        lastValue = next;
      }

      function renderRecent(removers) {
        if (!removersEl) return;
        if (!Array.isArray(removers) || !removers.length) {
          removersEl.innerHTML = '<div class="removal-count-remover-count">No recent removals yet.</div>';
          return;
        }
        var previousIds = knownRemoverIds;
        var currentIds = new Set(removers.slice(0, 3).map(function (user) {
          return String(user.userId || '');
        }));
        removersEl.innerHTML = removers.slice(0, 3).map(function (user) {
          var name = user.username || user.name || user.displayName || ('User ' + user.userId);
          var avatar = user.avatarUrl
            ? '<img class="removal-count-remover-avatar" src="' + escapeHtml(user.avatarUrl) + '" alt="" loading="lazy">'
            : '<div class="removal-count-remover-avatar" aria-hidden="true"></div>';
          var isNew = previousIds && !previousIds.has(String(user.userId || ''));
          return '<article class="removal-count-remover">' +
            avatar +
            '<div class="removal-count-remover-name" title="' + escapeHtml(name) + '">' + escapeHtml(name) + '</div>' +
            '<div class="removal-count-remover-count">' + Number(user.count || 0).toLocaleString() + ' friends removed</div>' +
            '</article>';
        }).join('');
        if (previousIds) {
          Array.from(removersEl.children).forEach(function (card, index) {
            var user = removers[index];
            if (user && !previousIds.has(String(user.userId || ''))) {
              card.classList.add('remover-new');
            }
          });
        }
        knownRemoverIds = currentIds;
      }

      async function refresh() {
        try {
          var response = await fetch(endpoint, { cache: 'no-store' });
          if (!response.ok) throw new Error('HTTP ' + response.status);
          var data = await response.json();
          animateNumber(Number(data && data.totalUnfriended) || 0);
          if (metaEl) metaEl.textContent = 'Updating live · Last checked just now';
        } catch (_) {
          if (metaEl) metaEl.textContent = 'Live data is temporarily unavailable · Retrying…';
        }
        try {
          var recentResponse = await fetch(recentEndpoint, { cache: 'no-store' });
          if (!recentResponse.ok) throw new Error('HTTP ' + recentResponse.status);
          var recentData = await recentResponse.json();
          var removers = await hydrateRemoverProfiles(recentData && recentData.removers);
          renderRecent(removers);
        } catch (_) {
          if (removersEl) removersEl.innerHTML = '<div class="removal-count-remover-count">Recent remover data is unavailable.</div>';
        }
      }

      refresh();
      timer = setInterval(refresh, 5000);
      window.addEventListener('pagehide', function () {
        if (timer) clearInterval(timer);
      }, { once: true });
    })();
  </script>


