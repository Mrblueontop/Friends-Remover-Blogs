  <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
    function toggleBtnOtherMenu() {
      document.getElementById('btnOtherWrap').classList.toggle('open');
    }
    document.addEventListener('click', (e) => {
      const wrap = document.getElementById('btnOtherWrap');
      if (wrap && !wrap.contains(e.target)) wrap.classList.remove('open');
    });

    // ── Theme toggle ──────────────────────────────────────
    function applyTheme(isDark) {
      document.body.classList.toggle('dark-mode', isDark);
      try { localStorage.setItem('fr-theme', isDark ? 'dark' : 'light'); } catch(e) {}
      // Refresh translated labels (btn_dark / btn_light) if translations are loaded
      try {
        if (typeof TRANSLATIONS !== 'undefined') {
          const t = TRANSLATIONS[currentLang] || TRANSLATIONS.EN;
          const en = TRANSLATIONS.EN;
          document.querySelectorAll('.theme-btn-label').forEach(el => {
            el.textContent = isDark ? (t.btn_light || en.btn_light) : (t.btn_dark || en.btn_dark);
            el.setAttribute('data-i18n', isDark ? 'btn_light' : 'btn_dark');
          });
        }
      } catch(e) { /* translations not initialised yet at boot */ }
    }

    // ── Accent color system ──────────────────────────────────────────
    const ACCENT_COLORS = [
      { id: 'blue',   label: 'Blue',   color: '#2196f3', rgb: '33,150,243',  secondary: '#1565c0', light: '#64b5f6', ultraLight: '#bbdefb', navFrom: 'rgba(var(--primary-rgb),0.97)',  navTo: 'rgba(25,118,210,0.97)',  glow: 'rgba(var(--primary-rgb),0.3)'  },
      { id: 'purple', label: 'Purple', color: '#9c27b0', rgb: '156,39,176',  secondary: '#6a1b9a', light: '#ce93d8', ultraLight: '#f3e5f5', navFrom: 'rgba(156,39,176,0.97)',  navTo: 'rgba(106,27,154,0.97)', glow: 'rgba(156,39,176,0.3)' },
      { id: 'green',  label: 'Green',  color: '#22c55e', rgb: '34,197,94',   secondary: '#15803d', light: '#86efac', ultraLight: '#dcfce7', navFrom: 'rgba(34,197,94,0.97)',   navTo: 'rgba(21,128,61,0.97)',  glow: 'rgba(34,197,94,0.3)'  },
      { id: 'red',    label: 'Red',    color: '#e00000', rgb: '224,0,0',     secondary: '#a80000', light: '#ff5c5c', ultraLight: '#ffe0e0', navFrom: 'rgba(224,0,0,0.97)',     navTo: 'rgba(168,0,0,0.97)',   glow: 'rgba(224,0,0,0.3)'    },
      { id: 'orange', label: 'Orange', color: '#f97316', rgb: '249,115,22',  secondary: '#c2410c', light: '#fdba74', ultraLight: '#ffedd5', navFrom: 'rgba(249,115,22,0.97)',  navTo: 'rgba(194,65,12,0.97)', glow: 'rgba(249,115,22,0.3)' },
      { id: 'pink',   label: 'Pink',   color: '#ec4899', rgb: '236,72,153',  secondary: '#be185d', light: '#f9a8d4', ultraLight: '#fce7f3', navFrom: 'rgba(236,72,153,0.97)',  navTo: 'rgba(190,24,93,0.97)', glow: 'rgba(236,72,153,0.3)' },
      { id: 'teal',   label: 'Teal',   color: '#14b8a6', rgb: '20,184,166',  secondary: '#0f766e', light: '#5eead4', ultraLight: '#ccfbf1', navFrom: 'rgba(20,184,166,0.97)',  navTo: 'rgba(15,118,110,0.97)',glow: 'rgba(20,184,166,0.3)' },
      { id: 'amber',  label: 'Amber',  color: '#f59e0b', rgb: '245,158,11',  secondary: '#b45309', light: '#fcd34d', ultraLight: '#fef3c7', navFrom: 'rgba(245,158,11,0.97)',  navTo: 'rgba(180,83,9,0.97)',  glow: 'rgba(245,158,11,0.3)' },
      { id: 'indigo', label: 'Indigo', color: '#6366f1', rgb: '99,102,241',  secondary: '#4338ca', light: '#a5b4fc', ultraLight: '#e0e7ff', navFrom: 'rgba(99,102,241,0.97)',  navTo: 'rgba(67,56,202,0.97)', glow: 'rgba(99,102,241,0.3)' },
    ];

    let currentAccent = 'green';

    function applyAccentColor(id) {
      const accent = ACCENT_COLORS.find(a => a.id === id) || ACCENT_COLORS[0];
      currentAccent = accent.id;
      document.body.classList.toggle('halloween-theme', accent.id === 'halloween');
      const root = document.documentElement;
      root.style.setProperty('--primary-color',   accent.color);
      root.style.setProperty('--primary-rgb',     accent.rgb);
      root.style.setProperty('--secondary-color', accent.secondary);
      root.style.setProperty('--accent-nav-from', accent.navFrom);
      root.style.setProperty('--accent-nav-to',   accent.navTo);
      root.style.setProperty('--accent-glow',     accent.glow);
      // Derive light/ultra-light variants for gradients (used in .blue, 404 digits, etc.)
      root.style.setProperty('--accent-light',       accent.light);
      root.style.setProperty('--accent-ultra-light',  accent.ultraLight);
      root.style.setProperty('--accent-bg-start',    'rgba(' + accent.rgb + ',0.08)');
      root.style.setProperty('--accent-bg-mid',      'rgba(' + accent.rgb + ',0.04)');
      root.style.setProperty('--accent-header-bg',   'rgba(' + accent.rgb + ',0.12)');
      // Update nav swatch dot
      const swatch = document.getElementById('navColorSwatch');
      if (swatch) swatch.style.background = accent.color;
      // Update active state in panel
      document.querySelectorAll('.color-swatch-opt').forEach(el => {
        el.classList.toggle('active', el.dataset.accent === accent.id);
      });
      try { localStorage.setItem('fr-accent', accent.id); } catch(e) {}
    }

    function buildColorSwatches() {
      const container = document.getElementById('colorSwatches');
      if (!container) return;
      container.innerHTML = ACCENT_COLORS.map(a => `
        <button class="color-swatch-opt${a.id === currentAccent ? ' active' : ''}" data-accent="${a.id}" onclick="applyAccentColor('${a.id}');updateColorPanel();" title="${a.label}">
          <div class="swatch-dot" style="background:${a.color};"></div>
          <span class="swatch-label">${a.label}</span>
        </button>
      `).join('');
    }

    function toggleColorPanel() {
      const panel = document.getElementById('colorPanelDropdown');
      if (!panel) return;
      const isOpen = panel.classList.toggle('open');
      if (isOpen) buildColorSwatches();
    }

    function updateColorPanel() {
      buildColorSwatches();
    }

    // Close color panel on outside click
    document.addEventListener('click', function(e) {
      const wrap = document.getElementById('colorPanelWrap');
      if (wrap && !wrap.contains(e.target)) {
        const panel = document.getElementById('colorPanelDropdown');
        if (panel) panel.classList.remove('open');
      }
    });

    // Load saved accent on boot
    try {
      const savedAccent = localStorage.getItem('fr-accent');
      if (savedAccent) applyAccentColor(savedAccent);
      else applyAccentColor('green');
    } catch(e) { applyAccentColor('green'); }

    function toggleFaq(btn) {
      const item = btn.closest('.faq-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(i => i.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    }

    function toggleTheme() {
      applyTheme(!document.body.classList.contains('dark-mode'));
    }

    // Load saved theme on boot
