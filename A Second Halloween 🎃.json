    function buildArticleDownloadHTML(a) {
      if (!a.download || typeof a.download !== 'object') return '';
      const links = [];
      if (a.download.chrome)  links.push('<a class="ul-download-btn" href="' + a.download.chrome + '" target="_blank" rel="noopener">⬇ Chrome</a>');
      if (a.download.firefox) links.push('<a class="ul-download-btn" href="' + a.download.firefox + '" target="_blank" rel="noopener">⬇ Firefox</a>');
      if (!links.length) return '';
      return '<div class="ul-download-bar" style="margin:16px 0 0;">' + links.join('') + '</div>';
    }

    // Discover all .json files in the repo via GitHub Contents API, fetch each one.
    const GITHUB_REPO = 'Mrblueontop/Friends-Remover-Blogs';

    async function loadArticles() {
      const grid = document.getElementById('blogGrid');
      try {
        // List all files in the repo root
        const dirRes = await fetch('https://api.github.com/repos/' + GITHUB_REPO + '/contents/?_=' + Date.now());
        if (!dirRes.ok) throw new Error('Contents API error: ' + dirRes.status);
        const files = await dirRes.json();

        // Filter to .json files only (exclude index.json if it still exists)
        const jsonFiles = files.filter(function(f) {
          return f.type === 'file' && f.name.endsWith('.json') && f.name !== 'index.json';
        });

        if (!jsonFiles.length) {
          if (grid) grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:60px 0;color:var(--text-muted);">No articles yet. Check back soon.</div>';
          return;
        }

        // Fetch all files in parallel
        const results = await Promise.allSettled(jsonFiles.map(function(f) {
          return fetch(BLOG_BASE_URL + '/' + f.name + '?_=' + Date.now()).then(function(r) { return r.json(); }).then(function(a) {
            // Use the filename (without .json) as the stable id for routing
            a._file = f.name.replace(/\.json$/, '');
            a.catIcon = CAT_ICONS[a.cat] || '';
            return a;
          });
        }));

        const list = results
          .filter(function(r) { return r.status === 'fulfilled'; })
          .map(function(r) { return r.value; });

        // Sort by date descending (newest first). Falls back to file order if unparseable.
        list.sort(function(a, b) {
          return (new Date(b.date) || 0) - (new Date(a.date) || 0);
        });

        list.forEach(function(a) {
          ARTICLES[a._file] = a;
          ARTICLE_CACHE[a._file] = a; // already have full data, cache it
        });

        // Auto-pin the latest Updates article
        const latestUpdate = list.find(function(a) { return (a.cat || '').toLowerCase() === 'updates'; });
        if (latestUpdate) latestUpdate.pinned = true;

        renderBlogCards(list);
        renderUpdateLog(list);
        // Load remote totals without registering views for every card.
        prefetchBlogStates(list);
      } catch(e) {
        console.error('Failed to load blog articles:', e);
        if (grid) grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:60px 0;color:var(--text-muted);">Could not load articles. Check back soon.</div>';
      }
    }

    loadArticles();


    function blogTocGo(cardId) {
      const card = document.getElementById(cardId);
      if (!card) return;
      // Make sure blog page is shown
      if (typeof showPage === 'function' && !document.getElementById('page-blog').classList.contains('active')) {
        showPage('blog');
        setTimeout(function() {
          card.scrollIntoView({ behavior: 'smooth', block: 'start' });
          card.style.outline = '2px solid var(--primary-color)';
          card.style.outlineOffset = '4px';
          card.style.borderRadius = '16px';
          setTimeout(function() { card.style.outline = ''; card.style.outlineOffset = ''; }, 1800);
        }, 80);
      } else {
        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
        card.style.outline = '2px solid var(--primary-color)';
        card.style.outlineOffset = '4px';
        card.style.borderRadius = '16px';
        setTimeout(function() { card.style.outline = ''; card.style.outlineOffset = ''; }, 1800);
      }
    }

