          <div class="wb3-verify-email-sub" style="margin-top:-4px;">Enter it below to continue. Check spam if you don't see it.</div>
          <div class="wb3-otp-row" id="wb3-otp-row">
            <input class="wb3-otp-digit" id="otp0" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="one-time-code">
            <input class="wb3-otp-digit" id="otp1" maxlength="1" inputmode="numeric" pattern="[0-9]">
            <input class="wb3-otp-digit" id="otp2" maxlength="1" inputmode="numeric" pattern="[0-9]">
            <input class="wb3-otp-digit" id="otp3" maxlength="1" inputmode="numeric" pattern="[0-9]">
            <input class="wb3-otp-digit" id="otp4" maxlength="1" inputmode="numeric" pattern="[0-9]">
            <input class="wb3-otp-digit" id="otp5" maxlength="1" inputmode="numeric" pattern="[0-9]">
          </div>
          <div class="wb3-otp-error" id="wb3-otp-error"></div>
          <button class="wb3-otp-submit-btn" id="wb3-otp-submit-btn" onclick="wb3SubmitOTP()" disabled>Verify &amp; Continue</button>
          <div class="wb3-otp-resend">
            Didn't get it? <button class="wb3-otp-resend-btn" id="wb3-otp-resend-btn" onclick="wb3ResendOTP()" disabled>Resend code</button>
