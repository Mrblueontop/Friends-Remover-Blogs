      currentPage = id;
      document.body.setAttribute('data-page', id);

      // Dynamic page title + OG meta
      const pageMeta = {
        home:    { title: 'Friends Remover', desc: 'Bulk remove Roblox friends instantly. Select who to remove and clean your friends list in one click.' },
        blog:    { title: 'Updates & Blog', desc: 'Latest updates, announcements and dev notes from Friends Remover.' },
        about:   { title: 'About', desc: 'Learn more about the Friends Remover extension.' },
        careers: { title: 'Careers', desc: 'Join the Friends Remover team.' },
        support: { title: 'Support & FAQ', desc: 'Get help and answers to common questions.' },
        privacy: { title: 'Privacy Policy', desc: 'Privacy policy for Friends Remover.' },
        terms:   { title: 'Terms of Service', desc: 'Terms of service for Friends Remover.' },
        'community-guidelines': { title: 'Community Guidelines — Friends Remover', desc: 'Rules for respectful, safe, and useful Friends Remover community discussions.' },
        'frplus-policy': { title: 'FR Plus Purchase Policy — Friends Remover', desc: 'Purchase terms and policy for FR Plus.' },
        updates: { title: 'Update Log — Friends Remover', desc: 'All releases, changes, and what\'s coming next.' },
        frplus:  { title: 'FR Plus — Friends Remover', desc: 'Unlock premium features with FR Plus.' },
        article: { title: 'Blog', desc: 'Read the latest from Friends Remover.' },
        '404':   { title: '404 — Page Not Found', desc: 'This page does not exist.' },
        status:  { title: 'System Status — Friends Remover', desc: 'Live status for the Friends Remover extension backend, KV namespaces, and APIs.' }
      };
      const meta = pageMeta[id] || { title: 'Friends Remover', desc: '' };
      // Don't overwrite title for article pages — openArticle sets it correctly
      if (id !== 'article') document.title = meta.title;
      const ogTitle = document.querySelector('meta[property="og:title"]');
      const ogDesc  = document.querySelector('meta[property="og:description"]');
      const twTitle = document.querySelector('meta[name="twitter:title"]');
      const twDesc  = document.querySelector('meta[name="twitter:description"]');
      if (ogTitle) ogTitle.setAttribute('content', meta.title);
      if (ogDesc)  ogDesc.setAttribute('content', meta.desc);
      if (twTitle) twTitle.setAttribute('content', meta.title);
      if (twDesc)  twDesc.setAttribute('content', meta.desc);

      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      const target = document.getElementById('page-' + id);
      if (target) { target.classList.add('active'); window.scrollTo(0, 0); }
      else {
        // Unknown page → show 404
        const p404 = document.getElementById('page-404');
        if (p404) { p404.classList.add('active'); window.scrollTo(0, 0); }
        if (typeof spawnNfParticles === 'function') spawnNfParticles();
      }
      // Always restore header transform when switching pages
      if (siteHeaderEl) siteHeaderEl.style.transform = 'translateY(0)';

      if (pushState) {
        const hash = id === 'home' ? '' : '#' + id;
        history.pushState({ page: id }, '', location.pathname + hash);
      }
    }

    // Handle back/forward browser navigation
    window.addEventListener('popstate', (e) => {
      const blogSlug = new URLSearchParams(location.search).get('blog');
      if (blogSlug) {
        // Find article by slug
        const match = Object.keys(ARTICLES).find(function(id) {
          const s = CdLock.slug(id, ARTICLES[id]);
          return s === blogSlug || CdLock.slug(id, null) === blogSlug;
        });
        if (match) { openArticle(match); } else {
          // Unknown blog slug → 404
          document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
          const p404 = document.getElementById('page-404');
          if (p404) { p404.classList.add('active'); window.scrollTo(0, 0); }
          spawnNfParticles();
        }
        return;
      }
      if (e.state?.articleId) { openArticle(e.state.articleId); return; }
      const hash = location.hash.replace('#', '');
      const id = e.state?.page || hash || 'home';
      // 'article' without a slug — go to blog
      if (id === 'article') { showPage('blog', false); return; }
      showPage(id, false);
    });

    // ── 404 particle spawner ──
    function spawnNfParticles() {
      const container = document.getElementById('nfParticles');
      if (!container) return;
      container.innerHTML = '';
      const count = 28;
      for (let i = 0; i < count; i++) {
        const p = document.createElement('div');
        p.className = 'nf-particle';
        const size = 3 + Math.random() * 5;
        p.style.cssText = [
          `width:${size}px`, `height:${size}px`,
          `left:${Math.random()*100}%`,
          `animation-duration:${4 + Math.random()*8}s`,
          `animation-delay:${Math.random()*6}s`,
          `opacity:${0.3 + Math.random()*0.7}`,
          `background:rgba(var(--primary-rgb),${0.4 + Math.random()*0.5})`
        ].join(';');
        container.appendChild(p);
      }
    }

    // Load correct page on initial load — suppress transitions during init
    document.body.classList.add('no-transition');
    const knownPages = ['home','about','careers','blog','article','support','privacy','terms','community-guidelines','status','updates','uninstall'];
    // Strip any ?query from the hash so #uninstall?roblox_id=123 routes to 'uninstall'
    const initBlogSlug = new URLSearchParams(location.search).get('blog');
    const initHash = (location.hash.replace('#', '') || 'home').split('?')[0];
    // Use a regex so trailing slashes (e.g. Website.html/) don't break the check
    const pathIs404 = location.pathname !== '/' && !/\.html\/?$/.test(location.pathname) && location.pathname !== '/index.html';

    if (initBlogSlug) {
      // Wait for articles to load, then open by slug
      showPage('blog', false);
      const tryOpen = setInterval(function() {
        const match = Object.keys(ARTICLES).find(function(id) {
          const s = CdLock.slug(id, ARTICLES[id]);
          return s === initBlogSlug || CdLock.slug(id, null) === initBlogSlug;
        });
        if (match) { clearInterval(tryOpen); openArticle(match); }
      }, 100);
      setTimeout(function() {
        clearInterval(tryOpen);
        // Articles loaded but slug not found → show 404
        const finalMatch = Object.keys(ARTICLES).find(function(id) {
          const s = CdLock.slug(id, ARTICLES[id]);
          return s === initBlogSlug || CdLock.slug(id, null) === initBlogSlug;
        });
        if (!finalMatch) {
          document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
          const p404 = document.getElementById('page-404');
          if (p404) { p404.classList.add('active'); window.scrollTo(0, 0); }
          spawnNfParticles();
        }
      }, 8000);
    } else {
      const initPage = pathIs404 ? '404' : (knownPages.includes(initHash) ? initHash : '404');
      if (initPage === '404') spawnNfParticles();
      showPage(initPage, false);
    }
    requestAnimationFrame(() => requestAnimationFrame(() => document.body.classList.remove('no-transition')));

    // ── Video fullscreen button ──
    (function() {
      const fsBtn = document.getElementById('videoFullscreenBtn');
      const mockWrap = document.querySelector('.browser-mock-wrap');
      if (!fsBtn || !mockWrap) return;

      function enterFS() {
        if (mockWrap.requestFullscreen) {
          mockWrap.requestFullscreen().catch(() => toggleFallback(true));
        } else if (mockWrap.webkitRequestFullscreen) {
          mockWrap.webkitRequestFullscreen();
        } else {
          toggleFallback(true);
        }
      }
      function exitFS() {
        if (document.exitFullscreen) document.exitFullscreen().catch(() => toggleFallback(false));
        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
        else toggleFallback(false);
      }
      function toggleFallback(on) {
        mockWrap.classList.toggle('is-fullscreen', on);
        updateIcon(on);
      }
      function updateIcon(isFs) {
        const expand = fsBtn.querySelector('.fs-icon-expand');
        const shrink = fsBtn.querySelector('.fs-icon-shrink');
        if (expand) expand.style.display = isFs ? 'none' : '';
        if (shrink) shrink.style.display = isFs ? '' : 'none';
      }

      fsBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isFs = !!document.fullscreenElement || mockWrap.classList.contains('is-fullscreen');
        if (isFs) exitFS(); else enterFS();
      });

      document.addEventListener('fullscreenchange', () => {
        const isFs = !!document.fullscreenElement;
        mockWrap.classList.toggle('is-fullscreen', isFs);
        updateIcon(isFs);
      });

      // Keyboard shortcut: F
      document.addEventListener('keydown', (e) => {
        if (e.key === 'f' || e.key === 'F') {
          if (document.activeElement && ['INPUT','TEXTAREA'].includes(document.activeElement.tagName)) return;
          const isFs = !!document.fullscreenElement || mockWrap.classList.contains('is-fullscreen');
          if (isFs) exitFS(); else enterFS();
        }
        if (e.key === 'Escape') { toggleFallback(false); }
      });
    })();

    // ── Counter double-click fullscreen ──
    (function() {
      const counterSec = document.getElementById('counterSection');
      if (!counterSec) return;
      function toggleCounterFs() {
        const isFs = counterSec.classList.toggle('counter-fs');
        const req = counterSec.requestFullscreen || counterSec.webkitRequestFullscreen;
        if (isFs && req) {
          const r = req.call(counterSec);
          if (r && r.catch) r.catch(() => {});
        } else if (!isFs && document.fullscreenElement) {
          document.exitFullscreen().catch(() => {});
        } else if (!isFs && document.webkitFullscreenElement && document.webkitExitFullscreen) {
          document.webkitExitFullscreen();
        }
      }
      counterSec.addEventListener('dblclick', toggleCounterFs);
      // Double-tap on touch devices (dblclick is unreliable on some mobile browsers)
      let lastTap = 0;
      counterSec.addEventListener('touchend', (e) => {
        const now = Date.now();
        if (now - lastTap < 300) { e.preventDefault(); lastTap = 0; toggleCounterFs(); }
        else lastTap = now;
      }, { passive: false });
      document.addEventListener('fullscreenchange', () => {
        if (!document.fullscreenElement) {
          counterSec.classList.remove('counter-fs');
        }
      });
      document.addEventListener('webkitfullscreenchange', () => {
        if (!document.webkitFullscreenElement) counterSec.classList.remove('counter-fs');
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') counterSec.classList.remove('counter-fs');
      });
    })();

    // Tilt — listen on window so iframe never blocks it
    const browserMock = document.getElementById('browserMock');
    const BASE_X = 4, BASE_Y = -6, BASE_Z = 1;
    const MAX_TILT = 8;

    window.addEventListener('mousemove', (e) => {
      const rect = browserMock.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = Math.max(-1, Math.min(1, (e.clientX - cx) / (rect.width / 2)));
      const dy = Math.max(-1, Math.min(1, (e.clientY - cy) / (rect.height / 2)));
      const rotX = BASE_X + (-dy * MAX_TILT);
      const rotY = BASE_Y + (dx * MAX_TILT);
      browserMock.style.transition = 'transform 0.08s linear';
      browserMock.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg) rotateZ(${BASE_Z}deg)`;
      browserMock.style.boxShadow = '';
    });
    // Scroll indicator
    const scrollIndicator = document.getElementById('scrollIndicator');
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? scrollTop / docHeight : 0;
      scrollIndicator.style.transform = `scaleX(${progress})`;
    }, { passive: true });

    // Hide/show nav-top on scroll — home page only
    let lastScroll = 0;
    let scrollTicking = false;
    const navTopEl = document.querySelector('.nav-top');
    window.addEventListener('scroll', () => {
      if (!scrollTicking) {
        requestAnimationFrame(() => {
          if (currentPage !== 'home') { scrollTicking = false; return; }
          const isMobile = window.innerWidth <= 768;
          // On mobile the header is 60px total (no nav-bottom); on desktop shift by nav-top height only
          const scrollShift = isMobile ? 0 : -96;
          const current = window.scrollY;
          if (current <= 10) {
            siteHeaderEl.style.transform = 'translateY(0)';
          } else if (current > lastScroll + 5) {
            siteHeaderEl.style.transform = `translateY(${scrollShift}px)`;
          } else if (current < lastScroll - 5) {
            siteHeaderEl.style.transform = 'translateY(0)';
          }
          lastScroll = current;
          scrollTicking = false;
        });
        scrollTicking = true;
      }
    }, { passive: true });
    const words = [
      { word: 'friend',   prefix: "Each one was somebody's" },
      { word: 'sibling',  prefix: "Each one is somebody's"  },
      { word: 'rival',    prefix: "Each one, someone's"     },
      { word: 'teammate', prefix: "Each one was somebody's" },
      { word: 'ally',     prefix: "Each one was somebody's" },
    ];
    let wi = 0;
    const rotEl     = document.getElementById('rotating-word');
    const prefixEl  = document.getElementById('rotating-prefix');
    let rotInterval = null;

    let pollInterval = null;

    const counterSection = document.querySelector('.counter-section');
    const sectionObs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          // start rotating words
          if (!rotInterval) {
            rotInterval = setInterval(() => {
              wi = (wi + 1) % words.length;
              rotEl.style.opacity = '0';
              rotEl.style.transform = 'translateY(-8px)';
              setTimeout(() => {
                rotEl.textContent = words[wi].word;
                if (prefixEl) prefixEl.textContent = words[wi].prefix;
                rotEl.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                rotEl.style.opacity = '1';
                rotEl.style.transform = 'translateY(0)';
              }, 300);
            }, 2500);
          }
          // start polling
          if (!pollInterval) {
            fetchCount();
            pollInterval = setInterval(fetchCount, 5000);
          }
        } else {
          if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
          if (rotInterval) { clearInterval(rotInterval); rotInterval = null; }
        }
      });
    }, { threshold: 0.2 });

    // Counter scroll reveal
    const revEls = document.querySelectorAll('.counter-reveal');
    const revObs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.15 });
    revEls.forEach(el => revObs.observe(el));

    // Slot-machine counter — enhanced with color tiers, shockwave, particles, activity badge
    const counterEl = document.getElementById('counter');
    let currentValue = 0, targetValue = 0, animFrame;

    // ── Color tiers ──
    // Tiers now only change the label and glow strength; the colors always follow the current theme.
    const TH = { c1: 'var(--primary-color)', c2: 'var(--accent-light, var(--primary-color))', c3: 'var(--secondary-color)' };
    const COLOR_TIERS = [
      { min: 0,      ...TH, glow: 'rgba(var(--primary-rgb),0.35)', label: 'Live'         },
      { min: 10000,  ...TH, glow: 'rgba(var(--primary-rgb),0.4)',  label: 'Growing'      },
      { min: 25000,  ...TH, glow: 'rgba(var(--primary-rgb),0.4)',  label: 'On Fire 🔥'   },
      { min: 50000,  ...TH, glow: 'rgba(var(--primary-rgb),0.45)', label: 'Massive 🔥'   },
      { min: 100000, ...TH, glow: 'rgba(var(--primary-rgb),0.5)',  label: 'Legendary ⚡' },
    ];
    let currentTier = null;

    function getTier(val) {
      let t = COLOR_TIERS[0];
      for (const tier of COLOR_TIERS) { if (val >= tier.min) t = tier; }
      return t;
    }

    function applyTier(tier, force) {
      if (!force && currentTier === tier) return;
      currentTier = tier;
      counterEl.style.setProperty('--c1', tier.c1);
      counterEl.style.setProperty('--c2', tier.c2);
      counterEl.style.setProperty('--c3', tier.c3);
      counterEl.style.setProperty('--glow', tier.glow);
      counterEl.style.filter = `drop-shadow(0 0 32px ${tier.glow})`;
      const grad = `linear-gradient(135deg, ${tier.c1} 0%, ${tier.c2} 40%, ${tier.c3} 100%)`;
      counterEl.querySelectorAll('.digit-reel span, .digit-sep').forEach(el => {
        el.style.background = grad;
        el.style.webkitBackgroundClip = 'text';
        el.style.webkitTextFillColor = 'transparent';
        el.style.backgroundClip = 'text';
      });

    }

    // ── Shockwave ──
    const shockwaveEl = document.getElementById('counterShockwave');
    function fireShockwave() {
      if (!shockwaveEl) return;
      shockwaveEl.classList.remove('fire');
      void shockwaveEl.offsetWidth;
      if (currentTier) shockwaveEl.style.borderColor = currentTier.glow;
      shockwaveEl.classList.add('fire');
    }

    // ── Milestone particles ──
    const MILESTONES = [1000,5000,10000,25000,50000,100000,250000,500000];
    let lastMilestone = 0;
    function checkMilestone(val) {
      for (const m of MILESTONES) {
        if (val >= m && lastMilestone < m) {
          lastMilestone = m;
          burstParticles(16);
          fireShockwave();
          break;
        }
      }
    }
    function burstParticles(count) {
      const rect = counterEl.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2 + window.scrollY;
      const _pc = getComputedStyle(document.documentElement).getPropertyValue('--primary-color').trim() || '#2196f3';
      const _sc = getComputedStyle(document.documentElement).getPropertyValue('--secondary-color').trim() || '#1565c0';
      const colors = currentTier ? [currentTier.c1, currentTier.c2, currentTier.c3] : [_pc, _sc];
      for (let i = 0; i < count; i++) {
        const p = document.createElement('div');
        p.className = 'counter-particle';
        const angle = (i / count) * Math.PI * 2;
        const dist = 70 + Math.random() * 100;
        const tx = Math.cos(angle) * dist;
        const ty = Math.sin(angle) * dist - 60;
        p.style.cssText = `left:${cx}px;top:${cy}px;position:absolute;z-index:9999;background:${colors[i%colors.length]};width:${4+Math.random()*5}px;height:${4+Math.random()*5}px;--tx:translate(${tx}px,${ty}px);`;
        document.body.appendChild(p);
        setTimeout(() => p.remove(), 1400);
      }
    }



    function buildSlots(numStr) {
      const sw = counterEl.querySelector('.counter-shockwave');
      counterEl.innerHTML = '';
      if (sw) counterEl.appendChild(sw);
      const _pc2 = getComputedStyle(document.documentElement).getPropertyValue('--primary-color').trim() || '#2196f3';
      const _sc2 = getComputedStyle(document.documentElement).getPropertyValue('--secondary-color').trim() || '#1565c0';
      const grad = currentTier ? `linear-gradient(135deg,${currentTier.c1} 0%,${currentTier.c2} 40%,${currentTier.c3} 100%)` : `linear-gradient(135deg,${_pc2} 0%,${_pc2} 40%,${_sc2} 100%)`;
      for (const ch of numStr) {
        if (ch === ',') {
          const sep = document.createElement('span');
          sep.className = 'digit-sep';
          sep.textContent = ',';
          sep.style.background = grad;
          sep.style.webkitBackgroundClip = 'text';
          sep.style.webkitTextFillColor = 'transparent';
          sep.style.backgroundClip = 'text';
          counterEl.appendChild(sep);
        } else {
          const slot = document.createElement('div');
          slot.className = 'digit-slot';
          slot.dataset.digit = ch;
          const reel = document.createElement('div');
          reel.className = 'digit-reel';
          for (let d = 0; d <= 9; d++) {
            const s = document.createElement('span');
            s.textContent = d;
            s.style.background = grad;
            s.style.webkitBackgroundClip = 'text';
            s.style.webkitTextFillColor = 'transparent';
            s.style.backgroundClip = 'text';
            reel.appendChild(s);
          }
          slot.appendChild(reel);
          counterEl.appendChild(slot);
          reel.style.transition = 'none';
          reel.style.transform = `translateY(-${parseInt(ch) * 1.2}em)`;
        }
      }
    }

    function setDigits(value, animate) {
      const tier = getTier(value);
      applyTier(tier);
      checkMilestone(value);
      const formatted = value.toLocaleString();
      const slots = counterEl.querySelectorAll('.digit-slot');
      const chars  = [...formatted].filter(c => c !== ',');
      if (slots.length !== chars.length) { buildSlots(formatted); return; }
      const diff = Math.abs(value - currentValue);
      const dur = diff <= 1 ? 2400 : diff <= 5 ? 1400 : diff <= 50 ? 700 : 400;
      if (animate && diff > 100) fireShockwave();
      slots.forEach((slot, i) => {
        const newDigit = parseInt(chars[i]);
        const oldDigit = parseInt(slot.dataset.digit);
        slot.dataset.digit = newDigit;
        const reel = slot.querySelector('.digit-reel');
        if (animate && newDigit !== oldDigit) {
          reel.style.transition = `transform ${dur}ms cubic-bezier(0.22, 1, 0.36, 1)`;
          reel.style.transform = `translateY(-${newDigit * 1.2}em)`;
          slot.classList.remove('changed');
          void slot.offsetWidth;
          slot.classList.add('changed');
          setTimeout(() => slot.classList.remove('changed'), dur);
        } else if (!animate) {
          reel.style.transition = 'none';
          reel.style.transform = `translateY(-${newDigit * 1.2}em)`;
        }
      });
    }

    function animateTo(target) {
      cancelAnimationFrame(animFrame);
      const start = currentValue, diff = target - start;
      if (diff === 0) return;
      if (Math.abs(diff) <= 5) { currentValue = target; setDigits(target, true); return; }
      if (Math.abs(diff) > 500) {
        setTimeout(fireShockwave, 80);
        setTimeout(() => burstParticles(8), 180);
      }
      const duration = Math.min(2500, Math.max(1000, Math.abs(diff) * 4));
      const startTime = performance.now();
      let lastDisplayed = start;
      function step(now) {
        const t = Math.min((now - startTime) / duration, 1);
        const ease = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
        const val = Math.round(start + diff * ease);
        if (val !== lastDisplayed) {
          lastDisplayed = val;
          currentValue = val;
          setDigits(val, t > 0.8);
        }
        if (t < 1) { animFrame = requestAnimationFrame(step); }
        else { currentValue = target; setDigits(target, true); }
      }
      animFrame = requestAnimationFrame(step);
    }

    buildSlots('0');

    let lastConfirmed = 0;

    async function fetchCount() {
      try {
        const res = await fetch('https://fmstoragekv.zaggloob.workers.dev/history/all');
        if (!res.ok) return;
        const data = await res.json();
        const total = data.totalUnfriended ?? 0;
        if (total <= 0) return;

        const isFirstLoad = lastConfirmed === 0;
        lastConfirmed = total;

        if (isFirstLoad) {
          currentValue = 0;
          targetValue = total;
          applyTier(getTier(total), true);
          setTimeout(() => animateTo(total), 400);
          return;
        }

        // Only animate when the real count goes up — never speculate
        if (total > targetValue) {
          targetValue = total;
          animateTo(total);
        }
      } catch {}
    }

    sectionObs.observe(counterSection);
    // ── Robloxians strip ─────────────────────────────────────────
    const GRADIENTS = [
      '135deg,#667eea,#764ba2','135deg,#f093fb,#f5576c','135deg,#4facfe,#00f2fe',
      '135deg,#43e97b,#38f9d7','135deg,#fa709a,#fee140','135deg,#f7971e,#ffd200',
      '135deg,#11998e,#38ef7d','135deg,#6a11cb,#2575fc','135deg,#f953c6,#b91d73',
      '135deg,#30cfd0,#330867','135deg,#a18cd1,#fbc2eb','135deg,#e74c3c,#c0392b',
    ];

    // The overlay shows how many friends that user removed. The count comes from the worker's `count`
    // field (same name the live-removals page uses); if a user has no number, no overlay is added.
    let creatorWarned = false;
    function creatorRemovedCount(u) {
      if (!u || typeof u !== 'object') return null;
      const toNum = v => (v === null || v === undefined || v === '' || typeof v === 'boolean') ? null : (Number.isFinite(Number(v)) ? Number(v) : null);
      // 1) well-known names
      for (const k of ['count', 'removed', 'removedCount', 'totalRemoved', 'totalUnfriended', 'unfriended', 'unfriendedCount', 'friendsRemoved', 'removals', 'total']) {
        const n = toNum(u[k]); if (n !== null) return n;
      }
      // 2) any numeric field whose name looks like a removal count (this object, then one level down)
      const looks = /(count|remov|unfriend|total)/i, skip = /(id|time|date|at)$/i;
      const scan = o => { for (const k of Object.keys(o)) { if (looks.test(k) && !skip.test(k)) { const n = toNum(o[k]); if (n !== null) return n; } } return null; };
      let n = scan(u); if (n !== null) return n;
      for (const k of Object.keys(u)) { if (u[k] && typeof u[k] === 'object' && !Array.isArray(u[k])) { n = scan(u[k]); if (n !== null) return n; } }
      if (!creatorWarned) { creatorWarned = true; console.warn('[Robloxians strip] no removal count found. Fields returned for a user:', Object.keys(u), u); }
      return null;
    }
    function creatorHoverHTML(count) {
      if (count === null) return '';
      return '<div class="creator-hover"><b>' + count.toLocaleString() + '</b><small>' + (count === 1 ? 'friend removed' : 'friends removed') + '</small></div>';
    }

    function buildCreatorItem(username, avatarUrl, index, count) {
      const item = document.createElement('div');
      item.className = 'creator-item';
      const grad = GRADIENTS[index % GRADIENTS.length];
      const hover = creatorHoverHTML(count === undefined ? null : count);
      if (avatarUrl) {
        item.innerHTML = `<div class="creator-avatar"><img src="${avatarUrl}" alt="${username}" loading="lazy" onerror="this.replaceWith(document.createTextNode('${username[0].toUpperCase()}'))"/>${hover}</div><span>${username.slice(0,12)}</span>`;
      } else {
        item.innerHTML = `<div class="creator-avatar" style="background:linear-gradient(${grad})">${username[0].toUpperCase()}${hover}</div><span>${username.slice(0,12)}</span>`;
      }
      return item;
    }

    async function loadRobloxians() {
      const track = document.getElementById('creatorsTrack');
      if (!track) return;
      try {
        const res = await fetch('https://fmstoragekv.zaggloob.workers.dev/find-random?count=30');
        if (!res.ok) throw new Error('fetch failed');
        const data = await res.json();
        const users = data.results || [];
        if (!users.length) throw new Error('no users');

        // Build both sets for seamless loop
        const frag1 = document.createDocumentFragment();
        const frag2 = document.createDocumentFragment();
        users.forEach((u, i) => {
          frag1.appendChild(buildCreatorItem(u.username, u.avatarUrl, i, creatorRemovedCount(u)));
          frag2.appendChild(buildCreatorItem(u.username, u.avatarUrl, i, creatorRemovedCount(u)));
        });
        track.appendChild(frag1);
        track.appendChild(frag2);

        // Adjust animation speed based on count
        track.style.animationDuration = `${Math.max(20, users.length * 1.8)}s`;
      } catch {
        // Fallback static placeholders
        const fallback = [
          ['Robloxian','135deg,#667eea,#764ba2'],['Player2','135deg,#f093fb,#f5576c'],
          ['xXDarkXx','135deg,#4facfe,#00f2fe'],['User123','135deg,#43e97b,#38f9d7'],
          ['Noob456','135deg,#fa709a,#fee140'],['Pro999','135deg,#f7971e,#ffd200'],
          ['Builder','135deg,#11998e,#38ef7d'],['Trader','135deg,#6a11cb,#2575fc'],
        ];
        [1,2].forEach(() => {
          fallback.forEach(([name, g], i) => {
            const el = document.createElement('div');
            el.className = 'creator-item';
            el.innerHTML = `<div class="creator-avatar" style="background:linear-gradient(${g})">${name[0]}</div><span>${name.slice(0,12)}</span>`;
            track.appendChild(el);
          });
        });
      }
    }

    loadRobloxians();

