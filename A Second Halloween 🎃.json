<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
  <title>Friends Remover Status</title>
  <script>
    // Keep the live removal counter route completely separate from the site UI.
    // This runs in the head to avoid a flash of the normal homepage.
    if (/^\/removalcount\/?$/.test(location.pathname)) {
      document.documentElement.classList.add('removal-count-route');
    }
    if (/^\/stream\/?$/.test(location.pathname)) {
      document.documentElement.classList.add('stream-route');
    }
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="icon.png"/>
  <link rel="apple-touch-icon" href="icon.png"/>

  <!-- Open Graph / Discord Embed -->
  <meta property="og:title" content="Friends Remover"/>
  <meta property="og:description" content="Bulk remove Roblox friends instantly. Select who to remove and clean your friends list in one click."/>
  <meta property="og:image" content="https://friendsremover.xyz/og-image.png"/>
  <meta property="og:url" content="https://friendsremover.xyz/"/>
  <meta property="og:type" content="website"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content="Friends Remover"/>
  <meta name="twitter:description" content="Bulk remove Roblox friends instantly. Select who to remove and clean your friends list in one click."/>
  <meta name="twitter:image" content="https://friendsremover.xyz/og-image.png"/>

  <!-- Per-article OG override: runs before first paint so crawlers/link-previewers see it -->
  <script>
  (function() {
    // Map of known blog slugs → their OG metadata
    var BLOG_OG = {
      'compact-view': {
        title: 'Compact View — Friends Remover Blog',
        desc:  'Introducing Compact View: a denser, more efficient layout for managing your Roblox friends list.',
        image: null, // set dynamically from article thumbImage once loaded
        url:   'https://friendsremover.xyz/?blog=compact-view'
      }
      // Add more slugs here as new articles are published
    };

    var blogSlug = new URLSearchParams(location.search).get('blog');
    if (blogSlug) {
      var og = BLOG_OG[blogSlug];
      if (og) {
        // Update all OG/Twitter meta tags immediately
        function setMeta(sel, val) {
          var el = document.querySelector(sel);
          if (el) el.setAttribute('content', val);
        }
        // We must wait for the DOM to parse the <head> meta tags
        // Use document.write-safe approach: queue it
        document.addEventListener('DOMContentLoaded', function() {
          setMeta('meta[property="og:title"]',       og.title);
          setMeta('meta[property="og:description"]', og.desc);
          if (og.image) setMeta('meta[property="og:image"]', og.image);
          setMeta('meta[property="og:url"]',         og.url);
          setMeta('meta[name="twitter:title"]',      og.title);
          setMeta('meta[name="twitter:description"]',og.desc);
          if (og.image) setMeta('meta[name="twitter:image"]', og.image);
          document.title = og.title;
        });
      }
    }
  })();
  </script>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }

    :root {
      --primary-color: var(--primary-color);
      --primary-rgb: 34, 197, 94;
      --secondary-color: var(--secondary-color);
      --accent-nav-from: rgba(var(--primary-rgb),0.97);
      --accent-nav-to: rgba(21,128,61,0.97);
      --accent-glow: rgba(var(--primary-rgb),0.3);
      --bg-body: linear-gradient(135deg, var(--accent-bg-start) 0%, var(--accent-bg-mid) 50%, #f8fafc 100%);
      --bg-primary: #ffffff;
      --bg-secondary: #f8fafc;
      --bg-tertiary: #f1f5f9;
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      --text-muted: #94a3b8;
      --border-color: #e2e8f0;
      --counter-bg: var(--accent-bg-start);
      --footer-bg: #f8fafc;
      --browser-bg: #e2e8f0;
      --rblx-topbar-bg: #cbd5e1;
      --rblx-section-bg: #f1f5f9;
      --inv-cell-bg: #cbd5e1;
      --inv-cell-dark-bg: #e2e8f0;
      --preview-fade: #f8fafc;
      --community-icon-bg: #e2e8f0;
      --tt-bg: #ffffff;
      --tt-header-bg: var(--accent-header-bg);
      --orange: #f76b1c;
      --nav-text: #1e293b;
    }

    /* Smooth theme transitions */
    *, *::before, *::after {
      transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
    }
    /* But don't slow down animations/transforms */
    .counter-reveal, .digit-reel, .browser-mock, .browser-mock-wrap,
    .hero h1, .hero-sub, .hero-buttons, .btn-chrome, .btn-firefox,
    .nav-icon-btn, .nav-btn {
      transition-property: background-color, border-color, color, box-shadow, opacity, transform;
    }

    /* ═══════════════════════════════
       DARK MODE OVERRIDES
    ═══════════════════════════════ */
    body.dark-mode {
      --bg-body: linear-gradient(135deg, #000000 0%, #0a0e1a 50%, #050810 100%);
      --bg-primary: #0a0e1a;
      --bg-secondary: #111827;
      --bg-tertiary: #1a1f2e;
      --text-primary: #f1f5f9;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --border-color: #1f2937;
      --counter-bg: #0d1117;
      --footer-bg: #0a0e1a;
      --browser-bg: #1f2937;
      --rblx-topbar-bg: #374151;
      --rblx-section-bg: #1f2937;
      --inv-cell-bg: #4b5563;
      --inv-cell-dark-bg: #374151;
      --preview-fade: #111827;
      --community-icon-bg: #374151;
      --tt-bg: #111827;
      --tt-header-bg: #1a2332;
      --nav-text: #f1f3fa;
    }


    /* ═══════════════════════════════
       HALLOWEEN THEME (default)
    ═══════════════════════════════ */
    body.halloween-theme.dark-mode {
      --bg-body: linear-gradient(135deg, #07030d 0%, #150a24 50%, #0b0613 100%);
      --bg-primary: #120a1f;
      --bg-secondary: #1a0f2b;
      --bg-tertiary: #231538;
      --border-color: #36204f;
      --counter-bg: #0d0716;
      --footer-bg: #0b0613;
      --browser-bg: #2a1a40;
      --rblx-topbar-bg: #3b2559;
      --rblx-section-bg: #2a1a40;
      --preview-fade: #1a0f2b;
      --tt-bg: #1a0f2b;
      --tt-header-bg: #281640;
    }


    /* Halloween header banner — one image spanning both nav rows */
    body.halloween-theme .site-header {
      background:
        url('halloween-header.webp') center / cover no-repeat,
        linear-gradient(135deg, #2a0f4a, #12071f);
    }
    body.halloween-theme .nav-top::before { display: none; } /* no stripe overlay on the art */
    body.halloween-theme .nav-bottom::before { display: none; }
    body.halloween-theme .nav-top,
    body.halloween-theme .nav-bottom {
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    /* Halloween page banners: solid orange, no pattern */
    body.halloween-theme .blog-hero,
    body.halloween-theme .about-hero-band,
    body.halloween-theme .ui-hero,
    body.halloween-theme .support-hero {
      background: #ff7518 !important;
    }
    body.halloween-theme .blog-hero::before,
    body.halloween-theme .about-hero-band::before,
    body.halloween-theme .ui-hero::before,
    body.halloween-theme .ui-hero::after,
    body.halloween-theme .support-hero::before {
      display: none !important;
    }
    /* Halloween page frame (dark mode only — the art is dark) */
    body.halloween-theme.dark-mode { background: #05020a; }
    body.halloween-theme.dark-mode::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: -1;
      background: url('halloween-compact-frame.webp') center bottom / cover no-repeat;
      pointer-events: none;
    }

    /* ═══ Halloween launch: countdown overlay + reveal ═══ */
    #frHwOverlay {
      position: fixed; inset: 0; z-index: 100000; pointer-events: none;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden; text-align: center;
    }
    @keyframes hwOverlayIn { from { opacity: 0; } }
    @keyframes hwIris { from { clip-path: circle(75% at 50% 50%); } to { clip-path: circle(0% at 50% 50%); } }
    .hw-layer { position: fixed; inset: 0; z-index: 100002; pointer-events: none; overflow: hidden; view-transition-name: hwlayer; }
    ::view-transition-old(root), ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
    ::view-transition-old(hwlayer) { display: none; }
    ::view-transition-group(hwlayer), ::view-transition-new(hwlayer) { animation: none; }
    .hw-canvas { position: absolute; inset: 0; pointer-events: none; }
    #frHwOverlay.hw-fade { animation: hwOverlayOutSimple .5s ease forwards; pointer-events: none; }
    @keyframes hwOverlayOutSimple { to { opacity: 0; } }
    .hw-glow {
      position: absolute; width: 70vmin; height: 70vmin; border-radius: 50%;
      background: radial-gradient(circle, rgba(255,117,24,.45), transparent 65%);
      animation: hwPulse 1s ease-in-out infinite;
    }
    @keyframes hwPulse { 0%,100% { transform: scale(.9); opacity: .7; } 50% { transform: scale(1.1); opacity: 1; } }
    .hw-stage { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; }
    .hw-stage.shake { animation: hwShake .55s ease-out; }
    @keyframes hwShake {
      0%,100% { transform: none; } 15% { transform: translate(-9px, 5px); } 30% { transform: translate(8px,-6px); }
      45% { transform: translate(-6px,-4px); } 60% { transform: translate(5px,4px); } 80% { transform: translate(-2px,2px); }
    }
    .hw-ring { position: absolute; width: min(62vmin, 440px); height: min(62vmin, 440px); transform: rotate(-90deg); overflow: visible; }
    .hw-ring circle {
      fill: none; stroke: #ff7518; stroke-width: 1.6; stroke-linecap: round;
      stroke-dasharray: 289; stroke-dashoffset: 0;
      filter: drop-shadow(0 0 6px rgba(255,117,24,.9));
      animation: hwRing 1s linear forwards;
    }
    @keyframes hwRing { to { stroke-dashoffset: 289; } }
    .hw-num {
      position: relative; display: block; font-size: clamp(7rem, 28vw, 17rem); font-weight: 900; line-height: 1;
      color: #ff7518;
      text-shadow: 0 0 30px rgba(255,117,24,.85), 0 0 90px rgba(255,117,24,.5);
      animation: hwPop 1s cubic-bezier(.2,.9,.3,1.2) both;
    }
    @keyframes hwPop {
      0%   { transform: scale(.3); opacity: 0; filter: blur(8px); }
      20%  { transform: scale(1.15); opacity: 1; filter: none; }
      35%  { transform: scale(1); }
      75%  { transform: scale(1); opacity: 1; }
      100% { transform: scale(.88); opacity: .2; }
    }
    /* — pumpkin: glides in from the right-middle, pulses faster at the center, then explodes — */
    .hw-hx { display: block; animation: hwFlyX var(--fd, 900ms) cubic-bezier(.18,.7,.2,1) both; }
    .hw-ha { display: block; animation: hwEnter var(--fd, 900ms) cubic-bezier(.18,.7,.2,1) both; filter: drop-shadow(0 0 18px rgba(255,117,24,.8)); }
    .hw-emoji { display: block; font-size: clamp(6rem, 20vw, 12rem); line-height: 1; }
    .hw-ha.pulse { animation: hwCharge var(--pd, 1000ms) cubic-bezier(.4,0,.6,1) both; }
    @keyframes hwFlyX  { from { transform: translateX(62vw); } to { transform: translateX(0); } }
    @keyframes hwEnter { from { transform: rotate(-360deg) scale(.55); } to { transform: rotate(0deg) scale(1); } }
    /* three clean heartbeats, each bigger and brighter than the last, then the blast */
    @keyframes hwCharge {
      0%   { transform: scale(1);    filter: drop-shadow(0 0 18px rgba(255,117,24,.8)) brightness(1); }
      16%  { transform: scale(1.12); filter: drop-shadow(0 0 30px rgba(255,117,24,.9)) brightness(1.15); }
      30%  { transform: scale(1);    filter: drop-shadow(0 0 18px rgba(255,117,24,.8)) brightness(1); }
      48%  { transform: scale(1.26); filter: drop-shadow(0 0 46px rgba(255,100,20,.95)) brightness(1.35); }
      62%  { transform: scale(1.04); filter: drop-shadow(0 0 24px rgba(255,117,24,.85)) brightness(1.1); }
      84%  { transform: scale(1.7);  filter: drop-shadow(0 0 80px rgba(255,70,0,1)) brightness(1.7); }
      100% { transform: scale(1.2);  filter: drop-shadow(0 0 120px #fff) brightness(3); }
    }

    /* — impact — */
    .hw-core {
      position: absolute; left: 50%; top: 50%; width: 46vmin; height: 46vmin; margin: -23vmin 0 0 -23vmin; border-radius: 50%;
      background: radial-gradient(circle, #fff 0%, #ffe9a8 22%, rgba(255,150,40,.75) 48%, rgba(255,90,0,0) 72%);
      animation: hwCore .6s cubic-bezier(.1,.7,.3,1) forwards;
    }
    @keyframes hwCore { from { transform: scale(.15); opacity: 1; } to { transform: scale(6); opacity: 0; } }
    .hw-shock {
      position: absolute; left: 50%; top: 50%; width: 30vmin; height: 30vmin; margin: -15vmin 0 0 -15vmin; border-radius: 50%;
      border: 1.2vmin solid rgba(255,230,180,.95);
      box-shadow: 0 0 5vmin rgba(255,140,40,.9), inset 0 0 5vmin rgba(255,140,40,.6);
      will-change: transform, opacity;
      animation: hwShock .9s cubic-bezier(.12,.7,.25,1) forwards;
    }
    .hw-rays {
      position: absolute; left: 50%; top: 50%; width: 260vmax; height: 260vmax; margin: -130vmax 0 0 -130vmax;
      background: repeating-conic-gradient(from 0deg, rgba(255,238,190,.95) 0 2.2deg, transparent 2.2deg 7deg);
      -webkit-mask-image: radial-gradient(circle, #000 0, rgba(0,0,0,.6) 14%, transparent 40%);
      mask-image: radial-gradient(circle, #000 0, rgba(0,0,0,.6) 14%, transparent 40%);
      mix-blend-mode: screen; will-change: transform, opacity;
      animation: hwRays 1.2s cubic-bezier(.08,.75,.25,1) forwards;
    }
    .hw-rays.two {
      background: repeating-conic-gradient(from 3deg, rgba(255,160,60,.9) 0 1.4deg, transparent 1.4deg 11deg);
      animation-name: hwRaysB; animation-duration: 1.5s;
    }
    @keyframes hwRays  { 0% { transform: scale(.04) rotate(0deg);   opacity: 1; } 100% { transform: scale(1) rotate(28deg);  opacity: 0; } }
    @keyframes hwRaysB { 0% { transform: scale(.04) rotate(0deg);   opacity: 1; } 100% { transform: scale(1) rotate(-22deg); opacity: 0; } }
    .hw-shock.two { animation-duration: 1.2s; animation-delay: .08s; opacity: 0; border-color: rgba(255,150,50,.85); }
    .hw-shock.three { animation-duration: 1.5s; animation-delay: .2s; opacity: 0; border-width: .5vmin; border-color: rgba(190,140,255,.8); box-shadow: 0 0 4vmin rgba(168,85,247,.8); }
    @keyframes hwShock { 0% { transform: scale(.1); opacity: 1; } 100% { transform: scale(14); opacity: 0; } }
    .hw-bat {
      display: block; fill: #170826; stroke: rgba(205,170,255,.55); stroke-width: .8;
      filter: drop-shadow(0 0 5px rgba(168,85,247,.9));
      transform-origin: 50% 40%; animation: hwFlap .2s ease-in-out infinite alternate;
    }
    @keyframes hwFlap { from { transform: scaleY(1); } to { transform: scaleY(.45); } }

    .hw-final { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 0 20px; }
    .hw-final-pumpkin {
      font-size: clamp(4.5rem, 16vw, 9rem); line-height: 1;
      filter: drop-shadow(0 0 28px rgba(255,117,24,.9));
      animation: hwBounce .9s cubic-bezier(.2,.9,.3,1.3) both;
    }
    .hw-final-text {
      display: flex; flex-wrap: wrap; justify-content: center;
      font-size: clamp(2.3rem, 9vw, 5.5rem); font-weight: 900; letter-spacing: -0.03em; color: #fff;
      text-shadow: 0 0 24px rgba(255,117,24,.9), 0 0 70px rgba(255,117,24,.6);
    }
    .hw-letter { display: inline-block; opacity: 0; animation: hwLetter .6s calc(.25s + var(--i) * 45ms) cubic-bezier(.2,.9,.3,1.3) forwards; }
    @keyframes hwLetter { from { opacity: 0; transform: translateY(46px) rotate(9deg) scale(.5); } to { opacity: 1; transform: none; } }
    @keyframes hwBounce { 0% { transform: scale(0) rotate(-25deg); } 60% { transform: scale(1.2) rotate(8deg); } 100% { transform: scale(1) rotate(0); } }
    .hw-flash { position: absolute; inset: 0; z-index: 2; pointer-events: none; opacity: 0; background: radial-gradient(circle at 50% 50%, #fff 0%, #fff 25%, #ffe0a0 55%, #ff9a3c 100%); }
    .hw-flash.soft { background: #a78bfa; }
    .hw-flash.soft.go { animation: hwFlashSoft .5s ease-out; }
    .hw-flash.big.go  { animation: hwFlashBig 1.15s ease-out; }
    @keyframes hwFlashSoft { 0% { opacity: 0; } 12% { opacity: .35; } 100% { opacity: 0; } }
    @keyframes hwFlashBig  { 0% { opacity: 0; } 4% { opacity: 1; } 34% { opacity: 1; } 100% { opacity: 0; } }

    #frHwFade { position: fixed; inset: 0; z-index: 100000; pointer-events: none; background: #0b0414; animation: hwFadeCycle 1.1s ease forwards; }
    @keyframes hwFadeCycle { 0% { opacity: 0; } 40%, 55% { opacity: 1; } 100% { opacity: 0; } }
    .hw-flyers { position: fixed; inset: 0; z-index: 100001; pointer-events: none; overflow: hidden; }
    .hw-fly  { position: absolute; left: 0; will-change: transform; animation: hwFly linear both; }
    .hw-rise { position: absolute; bottom: -12vh; will-change: transform; animation: hwRiseUp ease-in both; }
    @keyframes hwFly {
      from { transform: translate(var(--x0), 0); }
      50%  { transform: translate(calc((var(--x0) + var(--x1)) / 2), var(--wob)); }
      to   { transform: translate(var(--x1), 0); }
    }
    @keyframes hwRiseUp {
      0%   { transform: translate(0, 0) rotate(-8deg); opacity: 0; }
      15%  { opacity: 1; }
      50%  { transform: translate(var(--sway), -65vh) rotate(8deg); }
      100% { transform: translate(0, -125vh) rotate(-8deg); opacity: 0; }
    }

    body.hw-reveal .site-header { animation: hwHeaderIn 1.4s cubic-bezier(.2,.8,.2,1) both; }
    body.hw-reveal.halloween-theme.dark-mode::before { animation: hwFrameIn 2.2s ease both; }
    body.hw-reveal .blog-hero, body.hw-reveal .about-hero-band, body.hw-reveal .ui-hero { animation: hwBannerIn 1.2s ease both; }
    @keyframes hwHeaderIn { from { filter: brightness(2.6) saturate(1.7); } to { filter: none; } }
    @keyframes hwFrameIn  { from { transform: scale(1.14); filter: brightness(2); } to { transform: none; filter: none; } }
    @keyframes hwBannerIn { from { filter: brightness(2); } to { filter: none; } }
    body.reduce-motion #frHwOverlay, body.reduce-motion .hw-glow, body.reduce-motion .hw-ring circle,
    body.reduce-motion .hw-num, body.reduce-motion .hw-final-pumpkin, body.reduce-motion .hw-letter, body.reduce-motion .hw-hero { animation-duration: .01s !important; animation-delay: 0s !important; }

    /* Theme icon swap — show sun in light mode (default), moon in dark */
    .theme-icon-moon { display: none; }
    .theme-icon-sun { display: block; }
    body.dark-mode .theme-icon-sun { display: none; }
    body.dark-mode .theme-icon-moon { display: block; }

    /* ═══════════════════════════════
       COLOR THEME PANEL
    ═══════════════════════════════ */
    .color-panel-wrap {
      position: relative;
    }
    .color-panel-btn {
      background: rgba(255,255,255,0.15);
      border: 1px solid rgba(255,255,255,0.3);
      color: rgba(255,255,255,0.95);
      display: flex; align-items: center; justify-content: center;
      gap: 8px;
      height: 42px;
      padding: 0 18px;
      border-radius: 0;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      transition: background 0.2s, border-color 0.2s, transform 0.15s;
      flex-shrink: 0;
    }
    .color-panel-btn:hover {
      background: rgba(255,255,255,0.28);
      border-color: rgba(255,255,255,0.5);
      transform: translateY(-1px);
    }
    .color-panel-swatch {
      width: 14px; height: 14px; border-radius: 50%;
      background: var(--primary-color);
      border: 2px solid rgba(255,255,255,0.7);
      flex-shrink: 0;
    }
    .color-panel-dropdown {
      display: none;
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      box-shadow: 0 16px 40px rgba(0,0,0,0.18);
      padding: 16px;
      z-index: 9999;
      min-width: 220px;
    }
    .color-panel-dropdown.open { display: block; }
    .color-panel-title {
      font-size: 0.68rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted);
      margin-bottom: 12px;
    }
    .color-swatches {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .color-swatch-opt {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      padding: 8px 4px;
      border: 1.5px solid var(--border-color);
      background: var(--bg-secondary);
      cursor: pointer;
      transition: border-color 0.15s, transform 0.12s;
    }
    .color-swatch-opt:hover { transform: translateY(-2px); border-color: var(--text-muted); }
    .color-swatch-opt.active { border-color: var(--primary-color); }
    .color-swatch-opt .swatch-dot {
      width: 22px; height: 22px; border-radius: 50%;
    }
    .color-swatch-opt .swatch-label {
      font-size: 0.68rem;
      font-weight: 600;
      color: var(--text-secondary);
      text-align: center;
    }
    .color-panel-sep {
      height: 1px;
      background: var(--border-color);
      margin: 12px 0;
    }

    /* Dark mode browser mock */
    body.dark-mode .browser-mock {
      background: #111827;
      border: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 40px 100px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.04);
    }
    body.dark-mode .browser-content { background: #0d1117; }

    /* Dark mode counter */
    body.dark-mode .counter-section { background: var(--counter-bg); }
    body.dark-mode .counter-label-top { color: #94a3b8; }
    body.dark-mode .counter-label-bottom { color: #94a3b8; }
    body.dark-mode .counter-label-bottom strong { color: #f1f5f9; }
    body.dark-mode .counter-footnote { color: #374151; }

    /* Dark mode mobile menu */
    body.dark-mode .mobile-menu { background: rgba(0,0,0,0.97); }
    body.dark-mode .mobile-menu a { color: rgba(255,255,255,0.75); }
    body.dark-mode .mobile-menu-footer button {
      background: rgba(255,255,255,0.07);
      border-color: rgba(255,255,255,0.12);
      color: #fff;
    }
    body.dark-mode .hamburger span { background: #fff; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, var(--accent-bg-start) 0%, var(--accent-bg-mid) 50%, #f8fafc 100%);
      background-attachment: fixed;
      color: var(--text-primary);
      min-height: 100vh;
      overflow-x: clip;
      transition: background 0.35s ease, color 0.35s ease;
    }
    body.dark-mode {
      background: linear-gradient(135deg, #000000 0%, #0a0e1a 50%, #050810 100%);
    }

    /* ══════════════════════════════════════
       BLOG TABLE OF CONTENTS BAR
    ══════════════════════════════════════ */
    #blog-toc-bar {
      max-width: 860px;
      margin: 0 auto 32px;
      padding: 0 24px;
    }
    .blog-toc-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted);
      margin-bottom: 12px;
    }
    .blog-toc-items {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 0;
      overflow: hidden;
    }
    .blog-toc-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 20px;
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-primary);
      transition: background 0.15s, color 0.15s;
      text-decoration: none;
    }
    .blog-toc-item:hover {
      background: rgba(var(--primary-rgb),0.07);
      color: var(--primary-color);
    }
    .blog-toc-num {
      font-size: 0.75rem;
      font-weight: 800;
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
      min-width: 22px;
    }
    .blog-toc-badge {
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      padding: 2px 7px;
      border-radius: 0;
      flex-shrink: 0;
    }
    .blog-toc-badge-new    { background: rgba(var(--primary-rgb),0.15); color: var(--primary-color); }
    .blog-toc-badge-update { background: rgba(245,158,11,0.15);  color: #d97706; }
    .blog-toc-badge-dev    { background: rgba(139,92,246,0.15);  color: #7c3aed; }
    .blog-toc-date {
      margin-left: auto;
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--text-muted);
      white-space: nowrap;
    }
    .blog-toc-sep {
      height: 1px;
      background: var(--border-color);
      margin: 0 20px;
    }

    .blog-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
    @media (max-width: 1100px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 580px)  { .blog-grid { grid-template-columns: 1fr; } }

    /* Card dividers — between rows via CSS, not inside grid */
    .blog-grid-divider {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 4px 0;
      max-width: 860px;
      margin: 0 auto;
    }
    .blog-grid-divider-line { flex: 1; height: 1px; background: var(--border-color); }
    .blog-grid-divider-dot  { font-size: 0.6rem; color: var(--text-muted); opacity: 0.5; }

    /* ── Pinned card ── */
    .blog-card-pinned {
      border: 1.5px solid rgba(var(--primary-rgb), 0.35) !important;
      box-shadow: 0 0 0 3px rgba(var(--primary-rgb), 0.07), 0 4px 20px rgba(var(--primary-rgb), 0.10);
      position: relative;
    }
    .blog-pin-ribbon {
      position: absolute;
      top: 8px; left: 8px;
      z-index: 10;
      display: inline-flex; align-items: center; justify-content: center;
      width: 26px; height: 26px;
      background: rgba(var(--primary-rgb), 0.92);
      color: #fff;
      border-radius: 6px;
      pointer-events: none;
    }
    .blog-pinned-section {
      margin-bottom: 28px;
    }
    .blog-pinned-label {
      display: flex; align-items: center; gap: 8px;
      font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.1em; color: var(--text-muted);
      margin-bottom: 14px;
    }
    .blog-pinned-label svg { opacity: 0.6; }

    /* ── Pinned card ── */
    .blog-card-pinned {
      border: 1.5px solid rgba(var(--primary-rgb), 0.35) !important;
      box-shadow: 0 0 0 3px rgba(var(--primary-rgb), 0.07), 0 4px 20px rgba(var(--primary-rgb), 0.10);
      position: relative;
    }
    .blog-pin-ribbon {
      position: absolute;
      top: 8px; left: 8px;
      z-index: 10;
      display: inline-flex; align-items: center; justify-content: center;
      width: 26px; height: 26px;
      background: rgba(var(--primary-rgb), 0.92);
      color: #fff;
      border-radius: 6px;
      pointer-events: none;
    }
    .blog-pinned-section {
      margin-bottom: 28px;
    }
    .blog-pinned-label {
      display: flex; align-items: center; gap: 8px;
      font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.1em; color: var(--text-muted);
      margin-bottom: 14px;
    }
    .blog-pinned-label svg { opacity: 0.6; }

    /* Article in-page TOC */
    .article-toc-sidebar {
      width: 220px;
      flex-shrink: 0;
      position: sticky;
      top: 24px;
      align-self: flex-start;
    }
    #article-toc-widget {
      display: none;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 0;
      padding: 16px;
    }
    #article-toc-widget.visible { display: block; }
    .article-toc-title {
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      color: var(--text-muted);
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 7px;
    }
    .article-toc-link {
      display: flex;
      align-items: flex-start;
      gap: 9px;
      padding: 7px 8px;
      border-radius: 0;
      font-size: 0.83rem;
      font-weight: 500;
      color: var(--text-secondary);
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      border: none;
      background: none;
      width: 100%;
      text-align: left;
      font-family: 'Inter', sans-serif;
      line-height: 1.4;
    }
    .article-toc-link:hover { background: rgba(var(--primary-rgb),0.08); color: var(--primary-color); }
    .article-toc-link.active { background: rgba(var(--primary-rgb),0.1); color: var(--primary-color); font-weight: 600; }
    .article-toc-link::before {
      content: '—';
      font-size: 0.7rem;
      color: var(--text-muted);
      flex-shrink: 0;
      margin-top: 2px;
    }
    .article-toc-link.active::before { color: var(--primary-color); }

    /* Wrap article layout for side TOC */
    .article-layout-wrap {
      display: flex;
      gap: 32px;
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
      align-items: flex-start;
    }
    .article-toc-sidebar {
      width: 220px;
      flex-shrink: 0;
    }
    .article-main-col {
      flex: 1;
      min-width: 0;
    }
    @media (max-width: 900px) {
      .article-layout-wrap { flex-direction: column; }
      .article-toc-sidebar { width: 100%; position: static; }
      #article-toc-widget { position: static; }
    }

    /* ── LANGUAGE SELECTOR IN FOOTER ── */
    .lang-topbar {
      display: contents; /* dissolve wrapper — children render inline */
    }
    .lang-topbar-inner {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 4px;
    }
    .lang-topbar-label {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text-muted);
      letter-spacing: 0.01em;
      white-space: nowrap;
    }
    /* Footer lang pill — matches footer text style */
    .lang-topbar .lang-dropdown { position: relative; }
    .lang-topbar .lang-pill {
      padding: 4px 10px;
      height: 28px;
      font-size: 0.78rem;
      border-radius: 0;
      background: var(--bg-tertiary);
      border: 1px solid var(--border-color);
      color: var(--text-secondary);
    }
    .lang-topbar .lang-pill:hover {
      background: var(--bg-secondary);
      border-color: var(--primary-color);
      color: var(--primary-color);
    }
    .lang-topbar .lang-menu {
      bottom: calc(100% + 8px);
      top: auto;
      right: 0;
      left: auto;
      min-width: 190px;
    }

    /* ═══════════════════════════════
       ROGOLD HEADER
    ═══════════════════════════════ */
    .site-header {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 200;
      transition: transform 0.3s ease;
    }

    /* Row 1 — settings-style blue gradient with animated diagonal stripe */
    .nav-top {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 40px;
      height: 96px;
      background: linear-gradient(135deg, var(--accent-nav-from), var(--accent-nav-to));
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow:
        0 20px 25px -5px rgba(0,0,0,0.25),
        0 0 0 1px rgba(255,255,255,0.1) inset;
      position: relative;
      overflow: hidden;
    }

    /* Animated diagonal stripe pattern — identical to settings .header::before */
    .nav-top::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: repeating-linear-gradient(
        45deg,
        rgba(255,255,255,0.04) 0px,
        rgba(255,255,255,0.04) 10px,
        transparent 10px,
        transparent 20px
      );
      animation: navTopPattern 20s linear infinite;
      pointer-events: none;
      z-index: 0;
    }

    @keyframes navTopPattern {
      0%   { transform: translate(0, 0); }
      100% { transform: translate(40px, 40px); }
    }

    /* Keep all nav-top children above the pattern */
    .nav-top > * { position: relative; z-index: 1; }

    .logo {
      font-family: 'Inter', sans-serif;
      font-weight: 900;
      font-size: 1.25rem;
      letter-spacing: -0.03em;
      color: #fff;
      text-decoration: none;
      text-shadow: 0 1px 4px rgba(0,0,0,0.2);
    }

    /* ── LANGUAGE DROPDOWN ── */
    .lang-dropdown { position: relative; }
    .lang-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 0.82rem;
      font-weight: 600;
      color: rgba(255,255,255,0.9);
      cursor: pointer;
      padding: 6px 10px;
      border-radius: 0;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.2);
      transition: background 0.15s, border-color 0.15s;
      user-select: none;
    }
    .lang-pill:hover { background: rgba(255,255,255,0.22); border-color: rgba(255,255,255,0.35); color: #fff; }
    .lang-pill .lang-flag { font-size: 1rem; line-height: 1; }
    .lang-pill .lang-chevron { transition: transform 0.2s ease; opacity: 0.7; }
    .lang-dropdown.open .lang-chevron { transform: rotate(180deg); }
    .lang-menu {
      display: none;
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      min-width: 200px;
      background: #1e2a3a;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 0;
      box-shadow: 0 16px 48px rgba(0,0,0,0.45), 0 2px 8px rgba(0,0,0,0.25);
      overflow: hidden;
      z-index: 500;
      animation: langMenuIn 0.18s cubic-bezier(0.34,1.56,0.64,1) both;
    }
    body:not(.dark-mode) .lang-menu {
      background: #fff;
      border-color: #e2e8f0;
      box-shadow: 0 16px 48px rgba(var(--primary-rgb),0.12), 0 2px 8px rgba(0,0,0,0.08);
    }
    @keyframes langMenuIn {
      from { opacity: 0; transform: translateY(-8px) scale(0.97); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .lang-dropdown.open .lang-menu { display: block; }
    .lang-menu-item {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px; cursor: pointer;
      font-size: 0.85rem; font-weight: 500;
      color: rgba(255,255,255,0.75);
      transition: background 0.12s, color 0.12s;
      border: none; background: none; width: 100%;
      text-align: left; font-family: 'Inter', sans-serif;
    }
    body:not(.dark-mode) .lang-menu-item { color: #475569; }
    .lang-menu-item:hover { background: rgba(var(--primary-rgb),0.15); color: #fff; }
    body:not(.dark-mode) .lang-menu-item:hover { background: rgba(var(--primary-rgb),0.08); color: #1e293b; }
    .lang-menu-item.active { color: #fff; background: rgba(var(--primary-rgb),0.25); font-weight: 700; }
    body:not(.dark-mode) .lang-menu-item.active { color: var(--primary-color); background: rgba(var(--primary-rgb),0.1); }
    .lang-menu-item .li-flag { font-size: 1.1rem; line-height: 1; }
    .lang-menu-item .li-name { flex: 1; }
    .lang-menu-item .li-code { font-size: 0.72rem; opacity: 0.5; font-weight: 600; letter-spacing: 0.04em; }

    .nav-btn {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      font-family: 'Inter', sans-serif;
      font-weight: 700;
      font-size: 1.05rem;
      padding: 14px 32px;
      border-radius: 0;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.15s, opacity 0.15s;
      white-space: nowrap;
      background: rgba(255,255,255,0.15);
      color: #fff;
      border: 2px solid rgba(255,255,255,0.4);
    }

    .nav-btn:hover { background: rgba(255,255,255,0.25); }

    .nav-icon-btn {
      background: rgba(255,255,255,0.15);
      border: 1px solid rgba(255,255,255,0.3);
      color: rgba(255,255,255,0.95);
      display: flex; align-items: center; justify-content: center;
      gap: 8px;
      height: 42px;
      padding: 0 18px;
      border-radius: 0;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      transition: background 0.2s, border-color 0.2s, transform 0.15s;
      flex-shrink: 0;
    }
    .nav-icon-btn:hover {
      background: rgba(255,255,255,0.28);
      border-color: rgba(255,255,255,0.5);
      color: #fff;
      transform: translateY(-1px);
    }
    .nav-bottom {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      height: 96px;
      background: linear-gradient(135deg,
        rgba(var(--primary-rgb), 0.55),
        rgba(var(--primary-rgb), 0.38));
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 2px solid rgba(255,255,255,0.1);
      border-bottom: 1px solid rgba(0,0,0,0.15);
      box-shadow:
        0 8px 24px rgba(var(--primary-rgb), 0.15),
        0 0 0 1px rgba(255,255,255,0.06) inset,
        inset 0 1px 0 rgba(255,255,255,0.08);
      position: relative;
      overflow: hidden;
      flex-wrap: wrap;
      padding: 0 24px;
    }

    /* Animated diagonal stripe — subtle and contained */
    .nav-bottom::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: repeating-linear-gradient(
        45deg,
        rgba(255,255,255,0.015) 0px,
        rgba(255,255,255,0.015) 8px,
        transparent 8px,
        transparent 16px
      );
      animation: navBottomPattern 25s linear infinite reverse;
      pointer-events: none;
      z-index: 0;
    }

    @keyframes navBottomPattern {
      0%   { transform: translate(0, 0); }
      100% { transform: translate(40px, 40px); }
    }

    .nav-bottom > * { position: relative; z-index: 1; }

    .nav-bottom-link {
      color: rgba(255,255,255,0.75);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      white-space: nowrap;
      padding: 10px 20px;
      border-radius: 0;
      position: relative;
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      letter-spacing: -0.01em;
      display: flex;
      align-items: center;
      gap: 8px;
      border: 1px solid rgba(255,255,255,0.1);
      overflow: hidden;
    }

    .nav-bottom-link::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, transparent 100%);
      opacity: 0;
      transition: opacity 0.25s ease;
      pointer-events: none;
    }

    .nav-bottom-link:hover {
      color: #fff;
      background: rgba(255,255,255,0.15);
      border-color: rgba(255,255,255,0.25);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(var(--primary-rgb), 0.3), 0 0 1px rgba(255,255,255,0.3) inset;
    }

    .nav-bottom-link.nav-active {
      color: #fff;
      background: rgba(255,255,255,0.18);
      border-color: rgba(255,255,255,0.35);
      transform: translateY(-1px);
    }

    .nav-bottom-link.featured {
      color: #fff;
      background: linear-gradient(135deg, rgba(var(--primary-rgb), 0.4), rgba(var(--primary-rgb), 0.25));
      border: 1px solid rgba(255,255,255,0.4);
      font-weight: 700;
    }

    .nav-bottom-link.featured:hover {
      background: linear-gradient(135deg, rgba(var(--primary-rgb), 0.5), rgba(var(--primary-rgb), 0.35));
      border-color: rgba(255,255,255,0.5);
      box-shadow: 0 12px 28px rgba(var(--primary-rgb), 0.4), 0 0 1px rgba(255,255,255,0.4) inset;
      transform: translateY(-3px) scale(1.02);
    }

    /* Show icon spans */
    .nb-icon { 
      display: flex;
      align-items: center;
      justify-content: center;
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .nav-bottom-link:hover .nb-icon {
      transform: rotate(12deg) scale(1.1);
    }

    .nb-underline { display: none; }

    .scroll-indicator {
      position: absolute;
      bottom: 0; left: 0;
      height: 3px;
      width: 100%;
      background: linear-gradient(90deg, var(--accent-light), #ffffff80);
      transform-origin: left;
      transform: scaleX(0);
      z-index: 10;
      transition: transform 0.05s linear;
    }

    /* ═══════════════════════════════
       HERO
    ═══════════════════════════════ */
    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 232px 24px 0;
      text-align: center;
      background: transparent;
      position: relative;
      z-index: 1;
    }

    .hero h1 {
      font-size: 3.75rem;
      font-weight: 900;
      line-height: 1.06;
      letter-spacing: -0.035em;
      color: var(--text-primary);
      max-width: 900px;
      white-space: nowrap;
      animation: fadeUp 0.65s 0.1s ease both;
    }

    .hero h1 .blue {
      background: linear-gradient(90deg, var(--primary-color), var(--accent-light), var(--secondary-color), var(--primary-color));
      background-size: 300% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: gradientShift 4s linear infinite;
    }

    .hero-sub {
      margin-top: 20px;
      font-size: 1.05rem;
      color: var(--text-secondary);
      max-width: 520px;
      line-height: 1.65;
      font-weight: 400;
      animation: fadeUp 0.65s 0.2s ease both;
    }

    .hero-buttons {
      margin-top: 44px;
      display: flex;
      gap: 18px;
      animation: fadeUp 0.65s 0.3s ease both;
    }

    .btn-chrome-wrap {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      position: relative;
    }
    .btn-chrome {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
      color: #fff;
      border: none; border-radius: 0;
      padding: 20px 44px;
      font-size: 1.15rem; font-weight: 700;
      cursor: pointer; text-decoration: none;
      font-family: 'Inter', sans-serif;
      letter-spacing: -0.01em;
      box-shadow: 0 8px 32px rgba(249,115,22,0.45), 0 2px 8px rgba(0,0,0,0.2);
      transition: transform 0.2s, box-shadow 0.2s;
      position: relative; overflow: hidden;
      opacity: 1;
      pointer-events: auto;
    }
    .btn-chrome:hover { transform: translateY(-4px); box-shadow: 0 16px 48px rgba(249,115,22,0.6), 0 4px 12px rgba(0,0,0,0.25); }
    .btn-chrome:active { transform: translateY(-1px); }
    .btn-chrome::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 60%);
      opacity: 1;
    }

    .btn-other {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: linear-gradient(135deg, #64748b 0%, #475569 100%);
      color: #fff;
      border: none; border-radius: 0;
      padding: 20px 32px;
      font-size: 1.15rem; font-weight: 700;
      cursor: pointer; text-decoration: none;
      font-family: 'Inter', sans-serif;
      letter-spacing: -0.01em;
      box-shadow: 0 8px 32px rgba(71,85,105,0.4), 0 2px 8px rgba(0,0,0,0.2);
      transition: transform 0.2s, box-shadow 0.2s;
      position: relative;
      user-select: none;
    }
    .btn-other:hover { transform: translateY(-4px); box-shadow: 0 16px 48px rgba(71,85,105,0.55), 0 4px 12px rgba(0,0,0,0.25); }
    .btn-other:active { transform: translateY(-1px); }
    .btn-other:disabled, .btn-other:disabled:hover, .btn-other:disabled:active {
      opacity: .45; cursor: not-allowed; transform: none; filter: grayscale(.4);
      box-shadow: 0 4px 16px rgba(71,85,105,0.25);
    }
    .btn-other:disabled .btn-other-chevron { opacity: .5; }

    .btn-other-divider {
      width: 1px;
      height: 24px;
      background: rgba(255,255,255,0.25);
      flex-shrink: 0;
    }

    .btn-other-chevron {
      display: flex;
      align-items: center;
      padding: 4px 2px;
      opacity: 0.85;
      transition: opacity 0.15s;
    }
    .btn-other:hover .btn-other-chevron { opacity: 1; }

    /* Dropdown */
    .btn-other-wrap {
      position: relative;
      display: inline-block;
    }

    .btn-other-menu {
      display: none;
      position: absolute;
      top: calc(100% + 10px);
      left: 50%;
      transform: translateX(-50%);
      min-width: 220px;
      background: #1e2a3a;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 0;
      box-shadow: 0 16px 48px rgba(0,0,0,0.45);
      overflow: hidden;
      z-index: 500;
      animation: langMenuIn 0.18s cubic-bezier(0.34,1.56,0.64,1) both;
    }

    body:not(.dark-mode) .btn-other-menu {
      background: #fff;
      border-color: #e2e8f0;
      box-shadow: 0 16px 48px rgba(0,0,0,0.12);
    }

    .btn-other-wrap.open .btn-other-menu { display: block; }

    .btn-other-menu-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      font-size: 0.9rem;
      font-weight: 600;
      color: rgba(255,255,255,0.8);
      text-decoration: none;
      transition: background 0.12s, color 0.12s;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
    }
    body:not(.dark-mode) .btn-other-menu-item { color: #475569; }
    .btn-other-menu-item:hover { background: rgba(var(--primary-rgb),0.15); color: #fff; }
    body:not(.dark-mode) .btn-other-menu-item:hover { background: rgba(var(--primary-rgb),0.08); color: #1e293b; }
    .btn-other-menu-item img { width: 22px; height: 22px; object-fit: contain; flex-shrink: 0; }

    /* Mobile-only "Download for other browsers" CRX option */
    .btn-other-menu-item.mobile-only-crx { display: none; }
    @media (max-width: 768px) {
      .btn-other-menu-item.mobile-only-crx { display: flex; }
    }
    .btn-other-menu-item-disabled {
      opacity: 0.55;
      cursor: not-allowed;
      pointer-events: none;
    }
    .btn-menu-coming-soon {
      margin-left: auto;
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #94a3b8;
      background: rgba(148,163,184,0.12);
      border: 1px solid rgba(148,163,184,0.2);
      padding: 2px 7px;
    }

    .logo-img {
      height: 56px;
      width: auto;
      object-fit: contain;
      filter: drop-shadow(0 2px 8px rgba(0,0,0,0.25));
      display: block;
    }

    /* Pin right controls to the right edge without affecting centering */
    .nav-top-right {
      display: flex;
      align-items: center;
      gap: 10px;
      position: absolute;
      right: 40px;
    }

    .btn-icon {
      width: 26px !important;
      height: 26px !important;
      max-width: 26px !important;
      max-height: 26px !important;
      flex-shrink: 0;
      object-fit: contain;
      display: block;
    }

    /* Preview stage */
    .preview-stage {
      margin-top: 56px;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      padding: 0 0 0;
    }

    .side-panel { display: none; }

    .browser-content {
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #0d1117;
      overflow: hidden;
      position: relative;
    }
    .browser-content iframe {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      border: none;
      pointer-events: none;
    }

    .browser-mock-wrap {
      perspective: 800px;
      width: min(900px, 92vw);
      animation: fadeUp 0.8s 0.5s ease both, floatY 6s 1.5s ease-in-out infinite;
    }

    .browser-mock {
      width: 100%;
      flex-shrink: 0;
      background: #111827;
      border-radius: 0;
      border: 1px solid rgba(255,255,255,0.08);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: 0 40px 100px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.04);
      transform: rotateX(4deg) rotateY(-6deg) rotateZ(1deg);
      transform-style: preserve-3d;
      will-change: transform;
    }

    .preview-fade { display: none; }

    /* ═══════════════════════════════
       FEATURED CREATORS
    ═══════════════════════════════ */
    .creators-section {
      width: 100%;
      padding: 48px 0 40px;
      position: relative;
      z-index: 2;
      overflow: hidden;
    }

    .creators-label {
      text-align: center;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 28px;
      opacity: 0.7;
    }

    .creators-track-wrap {
      position: relative;
      overflow: hidden;
      width: 100%;
    }

    /* Fade edges */
    .creators-track-wrap::before,
    .creators-track-wrap::after {
      content: '';
      position: absolute;
      top: 0; bottom: 0;
      width: 160px;
      z-index: 2;
      pointer-events: none;
    }
    .creators-track-wrap::before {
      left: 0;
      background: linear-gradient(90deg, var(--accent-bg-start) 0%, transparent 100%);
    }
    .creators-track-wrap::after {
      right: 0;
      background: linear-gradient(270deg, var(--accent-bg-start) 0%, transparent 100%);
    }

    body.dark-mode .creators-track-wrap::before {
      background: linear-gradient(90deg, #000 0%, transparent 100%);
    }
    body.dark-mode .creators-track-wrap::after {
      background: linear-gradient(270deg, #000 0%, transparent 100%);
    }

    body.light-mode .creators-track-wrap::before {
      background: linear-gradient(90deg, var(--accent-bg-start) 0%, transparent 100%);
    }
    body.light-mode .creators-track-wrap::after {
      background: linear-gradient(270deg, var(--accent-bg-start) 0%, transparent 100%);
    }

    .creators-track {
      display: flex;
      gap: 20px;
      width: max-content;
      padding: 8px 0 16px;
      animation: creatorsScroll 35s linear infinite;
    }

    .creators-track:hover { animation-play-state: paused; }

    @keyframes creatorsScroll {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    .creator-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1);
      flex-shrink: 0;
      width: calc((100vw - 160px) / 8.5);
      max-width: 130px;
      min-width: 90px;
    }

    .creator-item:hover { transform: translateY(-8px) scale(1.06); }

    .creator-avatar {
      width: 100%;
      aspect-ratio: 1;
      border-radius: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.2rem;
      font-weight: 900;
      color: rgba(255,255,255,0.9);
      box-shadow: 0 8px 24px rgba(0,0,0,0.15);
      overflow: hidden;
      flex-shrink: 0;
      background: var(--bg-secondary);
      position: relative;
    }
    .creator-hover {
      position: absolute; inset: 0; z-index: 2;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
      padding: 6px; text-align: center; color: #fff;
      background: rgba(220, 38, 38, 0.86);
      opacity: 0; transition: opacity .2s ease; pointer-events: none;
    }
    .creator-hover b { font-size: clamp(1.1rem, 2.6vw, 1.7rem); font-weight: 900; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
    .creator-hover small { font-size: .62rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; opacity: .92; }
    .creator-item:hover .creator-hover, .creator-item:focus-within .creator-hover { opacity: 1; }

    body.dark-mode .creator-avatar {
      box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    }

    .creator-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .creator-item span {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text-secondary);
      white-space: nowrap;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 90px;
    }

    /* ═══════════════════════════════
       SECTION DIVIDER
    ═══════════════════════════════ */
    .section-divider {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      padding: 0 80px;
      position: relative;
      z-index: 2;
    }

    .divider-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg,
        transparent 0%,
        rgba(var(--primary-rgb), 0.25) 40%,
        rgba(var(--primary-rgb), 0.5) 100%
      );
    }

    .divider-line:last-child {
      background: linear-gradient(90deg,
        rgba(var(--primary-rgb), 0.5) 0%,
        rgba(var(--primary-rgb), 0.25) 60%,
        transparent 100%
      );
    }

    .divider-dot {
      width: 6px;
      height: 6px;
      border-radius: 0;
      background: rgba(var(--primary-rgb), 0.6);
      box-shadow: 0 0 8px rgba(var(--primary-rgb), 0.5);
      flex-shrink: 0;
    }

    /* ═══════════════════════════════
       COUNTER SECTION
    ═══════════════════════════════ */
    .counter-section {
      width: 100%;
      min-height: unset;
      background: transparent;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 80px 0 100px;
      position: relative;
      overflow: visible;
      z-index: 2;
    }

    .counter-section::before {
      content: '';
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 600px; height: 400px;
      background: radial-gradient(ellipse at center, rgba(var(--primary-rgb),0.07) 0%, transparent 70%);
      pointer-events: none;
    }

    .counter-label-top {
      font-size: 1.35rem;
      font-weight: 500;
      color: var(--text-secondary);
      margin-bottom: 28px;
      letter-spacing: -0.01em;
    }
    .counter-label-top .sibling {
      color: var(--primary-color);
      font-weight: 600;
      display: inline-block;
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .counter-number {
      font-size: clamp(5rem, 14vw, 10rem);
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1;
      margin-bottom: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: nowrap;
      gap: 0;
      max-width: 100%;
      overflow: visible;
      padding: 0 40px;
      filter: drop-shadow(0 0 20px rgba(var(--primary-rgb),0.2));
      animation: fadeUp 0.7s 0.1s ease both, counterGlow 3s ease-in-out infinite;
      transition: filter 1.2s ease;
    }

    /* Color tier CSS variables — JS sets these */
    .counter-number {
      --c1: var(--primary-color);
      --c2: var(--accent-light);
      --c3: var(--secondary-color);
      --glow: rgba(var(--primary-rgb),0.35);
    }

    .digit-slot {
      position: relative;
      overflow: hidden;
      height: 1.2em;
      display: inline-flex;
      align-items: flex-start;
      flex-shrink: 0;
    }

    .digit-reel {
      display: flex;
      flex-direction: column;
      transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }

    .digit-reel span {
      height: 1.2em;
      min-width: 0.6em;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, var(--c1) 0%, var(--c2) 40%, var(--c3) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-variant-numeric: tabular-nums;
      transition: background 1.2s ease;
    }

    .digit-sep {
      background: linear-gradient(135deg, var(--c1) 0%, var(--c2) 40%, var(--c3) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.1em;
      display: inline-flex;
      align-items: center;
    }

    /* Shockwave burst ring — fires on big jump */
    .counter-shockwave {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%) scale(0);
      width: 200px; height: 200px;
      border-radius: 50%;
      border: 3px solid var(--glow, rgba(var(--primary-rgb),0.6));
      pointer-events: none;
      opacity: 0;
    }
    .counter-shockwave.fire {
      animation: shockwavePulse 0.9s cubic-bezier(0.22,1,0.36,1) forwards;
    }
    @keyframes shockwavePulse {
      0%   { transform: translate(-50%,-50%) scale(0.2); opacity: 0.9; }
      100% { transform: translate(-50%,-50%) scale(4);   opacity: 0; }
    }

    /* Milestone burst particles */
    .counter-particle {
      position: absolute;
      width: 6px; height: 6px;
      border-radius: 0;
      pointer-events: none;
      animation: counterParticle 1.2s cubic-bezier(0.22,1,0.36,1) forwards;
    }
    @keyframes counterParticle {
      0%   { opacity: 1; transform: translate(0,0) scale(1) rotate(0deg); }
      100% { opacity: 0; transform: var(--tx, translate(80px,-120px)) scale(0.3) rotate(360deg); }
    }

    /* Color tier transitions on label texts */
    .counter-label-top,
    .counter-label-bottom,
    .counter-label-bottom strong {
      transition: color 1.2s ease;
    }

    .counter-label-bottom {
      font-size: 1.05rem;
      font-weight: 400;
      color: var(--text-secondary);
      letter-spacing: -0.01em;
    }
    .counter-label-bottom strong { color: var(--text-primary); font-weight: 600; }

    .counter-footnote {
      position: absolute;
      bottom: 32px;
      font-size: 0.75rem;
      color: var(--border-color);
      letter-spacing: 0.02em;
    }

    .counter-reveal {
      opacity: 0;
      transform: translateY(60px);
      transition: opacity 0.8s cubic-bezier(0.16,1,0.3,1), transform 0.8s cubic-bezier(0.16,1,0.3,1);
    }
    .counter-reveal.visible { opacity: 1; transform: translateY(0); }
    .counter-reveal.delay-1 { transition-delay: 0.15s; }
    .counter-reveal.delay-2 { transition-delay: 0.3s; }

    @keyframes digitFlash { 0%{opacity:1;} 20%{opacity:0.5;} 100%{opacity:1;} }
    .digit-slot.changed .digit-reel { animation: digitFlash 0.4s ease; }

    .nav-bottom a.nav-active { color: #fff; }
    .page { display: none; }
    .page.active { display: block; }

    /* Standalone /removalcount route */
    html.removal-count-route,
    html.removal-count-route body {
      min-height: 100%;
      background: #050b16;
    }
    html.removal-count-route body {
      color: #f8fafc;
      overflow: hidden;
    }
    html.removal-count-route body > *:not(#removal-count-page) {
      display: none !important;
    }
    #removal-count-page {
      display: none;
    }
    html.removal-count-route #removal-count-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      position: relative;
      overflow: hidden;
      font-family: 'Inter', sans-serif;
      background:
        radial-gradient(circle at 50% 42%, rgba(33,150,243,.16), transparent 34rem),
        linear-gradient(145deg, #071426 0%, #050b16 52%, #02050b 100%);
    }
    .removal-count-glow {
      position: absolute;
      width: min(72vw, 720px);
      aspect-ratio: 1;
      border: 1px solid rgba(66,165,245,.13);
      border-radius: 50%;
      box-shadow: 0 0 100px rgba(33,150,243,.12), inset 0 0 80px rgba(33,150,243,.05);
      pointer-events: none;
    }
    .removal-count-card {
      position: relative;
      z-index: 1;
      width: min(100%, 920px);
      text-align: center;
    }
    .removal-count-kicker {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: #8abff0;
      font-size: .74rem;
      font-weight: 800;
      letter-spacing: .18em;
      text-transform: uppercase;
      margin-bottom: 28px;
    }
    .removal-count-kicker::before {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #36d399;
      box-shadow: 0 0 14px #36d399;
      animation: removalCountPulse 1.5s ease-in-out infinite;
    }
    .removal-count-number {
      margin: 0;
      color: #fff;
      font-size: clamp(4rem, 15vw, 11rem);
      line-height: .92;
      letter-spacing: -.075em;
      font-weight: 900;
      font-variant-numeric: tabular-nums;
      text-shadow: 0 0 38px rgba(66,165,245,.32);
      transition: opacity .25s ease, transform .25s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 1em;
    }
    .removal-count-number.is-updating {
      opacity: .55;
      transform: scale(.985);
    }
    .removal-count-digit {
      position: relative;
      display: inline-flex;
      align-items: flex-start;
      height: 1.2em;
      overflow: hidden;
      flex: 0 0 .6em;
      background: transparent !important;
    }
    .removal-count-digit-reel {
      display: flex;
      flex-direction: column;
      transform: translateY(0);
      transition: transform .55s cubic-bezier(.22,1,.36,1);
      will-change: transform;
      background: transparent !important;
    }
    .removal-count-digit-reel span {
      display: block;
      height: 1.2em;
      min-width: .6em;
      line-height: 1.2em;
      text-align: center;
      background: transparent !important;
    }
    .removal-count-separator {
      display: inline-block;
      height: 1em;
      line-height: 1em;
      width: .34em;
      flex: 0 0 .34em;
      margin: 0 .015em;
      background: transparent !important;
    }
    .removal-count-number.count-bump {
      animation: removalCountBump .65s cubic-bezier(.22,1,.36,1);
    }
    @keyframes removalCountBump {
      0% { filter: drop-shadow(0 0 0 rgba(240,74,61,0)); }
      35% { filter: drop-shadow(0 0 24px rgba(240,74,61,.5)); transform: scale(1.025); }
      100% { filter: drop-shadow(0 0 0 rgba(240,74,61,0)); transform: scale(1); }
    }
    @keyframes removalCountParticle {
      to { opacity: 0; transform: translate(var(--tx),var(--ty)) scale(.25) rotate(180deg); }
    }
    .removal-count-label {
      margin-top: 30px;
      color: #d7e7f8;
      font-size: clamp(1rem, 2.5vw, 1.35rem);
      font-weight: 500;
    }
    .removal-count-label strong { color: #42a5f5; }
    .removal-count-meta {
      min-height: 20px;
      margin-top: 18px;
      color: #6f8aa8;
      font-size: .78rem;
    }
    .removal-count-recent {
      width: min(100%, 720px);
      margin: 46px auto 0;
      padding-top: 26px;
      border-top: 1px solid rgba(138,191,240,.16);
    }
    .removal-count-recent-title {
      color: #8abff0;
      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .16em;
      text-transform: uppercase;
      margin-bottom: 16px;
    }
    .removal-count-removers {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    .removal-count-remover {
      min-width: 0;
      padding: 14px 10px 13px;
      border: 1px solid rgba(138,191,240,.14);
      background: rgba(13,31,53,.58);
      border-radius: 14px;
    }
    .removal-count-remover.remover-new {
      animation: removalCountRemoverIn .7s cubic-bezier(.22,1,.36,1) both;
    }
    @keyframes removalCountRemoverIn {
      0% {
        opacity: 0;
        transform: translateY(18px) scale(.94);
        box-shadow: 0 0 0 rgba(240,90,55,0);
      }
      55% {
        opacity: 1;
        transform: translateY(-3px) scale(1.015);
        box-shadow: 0 10px 28px rgba(240,90,55,.2);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
        box-shadow: 0 9px 24px rgba(63,35,38,.08);
      }
    }
    .removal-count-remover-avatar {
      width: 58px;
      height: 58px;
      margin: 0 auto 9px;
      border-radius: 50%;
      object-fit: cover;
      display: block;
      background: linear-gradient(135deg,#1d4ed8,#38bdf8);
      border: 2px solid rgba(138,191,240,.42);
    }
    .removal-count-remover-name {
      overflow: hidden;
      color: #e5f1fc;
      font-size: .78rem;
      font-weight: 700;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .removal-count-remover-count {
      margin-top: 5px;
      color: #76baf0;
      font-size: .72rem;
    }
    .removal-count-brand {
      position: fixed;
      bottom: 22px;
      left: 0;
      right: 0;
      text-align: center;
      color: #49627d;
      font-size: .7rem;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    @keyframes removalCountPulse {
      0%, 100% { opacity: .45; transform: scale(.8); }
      50% { opacity: 1; transform: scale(1.15); }
    }
    @media (max-width: 560px) {
      html.removal-count-route #removal-count-page { padding: 18px; }
      .removal-count-label { margin-top: 22px; }
      .removal-count-recent { margin-top: 34px; }
      .removal-count-removers { gap: 7px; }
      .removal-count-remover { padding-left: 5px; padding-right: 5px; }
      .removal-count-remover-avatar { width: 48px; height: 48px; }
      .removal-count-remover-name { font-size: .68rem; }
      .removal-count-remover-count { font-size: .64rem; }
    }
    /* Match the public Friends Remover website on the standalone route. */
    html.removal-count-route,
    html.removal-count-route body {
      background: #fff7f7;
    }
    html.removal-count-route #removal-count-page {
      display: block;
      min-height: 100vh;
      padding: 0 0 56px;
      overflow: hidden auto;
      background:
        radial-gradient(circle at 50% 32%, rgba(255,255,255,.94), transparent 34rem),
        linear-gradient(180deg, #fff3f3 0%, #fffafa 42%, #fff 100%);
      color: #1d2940;
    }
    .removal-count-site-header {
      min-height: 96px;
      padding: 18px 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      background:
        repeating-linear-gradient(135deg, rgba(255,255,255,.045) 0 3px, transparent 3px 14px),
        linear-gradient(135deg, #df1017, #f1262d 55%, #d80d17);
      box-shadow: 0 10px 28px rgba(214,24,31,.2);
    }
    .removal-count-site-logo {
      width: min(330px, 62vw);
      max-height: 62px;
      object-fit: contain;
      display: block;
    }
    .removal-count-site-actions {
      position: absolute;
      right: 32px;
      display: flex;
      gap: 10px;
    }
    .removal-count-site-actions a {
      padding: 10px 16px;
      color: #fff;
      border: 1px solid rgba(255,255,255,.38);
      background: rgba(255,255,255,.08);
      font-size: .78rem;
      font-weight: 700;
      text-decoration: none;
    }
    .removal-count-site-actions a:hover { background: rgba(255,255,255,.2); }
    .removal-count-content {
      width: min(100% - 40px, 980px);
      margin: 0 auto;
      padding: 82px 0 0;
      text-align: center;
    }
    .removal-count-kicker {
      color: #f05a37;
      font-size: .72rem;
      letter-spacing: .15em;
      margin-bottom: 22px;
    }
    .removal-count-kicker::before {
      background: #f05a37;
      box-shadow: 0 0 12px rgba(240,90,55,.5);
    }
    .removal-count-number {
      color: #1d2940;
      font-size: clamp(4.5rem, 14vw, 10rem);
      letter-spacing: -.07em;
      text-shadow: 0 8px 22px rgba(29,41,64,.12);
    }
    .removal-count-label {
      color: #64748b;
      font-size: clamp(1rem, 2.5vw, 1.3rem);
    }
    .removal-count-label strong { color: #f04a3d; }
    .removal-count-meta { color: #94a3b8; }
    .removal-count-recent {
      border-top-color: rgba(29,41,64,.12);
      margin-top: 50px;
      padding-top: 28px;
    }
    .removal-count-recent-title {
      color: #64748b;
      letter-spacing: .13em;
    }
    .removal-count-remover {
      background: rgba(255,255,255,.8);
      border: 1px solid #f0dfe0;
      border-radius: 0;
      box-shadow: 0 9px 24px rgba(63,35,38,.08);
    }
    .removal-count-remover-avatar {
      border-color: #f7a49b;
    }
    .removal-count-remover-name { color: #1d2940; }
    .removal-count-remover-count { color: #f05a37; font-weight: 700; }
    .removal-count-brand {
      color: #a7aebb;
      letter-spacing: .13em;
    }
    @media (max-width: 700px) {
      .removal-count-site-header { min-height: 72px; padding: 12px 18px; }
      .removal-count-site-actions { display: none; }
      .removal-count-content { padding-top: 58px; }
    }

    /* Dedicated 9:16 browser source for OBS/TikTok streaming. */
    html.stream-route,
    html.stream-route body {
      width: 100%;
      min-height: 100%;
      margin: 0;
      background: #090d16;
    }
    html.stream-route body {
      overflow: hidden;
    }
    html.stream-route body > *:not(#stream-page) {
      display: none !important;
    }
    #stream-page {
      display: none;
    }
    html.stream-route #stream-page {
      width: 100vw;
      height: 100vh;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(ellipse at center, rgba(239,68,68,.1), transparent 52%),
        #ffffff;
    }
    html.stream-route .stream-backdrop {
      background:
        radial-gradient(circle at 50% 20%, rgba(239,68,68,.14), transparent 45%),
        #ffffff;
      filter: none;
      opacity: 1;
    }
    html.stream-route .stream-frame {
      display: none;
    }
    html.stream-route .stream-counter {
      display: block;
      width: min(92vw, 520px);
      padding: 34px 20px 28px;
      text-align: center;
      color: #172033;
    }
    html.stream-route .stream-counter .removal-count-number {
      color: #d71920;
      font-size: clamp(3.8rem, 18vw, 7rem);
      text-shadow: 0 8px 24px rgba(215,25,32,.2);
      column-gap: 0;
      white-space: nowrap;
      letter-spacing: -.035em;
    }
    html.stream-route .stream-counter .removal-count-label {
      color: #58657a;
      margin-top: 20px;
      font-size: 1rem;
    }
    html.stream-route .stream-counter .removal-count-label strong { color: #e12b31; }
    html.stream-route .stream-counter .removal-count-meta {
      color: #9aa3b2;
      margin-top: 12px;
    }
    html.stream-route .stream-counter .removal-count-recent {
      margin-top: 32px;
      padding-top: 22px;
      border-top-color: rgba(215,25,32,.18);
    }
    html.stream-route .stream-counter .removal-count-recent-title { color: #c51d25; }
    html.stream-route .stream-counter .removal-count-removers { gap: 8px; }
    html.stream-route .stream-counter .removal-count-remover {
      padding: 12px 6px;
      border-radius: 0;
      background: rgba(255,255,255,.9);
      border-color: rgba(215,25,32,.2);
      box-shadow: 0 8px 20px rgba(89,22,25,.1);
    }
    html.stream-route .stream-counter .removal-count-remover-avatar {
      width: 48px;
      height: 48px;
      border-color: rgba(215,25,32,.45);
    }
    html.stream-route .stream-counter .removal-count-remover-name {
      color: #172033;
      font-size: .7rem;
    }
    html.stream-route .stream-counter .removal-count-remover-count {
      color: #d71920;
      font-size: .62rem;
    }
    html.stream-route .stream-quality {
      color: rgba(180,25,32,.65);
    }
    html.stream-route #stream-page,
    html.stream-route #stream-page *,
    html.removal-count-route #removal-count-page,
    html.removal-count-route #removal-count-page * {
      border-radius: 0 !important;
    }
    .stream-stage {
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      isolation: isolate;
    }
    .stream-backdrop {
      position: absolute;
      inset: -8%;
      z-index: -1;
      background:
        linear-gradient(rgba(9,13,22,.74), rgba(9,13,22,.74)),
        url('https://vumbnail.com/1173410257.jpg') center / cover no-repeat;
      filter: blur(28px) saturate(.75);
      transform: scale(1.12);
      opacity: .75;
    }
    .stream-frame {
      width: min(100vw, 177.7778vh);
      aspect-ratio: 16 / 9;
      max-height: 100vh;
      position: relative;
      overflow: hidden;
      background: #0d1117;
      box-shadow: 0 24px 80px rgba(0,0,0,.4);
    }
    .stream-frame iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }
    .stream-brand {
      position: absolute;
      left: 50%;
      bottom: 22px;
      transform: translateX(-50%);
      width: min(210px, 42vw);
      opacity: .82;
      pointer-events: none;
    }
    .stream-quality {
      position: absolute;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);
      color: rgba(255,255,255,.6);
      font: 700 10px/1 Inter, sans-serif;
      letter-spacing: .16em;
      text-transform: uppercase;
      pointer-events: none;
    }
    @media (max-aspect-ratio: 9/16) {
      .stream-frame { width: 100vw; height: auto; }
    }

    /* ═══════════════════════════════
       ABOUT SECTION
    ═══════════════════════════════ */
    /* ═══ ABOUT — Rotector-style layout ═══ */

    /* Hero band — full-width gradient like blog, sits at top of page */
    .about-hero-band {
      padding: calc(96px + 80px) 24px 72px;
      background: linear-gradient(135deg, var(--accent-nav-from), var(--accent-nav-to));
      box-shadow: 0 20px 25px -5px rgba(0,0,0,0.25), 0 0 0 1px rgba(255,255,255,0.1) inset;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      position: relative;
      overflow: hidden;
      width: 100%;
    }

    .about-hero-band::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: repeating-linear-gradient(
        45deg,
        rgba(255,255,255,0.04) 0px,
        rgba(255,255,255,0.04) 10px,
        transparent 10px,
        transparent 20px
      );
      animation: navTopPattern 20s linear infinite;
      pointer-events: none;
      z-index: 0;
    }

    .about-hero-band h1 {
      font-size: clamp(2rem, 5vw, 3.2rem);
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1.1;
      color: #fff;
      margin: 0 0 20px;
      position: relative;
      z-index: 1;
      text-shadow: 0 2px 20px rgba(0,0,0,0.2);
    }

    .about-hero-band h1 .brand {
      opacity: 0.85;
    }

    .about-hero-band p {
      font-size: 1.05rem;
      line-height: 1.75;
      color: rgba(255,255,255,0.75);
      max-width: 560px;
      margin: 0;
      position: relative;
      z-index: 1;
    }

    .about-section {
      background: var(--bg-body, transparent);
      padding: 88px 24px 120px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* Story content column */
    .about-inner {
      max-width: 680px;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .about-eyebrow { display: none; }

    .about-title { display: none; }

    .about-story-label {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 8px;
    }

    .about-story-label span {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-secondary);
      white-space: nowrap;
    }

    .story-line {
      flex: 1;
      height: 1px;
      background: var(--border-color);
    }

    .about-story-sub {
      font-size: clamp(1.25rem, 2.5vw, 1.6rem);
      font-weight: 800;
      color: var(--text-primary);
      margin-bottom: 48px;
      letter-spacing: -0.02em;
      line-height: 1.25;
    }

    /* Story paragraphs with left border like Rotector */
    .about-paragraphs {
      display: flex;
      flex-direction: column;
      gap: 24px;
      border-left: 3px solid var(--primary-color);
      padding-left: 28px;
    }

    .about-paragraphs p {
      font-size: 1.05rem;
      line-height: 1.82;
      color: var(--text-secondary);
    }

    .about-paragraphs em {
      color: var(--text-primary);
      font-style: italic;
    }

    .about-highlight {
      margin-top: 12px;
      background: rgba(var(--primary-rgb),0.07);
      border-left: none;
      padding: 18px 22px;
      border-radius: 6px;
      color: var(--text-primary) !important;
      font-weight: 600;
      font-size: 1.02rem;
    }

    .about-highlight strong {
      color: var(--primary-color);
    }

    .about-quote {
      margin-top: 48px;
      padding: 28px 32px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-left: 3px solid var(--primary-color);
      border-radius: 0;
      font-size: 1.05rem !important;
      font-style: italic;
      color: var(--text-primary) !important;
      line-height: 1.7;
      text-align: left;
    }

    .about-author {
      margin-top: 48px;
    }

    .about-author-divider {
      height: 1px;
      background: var(--border-color);
      margin-bottom: 28px;
    }

    .about-author-card {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .about-author-avatar {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      border: 2px solid var(--primary-color);
      background: rgba(var(--primary-rgb), 0.12);
      color: var(--primary-color);
      font-size: 1.2rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .about-author-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }

    .about-author-info {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .about-author-name {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-primary);
    }

    .about-author-role {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--primary-color);
    }

    /* ═══════════════════════════════
       STAFF & JOBS PAGES
    ═══════════════════════════════ */
    .staff-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
      justify-content: center;
      margin-top: 48px;
    }

    .staff-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 0;
      padding: 40px 32px;
      text-align: center;
      width: 220px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.07);
      transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.25s;
    }

    .staff-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 16px 40px rgba(var(--primary-rgb),0.15);
    }

    .staff-avatar {
      font-size: 3rem;
      margin-bottom: 16px;
    }

    .staff-name {
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--text-primary);
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }

    .staff-role {
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--primary-color);
      background: rgba(var(--primary-rgb),0.1);
      padding: 4px 12px;
      border-radius: 0;
      display: inline-block;
    }

    .jobs-empty {
      text-align: center;
      padding: 80px 24px;
    }

    .jobs-empty-icon {
      font-size: 4rem;
      margin-bottom: 20px;
    }

    .jobs-empty-title {
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--text-primary);
      margin-bottom: 10px;
      letter-spacing: -0.02em;
    }

    .jobs-empty-sub {
      font-size: 1rem;
      color: var(--text-secondary);
      max-width: 400px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* ═══════════════════════════════
       FOOTER
    ═══════════════════════════════ */
    footer {
      background: var(--footer-bg);
      border-top: 1px solid var(--border-color);
      padding: 0;
    }
    .footer-main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 56px 48px 48px;
      display: grid;
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
      gap: 40px;
    }
    .footer-brand {}
    .footer-brand-logo {
      display: flex; align-items: center; gap: 10px;
      margin-bottom: 14px;
    }
    .footer-brand-logo img { height: 32px; width: auto; object-fit: contain; opacity: 0.85; }
    .footer-brand-desc {
      font-size: 0.82rem;
      color: var(--text-secondary);
      line-height: 1.6;
      margin-bottom: 16px;
      max-width: 240px;
    }
    .footer-brand-email {
      font-size: 0.82rem;
      color: var(--text-secondary);
      text-decoration: none;
      margin-bottom: 18px;
      display: block;
    }
    .footer-brand-email:hover { color: var(--text-primary); }
    .footer-social { display: flex; gap: 12px; margin-top: 6px; }
    .footer-social a {
      display: flex; align-items: center; justify-content: center;
      width: 34px; height: 34px; border-radius: 0;
      background: var(--bg-tertiary);
      border: 1px solid var(--border-color);
      color: var(--text-secondary);
      text-decoration: none;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .footer-social a:hover { background: var(--primary-color); color: #fff; border-color: var(--primary-color); }
    .footer-col-title {
      font-size: 0.8rem;
      font-weight: 800;
      color: var(--text-primary);
      margin-bottom: 16px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .footer-col-links { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .footer-col-links a {
      font-size: 0.83rem;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      transition: color 0.15s;
    }
    .footer-col-links a:hover { color: var(--text-primary); }
    .footer-bottom {
      border-top: 1px solid var(--border-color);
      padding: 18px 48px;
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .footer-copy {
      font-size: 0.76rem;
      color: var(--text-muted);
    }
    @media (max-width: 860px) {
      .footer-main { grid-template-columns: 1fr 1fr; padding: 40px 24px 32px; }
      .footer-bottom { padding: 16px 24px; }
    }
    @media (max-width: 520px) {
      .footer-main { grid-template-columns: 1fr; padding: 36px 20px 28px; }
    }

    .footer-cols-mobile { display: none; }
    .footer-lang-mobile { display: none; }

    /* ── Mobile footer complete redesign ── */
    @media (max-width: 768px) {
      footer { padding-bottom: 96px; } /* clear tab bar */

      .footer-main {
        display: flex;
        flex-direction: column;
        gap: 0;
        padding: 32px 20px 0;
      }

      /* Brand block — centered, compact */
      .footer-brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 24px;
      }
      .footer-brand-logo { justify-content: center; margin-bottom: 10px; }
      .footer-brand-desc { max-width: 100%; font-size: 0.8rem; margin-bottom: 10px; }
      .footer-brand-email { margin-bottom: 12px; }
      .footer-social { justify-content: center; }

      /* Links section — 2-col grid of all cols merged */
      .footer-cols-mobile {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px 20px;
        margin-bottom: 24px;
      }
      /* Hide original col wrappers on mobile */
      .footer-col { display: none; }

      .footer-col-title {
        font-size: 0.72rem;
        margin-bottom: 10px;
        letter-spacing: 0.08em;
      }
      .footer-col-links { gap: 8px; }
      .footer-col-links a { font-size: 0.82rem; }

      /* Lang selector — full width pill */
      .footer-lang-mobile {
        padding: 16px 0;
        border-top: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0;
      }
      .footer-lang-mobile .lang-topbar-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text-secondary);
      }
      .footer-lang-mobile .lang-pill {
        background: var(--bg-tertiary);
        border-color: var(--border-color);
        color: var(--text-secondary);
        border-radius: 0;
        font-size: 0.82rem;
      }
      /* Hide the lang block inside Resources col (already shown in mobile block) */
      .footer-col .lang-topbar { display: none; }

      .footer-bottom {
        padding: 14px 20px;
        border-top: none;
        justify-content: flex-start;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
      }
      .footer-cols-mobile { display: grid; }
      .footer-lang-mobile { display: flex; }
      .footer-copy { font-size: 0.72rem; text-align: center; padding: 14px 0 0; }
    }

    /* ═══════════════════════════════
       LIVE CHAT PANEL
    ═══════════════════════════════ */

    /* ── Chat color tokens (light mode = white, dark mode = dark) ── */
    :root {
      --ck-bg:           #ffffff;
      --ck-header-bg:    #1e293b;
      --ck-header2-bg:   #f1f5f9;
      --ck-msg-bg:       #f1f5f9;
      --ck-bot-bubble:   #ffffff;
      --ck-agent-bubble: #f0fdf4;
      --ck-agent-border: rgba(34,197,94,0.25);
      --ck-user-text:    #1e293b;
      --ck-input-bg:     #ffffff;
      --ck-input-border: #d1d5db;
      --ck-row-bg:       #f8fafc;
      --ck-row-border:   #e5e7eb;
      --ck-text:         #111827;
      --ck-text-sub:     #6b7280;
      --ck-text-muted:   #9ca3af;
      --ck-blue:         #2563eb;
      --ck-online:       #22c55e;
      --ck-shadow:       0 8px 40px rgba(0,0,0,0.15), 0 2px 8px rgba(0,0,0,0.07);
      --ck-radius:       0px;
      --ck-header-text:  #ffffff;
      --ck-header-sub:   rgba(255,255,255,0.55);
      --ck-gear-bg:      rgba(255,255,255,0.12);
      --ck-msg-input-bg: #ffffff;
      --ck-msg-input-border: #e5e7eb;
      --ck-reply-bar-bg: rgba(37,99,235,0.06);
      --ck-reply-bar-border: rgba(37,99,235,0.15);
      --ck-typing-dot:   #9ca3af;
    }
    body.dark-mode {
      --ck-bg:           #1e2029;
      --ck-header-bg:    #0f1117;
      --ck-header2-bg:   #1a1d26;
      --ck-msg-bg:       #1a1d26;
      --ck-bot-bubble:   #2a2d3a;
      --ck-agent-bubble: #1a2e1a;
      --ck-agent-border: rgba(34,197,94,0.18);
      --ck-user-text:    #e2e8f0;
      --ck-input-bg:     #1e2029;
      --ck-input-border: #2e3140;
      --ck-row-bg:       #1a1d26;
      --ck-row-border:   #2e3140;
      --ck-text:         #f1f5f9;
      --ck-text-sub:     #94a3b8;
      --ck-text-muted:   #4b5563;
      --ck-blue:         #4b9eff;
      --ck-online:       #22c55e;
      --ck-shadow:       0 8px 40px rgba(0,0,0,0.6), 0 2px 8px rgba(0,0,0,0.35);
      --ck-gear-bg:      rgba(255,255,255,0.08);
      --ck-msg-input-bg: #1e2029;
      --ck-msg-input-border: #2e3140;
      --ck-reply-bar-bg: rgba(75,158,255,0.07);
      --ck-reply-bar-border: rgba(75,158,255,0.15);
      --ck-typing-dot:   rgba(255,255,255,0.35);
    }

    .fr-chat-wrap { display: none; }

    /* ── Launcher ── */
    #fr-global-chat-wrap {
      position: fixed; bottom: 24px; right: 24px;
      z-index: 400; display: flex; flex-direction: column; align-items: flex-end;
    }
    @media (max-width: 768px) {
      .fr-chat-launcher { display: none !important; }
      #fr-global-chat-wrap {
        top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important;
        width: 100% !important; height: 100% !important;
        position: fixed !important;
        z-index: 999 !important;
        pointer-events: none;
        align-items: stretch !important;
        justify-content: flex-end;
      }
      .fr-chat-panel-wrap {
        position: static !important;
        width: 100% !important;
        height: 100% !important;
        pointer-events: none;
      }
      .fr-chat-card {
        position: static !important;
        width: 100% !important;
        height: 100% !important;
        max-height: 100% !important;
        min-height: 100% !important;
        border-radius: 0;
        pointer-events: none;
        transform-origin: center bottom;
      }
      .fr-chat-card:not(.hidden) {
        pointer-events: auto !important;
      }
      #fr-global-chat-wrap:has(.fr-chat-card:not(.hidden)) {
        pointer-events: auto !important;
      }
    }
    .fr-chat-launcher {
      width: 54px; height: 54px; border-radius: 0;
      background: #23262f; border: none; cursor: pointer; color: #fff;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 18px rgba(0,0,0,0.35);
      transition: transform 0.2s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.2s;
      position: relative; flex-shrink: 0;
    }
    .fr-chat-launcher:hover { transform: scale(1.08); box-shadow: 0 6px 24px rgba(0,0,0,0.4); }
    .fr-chat-launcher .fr-launcher-icon { transition: opacity 0.18s, transform 0.18s; }
    .fr-chat-launcher.open .fr-launcher-icon-chat { opacity: 0; transform: scale(0.5) rotate(90deg); }
    .fr-chat-launcher.open .fr-launcher-icon-close { opacity: 1; transform: scale(1) rotate(0deg); }
    .fr-chat-launcher:not(.open) .fr-launcher-icon-chat { opacity: 1; transform: scale(1) rotate(0deg); }
    .fr-chat-launcher:not(.open) .fr-launcher-icon-close { opacity: 0; transform: scale(0.5) rotate(-90deg); }
    .fr-launcher-icons { position: relative; width: 22px; height: 22px; }
    .fr-launcher-icon { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
    .fr-chat-badge-dot {
      position: absolute; top: -2px; right: -2px;
      width: 12px; height: 12px; border-radius: 0;
      background: #ef4444; border: 2px solid #23262f; display: none;
    }
    .fr-chat-badge-dot.show { display: block; }

    /* ── Panel ── */
    .fr-chat-panel-wrap {
      position: absolute; bottom: 66px; right: 0;
      width: min(400px, calc(100vw - 32px)); z-index: 200;
    }
    .fr-chat-card {
      display: flex; flex-direction: column;
      border-radius: 0; overflow: hidden;
      background: var(--ck-bg);
      box-shadow: var(--ck-shadow);
      border: 1px solid rgba(0,0,0,0.1);
      max-height: 88vh; position: relative;
      transform-origin: bottom right;
      transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.34,1.3,0.64,1);
    }
    body.dark-mode .fr-chat-card { border-color: rgba(255,255,255,0.06); }
    .fr-chat-card.chat-active { height: 580px; }
    .fr-chat-card.chat-maximized {
      position: fixed !important;
      inset: 0 !important;
      width: 100vw !important;
      height: 100dvh !important;
      max-height: 100dvh !important;
      border-radius: 0 !important;
      z-index: 9999 !important;
    }
    /* Hide maximize option on mobile — already fullscreen by default */
    @media (max-width: 768px) {
      #ck-maximize-row { display: none !important; }
    }
    .fr-chat-card.hidden { opacity: 0; transform: scale(0.93) translateY(10px); pointer-events: none; }

    /* ── Header (always dark) ── */
    .fr-chat-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 13px 14px 12px;
      background: var(--ck-header-bg);
      flex-shrink: 0;
    }
    .fr-chat-header-brand { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
    /* Blue circle info icon */
    .fr-chat-avatar {
      width: 32px; height: 32px; border-radius: 0; flex-shrink: 0;
      background: var(--ck-blue);
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 0.75rem; font-weight: 900;
    }
    .fr-chat-title {
      font-size: 0.9rem; font-weight: 700;
      color: var(--ck-blue); white-space: nowrap;
      overflow: hidden; text-overflow: ellipsis;
    }
    .fr-chat-subtitle { font-size: 0.72rem; color: var(--ck-header-sub); margin-top: 1px; font-variant-numeric: tabular-nums; }
    .fr-chat-header-actions { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
    /* Gear button — circular, slightly lighter than header */
    .fr-chat-gear-btn {
      width: 34px; height: 34px; border-radius: 0;
      background: var(--ck-gear-bg);
      border: 1px solid rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.75); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background 0.15s;
    }
    .fr-chat-gear-btn:hover { background: rgba(255,255,255,0.18); }
    .fr-chat-badge { display: none; } /* hidden — using gear/min/close instead */
    /* Minimize and close — text buttons */
    .fr-chat-icon-btn {
      width: 30px; height: 30px; border-radius: 0;
      background: none; border: none;
      color: rgba(255,255,255,0.6); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem; line-height: 1; transition: color 0.15s;
    }
    .fr-chat-icon-btn:hover { color: #fff; }
    .fr-chat-reset-btn {
      width: 30px; height: 30px; border-radius: 0;
      background: none; border: none;
      color: rgba(255,255,255,0.6); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: color 0.15s;
    }
    .fr-chat-reset-btn:hover:not(:disabled) { color: #f87171; }
    .fr-chat-reset-btn:disabled { opacity: 0.25; cursor: not-allowed; }

    /* ── Settings panel (gear menu) ── */
    #ck-settings-panel {
      background: var(--ck-bg);
      border-bottom: 1px solid var(--ck-row-border);
      flex-shrink: 0; overflow: hidden;
    }
    .ck-settings-row {
      display: flex; align-items: center; gap: 14px;
      padding: 14px 16px;
      border-bottom: 1px solid var(--ck-row-border);
      cursor: pointer; transition: background 0.12s;
    }
    .ck-settings-row:last-child { border-bottom: none; }
    .ck-settings-row:hover { background: var(--ck-row-bg); }
    .ck-settings-icon {
      width: 22px; color: var(--ck-text-sub);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .ck-settings-label { flex: 1; font-size: 0.9rem; font-weight: 500; color: var(--ck-text); }
    .ck-settings-right { display: flex; align-items: center; gap: 8px; }
    .ck-settings-action { font-size: 0.88rem; font-weight: 700; color: var(--ck-blue); }
    .ck-settings-chevron { color: var(--ck-text-sub); transition: transform 0.2s; }
    .ck-settings-chevron.open { transform: rotate(180deg); }
    /* Toggle switch */
    .ck-toggle {
      width: 44px; height: 24px; border-radius: 0;
      background: var(--ck-blue); position: relative; flex-shrink: 0;
      transition: background 0.2s; cursor: pointer; border: none;
    }
    .ck-toggle::after {
      content: ''; position: absolute; top: 2px; right: 2px;
      width: 20px; height: 20px; border-radius: 0; background: #fff;
      transition: right 0.2s;
    }
    .ck-toggle.off { background: #4b5563; }
    .ck-toggle.off::after { right: calc(100% - 22px); }
    /* Expandable sub-form in settings */
    .ck-settings-sub {
      padding: 4px 16px 16px 52px;
      border-bottom: 1px solid var(--ck-row-border);
      display: none;
    }
    .ck-settings-sub.open { display: block; }
    .ck-sub-label { font-size: 0.8rem; font-weight: 600; color: var(--ck-text); margin-bottom: 5px; display: block; }
    .ck-sub-optional { font-size: 0.75rem; font-weight: 400; color: var(--ck-text-muted); margin-left: 5px; }
    .ck-sub-input {
      width: 100%; padding: 10px 13px; border-radius: 0;
      border: 1.5px solid var(--ck-input-border);
      background: var(--ck-input-bg);
      font-family: inherit; font-size: 0.85rem; color: var(--ck-text);
      outline: none; transition: border-color 0.15s; margin-bottom: 10px;
    }
    .ck-sub-input:focus { border-color: var(--ck-blue); }
    .ck-sub-submit {
      width: 100%; padding: 10px; border-radius: 0; border: none;
      background: var(--ck-blue); color: #fff;
      font-family: inherit; font-size: 0.88rem; font-weight: 700;
      cursor: pointer; opacity: 0.7; transition: opacity 0.15s;
    }
    .ck-sub-submit:hover { opacity: 1; }

    /* ── Intake view ── */
    #wb3-view-intake {
      display: flex; flex-direction: column; flex: 1;
      background: var(--ck-bg); overflow-y: auto;
    }
    /* Header row: back arrow + logo + name/status */
    .wb3-intake-header {
      display: flex; align-items: center; gap: 12px;
      padding: 16px 16px 14px;
      border-bottom: 1px solid var(--ck-row-border); flex-shrink: 0;
    }
    .wb3-intake-back-btn {
      background: none; border: none; cursor: pointer;
      color: var(--ck-text-sub); padding: 4px; flex-shrink: 0;
      display: flex; align-items: center; border-radius: 0;
      transition: color 0.15s;
    }
    .wb3-intake-back-btn:hover { color: var(--ck-text); }
    .wb3-intake-logo-sm {
      width: 38px; height: 38px; border-radius: 0; flex-shrink: 0;
      background: var(--ck-header-bg);
      overflow: hidden; display: flex; align-items: center; justify-content: center;
      font-size: 0.65rem; font-weight: 700; color: #fff;
    }
    .wb3-intake-header-info { display: flex; flex-direction: column; gap: 1px; }
    .wb3-intake-header-name {
      font-size: 0.95rem; font-weight: 700; color: var(--ck-text);
      display: flex; align-items: center; gap: 6px;
    }
    .wb3-intake-online-dot {
      display: inline-block; width: 9px; height: 9px; border-radius: 0;
      background: #22c55e; box-shadow: 0 0 0 2px rgba(34,197,94,0.2);
      flex-shrink: 0;
    }
    .wb3-intake-header-sub { font-size: 0.75rem; color: var(--ck-text-sub); }
    /* Description paragraph */
    .wb3-intake-desc {
      padding: 18px 18px 4px;
      font-size: 0.92rem; color: var(--ck-text); line-height: 1.55;
      flex-shrink: 0;
    }
    /* Form */
    .wb3-intake-form-body {
      padding: 16px 16px 20px; display: flex; flex-direction: column;
      gap: 14px; flex-shrink: 0;
    }
    .wb3-intake-label { font-size: 0.82rem; font-weight: 700; color: var(--ck-text); margin-bottom: 6px; display: block; }
    .wb3-intake-input, .wb3-intake-textarea {
      width: 100%; padding: 11px 14px; border-radius: 0;
      border: 1.5px solid var(--ck-input-border);
      background: var(--ck-input-bg);
      font-family: inherit; font-size: 0.88rem; color: var(--ck-text);
      outline: none; transition: border-color 0.15s; resize: none;
    }
    .wb3-intake-input:focus, .wb3-intake-textarea:focus { border-color: var(--ck-blue); }
    .wb3-intake-textarea { min-height: 90px; line-height: 1.5; }
    .wb3-intake-submit-btn {
      width: 100%; padding: 13px; border-radius: 0; border: none;
      background: var(--ck-blue); color: #fff;
      font-family: inherit; font-size: 0.95rem; font-weight: 700;
      cursor: pointer; transition: opacity 0.15s, transform 0.1s; margin-top: 2px;
      letter-spacing: 0.01em;
    }
    .wb3-intake-submit-btn:hover:not(:disabled) { opacity: 0.88; transform: translateY(-1px); }
    .wb3-intake-submit-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
    .wb3-intake-error { font-size: 0.75rem; color: #ef4444; min-height: 14px; }

    /* ── Email verification (OTP) view ── */
    #wb3-view-verify {
      display: none; flex-direction: column; flex: 1;
      background: var(--ck-bg); overflow-y: auto;
    }
    #wb3-view-verify.active { display: flex; }
    .wb3-verify-email-wrap {
      padding: 28px 20px 24px;
      display: flex; flex-direction: column; align-items: center;
      gap: 14px; text-align: center; flex: 1;
    }
    .wb3-verify-email-icon {
      width: 56px; height: 56px; border-radius: 50%;
      background: rgba(var(--primary-rgb),0.12);
      display: flex; align-items: center; justify-content: center;
      color: var(--ck-blue); flex-shrink: 0;
    }
    .wb3-verify-email-title {
      font-size: 1.05rem; font-weight: 800; color: var(--ck-text); line-height: 1.3;
    }
    .wb3-verify-email-sub {
      font-size: 0.83rem; color: var(--ck-text-sub); line-height: 1.6; max-width: 260px;
    }
    .wb3-verify-email-addr {
      font-size: 0.82rem; font-weight: 700; color: var(--ck-blue);
      background: rgba(var(--primary-rgb),0.08); border: 1px solid rgba(var(--primary-rgb),0.2);
      padding: 5px 14px; border-radius: 99px; word-break: break-all;
    }
    /* OTP digit inputs */
    .wb3-otp-row {
      display: flex; gap: 8px; justify-content: center; margin: 4px 0;
    }
    .wb3-otp-digit {
      width: 42px; height: 52px; border-radius: 0;
      border: 1.5px solid var(--ck-input-border);
      background: var(--ck-input-bg); color: var(--ck-text);
      font-size: 1.4rem; font-weight: 800; text-align: center;
      font-family: inherit; outline: none; caret-color: var(--ck-blue);
      transition: border-color 0.15s;
    }
    .wb3-otp-digit:focus { border-color: var(--ck-blue); }
    .wb3-otp-digit.filled { border-color: var(--ck-blue); }
    .wb3-otp-digit.error  { border-color: #ef4444; animation: otp-shake 0.3s ease; }
    @keyframes otp-shake {
      0%,100% { transform: translateX(0); }
      25%      { transform: translateX(-4px); }
      75%      { transform: translateX(4px); }
    }
    .wb3-otp-submit-btn {
      width: 100%; max-width: 240px; padding: 12px; border-radius: 0; border: none;
      background: var(--ck-blue); color: #fff;
      font-family: inherit; font-size: 0.95rem; font-weight: 700;
      cursor: pointer; transition: opacity 0.15s, transform 0.1s;
    }
    .wb3-otp-submit-btn:hover:not(:disabled) { opacity: 0.88; transform: translateY(-1px); }
    .wb3-otp-submit-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
    .wb3-otp-error { font-size: 0.75rem; color: #ef4444; min-height: 16px; }
    .wb3-otp-resend {
      font-size: 0.78rem; color: var(--ck-text-muted);
    }
    .wb3-otp-resend-btn {
      background: none; border: none; cursor: pointer;
      color: var(--ck-blue); font-family: inherit; font-size: 0.78rem;
      font-weight: 600; padding: 0; text-decoration: underline;
    }
    .wb3-otp-resend-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    /* ── Back button ── */
    .wb3-back-btn {
      background: none; border: none; cursor: pointer;
      color: rgba(255,255,255,0.55); padding: 4px 6px 4px 0;
      display: flex; align-items: center; transition: color 0.15s;
    }
    .wb3-back-btn:hover { color: #fff; }

    /* ── Verification buttons ── */
    .wb3-verify-options { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
    .wb3-verify-btn {
      padding: 7px 22px; border-radius: 0;
      border: 1.5px solid var(--ck-blue);
      background: transparent; color: var(--ck-blue);
      font-family: inherit; font-size: 0.82rem; font-weight: 700;
      cursor: pointer; transition: background 0.15s, color 0.15s;
    }
    .wb3-verify-btn:hover:not(:disabled) { background: var(--ck-blue); color: #fff; }
    .wb3-verify-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    /* ── Messages area (adapts to light/dark mode) ── */
    #ai-chat-messages {
      flex: 1; overflow-y: auto; min-height: 0;
      padding: 14px 14px 8px;
      display: flex; flex-direction: column; gap: 10px;
      scroll-behavior: smooth;
      background: var(--ck-msg-bg);
    }
    #ai-chat-messages::-webkit-scrollbar { width: 3px; }
    #ai-chat-messages::-webkit-scrollbar-thumb { background: rgba(128,128,128,0.25); border-radius: 0; }

    /* ── Input row (adapts to light/dark mode) ── */
    #support-input-row {
      display: flex; gap: 10px; align-items: center;
      padding: 14px 14px; min-height: 64px;
      background: var(--ck-bg);
      border-top: 1px solid var(--ck-row-border);
      flex-shrink: 0;
    }
    #ai-chat-input {
      flex: 1; padding: 0; border: none; background: transparent;
      font-family: inherit; font-size: 0.9rem;
      color: var(--ck-text); outline: none;
    }
    #ai-chat-input::placeholder { color: var(--ck-text-muted); }
    #ai-chat-input:disabled { opacity: 0.4; cursor: not-allowed; }
    #ai-send-btn { display: none; }
    /* Send button */
    #ck-send-icon {
      color: var(--ck-text-sub); cursor: pointer; flex-shrink: 0;
      display: flex; align-items: center; background: none; border: none;
      transition: color 0.15s;
    }
    #ck-send-icon:hover { color: var(--ck-blue); }

    /* ── Reply bar ── */
    #ai-reply-quote-bar {
      background: var(--ck-reply-bar-bg) !important;
      border-top: 1px solid var(--ck-reply-bar-border) !important;
      font-size: 0.75rem !important; color: var(--ck-text-sub) !important;
    }

    /* ── Queue banner (hidden — replaced by overlay) ── */
    #wb3-queue-status { display: none !important; }

    /* ── Queue overlay (full message area replacement while waiting) ── */
    #ck-queue-overlay {
      display: none;
      flex-direction: column; align-items: center; justify-content: center;
      flex: 1; padding: 28px 20px; background: var(--ck-msg-bg);
      text-align: center; gap: 14px;
    }
    #ck-queue-overlay.visible { display: flex; }
    .ck-queue-spinner {
      width: 48px; height: 48px; border-radius: 0;
      border: 3px solid var(--ck-row-border);
      border-top-color: var(--ck-blue);
      animation: ckSpin 1.1s linear infinite;
      flex-shrink: 0;
    }
    @keyframes ckSpin { to { transform: rotate(360deg); } }
    .ck-queue-title { font-size: 0.95rem; font-weight: 700; color: var(--ck-text); }
    .ck-queue-sub { font-size: 0.82rem; color: var(--ck-text-sub); line-height: 1.55; }
    .ck-queue-badge {
      display: inline-block; padding: 5px 16px; border-radius: 0;
      background: rgba(37,99,235,0.08); border: 1px solid rgba(37,99,235,0.18);
      color: var(--ck-blue); font-size: 0.76rem; font-weight: 700;
    }

    /* ── Message bubbles ── */
    .ai-msg { display: flex; gap: 8px; align-items: flex-end; animation: msgSlideIn 0.25s cubic-bezier(0.22,1,0.36,1) both; }
    @keyframes msgSlideIn { from{opacity:0;transform:translateY(8px) scale(0.97)} to{opacity:1;transform:none} }
    .ai-msg.user { flex-direction: row-reverse; }
    .ai-msg.bot .ai-msg-avatar, .ai-msg.agent .ai-msg-avatar {
      width: 30px; height: 30px; border-radius: 0; flex-shrink: 0;
      background: var(--ck-bot-bubble);
      border: 1px solid var(--ck-row-border);
      display: flex; align-items: center; justify-content: center;
      color: var(--ck-text-sub); font-size: 0.6rem; font-weight: 700;
    }
    .ai-msg.agent .ai-msg-avatar {
      background: var(--ck-agent-bubble);
      border-color: var(--ck-agent-border);
    }
    .msg-wrap { display: flex; flex-direction: column; max-width: 80%; }
    .ai-msg.user .msg-wrap { align-items: flex-end; }
    .ai-msg-bubble-wrap { display: flex; flex-direction: column; }
    .ai-msg-bubble {
      padding: 10px 14px; font-size: 0.86rem; line-height: 1.55; word-break: break-word;
      border-radius: 4px 18px 18px 18px;
    }
    .ai-msg.bot .ai-msg-bubble {
      background: var(--ck-bot-bubble); color: var(--ck-text);
      border-radius: 4px 18px 18px 18px;
      border: 1px solid var(--ck-row-border);
      min-width: 54px;
    }
    body.dark-mode .ai-msg.bot .ai-msg-bubble { border-color: transparent; }
    .ai-msg.agent .ai-msg-bubble {
      background: #22c55e; color: #ffffff;
      border-radius: 4px 18px 18px 18px;
      border: none;
      font-weight: 500;
    }
    body.dark-mode .ai-msg.agent .ai-msg-bubble {
      background: #16a34a; color: #ffffff;
    }
    .ai-msg.user .ai-msg-bubble {
      background: var(--ck-blue); color: #ffffff;
      border-radius: 18px 18px 4px 18px;
      font-size: 0.9rem;
    }
    body.dark-mode .ai-msg.user .ai-msg-bubble { background: #2563eb; color: #fff; }
    /* Timestamp under user message */
    .ai-msg.user .msg-wrap::after {
      content: attr(data-ts);
      font-size: 0.66rem; color: var(--ck-text-muted);
      margin-top: 3px; text-align: right; display: block;
    }
    .ai-msg-system {
      text-align: center; font-size: 0.7rem; color: var(--ck-text-muted);
      padding: 2px 0; margin: 2px auto;
    }
    /* Typing dots */
    .ai-typing-indicator, .chat-typing-dots { display: flex; gap: 5px; align-items: center; padding: 4px 2px; }
    .ai-typing-dot {
      width: 7px; height: 7px; border-radius: 0;
      background: var(--ck-text-sub);
      animation: frTypingBounce 1.3s infinite ease-in-out;
      flex-shrink: 0;
    }
    .ai-typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .ai-typing-dot:nth-child(3) { animation-delay: 0.4s; }
    @keyframes frTypingBounce {
      0%, 80%, 100% { transform: translateY(0); opacity: 0.35; }
      40% { transform: translateY(-6px); opacity: 1; }
    }
    /* Typing bubble gets a bit of padding so dots have room */
    .ai-msg.bot .ai-msg-bubble:has(.ai-typing-indicator) {
      padding: 12px 16px;
    }
    .msg-reactions { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
    .msg-reaction-chip {
      font-size: 0.7rem; padding: 2px 7px; border-radius: 0;
      background: var(--ck-row-bg); border: 1px solid var(--ck-row-border);
      cursor: pointer; transition: all 0.12s; color: var(--ck-text-sub);
    }
    .msg-reaction-chip.mine { background: rgba(37,99,235,0.1); border-color: rgba(37,99,235,0.3); }
    .wb3-options { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 4px 38px; }
    .wb3-option-btn {
      padding: 6px 14px; border-radius: 0; font-size: 0.78rem; font-weight: 600;
      background: var(--ck-row-bg); border: 1.5px solid var(--ck-row-border);
      color: var(--ck-text-sub); cursor: pointer; transition: all 0.13s;
    }
    .wb3-option-btn:hover { background: rgba(37,99,235,0.08); border-color: rgba(37,99,235,0.3); color: var(--ck-blue); }
    .msg-reply-quote {
      font-size: 0.72rem; border-left: 3px solid var(--ck-blue);
      padding: 3px 8px; margin-bottom: 5px;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      color: var(--ck-text-sub); background: var(--ck-reply-bar-bg);
      border-radius: 0;
    }
    .wb3-msg-actions { display: flex; gap: 6px; margin-top: 3px; opacity: 0; transition: opacity 0.15s; }
    .ai-msg:hover .wb3-msg-actions { opacity: 1; }

    /* ── Feedback overlay ── */
    #wb3-feedback-overlay {
      display: none; position: absolute; inset: 0; border-radius: 0;
      background: rgba(0,0,0,0.5); z-index: 100;
      align-items: center; justify-content: center;
    }
    #wb3-feedback-overlay.open { display: flex; }
    #wb3-feedback-box {
      background: var(--ck-bg); border-radius: 0; padding: 28px 24px;
      text-align: center; width: 280px; box-shadow: 0 8px 40px rgba(0,0,0,0.25);
      border: 1px solid var(--ck-row-border);
    }
    #wb3-feedback-title { font-size: 1.1rem; font-weight: 800; color: var(--ck-text); margin-bottom: 4px; }
    #wb3-feedback-sub { font-size: 0.78rem; color: var(--ck-text-sub); margin-bottom: 20px; }
    #wb3-feedback-thumbs { display: flex; justify-content: center; gap: 20px; margin-bottom: 20px; }
    .wb3-thumb-btn {
      width: 52px; height: 52px; border-radius: 0;
      border: 1.5px solid var(--ck-row-border);
      background: var(--ck-row-bg); color: var(--ck-text-sub); cursor: pointer;
      display: flex; align-items: center; justify-content: center; transition: all 0.15s;
    }
    .wb3-thumb-btn:hover { border-color: var(--ck-blue); color: var(--ck-blue); background: rgba(37,99,235,0.06); transform: scale(1.07); }
    .wb3-thumb-btn.selected-up { background: rgba(22,163,74,0.12); border-color: #16a34a; color: #16a34a; }
    .wb3-thumb-btn.selected-down { background: rgba(220,38,38,0.12); border-color: #dc2626; color: #dc2626; }
    #wb3-feedback-actions { display: flex; gap: 8px; justify-content: center; margin-bottom: 12px; }
    .wb3-feedback-go-back {
      padding: 9px 16px; border-radius: 0; font-size: 0.82rem; font-weight: 600;
      background: none; border: none; color: var(--ck-blue); cursor: pointer; font-family: inherit;
    }
    .wb3-feedback-leave {
      flex: 1; padding: 9px 16px; border-radius: 0; font-size: 0.82rem; font-weight: 600;
      background: var(--ck-row-bg); border: 1px solid var(--ck-row-border);
      color: var(--ck-text); cursor: pointer; font-family: inherit; transition: background 0.15s;
    }
    .wb3-feedback-leave:hover { background: var(--ck-bot-bubble); }
    #wb3-feedback-note { font-size: 0.7rem; color: var(--ck-text-muted); line-height: 1.55; }

    /* ── Agent joined card ── */
    .ck-agent-joined-card {
      display: flex; flex-direction: column; align-items: center;
      padding: 22px 16px 14px; animation: msgSlideIn 0.4s cubic-bezier(0.22,1,0.36,1) both;
    }
    .ck-agent-av-lg {
      width: 80px; height: 80px; border-radius: 0; overflow: hidden;
      margin-bottom: 10px; box-shadow: 0 4px 20px rgba(0,0,0,0.18);
      background: var(--ck-bot-bubble); border: 1px solid var(--ck-row-border);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.9rem; font-weight: 700; color: var(--ck-text-sub);
    }
    .ck-agent-av-lg img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
    .ck-agent-name { font-size: 0.92rem; font-weight: 700; color: var(--ck-text); margin-bottom: 2px; }
    .ck-agent-joined-label { font-size: 0.78rem; color: var(--ck-text-sub); }
    .ck-agent-ts { font-size: 0.68rem; color: var(--ck-text-muted); margin-top: 4px; }

    /* ── Verify card (identity check) — standalone centered ── */
    .ck-verify-card {
      display: flex; flex-direction: column; align-items: center;
      gap: 10px; padding: 20px 16px 8px;
      animation: msgSlideIn 0.3s cubic-bezier(0.22,1,0.36,1) both;
    }
    .ck-verify-label { font-size: 0.82rem; color: var(--ck-text-sub); letter-spacing: 0.01em; }
    .ck-verify-avatar {
      width: 88px; height: 88px; border-radius: 0;
      background: var(--ck-bot-bubble); border: 1px solid var(--ck-row-border);
      overflow: hidden; display: flex; align-items: center; justify-content: center;
      font-size: 0.8rem; font-weight: 700; color: var(--ck-text-muted);
    }
    .ck-verify-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
    .ck-verify-name { font-size: 0.95rem; font-weight: 700; color: var(--ck-text); margin-top: 2px; }
    .ck-verify-id { font-size: 0.72rem; color: var(--ck-text-muted); }
    .ck-verify-btns {
      display: flex; flex-wrap: wrap; gap: 7px; justify-content: center;
      margin-top: 6px; padding-bottom: 4px;
    }
    .ck-verify-btn {
      padding: 7px 18px; border-radius: 0; font-size: 0.82rem; font-weight: 700;
      cursor: pointer; font-family: inherit; transition: all 0.15s;
      border: 1.5px solid var(--ck-blue); background: transparent; color: var(--ck-blue);
    }
    .ck-verify-btn:hover:not(:disabled) { background: var(--ck-blue); color: #fff; transform: translateY(-1px); }
    .ck-verify-btn.ck-verify-btn-no {
      border-color: var(--ck-row-border); color: var(--ck-text-sub);
    }
    .ck-verify-btn.ck-verify-btn-no:hover:not(:disabled) { background: var(--ck-bot-bubble); color: var(--ck-text); }
    .ck-verify-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }

    /* ── Limit notice (light-mode friendly) ── */
    #wb3-limit-notice {
      padding: 9px 14px; border-top: 1px solid #fca5a5;
      font-size: 0.78rem; text-align: center; flex-shrink: 0;
      background: #fef2f2; color: #991b1b;
    }
    body.dark-mode #wb3-limit-notice { background: rgba(153,27,27,0.15); border-top-color: rgba(239,68,68,0.2); color: #f87171; }

    /* ── Offline/closed notice ── */
    #support-offline-notice, #support-closed-notice {
      flex-shrink: 0; padding: 7px 13px; text-align: center;
      background: rgba(245,158,11,0.06); border-top: 1px solid rgba(245,158,11,0.18);
      font-size: 0.73rem; color: var(--ck-text-sub);
    }

        /* ═══════════════════════════════
       LEGAL PAGES
    ═══════════════════════════════ */
    .legal-page {
      max-width: 760px;
      margin: 0 auto;
      padding: 220px 32px 80px; /* 220px clears fixed nav-top(96) + nav-bottom(96) + buffer */
    }
    @media (max-width: 768px) {
      .legal-page { padding-top: 110px; } /* mobile has only nav-top ~60px */
    }
    .legal-back { margin-bottom: 32px; }
    .legal-header { margin-bottom: 40px; padding-bottom: 28px; border-bottom: 1px solid var(--border-color); }
    .legal-title { font-size: 2.2rem; font-weight: 900; color: var(--text-primary); letter-spacing: -0.03em; margin-bottom: 8px; }
    .legal-meta { font-size: 0.82rem; color: var(--text-muted); }
    .legal-body { display: flex; flex-direction: column; gap: 36px; }
    .legal-section h2 { font-size: 1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 10px; }
    .legal-section p { font-size: 0.88rem; color: var(--text-secondary); line-height: 1.75; margin-bottom: 10px; }
    .legal-section p:last-child { margin-bottom: 0; }
    .legal-section ul { margin: 10px 0 10px 20px; display: flex; flex-direction: column; gap: 6px; }
    .legal-section ul li { font-size: 0.88rem; color: var(--text-secondary); line-height: 1.6; }
    .legal-section a { color: var(--primary-color); text-decoration: none; }
    .legal-section a:hover { text-decoration: underline; }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(28px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes floatY {
      0%, 100% { transform: translateY(0px); }
      50%       { transform: translateY(-10px); }
    }
    @keyframes gradientShift {
      0%   { background-position: 0% 50%; }
      50%  { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    @keyframes counterGlow {
      0%, 100% { filter: drop-shadow(0 0 20px rgba(var(--primary-rgb),0.2)); }
      50%       { filter: drop-shadow(0 0 50px rgba(var(--primary-rgb),0.45)); }
    }
    /* ── Video fullscreen button ── */
    .video-fs-btn {
      position: absolute;
      bottom: 12px; right: 12px;
      z-index: 10;
      width: 40px; height: 40px;
      background: rgba(0,0,0,0.4);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 0;
      color: rgba(255,255,255,0.7);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      opacity: 0.35;
      transition: opacity 0.15s, background 0.15s, transform 0.15s, color 0.15s;
      backdrop-filter: blur(4px);
    }
    .browser-content:hover .video-fs-btn { opacity: 1; }
    .video-fs-btn:hover,
    .video-fs-btn:focus {
      background: rgba(var(--primary-rgb),0.9);
      color: #fff;
      transform: scale(1.08);
      opacity: 1 !important;
      border-color: rgba(255,255,255,0.35);
    }

    /* Fullscreen state for browser mock */
    .browser-mock-wrap.is-fullscreen {
      position: fixed !important;
      inset: 0 !important;
      z-index: 9000 !important;
      width: 100vw !important;
      height: 100vh !important;
      perspective: none !important;
      background: #000;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .browser-mock-wrap.is-fullscreen .browser-mock {
      width: 100% !important;
      height: 100% !important;
      transform: none !important;
      border-radius: 0;
      border: none;
      box-shadow: none;
    }
    .browser-mock-wrap.is-fullscreen .browser-content {
      aspect-ratio: unset;
      height: 100%;
    }

    /* ── Counter double-click fullscreen ── */
    .counter-section {
      cursor: default;
    }
    .counter-section.counter-fs {
      position: fixed !important;
      inset: 0 !important;
      z-index: 9001 !important;
      padding: 0 !important;
      min-height: 100vh !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      background: var(--bg-primary) !important;
      cursor: default;
    }
    .counter-section.counter-fs .counter-number {
      font-size: clamp(7rem, 22vw, 18rem) !important;
    }
    /* Fullscreen counter: pure black background, everything white */
    .counter-section.counter-fs,
    .counter-section.counter-fs:fullscreen,
    .counter-section.counter-fs:-webkit-full-screen {
      background: #000 !important;
      background-image: none !important;
    }
    .counter-section.counter-fs::before,
    .counter-section.counter-fs::after { display: none !important; }
    .counter-section.counter-fs *,
    .counter-section.counter-fs .digit-reel span,
    .counter-section.counter-fs .digit-sep,
    .counter-section.counter-fs .counter-label-top,
    .counter-section.counter-fs .counter-label-bottom,
    .counter-section.counter-fs .counter-label-bottom strong,
    .counter-section.counter-fs .counter-footnote,
    .counter-section.counter-fs .sibling {
      color: #fff !important;
      background: none !important;
      -webkit-background-clip: border-box !important;
      background-clip: border-box !important;
      -webkit-text-fill-color: #fff !important;
      text-shadow: none !important;
    }
    .counter-section.counter-fs .counter-number {
      filter: none !important;
      animation: none !important;
    }
    .counter-section.counter-fs .counter-shockwave { border-color: #fff !important; }
    .counter-section.counter-fs .counter-particle { background: #fff !important; }

    /* ═══════════════════════════════
       404 NOT FOUND PAGE
    ═══════════════════════════════ */
    .not-found-section {
      min-height: calc(100vh - 192px);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      padding: 220px 24px 80px;
    }
    .nf-bg-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(var(--primary-rgb),0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(var(--primary-rgb),0.06) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 40%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 40%, transparent 100%);
      pointer-events: none;
    }
    .nf-particles {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }
    .nf-particle {
      position: absolute;
      width: 4px; height: 4px;
      border-radius: 0;
      background: rgba(var(--primary-rgb),0.6);
      animation: nfParticleFloat linear infinite;
    }
    @keyframes nfParticleFloat {
      0%   { transform: translateY(100vh) rotate(0deg); opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 1; }
      100% { transform: translateY(-100px) rotate(720deg); opacity: 0; }
    }
    .nf-inner {
      position: relative;
      z-index: 2;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
    }
    .nf-glitch-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      margin-bottom: 32px;
      animation: nfFadeIn 0.7s ease both;
    }
    /* The two "4" digits — static, no glitch */
    .nf-code {
      font-size: clamp(6rem, 18vw, 11rem);
      font-weight: 900;
      letter-spacing: -0.05em;
      line-height: 1;
      background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-light) 50%, var(--secondary-color) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      position: relative;
      filter: drop-shadow(0 0 30px rgba(var(--primary-rgb),0.35));
    }
    /* Middle "0" container — no rings, just the digit */
    .nf-code-mid {
      -webkit-text-fill-color: transparent;
      color: transparent;
      position: relative;
    }
    .nf-zero-wrap {
      position: relative;
      width: clamp(6rem, 18vw, 11rem);
      height: clamp(6rem, 18vw, 11rem);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    /* Rings removed — hide them */
    .nf-zero-ring { display: none; }
    .nf-zero-core {
      font-size: clamp(6rem, 18vw, 11rem);
      font-weight: 900;
      letter-spacing: -0.05em;
      line-height: 1;
      background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-light) 50%, var(--secondary-color) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      position: relative;
      z-index: 2;
      filter: drop-shadow(0 0 30px rgba(var(--primary-rgb),0.35));
    }
    .nf-title {
      font-size: clamp(1.6rem, 4vw, 2.4rem);
      font-weight: 900;
      letter-spacing: -0.03em;
      color: var(--text-primary);
      margin-bottom: 14px;
      animation: nfFadeIn 0.7s 0.2s ease both;
    }
    .nf-sub {
      font-size: 1.05rem;
      color: var(--text-secondary);
      max-width: 400px;
      line-height: 1.65;
      margin-bottom: 40px;
      animation: nfFadeIn 0.7s 0.35s ease both;
    }
    .nf-actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 32px;
      animation: nfFadeIn 0.7s 0.5s ease both;
    }
    .nf-btn-home {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
      color: #fff;
      border: none; border-radius: 0;
      padding: 14px 30px;
      font-size: 1rem; font-weight: 700;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      box-shadow: 0 8px 24px rgba(var(--primary-rgb),0.45);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .nf-btn-home:hover { transform: translateY(-3px); box-shadow: 0 16px 40px rgba(var(--primary-rgb),0.6); }
    .nf-btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      background: transparent;
      color: var(--text-secondary);
      border: 1.5px solid var(--border-color);
      border-radius: 0;
      padding: 14px 30px;
      font-size: 1rem; font-weight: 700;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: border-color 0.2s, color 0.2s, background 0.2s;
    }
    .nf-btn-ghost:hover { border-color: var(--primary-color); color: var(--primary-color); background: rgba(var(--primary-rgb),0.06); }
    .nf-links {
      display: flex;
      align-items: center;
      gap: 10px;
      animation: nfFadeIn 0.7s 0.65s ease both;
    }
    .nf-quick-link {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      transition: color 0.15s;
    }
    .nf-quick-link:hover { color: var(--primary-color); }
    .nf-dot { color: var(--border-color); font-size: 0.75rem; }
    @keyframes nfFadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    /* ═══════════════════════════════
       MOBILE
    ═══════════════════════════════ */
    .hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 40px; height: 40px;
      background: none; border: none; cursor: pointer;
      padding: 4px;
      flex-shrink: 0;
      position: absolute;
      right: 20px;
    }
    .hamburger span {
      display: block; height: 2px; border-radius: 0;
      background: #fff;
      transition: transform 0.3s ease, opacity 0.3s ease, width 0.3s ease;
      transform-origin: center;
    }
    .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; }
    .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .mobile-menu {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(5, 8, 16, 0.98);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      z-index: 299;
      flex-direction: column;
      padding: 0;
      overflow-y: auto;
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.2, 0.64, 1);
    }
    .mobile-menu.open {
      display: flex;
      opacity: 1;
      transform: translateY(0);
    }

    /* Mobile menu header bar */
    .mobile-menu::before {
      content: '';
      display: block;
      height: 64px;
      flex-shrink: 0;
    }

    /* Close button */
    .mobile-menu-close {
      position: absolute;
      top: 14px; right: 16px;
      width: 36px; height: 36px;
      border-radius: 0;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      color: #fff;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      font-size: 1.1rem;
      z-index: 1;
    }

    .mobile-menu-links {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 16px 20px 24px;
      gap: 6px;
    }

    .mobile-menu a {
      font-size: 1.1rem;
      font-weight: 600;
      color: rgba(255,255,255,0.7);
      text-decoration: none;
      padding: 16px 18px;
      border-radius: 0;
      border: 1px solid rgba(255,255,255,0.06);
      background: rgba(255,255,255,0.04);
      transition: all 0.18s ease;
      letter-spacing: -0.01em;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .mobile-menu a:hover, .mobile-menu a:active {
      color: #fff;
      background: rgba(255,255,255,0.09);
      border-color: rgba(255,255,255,0.14);
    }
    .mobile-menu a.featured-mobile {
      color: #fff;
      background: linear-gradient(135deg, rgba(var(--primary-rgb),0.35), rgba(var(--primary-rgb),0.25));
      border-color: rgba(var(--primary-rgb),0.4);
      font-size: 1.15rem;
      font-weight: 700;
    }
    .mobile-menu a.featured-mobile:hover {
      background: linear-gradient(135deg, rgba(var(--primary-rgb),0.5), rgba(var(--primary-rgb),0.4));
    }

    .mobile-menu-footer {
      padding: 16px 20px 32px;
      display: flex;
      gap: 10px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .mobile-menu-footer button {
      flex: 1;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.12);
      color: #fff;
      border-radius: 0;
      padding: 14px;
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .mobile-menu-footer button:active {
      background: rgba(255,255,255,0.12);
    }

    /* ── Mobile bottom tab bar ── */

    @media (max-width: 768px) {
      /* Show only the logo bar on mobile — hide nav links */
      .site-header { display: block !important; }
      .not-found-section { padding: 100px 20px 60px; }

      /* Slim down nav-top for mobile */
      .nav-top {
        height: 60px;
        padding: 0 16px;
        justify-content: space-between;
      }
      /* Hide right-side buttons on mobile — hamburger handles navigation */
      .nav-top-right { display: none; }
      .nav-bottom { display: none !important; }
      .logo-img { height: 38px; }

      /* Show hamburger on mobile */
      .hamburger { display: flex; position: static; margin-left: auto; }

      /* Adjust hero top padding to match slim header */
      .hero { padding: 68px 20px 0; text-align: center; align-items: center; }

      /* HOME - Hero */
      .hero h1 { font-size: clamp(1.8rem, 8vw, 2.6rem); white-space: normal; max-width: 100%; }
      .hero-sub { font-size: 0.95rem; max-width: 100%; text-align: center; margin-top: 10px; }
      .hero-buttons { flex-direction: column; align-items: center; gap: 10px; margin-top: 16px; width: 100%; }
      .btn-chrome, .btn-firefox, .btn-other { width: 100%; max-width: 340px; justify-content: center; }
      .btn-other-wrap { width: 100%; max-width: 340px; }

      /* Browser mock — smaller on mobile */
      .browser-mock-wrap { width: 88vw; max-height: 52vw; overflow: hidden; }
      .browser-mock { transform: none; }
      .preview-stage { margin-top: 12px; }

      /* Creators strip */
      .creators-section { padding: 32px 16px; text-align: center; }
      .creators-label { text-align: center; justify-content: center; }
      .creators-list { justify-content: center; }

      /* Counter */
      .counter-section { padding: 56px 20px; min-height: auto; text-align: center; }
      .counter-number { font-size: clamp(3.5rem, 18vw, 6rem); }
      .counter-label-top { font-size: 1rem; text-align: center; }
      .counter-label-bottom { text-align: center; }

      /* ABOUT / CAREERS */
      .about-hero-band { padding: calc(60px + 56px) 20px 48px; }
      .about-section { padding: 56px 20px 80px; }
      .about-story-sub { font-size: 1.15rem; margin-bottom: 32px; }
      .about-paragraphs p { font-size: 0.97rem; }
      .about-paragraphs { padding-left: 20px; }
      .about-quote { padding: 20px; font-size: 0.95rem !important; }
      .about-inner { gap: 0; }

      /* BLOG */
      .blog-hero { padding: 60px 20px 32px; padding-top: calc(60px + 32px); min-height: auto; }
      .blog-hero h1 { font-size: 1.6rem; }
      .blog-hero p { font-size: 0.88rem; }
      .blog-controls { padding: 0 16px; margin-top: 20px; }
      .blog-search { padding: 12px 16px 12px 44px; font-size: 0.92rem; }
      .blog-filter-row { gap: 8px; }
      .blog-filter-btn { padding: 7px 14px; font-size: 0.82rem; }
      .blog-count-bar { margin-left: 16px; margin-right: 16px; padding: 10px 16px; font-size: 0.82rem; }
      .blog-section { padding: 0 16px 88px; margin-top: 24px; }
      .blog-section-title { font-size: 1rem; margin-bottom: 16px; }
      .blog-grid { gap: 14px; }

      /* Mobile blog card: horizontal layout */
      .blog-card {
        flex-direction: row;
        align-items: stretch;
        min-height: 100px;
      }
      .blog-card-thumb {
        width: 110px;
        min-width: 110px;
        aspect-ratio: unset;
        flex-shrink: 0;
      }
      .blog-card-body {
        padding: 14px 14px 12px;
        gap: 4px;
        justify-content: center;
      }
      .blog-card-title { font-size: 0.95rem; margin-bottom: 5px; line-height: 1.3; }
      .blog-card-excerpt { font-size: 0.8rem; -webkit-line-clamp: 2; margin-bottom: 10px; }
      .blog-card-meta { gap: 12px; font-size: 0.75rem; margin-bottom: 10px; }
      .blog-card-readmore { font-size: 0.82rem; }
      .blog-card-badge { top: 8px; right: 8px; padding: 3px 8px; font-size: 0.62rem; }
      .blog-card:hover { transform: translateY(-2px); }

      /* ARTICLE */
      .article-back-bar { padding: 76px 0 0; }
      .article-layout-wrap { padding: 0; gap: 0; }
      .article-container { padding: 0 16px 88px; }
      .article-header-card { border-radius: 8px; }
      .article-header-body { padding: 16px 16px 14px; }
      .article-nav-strip { padding: 10px 16px; gap: 7px; }
      .article-nav-chips { display: none; }
      .article-breadcrumb { display: none; }
      .article-title-row { flex-direction: column; gap: 10px; }
      .article-version-chip { margin-top: 0; }
      .article-title { font-size: 1.55rem; letter-spacing: -0.025em; line-height: 1.25; }
      .article-meta-row { gap: 0; flex-wrap: wrap; padding: 10px 16px; font-size: 0.78rem; }
      .article-actions-row { padding: 8px 16px 10px; flex-wrap: wrap; }
      .article-platform-row { padding: 10px 16px; }
      .article-hero-img { margin-bottom: 28px; }
      .article-body { font-size: 0.97rem; line-height: 1.75; }
      .article-body h2 { font-size: 1.25rem; margin: 28px 0 12px; }
      .article-body h3 { font-size: 1.05rem; margin: 20px 0 10px; }
      .article-body blockquote { padding: 12px 16px; margin: 20px 0; font-size: 0.93rem; }
      .article-body ul, .article-body ol { padding-left: 18px; }
      /* Hide TOC sidebar on mobile — it stacks badly */
      .article-toc-sidebar { display: none; }
      .article-feedback { margin-top: 36px; padding: 18px 16px; }
      .article-feedback-actions { gap: 8px; }
      .article-reaction-btn { min-width: 104px; }
      .article-back-footer { margin-top: 36px; padding-top: 24px; }

      /* SUPPORT */
      .support-hero { padding: 80px 20px 48px; }
      .support-body { grid-template-columns: 1fr; padding: 0 16px 88px; gap: 32px; }
      .support-col-full { grid-column: 1; }
      .support-quick-grid { grid-template-columns: 1fr 1fr; }

      /* Footer */
      .footer-main { grid-template-columns: 1fr 1fr; padding: 36px 20px 28px; }
    }

    @media (max-width: 480px) {
      .hero h1 { font-size: 1.9rem; }
      .counter-number { font-size: clamp(2.8rem, 16vw, 4.5rem); }
      .footer-main { grid-template-columns: 1fr; }
      /* Very small screens: keep cards vertical */
      .blog-card { flex-direction: column; }
      .blog-card-thumb { width: 100%; }
      .blog-card-body { padding: 16px 16px 14px; }
    }

    /* Hide nav-top on blog/about/careers/updates/status via CSS — instant, no JS timing gap */
    @media (min-width: 769px) {
      body[data-page="blog"] .nav-top,
      body[data-page="about"] .nav-top,
      body[data-page="careers"] .nav-top,
      body[data-page="updates"] .nav-top,
      body[data-page="status"] .nav-top,
      body[data-page="frplus"] .nav-top,
      body[data-page="uninstall"] .nav-top { display: none !important; }
      body[data-page="uninstall"] .nav-bottom { display: none !important; }
    }

    /* Blog hero clears only nav-bottom (96px) when nav-top is hidden */
    @media (min-width: 769px) {
      body[data-page="blog"] .blog-hero {
        padding-top: calc(96px + 20px) !important;
      }
    }

    /* ═══════════════════════════════
       BLOG PAGE
    ═══════════════════════════════ */
    .blog-hero {
      padding: 20px 0;
      padding-top: calc(96px + 96px + 20px); /* fallback: both bars visible */
      margin: 0;
      border-radius: 0;
      overflow: hidden;
      position: relative;
      background: linear-gradient(135deg, var(--accent-nav-from), var(--accent-nav-to));
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      min-height: 0;
      max-width: 100%;
      width: 100%;
      box-shadow: 0 20px 25px -5px rgba(0,0,0,0.25), 0 0 0 1px rgba(255,255,255,0.1) inset;
    }

    .blog-hero::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: repeating-linear-gradient(
        45deg,
        rgba(255,255,255,0.04) 0px,
        rgba(255,255,255,0.04) 10px,
        transparent 10px,
        transparent 20px
      );
      animation: navTopPattern 20s linear infinite;
      pointer-events: none;
      z-index: 0;
    }

    .blog-hero-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 64px;
      height: 64px;
      border: 2.5px solid rgba(255,255,255,0.35);
      border-radius: 0;
      margin-bottom: 24px;
      position: relative;
      z-index: 1;
      color: #fff;
      background: rgba(255,255,255,0.1);
    }

    .blog-hero h1 {
      font-size: clamp(2.4rem, 5vw, 3.6rem);
      font-weight: 900;
      letter-spacing: -0.04em;
      color: #fff;
      margin-bottom: 20px;
      position: relative;
      z-index: 1;
      text-shadow: 0 2px 20px rgba(0,0,0,0.2);
    }

    .blog-hero h1 span {
      background: none;
      -webkit-background-clip: unset;
      -webkit-text-fill-color: #fff;
      background-clip: unset;
      color: #fff;
      opacity: 0.85;
    }

    .blog-hero p {
      font-size: 1.05rem;
      color: rgba(255,255,255,0.75);
      max-width: 560px;
      margin: 0 auto;
      line-height: 1.7;
      position: relative;
      z-index: 1;
    }

    body.dark-mode .blog-hero {
      background: linear-gradient(135deg, var(--accent-nav-from), var(--accent-nav-to));
    }
    body.dark-mode .blog-hero h1,
    body.dark-mode .blog-hero h1 span { color: #fff; -webkit-text-fill-color: #fff; }
    body.dark-mode .blog-hero p { color: rgba(255,255,255,0.75); }
    body.dark-mode .blog-hero-icon { color: #fff; border-color: rgba(255,255,255,0.35); }

    /* Search + filter bar */
    .blog-controls {
      max-width: 1300px;
      margin: 28px auto 0;
      padding: 0 24px;
      animation: fadeUp 0.5s 0.2s ease both;
    }

    .blog-search-wrap {
      position: relative;
      margin-bottom: 20px;
    }

    .blog-search-icon {
      position: absolute;
      left: 18px; top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      pointer-events: none;
      display: flex;
    }

    .blog-search {
      width: 100%;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 0;
      padding: 14px 18px 14px 48px;
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
      color: var(--text-primary);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .blog-search::placeholder { color: var(--text-muted); }

    .blog-search:focus {
      border-color: rgba(var(--primary-rgb),0.5);
      box-shadow: 0 0 0 3px rgba(var(--primary-rgb),0.12);
    }

    body.light-mode .blog-search {
      background: #fff;
      border-color: #e2e8f0;
    }

    .blog-filter-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    @media (max-width: 580px) {
      .blog-filter-row {
        flex-wrap: nowrap;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding-bottom: 4px;
      }
      .blog-filter-row::-webkit-scrollbar { display: none; }
      .blog-filter-btn { flex-shrink: 0; }
    }

    .blog-filter-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 18px;
      border-radius: 0;
      font-family: 'Inter', sans-serif;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      border: 1.5px solid var(--border-color);
      background: transparent;
      color: var(--text-secondary);
      transition: all 0.18s;
    }

    .blog-filter-btn:hover {
      border-color: rgba(var(--primary-rgb),0.4);
      color: var(--text-primary);
      background: rgba(var(--primary-rgb),0.07);
    }

    .blog-filter-btn.active {
      background: var(--primary-color);
      border-color: var(--primary-color);
      color: #fff;
    }

    .blog-count-bar {
      max-width: 1300px;
      margin: 16px auto 0;
      padding: 12px 24px;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 0;
      font-size: 0.88rem;
      color: var(--text-muted);
      animation: fadeUp 0.5s 0.22s ease both;
    }

    body.light-mode .blog-count-bar {
      background: #fff;
      border-color: #e2e8f0;
    }

    /* Articles grid */
    /* ── Blog grid & cards (RoGold-style) ── */
    .blog-section {
      max-width: 1300px;
      margin: 48px auto 0;
      padding: 0 24px 100px;
    }

    .blog-section-title {
      font-size: 1.2rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text-primary);
      margin-bottom: 28px;
    }

    .blog-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    @media (max-width: 1100px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 580px)  { .blog-grid { grid-template-columns: 1fr; } }

    .blog-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 0;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.24s cubic-bezier(0.34,1.4,0.64,1), box-shadow 0.24s, border-color 0.2s;
      display: flex;
      flex-direction: column;
    }

    .blog-card:hover {
      transform: translateY(-5px);
      border-color: rgba(var(--primary-rgb),0.3);
      box-shadow: 0 24px 56px rgba(0,0,0,0.35), 0 0 0 1px rgba(var(--primary-rgb),0.1);
    }

    body.light-mode .blog-card { background: #fff; border-color: #e2e8f0; }
    body.light-mode .blog-card:hover { box-shadow: 0 10px 32px rgba(var(--primary-rgb),0.1), 0 0 0 1px rgba(var(--primary-rgb),0.12); }

    /* Thumbnail */
    .blog-card-thumb {
      width: 100%;
      position: relative;
      overflow: hidden;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Show full image, no cropping */
    .blog-card-thumb img {
      width: 100%;
      height: auto;
      display: block;
      object-fit: contain;
      object-position: center;
      transition: transform 0.4s ease;
    }
    .blog-card:hover .blog-card-thumb img { transform: scale(1.03); }
    .blog-card-thumb-empty {
      background: var(--bg-tertiary);
      border-bottom: 1px solid var(--border-color);
    }

    .blog-card-no-thumb .blog-card-body { padding-top: 20px; }

    .blog-card-thumb-inner {
      position: absolute; inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.4s ease;
    }

    /* Zoom on hover */
    .blog-card:hover .blog-card-thumb-inner { transform: scale(1.03); }

    .blog-card-badge {
      position: absolute;
      top: 12px; right: 12px;
      padding: 5px 11px;
      border-radius: 0;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      backdrop-filter: blur(6px);
      z-index: 2;
    }

    .blog-card-badge.new { background: rgba(34,197,94,0.9); color: #fff; }
    .blog-card-badge.update { background: rgba(245,158,11,0.92); color: #000; }
    .blog-card-badge.countdown { background: rgba(139,92,246,0.92); color: #fff; font-variant-numeric: tabular-nums; letter-spacing: 0.03em; }

    /* Locked (scheduled) art: the blurred picture and the "?" are baked into the image pixels (see CdLock) */
    .cd-lock-q { text-align:center; font-weight:900; font-size:clamp(96px,22vw,200px); line-height:1; padding:24px 0; color:var(--text-muted); opacity:.55; user-select:none; }
    .ul-intro .cd-lock-q { font-size:72px; padding:8px 0; }
    img.cd-lock-img { width: 100%; height: auto; display: block; aspect-ratio: 16 / 9; background: linear-gradient(135deg, #1b1033, #3b1d6e); }

    /* Blog page: big countdown replaces the logo while an update is scheduled */
    .blog-hero-cd { position: relative; z-index: 1; text-align: center; padding: 6px 16px 10px; width: 100%; }
    .bhc-label { font-size: .85rem; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.85); margin-bottom: 12px; }
    .bhc-row { display: flex; justify-content: center; align-items: flex-start; gap: clamp(4px, 1.6vw, 16px); }
    .bhc-seg { display: flex; flex-direction: column; align-items: center; min-width: clamp(58px, 15vw, 150px); }
    .bhc-num { font-size: clamp(2.8rem, 12vw, 7rem); font-weight: 900; line-height: 1; color: #fff; font-variant-numeric: tabular-nums; letter-spacing: -.04em; text-shadow: 0 4px 30px rgba(0,0,0,.3); }
    .bhc-unit { margin-top: 8px; font-size: .7rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: rgba(255,255,255,.7); }
    .bhc-sep { font-size: clamp(2.8rem, 12vw, 7rem); font-weight: 900; line-height: 1; color: rgba(255,255,255,.55); animation: bhcBlink 1s steps(1) infinite; }
    @keyframes bhcBlink { 0% { opacity: 1; } 50% { opacity: .25; } }
    .bhc-sound { position: absolute; right: 14px; bottom: 6px; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;
      background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.35); color: #fff; cursor: pointer; padding: 0; }
    .bhc-sound:hover { background: rgba(255,255,255,.2); }

    /* Card body */
    .blog-card-body {
      padding: 22px 22px 20px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .blog-card-title {
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text-primary);
      line-height: 1.35;
      margin-bottom: 10px;
    }

    .blog-card-excerpt {
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--text-secondary);
      line-height: 1.65;
      flex: 1;
      margin-bottom: 16px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .blog-card-meta {
      display: flex;
      align-items: center;
      gap: 20px;
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-bottom: 16px;
    }

    .blog-card-date, .blog-card-read {
      display: flex; align-items: center; gap: 6px;
    }

    .blog-card-readmore {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--primary-color);
      text-decoration: none;
      transition: gap 0.2s, opacity 0.2s;
    }

    .blog-card:hover .blog-card-readmore { gap: 13px; }

    .blog-card-readmore svg {
      transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1);
    }
    .blog-card:hover .blog-card-readmore svg { transform: translateX(4px); }

    /* No results */
    .blog-no-results {
      grid-column: 1 / -1;
      text-align: center;
      padding: 64px 0;
      color: var(--text-muted);
    }
    .blog-no-results-icon { font-size: 3rem; margin-bottom: 14px; }
    .blog-no-results-title { font-size: 1.15rem; font-weight: 800; color: var(--text-secondary); margin-bottom: 8px; }

    /* ── Article / Post view ── */
    #page-article {
      min-height: 100vh;
    }

    /* ── Article back bar (nav strip) ── */
    .article-back-bar {
      padding: 136px 0 0;
    }

    @media (max-width: 768px) {
      .article-back-bar { padding-top: 76px; }
    }

    /* ── Article header card ── */
    .article-header-card {
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 32px;
    }

    /* Top accent bar */
    .article-accent-bar {
      height: 3px;
      background: linear-gradient(90deg, var(--primary-color) 0%, var(--accent-light) 60%, var(--accent-ultra-light) 100%);
    }

    /* Nav strip inside the card */
    .article-nav-strip {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 24px;
      border-bottom: 1px solid var(--border-color);
      background: var(--bg-secondary);
      flex-wrap: wrap;
    }

    .article-nav-tag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--primary-color);
      background: rgba(var(--primary-rgb),0.08);
      border: 1px solid rgba(var(--primary-rgb),0.22);
      border-radius: 999px;
      padding: 3px 10px;
    }
    body.dark-mode .article-nav-tag { background: rgba(var(--primary-rgb),0.14); }

    .article-nav-dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: var(--border-color); flex-shrink: 0;
    }

    .article-nav-date {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .article-nav-chips {
      display: flex; gap: 6px; margin-left: auto; flex-wrap: wrap;
    }

    .article-nav-chip {
      font-size: 0.72rem; font-weight: 600;
      padding: 3px 10px; border-radius: 999px;
      border: 1px solid var(--border-color);
      background: var(--bg-primary);
      color: var(--text-secondary);
    }
    .article-nav-chip.version {
      background: rgba(var(--primary-rgb),0.07);
      border-color: rgba(var(--primary-rgb),0.25);
      color: var(--primary-color);
      font-family: 'JetBrains Mono', monospace;
    }
    body.dark-mode .article-nav-chip.version { background: rgba(var(--primary-rgb),0.14); }

    .article-back-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-secondary);
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      transition: color 0.18s, gap 0.18s;
      font-family: 'Inter', sans-serif;
      flex-shrink: 0;
    }
    .article-back-btn:hover { color: var(--text-primary); gap: 10px; }
    .article-back-btn svg { transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1); }
    .article-back-btn:hover svg { transform: translateX(-4px); }

    .article-breadcrumb {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.78rem;
      color: var(--text-muted);
    }
    .article-breadcrumb-sep { opacity: 0.4; }
    .article-breadcrumb-current {
      color: var(--text-secondary);
      font-weight: 500;
      max-width: 200px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* Header body inside card */
    .article-header-body {
      padding: 22px 24px 18px;
    }

    .article-cat {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--primary-color);
      background: rgba(var(--primary-rgb),0.08);
      border-radius: 999px;
      padding: 4px 12px;
      margin-bottom: 14px;
    }
    body.dark-mode .article-cat { background: rgba(var(--primary-rgb),0.14); }

    /* Title row with version chip */
    .article-title-row {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 0;
    }

    .article-title {
      font-size: clamp(1.6rem, 4vw, 2.4rem);
      font-weight: 900;
      letter-spacing: -0.03em;
      color: var(--text-primary);
      line-height: 1.2;
      flex: 1;
      margin: 0;
    }

    .article-subtitle {
      font-size: 0.92rem;
      color: var(--text-secondary);
      line-height: 1.6;
      margin-top: 8px;
      max-width: 600px;
    }

    .article-version-chip {
      display: inline-flex;
      align-items: center;
      font-size: 0.75rem;
      font-weight: 700;
      font-family: 'JetBrains Mono', monospace;
      color: var(--primary-color);
      background: rgba(var(--primary-rgb),0.08);
      border: 1px solid rgba(var(--primary-rgb),0.25);
      border-radius: 999px;
      padding: 5px 13px;
      white-space: nowrap;
      margin-top: 5px;
      flex-shrink: 0;
    }
    body.dark-mode .article-version-chip { background: rgba(var(--primary-rgb),0.14); }

    /* Meta strip */
    .article-meta-row {
      display: flex;
      align-items: center;
      gap: 0;
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-top: 0;
      padding: 12px 24px;
      border-top: 1px solid var(--border-color);
      background: var(--bg-secondary);
      flex-wrap: wrap;
    }

    .article-meta-item {
      display: flex;
      align-items: center;
      gap: 6px;
      padding-right: 16px;
      margin-right: 16px;
      border-right: 1px solid var(--border-color);
    }
    .article-meta-item:last-child { border-right: none; margin-right: 0; padding-right: 0; }

    /* Actions row */
    .article-actions-row {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 24px 12px;
      border-top: 1px solid var(--border-color);
      flex-wrap: wrap;
    }

    .article-action-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--text-secondary);
      background: none;
      border: 1px solid var(--border-color);
      border-radius: 0;
      padding: 5px 12px;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: background 0.15s, color 0.15s;
    }
    .article-action-btn:hover { background: var(--bg-secondary); color: var(--text-primary); }
    .article-action-btn.primary {
      background: var(--primary-color);
      color: #fff;
      border-color: transparent;
      margin-left: auto;
    }
    .article-action-btn.primary:hover { background: var(--secondary-color); }

    /* ── Blog reactions ── */
    .article-feedback {
      margin-top: 48px;
      padding: 22px 24px;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      background: var(--bg-secondary);
      text-align: center;
    }
    body.light-mode .article-feedback {
      background: #fff;
      border-color: #e2e8f0;
    }
    .article-feedback-title {
      color: var(--text-primary);
      font-size: 0.95rem;
      font-weight: 800;
      margin-bottom: 4px;
    }
    .article-feedback-subtitle {
      color: var(--text-muted);
      font-size: 0.78rem;
      margin-bottom: 16px;
    }
    .article-feedback-actions {
      display: flex;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .article-reaction-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-width: 112px;
      padding: 9px 14px;
      border: 1px solid var(--border-color);
      border-radius: 0;
      background: var(--bg-primary);
      color: var(--text-secondary);
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      font-size: 0.8rem;
      font-weight: 700;
      transition: background 0.15s, border-color 0.15s, color 0.15s, transform 0.15s;
    }
    .article-reaction-btn:hover {
      border-color: rgba(var(--primary-rgb),0.45);
      color: var(--text-primary);
      transform: translateY(-1px);
    }
    .article-reaction-btn:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: 2px;
    }
    .article-reaction-btn svg {
      width: 15px;
      height: 15px;
      flex-shrink: 0;
    }
    .article-reaction-btn.selected-like {
      background: rgba(22,163,74,0.12);
      border-color: #16a34a;
      color: #16a34a;
    }
    .article-reaction-btn.selected-dislike {
      background: rgba(220,38,38,0.12);
      border-color: #dc2626;
      color: #dc2626;
    }
    .article-reaction-count {
      min-width: 1ch;
      font-variant-numeric: tabular-nums;
    }
    .article-feedback-status {
      min-height: 18px;
      margin-top: 12px;
      color: var(--text-muted);
      font-size: 0.72rem;
    }
    .article-feedback-inline {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .article-feedback-inline .article-reaction-btn {
      min-width: auto;
      gap: 5px;
      padding: 5px 10px;
      font-size: 0.78rem;
    }
    .article-feedback-inline .article-reaction-btn svg {
      width: 13px;
      height: 13px;
    }
    .article-view-count {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 2px;
      color: var(--text-muted);
      font-size: 0.78rem;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .article-view-count svg {
      width: 13px;
      height: 13px;
      flex-shrink: 0;
    }

    /* ── Article header refinement ──
       Keep article metadata quiet and let feedback controls read as one
       intentional group instead of a row of unrelated boxes. */
    .article-post-shell {
      padding: 12px 0 0 !important;
    }

    .article-breadcrumb-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 34px;
    }

    .article-breadcrumb-row > span {
      font-size: 0.75rem !important;
    }

    .article-title-block {
      margin-bottom: 26px !important;
    }

    .article-meta-row {
      gap: 0 !important;
      padding: 14px 0 !important;
      margin-bottom: 24px !important;
      background: transparent !important;
      border-top: 1px solid var(--border-color) !important;
      border-bottom: 1px solid var(--border-color) !important;
    }

    .article-meta-row > span {
      display: inline-flex !important;
      align-items: center;
      gap: 7px !important;
      padding: 0 14px 0 0 !important;
      margin: 0 14px 0 0 !important;
      border: 0 !important;
      color: var(--text-muted) !important;
      font-size: 0.76rem !important;
      white-space: nowrap;
    }

    .article-meta-row > span > svg {
      opacity: 0.72;
    }

    .article-meta-row .article-version-chip {
      margin: 0 !important;
      padding: 5px 9px !important;
      border-radius: 7px !important;
      font-size: 0.7rem !important;
      letter-spacing: 0.01em;
    }

    .article-previous-link {
      color: var(--text-muted);
      font-size: 0.76rem;
      white-space: nowrap;
    }

    .article-previous-link a {
      color: var(--primary-color) !important;
      text-decoration: none;
      font-weight: 600;
    }

    .article-previous-link a:hover {
      text-decoration: underline;
    }

    .article-actions-row {
      display: flex !important;
      align-items: center;
      gap: 8px;
      flex-basis: 100%;
      width: 100%;
      justify-content: space-between;
      margin: 12px 0 0 !important;
      padding: 12px 0 0 !important;
      border-top: 1px solid var(--border-color) !important;
      flex-wrap: nowrap;
    }

    .article-feedback-inline {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      padding: 3px;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      background: var(--bg-secondary);
    }

    .article-feedback-inline .article-reaction-btn {
      min-height: 32px;
      padding: 7px 10px;
      border: 0;
      border-radius: 7px;
      background: transparent;
      font-size: 0.76rem;
      font-weight: 700;
    }

    .article-feedback-inline .article-reaction-btn:hover {
      background: rgba(var(--primary-rgb), 0.08);
      border-color: transparent;
      transform: none;
    }

    .article-feedback-inline .article-reaction-btn.selected-like {
      background: rgba(22, 163, 74, 0.14);
      color: #15803d;
    }

    .article-feedback-inline .article-reaction-btn.selected-dislike {
      background: rgba(220, 38, 38, 0.12);
      color: #b91c1c;
    }

    .article-feedback-inline .article-view-count {
      padding: 0 8px 0 10px;
      font-size: 0.76rem;
    }

    .article-actions-row > .article-action-btn {
      min-height: 38px;
      padding: 8px 12px;
      border-radius: 8px;
      background: var(--bg-primary);
      font-size: 0.76rem;
      font-weight: 700;
    }

    .article-actions-row > .article-action-btn:hover {
      background: var(--bg-secondary);
      border-color: rgba(var(--primary-rgb), 0.42);
      color: var(--primary-color);
    }

    @media (max-width: 760px) {
      .article-breadcrumb-row {
        margin-bottom: 24px;
      }

      .article-meta-row {
        align-items: flex-start;
        row-gap: 14px;
      }

      .article-actions-row {
        width: 100%;
        margin-left: 0;
      }

      .article-feedback-inline {
        flex: 1;
      }

      .article-feedback-inline .article-reaction-btn {
        flex: 1;
      }
    }
    .blog-comments-inline {
      margin-top: 42px;
      border: 1px solid var(--border-color);
      border-radius: 14px;
      background: var(--bg-primary);
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
      overflow: hidden;
    }
    .blog-comments-header {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 5px;
      padding: 26px 28px 20px;
      border-bottom: 1px solid var(--border-color);
    }
    .blog-comments-heading {
      display: flex;
      align-items: center;
      gap: 9px;
      min-width: 0;
    }
    .blog-comments-heading-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      flex: 0 0 24px;
      color: #4e9b72;
    }
    .blog-comments-title {
      min-width: 0;
      overflow: hidden;
      color: var(--text-primary);
      font-size: 1.25rem;
      font-weight: 850;
      letter-spacing: -0.025em;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .blog-comments-count {
      color: inherit;
      font-size: 1.25rem;
      font-weight: 850;
      white-space: nowrap;
    }
    .blog-comments-subtitle {
      color: var(--text-muted);
      font-size: 0.78rem;
    }
    .blog-comments-composer {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 22px 28px 24px;
      border-bottom: 1px solid var(--border-color);
      background: var(--bg-primary);
    }
    .blog-comments-composer-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      flex: 0 0 34px;
      margin-top: 3px;
      border-radius: 50%;
      background: linear-gradient(135deg, #4da875, #17633b);
      color: #fff;
      font-size: 0.74rem;
      font-weight: 850;
    }
    .blog-comments-composer-main {
      display: flex;
      flex: 1;
      align-items: flex-start;
      gap: 12px;
      min-width: 0;
    }
    .blog-comments-form {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: 9px;
      min-width: 0;
    }
    .blog-comments-input-row {
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }
    .blog-comments-textarea-wrap {
      position: relative;
      flex: 1;
      min-width: 0;
    }
    .blog-comments-form textarea {
      width: 100%;
      min-height: 100px;
      resize: vertical;
      padding: 13px 14px 30px;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      background: var(--bg-primary);
      color: var(--text-primary);
      font: inherit;
      font-size: 0.84rem;
      line-height: 1.5;
      box-sizing: border-box;
    }
    .blog-comments-form textarea:focus {
      outline: 2px solid rgba(23,139,75,0.22);
      border-color: #178b4b;
    }
    .blog-comments-form-row {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 12px;
    }
    .blog-comments-form-meta {
      display: flex;
      align-items: center;
      min-width: 0;
    }
    .blog-comments-note {
      color: var(--text-muted);
      font-size: 0.7rem;
    }
    .blog-comments-guidelines-link {
      color: #178b4b;
      font-weight: 700;
      text-decoration: none;
    }
    .blog-comments-guidelines-link:hover { text-decoration: underline; }
    .blog-comments-note strong {
      color: #178b4b;
      font-weight: 700;
    }
    .blog-comments-char-count {
      position: absolute;
      right: 12px;
      bottom: 9px;
      color: var(--text-muted);
      font-size: 0.68rem;
      white-space: nowrap;
    }
    .blog-comments-submit {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      flex: 0 0 auto;
      padding: 10px 16px;
      border: 0;
      border-radius: 6px;
      background: #178b4b;
      color: #fff;
      cursor: pointer;
      font: inherit;
      font-size: 0.78rem;
      font-weight: 750;
      white-space: nowrap;
      align-self: center;
      transition: background-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
    }
    .blog-comments-submit:hover {
      background: #126d3a;
      box-shadow: 0 5px 12px rgba(23,139,75,0.2);
      transform: translateY(-1px);
    }
    .blog-comments-submit:focus-visible {
      outline: 2px solid rgba(23,139,75,0.4);
      outline-offset: 2px;
    }
    .blog-comments-submit:disabled {
      cursor: wait;
      opacity: 0.65;
    }
    .blog-comments-guidelines {
      padding-left: 48px;
      color: var(--text-muted);
      font-size: 0.68rem;
    }
    .blog-comments-guidelines strong {
      color: #178b4b;
      font-weight: 700;
    }
    .blog-comments-list {
      min-height: 76px;
      max-height: 520px;
      overflow-y: auto;
      padding: 0 28px 28px;
    }
    .blog-comment {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-top: 16px;
      padding: 16px;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      background: var(--bg-primary);
      box-shadow: 0 3px 12px rgba(15, 23, 42, 0.035);
    }
    .blog-comment-avatar {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      flex: 0 0 34px;
      border: 2px solid var(--bg-primary);
      border-radius: 50%;
      background: linear-gradient(135deg, #3a78b8, #173f68);
      color: #fff;
      font-size: 0.68rem;
      font-weight: 900;
      overflow: hidden;
    }
    .blog-comment-avatar img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }
    .blog-comment:nth-child(3n) .blog-comment-avatar {
      background: linear-gradient(135deg, #d8893e, #70401c);
    }
    .blog-comment:nth-child(3n + 1) .blog-comment-avatar {
      background: linear-gradient(135deg, #4da875, #17633b);
    }
    .blog-comment-content {
      min-width: 0;
      flex: 1;
    }
    .blog-comment-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 6px;
      color: var(--text-muted);
      font-size: 0.7rem;
    }
    .blog-comment-author { color: #178b4b; font-weight: 800; }
    .blog-comment-text {
      color: var(--text-secondary);
      font-size: 0.86rem;
      line-height: 1.6;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .blog-comment-actions {
      display: flex;
      align-items: center;
      gap: 18px;
      margin-top: 10px;
    }
    .blog-comment-action {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--text-muted);
      cursor: pointer;
      font: inherit;
      font-size: 0.7rem;
    }
    .blog-comment-action:hover { color: #178b4b; }
    .blog-comment-more {
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 1rem;
      line-height: 1;
    }
    .blog-comment-more:hover { color: var(--text-primary); }
    .blog-comments-load-more {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: fit-content;
      margin: 20px auto 0;
      padding: 8px 18px;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      background: var(--bg-primary);
      color: #178b4b;
      cursor: pointer;
      font: inherit;
      font-size: 0.74rem;
      font-weight: 750;
    }
    .blog-comments-load-more:hover {
      border-color: rgba(23,139,75,0.45);
      background: rgba(23,139,75,0.06);
    }
    .blog-comments-empty {
      padding: 28px 0;
      color: var(--text-muted);
      font-size: 0.82rem;
      text-align: center;
    }
    @media (max-width: 640px) {
      .blog-comments-header { padding: 22px 18px 17px; }
      .blog-comments-composer { padding-left: 18px; padding-right: 18px; }
      .blog-comments-list { max-height: 48vh; padding-left: 18px; padding-right: 18px; padding-bottom: 20px; }
      .blog-comments-input-row { flex-direction: column; }
      .blog-comments-submit { align-self: flex-end; }
      .blog-comment { padding: 14px; }
    }

    /* Final comments surface: spacious, quiet, and deliberately card-based. */
    .blog-comments-inline {
      margin-top: 32px;
      border: 1px solid #e2ebe5;
      border-radius: 6px;
      background: linear-gradient(180deg, #ffffff 0%, #fbfefc 100%);
      box-shadow: 0 18px 48px rgba(25, 65, 43, 0.09), 0 2px 8px rgba(25, 65, 43, 0.04);
    }
    .blog-comments-header {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding: 14px 24px;
      min-height: 0;
      background: #ffffff;
    }
    .blog-comments-heading {
      position: relative;
      display: block !important;
      min-height: 26px;
    }
    .blog-comments-heading-icon {
      position: absolute;
      top: 0;
      left: 0;
      width: 26px;
      height: 26px;
      flex-basis: 26px;
      border: 1px solid #cfe8d8;
      border-radius: 4px;
      background: #effaf3;
      color: #268f5b;
    }
    .blog-comments-title {
      margin: 0;
      padding-left: 36px;
      font-size: 1.2rem;
      line-height: 26px;
      letter-spacing: -0.035em;
    }
    .blog-comments-count {
      color: #268f5b;
      font-size: 0.95rem;
      letter-spacing: -0.01em;
    }
    .blog-comments-subtitle {
      margin-left: 36px;
      color: #82918b;
      font-size: 0.79rem;
      line-height: 1.3;
    }
    .blog-comments-composer {
      gap: 12px;
      padding: 14px 24px 8px;
      border-top: 1px solid #edf2ee;
      border-bottom: 1px solid #e7eee9;
      background: #f8fbf9;
    }
    .blog-comments-composer-icon {
      width: 34px;
      height: 34px;
      flex-basis: 34px;
      margin-top: 2px;
      box-shadow: 0 4px 10px rgba(23, 139, 75, 0.18);
    }
    .blog-comments-composer-icon img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }
    .blog-comments-composer-main { gap: 14px; }
    .blog-comments-form { gap: 4px; }
    .blog-comments-input-row { gap: 10px; }
    .blog-comments-textarea-wrap { min-width: 0; }
    .blog-comments-form textarea {
      height: 56px;
      min-height: 56px;
      max-height: 56px;
      resize: none;
      padding: 10px 13px 24px;
      border-color: #dce8e0;
      border-radius: 6px;
      background: #ffffff;
      color: #1b2a23;
      font-size: 0.86rem;
      box-shadow: inset 0 1px 2px rgba(25, 65, 43, 0.03);
      transition: border-color 160ms ease, box-shadow 160ms ease;
    }
    .blog-comments-form textarea::placeholder { color: #9aa59f; }
    .blog-comments-form textarea:focus {
      outline: none;
      border-color: #4ca875;
      box-shadow: 0 0 0 4px rgba(76, 168, 117, 0.12);
    }
    .blog-comments-char-count {
      right: 14px;
      bottom: 10px;
      color: #9aa59f;
      font-size: 0.7rem;
    }
    .blog-comments-submit {
      min-height: 38px;
      padding: 9px 14px;
      border-radius: 6px;
      background: linear-gradient(135deg, #2c9a61, #16814a);
      box-shadow: 0 5px 12px rgba(23, 139, 75, 0.16);
      font-size: 0.79rem;
    }
    .blog-comments-submit:hover {
      background: linear-gradient(135deg, #238b55, #116d3e);
      box-shadow: 0 7px 16px rgba(23, 139, 75, 0.22);
    }
    .blog-comments-form-row { padding-left: 0; }
    .blog-comments-note {
      color: #899690;
      font-size: 0.72rem;
    }
    .blog-comments-list {
      max-height: 480px;
      padding: 8px 24px 22px;
      background: #fbfdfc;
    }
    .blog-comment {
      gap: 11px;
      margin-top: 8px;
      padding: 13px 14px 12px;
      border-color: #e1ebe4;
      border-radius: 6px;
      background: #ffffff;
      box-shadow: 0 5px 16px rgba(25, 65, 43, 0.055);
      transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    }
    .blog-comment:hover {
      border-color: #cfe3d5;
      box-shadow: 0 8px 22px rgba(25, 65, 43, 0.08);
      transform: translateY(-1px);
    }
    .blog-comment-avatar {
      width: 34px;
      height: 34px;
      flex-basis: 34px;
      border: 0;
      box-shadow: 0 3px 8px rgba(25, 65, 43, 0.14);
      font-size: 0.72rem;
    }
    .blog-comment-meta {
      margin-bottom: 5px;
      font-size: 0.71rem;
    }
    .blog-comment-byline {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      min-width: 0;
    }
    .blog-comment-separator { color: #b7c2bc; }
    .blog-comment-time { color: #9aa59f; }
    .blog-comment-text {
      color: #34443b;
      font-size: 0.88rem;
      line-height: 1.55;
    }
    .blog-comment-hidden {
      border-style: dashed;
      background: #fafcfb;
    }
    .blog-comment-hidden .blog-comment-text {
      color: #899690;
      font-style: italic;
    }
    .blog-comment-reply-context {
      display: flex;
      align-items: center;
      gap: 5px;
      margin: 1px 0 7px;
      color: #4c9a6b;
      font-size: 0.69rem;
      line-height: 1.2;
    }
    .blog-comment-reply-context::before {
      content: '↳';
      color: #2c9a61;
      font-size: 0.9rem;
      font-weight: 800;
    }
    .blog-comment-reply-context strong {
      color: #267b4c;
      font-weight: 800;
    }
    .blog-comment-actions {
      gap: 12px;
      margin-top: 8px;
    }
    .blog-comment-action {
      gap: 5px;
      color: #9aa59f;
      font-size: 0.72rem;
      transition: color 140ms ease, background-color 140ms ease;
    }
    .blog-comment-action svg {
      width: 15px;
      height: 15px;
      stroke: currentColor;
    }
    .blog-comment-action:hover {
      color: #268f5b;
      background: #effaf3;
    }
    .blog-comment-action.selected {
      color: #178b4b;
      background: #effaf3;
    }
    .blog-comment-reported {
      display: inline-flex;
      align-items: center;
      min-height: 32px;
      padding: 6px 8px;
      color: #9aa59f;
      font-size: 0.72rem;
      font-weight: 700;
    }
    .blog-comment-reply {
      position: relative;
      margin-top: 6px;
      margin-left: 42px;
      padding: 11px 14px 12px 16px;
      border-left: 3px solid #9ed7b2;
      background: #f6fbf7;
      box-shadow: 0 3px 10px rgba(25, 65, 43, 0.04);
    }
    .blog-comment-reply::before {
      content: '';
      position: absolute;
      top: 25px;
      left: -15px;
      width: 12px;
      border-top: 2px solid #9ed7b2;
    }
    .blog-comment-reply[data-reply-depth="2"] { margin-left: 72px; }
    .blog-comment-reply[data-reply-depth="3"],
    .blog-comment-reply[data-reply-depth="4"],
    .blog-comment-reply[data-reply-depth="5"] { margin-left: 96px; }
    .blog-comment-reply .blog-comment-avatar {
      width: 30px;
      height: 30px;
      flex-basis: 30px;
    }
    .blog-comment-more {
      width: 22px;
      height: 22px;
      border-radius: 3px;
      color: #9aa59f;
      transition: color 140ms ease, background-color 140ms ease;
    }
    .blog-comment-more:hover { background: #effaf3; color: #268f5b; }
    .blog-comment-menu-wrap {
      position: relative;
      flex: 0 0 auto;
      margin-left: auto;
    }
    .blog-comment-menu {
      position: absolute;
      z-index: 20;
      top: 27px;
      right: 0;
      display: none;
      min-width: 126px;
      padding: 5px;
      border: 1px solid #dce8e0;
      background: #ffffff;
      box-shadow: 0 8px 20px rgba(25, 65, 43, 0.14);
    }
    .blog-comment-menu.is-open { display: grid; gap: 2px; }
    .blog-comment-menu button {
      width: 100%;
      padding: 8px 10px;
      border: 0;
      background: transparent;
      color: #52635a;
      cursor: pointer;
      font: inherit;
      font-size: 0.74rem;
      text-align: left;
    }
    .blog-comment-menu button:hover {
      background: #effaf3;
      color: #178b4b;
    }
    .blog-comment-menu button[data-comment-menu-action="remove"]:hover {
      background: #fff1f1;
      color: #c43d3d;
    }
    .blog-comments-load-more {
      margin: 14px auto 0;
      padding: 8px 15px;
      border-color: #d7e6db;
      border-radius: 5px;
      color: #268f5b;
      background: #ffffff;
      box-shadow: 0 2px 5px rgba(25, 65, 43, 0.04);
      transition: border-color 140ms ease, background-color 140ms ease, transform 140ms ease;
    }
    .blog-comments-load-more:hover {
      border-color: #9bcaae;
      background: #effaf3;
      transform: translateY(-1px);
    }
    .blog-comments-empty {
      padding: 28px 20px;
      color: #899690;
    }
    @media (max-width: 640px) {
      .blog-comments-inline { border-radius: 5px; }
      .blog-comments-header { padding: 12px 16px; }
      .blog-comments-subtitle { margin-left: 36px; }
      .blog-comments-composer { padding: 12px 16px 8px; }
      .blog-comments-composer-main { gap: 10px; }
      .blog-comments-list { padding: 8px 12px 16px; }
      .blog-comments-input-row { gap: 10px; }
      .blog-comments-submit { align-self: flex-end; }
      .blog-comment-reply,
      .blog-comment-reply[data-reply-depth="2"],
      .blog-comment-reply[data-reply-depth="3"],
      .blog-comment-reply[data-reply-depth="4"],
      .blog-comment-reply[data-reply-depth="5"] {
        margin-left: 20px;
      }
    }

    /* Flat treatment requested for the entire comments surface. */
    .blog-comments-inline,
    .blog-comments-heading-icon,
    .blog-comments-composer-icon,
    .blog-comments-form textarea,
    .blog-comments-submit,
    .blog-comment,
    .blog-comment-avatar,
    .blog-comment-more,
    .blog-comments-load-more {
      border-radius: 0 !important;
    }

    /* Mobile comments: keep the thread readable and make every control easy
       to see and tap, including the own-comment overflow menu. */
    @media (max-width: 640px) {
      .blog-comments-inline {
        margin-top: 24px;
        overflow: visible;
      }
      .blog-comments-header {
        padding: 16px 14px 13px;
      }
      .blog-comments-title {
        font-size: 1.08rem;
      }
      .blog-comments-count {
        font-size: 0.9rem;
      }
      .blog-comments-subtitle {
        font-size: 0.74rem;
      }
      .blog-comments-composer {
        align-items: flex-start;
        gap: 9px;
        padding: 14px 14px 12px;
      }
      .blog-comments-composer-main {
        width: 100%;
      }
      .blog-comments-form textarea {
        height: 88px;
        min-height: 88px;
        max-height: 140px;
        padding: 11px 12px 25px;
        font-size: 0.88rem;
      }
      .blog-comments-submit {
        width: 100%;
        min-height: 40px;
      }
      .blog-comments-form-row {
        align-items: flex-start;
      }
      .blog-comments-note {
        line-height: 1.45;
      }
      .blog-comments-list {
        max-height: none;
        overflow: visible;
        padding: 8px 10px 16px;
      }
      .blog-comment {
        position: relative;
        gap: 9px;
        margin-top: 8px;
        padding: 12px 10px;
      }
      .blog-comment-avatar {
        width: 32px;
        height: 32px;
        flex-basis: 32px;
      }
      .blog-comment-meta {
        gap: 6px;
        margin-bottom: 6px;
      }
      .blog-comment-byline {
        gap: 5px;
        overflow: hidden;
      }
      .blog-comment-author,
      .blog-comment-time {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .blog-comment-more {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        margin: -6px -4px -4px 0;
        color: #5f7167;
        font-size: 1.35rem;
        line-height: 1;
        -webkit-tap-highlight-color: transparent;
      }
      .blog-comment-more:active,
      .blog-comment-more:focus-visible {
        background: #effaf3;
        color: #178b4b;
        outline: 2px solid rgba(23, 139, 75, 0.22);
        outline-offset: 1px;
      }
      .blog-comment-menu {
        top: 31px;
        right: -2px;
        min-width: 142px;
        padding: 6px;
      }
      .blog-comment-menu button {
        min-height: 38px;
        padding: 9px 11px;
        font-size: 0.8rem;
      }
      .blog-comment-text {
        font-size: 0.86rem;
        line-height: 1.55;
      }
      .blog-comment-actions {
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 11px;
      }
      .blog-comment-action {
        min-height: 32px;
        padding: 6px 8px;
        border: 1px solid #e1ebe4;
        border-radius: 999px !important;
        background: #fbfefc;
      }
      .blog-comment-action:active,
      .blog-comment-action:focus-visible {
        background: #effaf3;
        outline: 2px solid rgba(23, 139, 75, 0.18);
        outline-offset: 1px;
      }
      .blog-comment-reply,
      .blog-comment-reply[data-reply-depth="2"],
      .blog-comment-reply[data-reply-depth="3"],
      .blog-comment-reply[data-reply-depth="4"],
      .blog-comment-reply[data-reply-depth="5"] {
        margin-left: 14px;
        padding-left: 12px;
      }
    }

    /* Platform row at bottom of header card */
    .article-platform-row {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 11px 28px 13px;
    }
    .article-platform-label {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--text-muted);
      margin-right: 2px;
    }
    .article-platform-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text-secondary);
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 999px;
      padding: 4px 11px;
    }
    .article-platform-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--primary-color);
      display: inline-block;
      flex-shrink: 0;
    }

    .article-container {
      max-width: 820px;
      margin: 0 auto;
      padding: 0 24px 100px;
    }

    .article-hero-img {
      width: 100%;
      border-radius: 0;
      overflow: hidden;
      margin-bottom: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .article-hero-img:empty { display: none; margin: 0; }

    .article-hero-img img {
      width: 100%;
      height: auto;
      display: block;
      object-fit: contain;
      object-position: center;
    }

    .article-hero-img-inner {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* ── Image slideshow (multi-image thumbImage array) ── */
    .img-slider { position: relative; width: 100%; overflow: hidden; }
    .img-slider-track {
      display: flex; transition: transform 0.4s ease;
    }
    .img-slider-track img {
      flex-shrink: 0; width: 100%; height: auto; object-fit: contain; object-position: center; display: block;
    }
    .img-slider-btn {
      position: absolute; top: 50%; transform: translateY(-50%);
      background: rgba(0,0,0,0.5); border: none; color: #fff; cursor: pointer;
      width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;
      z-index: 2; transition: background 0.15s; padding: 0;
    }
    .img-slider-btn:hover { background: rgba(0,0,0,0.75); }
    .img-slider-btn.prev { left: 8px; }
    .img-slider-btn.next { right: 8px; }
    .img-slider-dots {
      position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%);
      display: flex; gap: 5px; z-index: 2;
    }
    .img-slider-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: rgba(255,255,255,0.45); border: none; cursor: pointer; padding: 0;
      transition: background 0.2s;
    }
    .img-slider-dot.active { background: #fff; }

    .article-body {
      font-size: 1.05rem;
      line-height: 1.8;
      color: var(--text-secondary);
    }

    .article-body h2 {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.025em;
      color: var(--text-primary);
      margin: 40px 0 16px;
    }

    .article-body h3 {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 28px 0 12px;
    }

    .article-body p { margin-bottom: 20px; }

    .article-body ul, .article-body ol {
      padding-left: 24px;
      margin-bottom: 20px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .article-body li { color: var(--text-secondary); }

    .article-body strong { color: var(--text-primary); font-weight: 700; }

    .article-body em { color: var(--primary-color); font-style: normal; font-weight: 600; }

    .article-body blockquote {
      border-left: 3px solid var(--primary-color);
      padding: 16px 20px;
      margin: 28px 0;
      background: rgba(var(--primary-rgb),0.06);
      border-radius: 0;
      font-style: italic;
      color: var(--text-primary);
    }

    body.light-mode .article-body blockquote {
      background: rgba(var(--primary-rgb),0.05);
    }

    .article-body pre, .article-body code {
      max-width: 100%;
      overflow-x: auto;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .article-back-footer {
      margin-top: 56px;
      padding-top: 32px;
      border-top: 1px solid var(--border-color);
    }

    /* ── Update Log page ───────────────────────────────────────── */
    /* ── Collapsible update entries ── */
    .ul-entry { margin-bottom: 16px; border: 1px solid var(--border-color); background: var(--bg-primary); transition: box-shadow 0.2s; }
    .ul-entry:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.07); }
    .ul-entry.expanded { margin-bottom: 32px; box-shadow: 0 4px 24px rgba(var(--primary-rgb),0.09); border-color: rgba(var(--primary-rgb),0.3); }
    .ul-entry-header {
      display: flex; align-items: center; gap: 14px;
      padding: 18px 22px; cursor: pointer; user-select: none;
      margin-bottom: 0;
    }
    .ul-entry-header:hover { background: var(--bg-secondary); }
    .ul-entry.expanded .ul-entry-header { background: var(--bg-secondary); border-bottom: 1px solid var(--border-color); }
    .ul-entry-chevron {
      margin-left: auto; flex-shrink: 0;
      width: 28px; height: 28px;
      display: flex; align-items: center; justify-content: center;
      border: 1px solid var(--border-color); background: var(--bg-tertiary);
      color: var(--text-muted); transition: transform 0.25s, background 0.15s, color 0.15s;
    }
    .ul-entry.expanded .ul-entry-chevron {
      transform: rotate(180deg);
      background: rgba(var(--primary-rgb),0.1);
      color: var(--primary-color);
      border-color: rgba(var(--primary-rgb),0.3);
    }
    .ul-entry-body {
      display: none;
      padding: 24px 28px 28px;
    }
    .ul-entry.expanded .ul-entry-body { display: block; }
    .ul-entry-summary {
      font-size: 0.82rem; color: var(--text-muted); line-height: 1.5;
      margin-top: 3px; max-width: 520px;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .ul-entry.expanded .ul-entry-summary { display: none; }
    .ul-entry-change-count {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: 0.68rem; font-weight: 700; padding: 2px 8px;
      background: rgba(var(--primary-rgb),0.1); border: 1px solid rgba(var(--primary-rgb),0.2);
      color: var(--primary-color); letter-spacing: 0.04em; margin-left: 6px;
    }
    .ul-entry-icon {
      width: 44px; height: 44px; background: linear-gradient(135deg,var(--primary-color),var(--secondary-color));
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .ul-entry-title {
      font-size: 1.5rem; font-weight: 900; letter-spacing: -0.03em; color: var(--text-primary);
    }
    .ul-entry-meta {
      display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 4px;
    }
    .ul-entry-date { font-size: 0.82rem; color: var(--text-muted); }
    /* ── Update Log platform filter tabs ── */
    .ul-platform-tabs {
      display: flex; gap: 6px; margin-bottom: 28px; flex-wrap: wrap;
    }
    .ul-ptab {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 8px 18px; border: 1px solid var(--border-color);
      background: var(--bg-secondary); color: var(--text-secondary);
      font-family: 'Inter', sans-serif; font-size: 0.82rem; font-weight: 600;
      cursor: pointer; transition: background 0.15s, border-color 0.15s, color 0.15s;
      border-radius: 0;
    }
    .ul-ptab:hover {
      background: var(--bg-tertiary); color: var(--text-primary);
      border-color: var(--text-muted);
    }
    .ul-ptab.active {
      background: rgba(var(--primary-rgb),0.1);
      border-color: rgba(var(--primary-rgb),0.5);
      color: var(--primary-color);
    }
    .ul-ptab svg { flex-shrink: 0; }
    .ul-version-badge {
      font-size: 0.68rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase;
      padding: 3px 10px; border: 1px solid rgba(var(--primary-rgb),0.3); color: var(--primary-color);
      background: rgba(var(--primary-rgb),0.1);
    }
    .ul-breaking-badge {
      font-size: 0.68rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase;
      padding: 3px 10px; border: 1px solid rgba(239,68,68,0.35); color: #ef4444;
      background: rgba(239,68,68,0.1);
    }
    .ul-platform-badge {
      font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em;
      padding: 3px 9px; border: 1px solid var(--border-color); color: var(--text-muted);
      background: var(--bg-tertiary);
    }
    .ul-breaking-banner {
      display: flex; align-items: flex-start; gap: 12px;
      background: rgba(239,68,68,0.07); border: 1px solid rgba(239,68,68,0.25);
      border-left: 3px solid #ef4444; padding: 14px 18px; margin-bottom: 20px;
      font-size: 0.88rem; color: var(--text-secondary); line-height: 1.55;
    }
    .ul-breaking-banner strong { color: #ef4444; }
    .ul-download-bar {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      margin-bottom: 20px;
    }
    .ul-download-btn {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 0.8rem; font-weight: 700; padding: 8px 16px;
      border: 1px solid rgba(var(--primary-rgb),0.4); color: var(--primary-color);
      background: rgba(var(--primary-rgb),0.07); cursor: pointer; text-decoration: none;
      transition: background 0.15s, border-color 0.15s;
    }
    .ul-download-btn:hover { background: rgba(var(--primary-rgb),0.14); border-color: rgba(var(--primary-rgb),0.6); }
    .ul-intro {
      background: var(--bg-secondary); border: 1px solid var(--border-color);
      padding: 24px 28px; margin-bottom: 24px; border-left: 3px solid var(--primary-color);
      font-size: 0.97rem; line-height: 1.75; color: var(--text-secondary);
    }
    .ul-intro p { margin: 0; }
    .ul-intro p + p { margin-top: 14px; }
    /* ── Changes section — matches old update log style ── */
    .ul-divider { display:flex; align-items:center; gap:14px; margin:8px 0 48px; }
    .ul-divider-line { flex:1; height:1px; background:var(--border-color); }
    .ul-divider-text { font-size:0.75rem; color:var(--text-muted); white-space:nowrap; }
    .changes-section { margin:36px 0 8px; }
    .changes-section-title { font-size:0.72rem; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-muted); margin-bottom:0; }
    .ch-group { margin-bottom:12px; border:1px solid var(--border-color); }
    .ch-group:last-child { margin-bottom:0; }
    .ch-group-header {
      display:flex; align-items:center; gap:10px;
      padding:11px 18px;
      border-bottom:1px solid var(--border-color);
    }
    .ch-group-header.added    { background:rgba(var(--primary-rgb),0.07); }
    .ch-group-header.removed  { background:rgba(239,68,68,0.07); }
    .ch-group-header.fixed    { background:rgba(34,197,94,0.07); }
    .ch-group-header.improved { background:rgba(245,158,11,0.07); }
    .ch-group-header.other    { background:rgba(168,85,247,0.07); }
    .ch-group-header.mobile      { background:rgba(20,184,166,0.07); }
    .ch-group-header.frplus      { background:rgba(234,179,8,0.10); }
    .ch-group-header.translation { background:rgba(99,102,241,0.07); }
    .ch-group-icon { font-size:1rem; line-height:1; }
    .ch-group-label {
      font-size:0.7rem; font-weight:900; letter-spacing:0.1em; text-transform:uppercase;
    }
    .ch-group-label.added       { color:var(--primary-color); }
    .ch-group-label.removed     { color:#ef4444; }
    .ch-group-label.fixed       { color:#22c55e; }
    .ch-group-label.improved    { color:#d97706; }
    .ch-group-label.other       { color:#a855f7; }
    .ch-group-label.mobile      { color:#14b8a6; }
    .ch-group-label.frplus      { color:#ca8a04; }
    .ch-group-label.translation { color:#6366f1; }
    .ch-item-sym.mobile         { color:#14b8a6; }
    .ch-item-sym.translation    { color:#6366f1; }
    .ch-item {
      display:flex; align-items:flex-start; gap:14px;
      padding:11px 18px;
      border-bottom:1px solid var(--border-color);
      font-size:0.88rem; color:var(--text-secondary); line-height:1.55;
      background:var(--bg-primary); transition:background 0.12s;
    }
    .ch-item:last-child { border-bottom:none; }
    .ch-item:hover { background:var(--bg-secondary); }
    .ch-item-sym { flex-shrink:0; margin-top:1px; font-size:0.85rem; font-style:normal; }
    .ch-item-sym.added    { color:var(--primary-color); }
    .ch-item-sym.removed  { color:#ef4444; }
    .ch-item-sym.fixed    { color:#22c55e; }
    .ch-item-sym.improved { color:#d97706; }
    .ch-item-sym.other    { color:#a855f7; }

    /* Expandable ch-item with moreInfo */
    .ch-item-expandable { cursor:pointer; align-items:flex-start; }
    .ch-item-expandable:hover { background:var(--bg-tertiary); }
    .ch-item-inner { flex:1; min-width:0; }
    .ch-item-row { display:flex; align-items:center; justify-content:space-between; gap:10px; }
    .ch-item-more-icon {
      flex-shrink:0; color:var(--text-muted);
      transition: transform 0.2s;
      display:flex; align-items:center;
    }
    .ch-item-more {
      display:none; margin-top:8px;
      font-size:0.8rem; line-height:1.6;
      color:var(--text-secondary);
      background:var(--bg-tertiary);
      border-left:2px solid var(--primary-color);
      padding:8px 12px;
    }
    .ch-item-more.open { display:block; }

    /* ── Hover badge on change items (used by the feature-history badge) ── */
    .ch-item-status {
      position: relative;
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px; height: 18px;
      font-size: 0.82rem;
      line-height: 1;
      cursor: help;
      margin-left: 2px;
    }
    .ch-item-status::after {
      content: attr(data-tooltip);
      position: absolute;
      bottom: calc(100% + 8px);
      left: 50%;
      transform: translateX(-50%) translateY(4px);
      background: #1e293b;
      color: #f8fafc;
      font-family: 'Inter', sans-serif;
      font-size: 0.72rem;
      font-weight: 500;
      line-height: 1.4;
      white-space: nowrap;
      padding: 7px 11px;
      border-radius: 6px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.25);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s ease, transform 0.15s ease;
      z-index: 30;
    }
    .ch-item-status::before {
      content: '';
      position: absolute;
      bottom: calc(100% + 3px);
      left: 50%;
      transform: translateX(-50%);
      border: 5px solid transparent;
      border-top-color: #1e293b;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s ease;
      z-index: 30;
    }
    .ch-item-status:hover::after,
    .ch-item-status:hover::before,
    .ch-item-status:focus::after,
    .ch-item-status:focus::before,
    .ch-item-status.tt-show::after,
    .ch-item-status.tt-show::before {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* ── Feature history badge: "removed in vX" / "returned in vY" (computed from the other updates) ── */
    .ch-item-status[data-lc] { color:#94a3b8; margin-left:6px; vertical-align:middle; }
    .ch-item-status[data-lc]:hover, .ch-item-status[data-lc].tt-show { color:#64748b; }
    .ch-item-status[data-lc] svg { display:block; }
    .ch-item-status[data-lc]::after { white-space:pre; text-align:left; }
    @media (max-width: 640px) {
      .ch-item-status[data-lc]::after { white-space:pre-line; width:max-content; max-width:220px; }
    }

    @media (max-width: 640px) {
      /* Tooltips can overflow narrow screens above the item; flip below on mobile */
      .ch-item-status::after {
        bottom: auto; top: calc(100% + 8px);
        transform: translateX(-50%) translateY(-4px);
        white-space: normal; max-width: 220px;
      }
      .ch-item-status::before {
        bottom: auto; top: calc(100% + 3px);
        border-top-color: transparent;
        border-bottom-color: #1e293b;
      }
      .ch-item-status:hover::after,
      .ch-item-status:hover::before { transform: translateX(-50%) translateY(0); }
    }



    /* ═══════════════════════════════
       UNINSTALL PAGE
    ═══════════════════════════════ */
    /* ═══ UNINSTALL PAGE ═══ */
    #page-uninstall { padding-top: 60px; background: var(--bg-body); min-height: 100vh; }

    /* ── Rating scale ─────────────────────────────────────────── */
    .ui-scale { display: grid; grid-template-columns: repeat(5,1fr); gap: 8px; }
    .ui-scale-opt {
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      padding: 14px 6px; border: 1.5px solid var(--border-color);
      background: var(--bg-secondary); cursor: pointer; user-select: none;
      transition: border-color 0.12s, background 0.12s;
    }
    .ui-scale-opt:hover { border-color: rgba(var(--primary-rgb),0.45); }
    .ui-scale-opt.selected { border-color: var(--primary-color); background: rgba(var(--primary-rgb),0.06); }
    .ui-scale-opt .ui-scale-emoji { font-size: 1.3rem; }
    .ui-scale-opt .ui-scale-label { font-size: 0.66rem; color: var(--text-muted); font-weight: 600; text-align: center; }
    .ui-scale-opt.selected .ui-scale-label { color: var(--primary-color); }

    /* ── Reasons card (revealed after a rating is picked) ───────── */
    .ui-reasons-card { display: none; margin-top: 14px; }
    .ui-reasons-card.show { display: block; }

    /* ── Hero ─────────────────────────────────────────────────── */
    .ui-hero {
      background: linear-gradient(135deg, rgba(var(--primary-rgb),1) 0%, #1565c0 65%, #0d47a1 100%);
      padding: 72px 28px 68px;
      position: relative;
      overflow: hidden;
    }
    .ui-hero::before {
      content: '';
      position: absolute; inset: 0;
      background-image: radial-gradient(rgba(255,255,255,0.07) 1px, transparent 1px);
      background-size: 26px 26px;
      pointer-events: none;
    }
    .ui-hero::after {
      content: '';
      position: absolute;
      right: -80px; bottom: -60px;
      width: 340px; height: 340px;
      border-radius: 50%;
      background: rgba(255,255,255,0.04);
      pointer-events: none;
    }
    .ui-hero-inner { max-width: 640px; margin: 0 auto; position: relative; z-index: 1; }
    .ui-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: rgba(255,255,255,0.55);
      margin-bottom: 18px;
    }
    .ui-eyebrow img { width: 16px; height: 16px; border-radius: 3px; opacity: 0.85; }
    .ui-title {
      font-size: 2.75rem; font-weight: 900; color: #fff;
      letter-spacing: -0.04em; line-height: 1.08; margin: 0 0 18px;
    }
    .ui-title em { font-style: normal; opacity: 0.6; }
    .ui-sub { font-size: 0.97rem; color: rgba(255,255,255,0.68); line-height: 1.65; max-width: 400px; }

    /* ── Body ─────────────────────────────────────────────────── */
    .ui-body { max-width: 640px; margin: 0 auto; padding: 36px 24px 90px; }

    /* ── Main card ────────────────────────────────────────────── */
    .ui-card {
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      padding: 28px 26px 24px;
    }
    .ui-card-header {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 12px; margin-bottom: 22px;
    }
    .ui-card-title { font-size: 0.95rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em; }
    .ui-card-hint { font-size: 0.75rem; color: var(--text-muted); font-weight: 500; white-space: nowrap; transition: color 0.15s; }
    .ui-card-hint.at-limit { color: var(--primary-color); font-weight: 600; }

    /* ── Reason list ──────────────────────────────────────────── */
    .ui-reasons { display: flex; flex-direction: column; gap: 6px; }
    .ui-reason-wrap { display: flex; flex-direction: column; }

    .ui-reason {
      display: flex; align-items: center; gap: 10px;
      padding: 12px 13px;
      border: 1.5px solid var(--border-color);
      background: var(--bg-secondary);
      cursor: pointer; user-select: none;
      transition: border-color 0.12s, background 0.12s;
      position: relative;
    }
    .ui-reason:hover { border-color: rgba(var(--primary-rgb),0.45); background: rgba(var(--primary-rgb),0.03); }
    .ui-reason.at-limit-disabled { opacity: 0.45; cursor: not-allowed; pointer-events: none; }
    .ui-reason.selected {
      border-color: var(--primary-color);
      border-left-width: 3px;
      background: rgba(var(--primary-rgb),0.06);
    }
    .ui-reason input[type="checkbox"] { display: none; }

    .ui-reason-emoji { font-size: 1.05rem; line-height: 1; flex-shrink: 0; }
    .ui-reason-label { font-size: 0.82rem; color: var(--text-secondary); line-height: 1.35; flex: 1; }
    .ui-reason.selected .ui-reason-label { color: var(--text-primary); font-weight: 600; }

    .ui-reason-check {
      width: 17px; height: 17px; flex-shrink: 0;
      border: 1.5px solid var(--border-color); background: var(--bg-primary);
      display: flex; align-items: center; justify-content: center;
      transition: background 0.12s, border-color 0.12s;
    }
    .ui-reason.selected .ui-reason-check { background: var(--primary-color); border-color: var(--primary-color); }
    .ui-reason-check svg { display: none; }
    .ui-reason.selected .ui-reason-check svg { display: block; }

    /* ── Inline textarea ──────────────────────────────────────── */
    .ui-inline {
      max-height: 0; overflow: hidden;
      transition: max-height 0.28s cubic-bezier(0.4,0,0.2,1);
      border: 1.5px solid transparent; border-top: none;
      background: rgba(var(--primary-rgb),0.03);
    }
    .ui-inline.open { max-height: 160px; border-color: var(--primary-color); }
    .ui-inline textarea {
      width: 100%; padding: 10px 12px;
      border: none; background: transparent; outline: none;
      color: var(--text-primary); font-family: 'Inter', sans-serif;
      font-size: 0.84rem; line-height: 1.6; resize: none; box-sizing: border-box;
    }
    .ui-inline-foot {
      display: flex; justify-content: flex-end;
      padding: 0 12px 8px;
      font-size: 0.68rem; color: var(--text-muted);
    }

    /* ── Error ────────────────────────────────────────────────── */
    .ui-error {
      margin-top: 16px; padding: 11px 14px;
      background: rgba(239,68,68,0.07);
      border: 1px solid rgba(239,68,68,0.25); border-left: 3px solid #ef4444;
      font-size: 0.82rem; color: #ef4444; line-height: 1.5; display: none;
    }

    /* ── Submit ───────────────────────────────────────────────── */
    .ui-submit {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      width: 100%; margin-top: 20px; padding: 13px 24px;
      background: var(--primary-color); color: #fff; border: none;
      font-family: 'Inter', sans-serif; font-size: 0.9rem; font-weight: 700;
      cursor: pointer; transition: opacity 0.15s, transform 0.15s; letter-spacing: -0.01em;
    }
    .ui-submit:hover:not(:disabled) { opacity: 0.88; transform: translateY(-1px); }
    .ui-submit:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }

    /* ── Thank you ────────────────────────────────────────────── */
    .ui-thankyou {
      text-align: center; padding: 68px 28px 56px;
      background: var(--bg-primary); border: 1px solid var(--border-color);
    }
    .ui-ty-ring {
      width: 76px; height: 76px;
      background: rgba(var(--primary-rgb),0.09);
      border: 2px solid rgba(var(--primary-rgb),0.2);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 24px;
    }
    .ui-ty-ring svg { width: 34px; height: 34px; }
    .ui-ty-title { font-size: 1.7rem; font-weight: 900; color: var(--text-primary); letter-spacing: -0.02em; margin-bottom: 10px; }
    .ui-ty-sub { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.65; max-width: 360px; margin: 0 auto 30px; }
    .ui-ty-btn {
      display: inline-flex; align-items: center; gap: 8px; padding: 12px 26px;
      background: rgba(var(--primary-rgb),0.08); border: 1px solid rgba(var(--primary-rgb),0.25);
      color: var(--primary-color); font-family: 'Inter', sans-serif;
      font-size: 0.9rem; font-weight: 700; text-decoration: none;
      transition: background 0.15s, border-color 0.15s;
    }
    .ui-ty-btn:hover { background: rgba(var(--primary-rgb),0.15); border-color: var(--primary-color); }

    .ui-ty-review {
      background: rgba(var(--primary-rgb),0.05);
      border: 1px solid rgba(var(--primary-rgb),0.18);
      padding: 20px 22px;
      max-width: 380px;
      margin: 0 auto 24px;
    }
    .ui-ty-review-title { font-size: 1.05rem; font-weight: 800; color: var(--text-primary); margin-bottom: 6px; }
    .ui-ty-review-sub { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.55; margin-bottom: 16px; }
    .ui-ty-review .ui-ty-btn {
      background: var(--primary-color); border-color: var(--primary-color); color: #fff;
    }
    .ui-ty-review .ui-ty-btn:hover { background: rgba(var(--primary-rgb),0.85); }

    /* ── Reinstall bar ────────────────────────────────────────── */
    .ui-reinstall-bar {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 12px; margin-top: 14px; padding: 16px 20px;
      border: 1px solid var(--border-color); background: var(--bg-primary);
    }
    .ui-reinstall-label { font-size: 0.85rem; color: var(--text-secondary); font-weight: 600; }
    .ui-reinstall-btn {
      display: inline-flex; align-items: center; gap: 7px; padding: 8px 16px;
      background: rgba(var(--primary-rgb),0.08); border: 1px solid rgba(var(--primary-rgb),0.28);
      color: var(--primary-color); font-family: 'Inter', sans-serif;
      font-size: 0.82rem; font-weight: 700; text-decoration: none;
      transition: background 0.15s, border-color 0.15s;
    }
    .ui-reinstall-btn:hover { background: rgba(var(--primary-rgb),0.15); border-color: var(--primary-color); }

    /* ── Player chip (shown when roblox_id in URL) ────────────── */
    .ui-player-chip {
      display: none;
      align-items: center;
      gap: 9px;
      margin-top: 22px;
      padding: 5px 14px 5px 5px;
      background: rgba(255,255,255,0.13);
      border: 1px solid rgba(255,255,255,0.22);
      border-radius: 100px;
      font-size: 0.82rem;
      color: rgba(255,255,255,0.92);
      font-weight: 600;
      width: fit-content;
    }
    .ui-player-chip.visible { display: inline-flex; }
    .ui-player-chip img {
      width: 28px; height: 28px; border-radius: 50%;
      object-fit: cover;
      background: rgba(255,255,255,0.1);
      flex-shrink: 0;
    }
    .ui-player-chip-label { font-size: 0.68rem; font-weight: 500; opacity: 0.7; margin-right: 2px; }

    /* ── Responsive ───────────────────────────────────────────── */
    @media (max-width: 580px) {
      #page-uninstall { padding-top: 60px; }
      .ui-title { font-size: 2rem; }
      .ui-hero { padding: 52px 20px 48px; }
      .ui-body { padding: 24px 16px 64px; }
      .ui-card { padding: 20px 16px 18px; }
      .ui-scale { gap: 5px; }
      .ui-scale-opt { padding: 12px 4px; }
      .ui-scale-opt .ui-scale-label { font-size: 0.6rem; }
    }

    body.light-mode .article-back-footer { border-top-color: #e2e8f0; }

    /* Light mode blog hero tint */
    body.light-mode .blog-hero {
      background: linear-gradient(135deg, var(--accent-nav-from), var(--accent-nav-to));
    }

    @media (max-width: 768px) {
      .blog-hero { padding: 32px 20px; padding-top: calc(60px + 32px); min-height: auto; }
    }

    /* Suppress transitions during initial page load */
    body.no-transition *, body.no-transition *::before, body.no-transition *::after {
      transition: none !important;
    }
    .page { display: none; transition: none !important; }
    .page.active { display: block; transition: none !important; }

    /* ═══════════════════════════════
       SUPPORT PAGE
    ═══════════════════════════════ */
    .support-hero {
      padding: 192px 24px 72px;
      text-align: center;
      position: relative;
      overflow: hidden;
      background: linear-gradient(180deg, rgba(var(--primary-rgb),0.12) 0%, transparent 100%);
    }

    .support-hero::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 70% 50% at 50% 0%, rgba(var(--primary-rgb),0.18) 0%, transparent 70%);
      pointer-events: none;
    }

    .support-hero-icon {
      width: 56px; height: 56px;
      border: 2px solid rgba(255,255,255,0.15);
      border-radius: 0;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 24px;
      background: rgba(var(--primary-rgb),0.12);
      animation: fadeUp 0.5s 0.05s ease both;
    }

    body.light-mode .support-hero-icon {
      border-color: rgba(var(--primary-rgb),0.25);
      background: rgba(var(--primary-rgb),0.07);
    }

    .support-hero h1 {
      font-size: clamp(2.2rem, 4.5vw, 3rem);
      font-weight: 900;
      letter-spacing: -0.035em;
      color: var(--text-primary);
      margin-bottom: 16px;
      animation: fadeUp 0.5s 0.1s ease both;
    }

    .support-hero h1 span {
      background: linear-gradient(90deg, var(--primary-color), var(--accent-light), var(--secondary-color), var(--primary-color));
      background-size: 300% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: gradientShift 4s linear infinite;
    }

    .support-hero p {
      font-size: 1rem;
      color: var(--text-secondary);
      max-width: 480px;
      margin: 0 auto 36px;
      line-height: 1.7;
      animation: fadeUp 0.5s 0.15s ease both;
    }

    .support-discord-cta {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: linear-gradient(135deg, #5865f2, #4752c4);
      color: #fff;
      padding: 14px 28px;
      border-radius: 0;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      box-shadow: 0 8px 28px rgba(88,101,242,0.4);
      transition: transform 0.2s, box-shadow 0.2s;
      animation: fadeUp 0.5s 0.2s ease both;
    }

    .support-discord-cta:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 36px rgba(88,101,242,0.55);
    }

    .support-body {
      max-width: 1060px;
      margin: 0 auto;
      padding: 0 24px 100px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px 56px;
      align-items: start;
    }

    .support-col-full { grid-column: 1 / -1; }

    .support-section-label {
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--primary-color);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .support-section-label::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border-color);
    }

    .support-quick-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    @media (max-width: 700px) { .support-quick-grid { grid-template-columns: 1fr 1fr; } }

    .support-quick-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 0;
      padding: 20px 18px;
      cursor: pointer;
      transition: transform 0.2s cubic-bezier(0.34,1.56,0.64,1), border-color 0.2s, box-shadow 0.2s;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .support-quick-card:hover {
      transform: translateY(-4px);
      border-color: rgba(var(--primary-rgb),0.35);
      box-shadow: 0 12px 32px rgba(0,0,0,0.2);
    }

    body.light-mode .support-quick-card { background: #fff; border-color: #e2e8f0; }

    .support-quick-icon {
      width: 38px; height: 38px;
      border-radius: 0;
      background: rgba(var(--primary-rgb),0.12);
      border: 1px solid rgba(var(--primary-rgb),0.2);
      display: flex; align-items: center; justify-content: center;
      color: var(--primary-color);
      flex-shrink: 0;
    }

    body.light-mode .support-quick-icon { background: rgba(var(--primary-rgb),0.07); }

    .support-quick-title {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1.3;
    }

    .support-quick-sub {
      font-size: 0.78rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .faq-item {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 0;
      overflow: hidden;
      transition: border-color 0.2s;
    }

    .faq-item.open { border-color: rgba(var(--primary-rgb),0.3); }
    body.light-mode .faq-item { background: #fff; border-color: #e2e8f0; }
    body.light-mode .faq-item.open { border-color: rgba(var(--primary-rgb),0.25); }

    .faq-question {
      width: 100%;
      background: none;
      border: none;
      padding: 18px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-primary);
      text-align: left;
      transition: color 0.15s;
    }

    .faq-question:hover { color: var(--primary-color); }

    .faq-chevron {
      flex-shrink: 0;
      color: var(--text-muted);
      transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), color 0.15s;
    }

    .faq-item.open .faq-chevron {
      transform: rotate(180deg);
      color: var(--primary-color);
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease, padding 0.3s ease;
      font-size: 0.9rem;
      color: var(--text-secondary);
      line-height: 1.7;
    }

    .faq-item.open .faq-answer {
      max-height: 400px;
      padding: 0 20px 18px;
    }

    .faq-answer a { color: var(--primary-color); text-decoration: none; }
    .faq-answer a:hover { text-decoration: underline; }

    .support-contact-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 0;
      padding: 28px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    body.light-mode .support-contact-card { background: #fff; border-color: #e2e8f0; }

    .support-contact-row {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 16px;
      border-radius: 0;
      background: var(--bg-tertiary);
      border: 1px solid var(--border-color);
      text-decoration: none;
      transition: border-color 0.2s, transform 0.2s cubic-bezier(0.34,1.56,0.64,1);
    }

    .support-contact-row:hover {
      border-color: rgba(var(--primary-rgb),0.35);
      transform: translateX(4px);
    }

    body.light-mode .support-contact-row {
      background: #f8fafc;
      border-color: #e2e8f0;
    }

    .support-contact-icon {
      width: 42px; height: 42px;
      border-radius: 0;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      font-size: 1.2rem;
    }

    .support-contact-info { flex: 1; }

    .support-contact-name {
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 2px;
    }

    .support-contact-desc {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .support-contact-arrow {
      color: var(--text-muted);
      transition: transform 0.2s, color 0.2s;
    }

    .support-contact-row:hover .support-contact-arrow {
      transform: translateX(4px);
      color: var(--primary-color);
    }

    .support-status-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 18px;
      background: rgba(34,197,94,0.08);
      border: 1px solid rgba(34,197,94,0.2);
      border-radius: 0;
      font-size: 0.85rem;
      font-weight: 600;
      color: #22c55e;
    }

    .status-dot {
      width: 8px; height: 8px;
      border-radius: 0;
      background: #22c55e;
      box-shadow: 0 0 0 0 rgba(34,197,94,0.4);
      animation: statusPulse 2s infinite;
      flex-shrink: 0;
    }

    @keyframes statusPulse {
      0%   { box-shadow: 0 0 0 0 rgba(34,197,94,0.4); }
      70%  { box-shadow: 0 0 0 7px rgba(34,197,94,0); }
      100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
    }

    body.light-mode .support-hero {
      background: linear-gradient(180deg, rgba(var(--primary-rgb),0.07) 0%, transparent 100%);
    }

    /* ── Read receipts ── */
    .wb3-read-receipt {
      font-size: 0.6rem;
      color: var(--ck-text-muted, #94a3b8);
      text-align: right;
      margin-top: 1px;
      padding-right: 2px;
      transition: color 0.3s;
    }

    /* ── Verified user label in user bubbles ── */
    .fr-verified-label {
      font-size: 0.65rem;
      color: #22c55e;
      font-weight: 700;
      text-align: right;
      margin-bottom: 2px;
    }

    /* ── Queue badge with pulse ── */
    #ck-queue-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.78rem;
      font-weight: 600;
      background: rgba(34,197,94,0.12);
      border: 1px solid rgba(34,197,94,0.25);
      padding: 5px 12px;
      border-radius: 99px;
      color: #22c55e;
      margin-top: 8px;
    }

    /* ══════════════════════════════════════
       STATUS PAGE
    ══════════════════════════════════════ */
    #page-status {
      padding-top: 160px; /* clear fixed header */
    }
    .status-wrap {
      max-width: 860px;
      margin: 0 auto;
      padding: 0 24px 80px;
    }

    /* masthead */
    .st-masthead {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 36px;
      flex-wrap: wrap;
    }
    .st-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.67rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--primary-color);
      border: 1px solid rgba(var(--primary-rgb),0.3);
      background: rgba(var(--primary-rgb),0.07);
      padding: 4px 10px;
      margin-bottom: 10px;
    }
    .st-badge-dot {
      width: 5px; height: 5px;
      border-radius: 50%;
      background: #22c55e;
      animation: stPulseGreen 2s infinite;
    }
    @keyframes stPulseGreen {
      0%   { box-shadow: 0 0 0 0 rgba(34,197,94,0.5); }
      70%  { box-shadow: 0 0 0 6px rgba(34,197,94,0); }
      100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
    }
    .st-title {
      font-size: 1.9rem;
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1.1;
    }
    .st-title .blue {
      background: linear-gradient(90deg, var(--primary-color), var(--accent-light), var(--secondary-color), var(--primary-color));
      background-size: 300% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: gradientShift 4s linear infinite;
    }
    .st-sub {
      font-size: 0.82rem;
      color: var(--text-secondary);
      margin-top: 6px;
    }

    /* refresh controls */
    .st-refresh-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }
    .st-timer {
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      font-size: 0.75rem;
      color: var(--text-secondary);
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      padding: 6px 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .st-timer-bar-wrap {
      width: 54px; height: 2px;
      background: var(--border-color);
      overflow: hidden;
    }
    .st-timer-bar {
      height: 100%;
      background: var(--primary-color);
      width: 100%;
      transform-origin: right;
      transition: transform 1s linear;
    }
    .st-refresh-btn {
      font-family: 'Inter', sans-serif;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      background: rgba(var(--primary-rgb),0.1);
      border: 1px solid rgba(var(--primary-rgb),0.3);
      color: var(--primary-color);
      padding: 6px 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: background 0.15s, border-color 0.15s;
    }
    .st-refresh-btn:hover { background: rgba(var(--primary-rgb),0.18); border-color: rgba(var(--primary-rgb),0.5); }
    .st-refresh-btn.spinning svg { animation: st-spin 0.7s linear infinite; }
    .st-refresh-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .st-refresh-btn:disabled:hover { background: rgba(var(--primary-rgb),0.1); border-color: rgba(var(--primary-rgb),0.3); }
    @keyframes st-spin { to { transform: rotate(360deg); } }

    /* global banner */
    .st-banner {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 18px 22px;
      border: 1px solid;
      margin-bottom: 32px;
      position: relative;
      overflow: hidden;
      transition: background 0.3s, border-color 0.3s;
    }
    .st-banner::before {
      content: '';
      position: absolute; inset: 0;
      background: repeating-linear-gradient(
        45deg,
        rgba(255,255,255,0.012) 0px, rgba(255,255,255,0.012) 4px,
        transparent 4px, transparent 8px
      );
      pointer-events: none;
    }
    .st-banner.ok     { background: rgba(34,197,94,0.06);  border-color: rgba(34,197,94,0.22); }
    .st-banner.warn   { background: rgba(245,158,11,0.07); border-color: rgba(245,158,11,0.22); }
    .st-banner.err    { background: rgba(239,68,68,0.07);  border-color: rgba(239,68,68,0.22); }
    .st-banner.loading{ background: rgba(var(--primary-rgb),0.05); border-color: rgba(var(--primary-rgb),0.18); }
    body:not(.dark-mode) .st-banner.ok   { background: rgba(34,197,94,0.05);  border-color: rgba(34,197,94,0.2); }
    body:not(.dark-mode) .st-banner.warn { background: rgba(245,158,11,0.06); }
    body:not(.dark-mode) .st-banner.err  { background: rgba(239,68,68,0.05); }
    .st-banner-icon { width:36px; height:36px; flex-shrink:0; display:flex; align-items:center; justify-content:center; }
    .st-banner-main { font-size:1.0rem; font-weight:800; letter-spacing:-0.02em; }
    .st-banner-sub  { font-size:0.78rem; color:var(--text-secondary); margin-top:1px; }
    .st-banner-meta {
      margin-left: auto;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      color: var(--text-muted);
      text-align: right;
      flex-shrink: 0;
    }

    /* section label */
    .st-section-label {
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .st-section-label::after {
      content: ''; flex: 1; height: 1px;
      background: var(--border-color);
    }

    /* KV table */
    .st-kv-table {
      border: 1px solid var(--border-color);
      overflow: hidden;
      margin-bottom: 28px;
    }
    .st-kv-row {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 13px 18px;
      border-bottom: 1px solid var(--border-color);
      background: var(--bg-primary);
      transition: background 0.15s;
    }
    .st-kv-row:last-child { border-bottom: none; }
    .st-kv-row:hover { background: var(--bg-tertiary); }
    .st-kv-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
      position: relative;
    }
    .st-kv-dot.ok     { background: #22c55e; }
    .st-kv-dot.err    { background: #ef4444; }
    .st-kv-dot.loading{ background: var(--text-muted); animation: stBlink 1s step-end infinite; }
    @keyframes stBlink { 50% { opacity: 0.2; } }
    .st-kv-dot.ok::after {
      content: ''; position: absolute; inset: -3px;
      border-radius: 50%; background: rgba(34,197,94,0.3);
      animation: stPulseGreen 2s infinite;
    }
    .st-kv-name { font-weight: 700; font-size: 0.875rem; flex: 1; }
    .st-kv-path {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--text-muted);
      background: var(--bg-tertiary);
      border: 1px solid var(--border-color);
      padding: 2px 8px;
    }
    .st-kv-badge {
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.04em; text-transform: uppercase;
      padding: 3px 8px; flex-shrink: 0;
    }
    .st-kv-badge.ok     { color:#22c55e; background:rgba(34,197,94,0.1);  border:1px solid rgba(34,197,94,0.2); }
    .st-kv-badge.err    { color:#ef4444; background:rgba(239,68,68,0.1);  border:1px solid rgba(239,68,68,0.2); }
    .st-kv-badge.loading{ color:var(--text-muted); background:var(--bg-tertiary); border:1px solid var(--border-color); }

    /* ping history */
    .st-ping-box {
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      padding: 14px 16px;
      margin-bottom: 28px;
    }
    .st-ping-head {
      font-size: 0.7rem;
      color: var(--text-muted);
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: 'JetBrains Mono', monospace;
    }
    .st-ping-bars {
      display: flex;
      align-items: flex-end;
      gap: 3px;
      height: 40px;
    }
    .st-ping-bar {
      flex: 1;
      transition: height 0.3s ease, background 0.3s ease;
      border-top: 1px solid transparent;
      min-height: 3px;
    }
    .st-ping-bar.empty { background: rgba(var(--primary-rgb),0.08); }
    .st-ping-bar.ok    { background: rgba(34,197,94,0.28);  border-top-color: rgba(34,197,94,0.5); }
    .st-ping-bar.slow  { background: rgba(245,158,11,0.28); border-top-color: rgba(245,158,11,0.5); }
    .st-ping-bar.err   { background: rgba(239,68,68,0.3);   border-top-color: rgba(239,68,68,0.5); }

    /* endpoint cooldown grid */
    .st-cd-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(256px, 1fr));
      gap: 12px;
      margin-bottom: 28px;
    }
    .st-cd-card {
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      padding: 14px 16px;
      transition: border-color 0.2s;
    }
    .st-cd-card:hover { border-color: rgba(var(--primary-rgb),0.35); }
    .st-cd-header { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
    .st-cd-method {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.63rem; font-weight: 600;
      padding: 2px 6px;
    }
    .st-cd-method.get    { background:rgba(var(--primary-rgb),0.12); color:var(--primary-color); border:1px solid rgba(var(--primary-rgb),0.2); }
    .st-cd-method.post   { background:rgba(34,197,94,0.1);   color:#16a34a; border:1px solid rgba(34,197,94,0.2); }
    .st-cd-method.delete { background:rgba(239,68,68,0.1);   color:#dc2626; border:1px solid rgba(239,68,68,0.2); }
    .st-cd-method.put    { background:rgba(245,158,11,0.1);  color:#d97706; border:1px solid rgba(245,158,11,0.2); }
    body.dark-mode .st-cd-method.post   { color:#4ade80; }
    body.dark-mode .st-cd-method.delete { color:#f87171; }
    body.dark-mode .st-cd-method.put    { color:#fbbf24; }
    body.dark-mode .st-cd-method.get    { color:#60a5fa; }
    .st-cd-path { font-family:'JetBrains Mono',monospace; font-size:0.78rem; color:var(--text-secondary); }
    .st-cd-desc { font-size:0.78rem; color:var(--text-secondary); margin-bottom:10px; }
    .st-cd-bar-wrap { height:3px; background:var(--border-color); margin-bottom:6px; overflow:hidden; }
    .st-cd-bar { height:100%; background:linear-gradient(90deg,var(--primary-color),var(--accent-light)); transition:width 0.5s ease; }
    .st-cd-bar.full    { background:linear-gradient(90deg,#22c55e,#4ade80); }
    .st-cd-bar.limited { background:linear-gradient(90deg,#ef4444,#f87171); }
    .st-cd-meta { display:flex; justify-content:space-between; align-items:center; }
    .st-cd-label { font-size:0.7rem; color:var(--text-muted); }
    .st-cd-val { font-family:'JetBrains Mono',monospace; font-size:0.7rem; font-weight:600; color:var(--text-secondary); }
    .st-cd-val.ready  { color:#22c55e; }
    .st-cd-val.active { color:#f59e0b; }

    /* updates timeline */
    .st-updates { margin-bottom:28px; }
    .st-update-item {
      display:flex; gap:16px;
      padding:16px 18px;
      background: var(--bg-primary);
      border:1px solid var(--border-color);
      border-bottom:none;
      transition:background 0.15s;
    }
    .st-update-item:last-child { border-bottom:1px solid var(--border-color); }
    .st-update-item:hover { background:var(--bg-tertiary); }
    .st-update-tl { display:flex; flex-direction:column; align-items:center; flex-shrink:0; padding-top:3px; }
    .st-update-dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; }
    .st-update-dot.new    { background:var(--primary-color); box-shadow:0 0 0 3px rgba(var(--primary-rgb),0.2); }
    .st-update-dot.fix    { background:#22c55e; }
    .st-update-dot.update { background:#f59e0b; }
    .st-update-dot.break  { background:#ef4444; }
    .st-update-dot.dev    { background:#a855f7; }
    .st-update-line { width:1px; flex:1; background:var(--border-color); margin-top:4px; }
    .st-update-item:last-child .st-update-line { display:none; }
    .st-update-body { flex:1; }
    .st-update-head { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:4px; }
    .st-update-ver {
      font-family:'JetBrains Mono',monospace; font-size:0.75rem; font-weight:600;
      color:var(--text-secondary);
      background:var(--bg-tertiary);
      border:1px solid var(--border-color);
      padding:1px 7px;
    }
    .st-update-tag {
      font-size:0.63rem; font-weight:800;
      letter-spacing:0.08em; text-transform:uppercase;
      padding:2px 7px;
    }
    .st-update-tag.new    { color:var(--primary-color); background:rgba(var(--primary-rgb),0.1); border:1px solid rgba(var(--primary-rgb),0.2); }
    .st-update-tag.fix    { color:#22c55e; background:rgba(34,197,94,0.1);  border:1px solid rgba(34,197,94,0.2); }
    .st-update-tag.update { color:#d97706; background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.2); }
    .st-update-tag.break  { color:#ef4444; background:rgba(239,68,68,0.1);  border:1px solid rgba(239,68,68,0.2); }
    .st-update-tag.dev    { color:#a855f7; background:rgba(168,85,247,0.1); border:1px solid rgba(168,85,247,0.2); }
    body.dark-mode .st-update-tag.new    { color:#60a5fa; }
    body.dark-mode .st-update-tag.fix    { color:#4ade80; }
    body.dark-mode .st-update-tag.update { color:#fbbf24; }
    body.dark-mode .st-update-tag.break  { color:#f87171; }
    body.dark-mode .st-update-tag.dev    { color:#c084fc; }
    .st-update-date { margin-left:auto; font-size:0.72rem; color:var(--text-muted); white-space:nowrap; }
    .st-update-title { font-size:0.9rem; font-weight:700; margin-bottom:3px; letter-spacing:-0.01em; }
    .st-update-desc  { font-size:0.8rem; color:var(--text-secondary); line-height:1.55; }

    /* footer row inside status page */
    .st-foot {
      display:flex; align-items:center; justify-content:space-between;
      flex-wrap:wrap; gap:12px;
      padding-top:24px;
      border-top:1px solid var(--border-color);
      font-size:0.75rem;
      color:var(--text-muted);
    }
    .st-foot a { color:var(--text-secondary); text-decoration:none; }
    .st-foot a:hover { color:var(--primary-color); }
    .st-foot code { font-family:'JetBrains Mono',monospace; font-size:0.72rem; }

    @media (max-width:600px) {
      #page-status { padding-top:120px; }
      .st-masthead { gap:12px; }
      .st-title { font-size:1.4rem; }
      .st-cd-grid { grid-template-columns:1fr; }
      .st-kv-path { display:none; }
      .st-banner-meta { display:none; }
    }

  </style>
</head>
<body>
