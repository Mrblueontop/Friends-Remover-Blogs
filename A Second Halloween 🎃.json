<!-- Pusher for real-time live chat -->
<script src="https://js.pusher.com/8.2/pusher.min.js"></script>
<script>
/* ============================================================
   FRIENDS REMOVER SUPPORT CHAT ENGINE
   AI chat (in-memory) + Live support via Pusher + KV
   ============================================================ */
const WB3_API            = 'https://xtero.zaggloob.workers.dev';
const EMAIL_VERIFY_API   = 'https://emailverify.zaggloob.workers.dev';
const WB3_PUSHER_KEY     = 'fe0cc3e34b1803ffc304';
const WB3_PUSHER_CLUSTER = 'us2';
const AI_REPLY_LIMIT     = 25;
const AI_LIMIT_WINDOW    = 6 * 60 * 60 * 1000; // 6 hours
const AI_LIMIT_LS_KEY    = 'fr_ai_limit';
const FR_AI_HISTORY_KEY  = 'fr_ai_history';
const FR_ROBLOX_KEY      = 'fr_roblox_user';
const FR_VERIFIED_EMAIL  = 'fr_verified_email'; // permanent — never cleared

/* Deep product knowledge injected as context on every AI request */
const FR_SYSTEM_CONTEXT = `[SYSTEM CONTEXT — Friends Remover Support Bot]
Product: Friends Remover — a free Chromium browser extension (Chrome & Edge) for bulk-removing Roblox friends.
Key facts:
- Completely free. No premium, no ads, no paywalls.
- Works on roblox.com/friends page only. Does NOT work on mobile browsers.
- Install: chrome.google.com/webstore → search "Friends Remover" OR go to friendsremover.xyz → click Install.
- Extension icon appears in the Chrome toolbar. If missing: check chrome://extensions, make sure it's enabled, then refresh roblox.com/friends.
- To use: open roblox.com/friends, click the FR panel on the right side, select friends to remove, click "Remove Selected".
- Bulk select: use "Select All" button or check individual boxes.
- Removal delay setting: default 500ms. If removals stop mid-way, increase to 1000–1500ms (Roblox rate limiting).
- After a Roblox site update, the extension may stop working. Fix: update to the latest version in chrome://extensions → "Update".
- The extension reads your public Roblox friends list via the Roblox website UI — it does NOT read passwords, cookies, or account credentials.
- Firefox support is experimental/not officially released. Chrome and Edge are fully supported.
- Discord for fastest help: https://discord.com/invite/Z3Vqjb7SZc (also #bug-reports channel).
- Common bugs:
  1. "Extension panel not showing" → Refresh the page. If still missing: disable/re-enable the extension.
  2. "Removal stopped partway" → Roblox rate limited the requests. Increase delay to 1200ms in Settings.
  3. "Select All not working" → Page may not have fully loaded. Scroll down to load all friends first.
  4. "Friends list shows 0" → Make sure you're on roblox.com/friends, not a game page. Log out and back in.
  5. "Extension broke after Roblox update" → Update the extension. Go to chrome://extensions → click Update.
  6. "I accidentally removed someone" → Removals are permanent. You must send a new friend request to re-add them.
  7. "Extension asks for permissions" → It only needs access to roblox.com. This is safe and required to read the friends list.
- Support hours: Weekdays 4:30 PM–10 PM EST, Weekends 12 PM–12 AM EST.
- If you cannot solve the issue, offer to connect with a live agent.`;

(function () {
  'use strict';

  let _mode = 'ai', _aiMessages = [], _aiReplyCount = 0, _limitTimer = null;
  let _liveSessionId = null, _pusher = null, _pusherChannel = null;
  let _lastMsgTs = 0, _renderedKvIds = new Set();
  var _wb3ReplyTo = null;
  var _robloxUser = null; // { userId, displayName, username, avatarUrl }
  var _pendingFirstMessage = null; // opening message held while Roblox verification runs

  /* ── AI chat history persistence ── */
  function _loadAiHistory() {
    try { return JSON.parse(localStorage.getItem(FR_AI_HISTORY_KEY) || '[]'); } catch { return []; }
  }
  function _saveAiHistory(msgs) { try { localStorage.setItem(FR_AI_HISTORY_KEY, JSON.stringify(msgs.slice(-40))); } catch {} }
  function _clearAiHistory() { try { localStorage.removeItem(FR_AI_HISTORY_KEY); } catch {} }

  /* ── Roblox user cache ── */
  function _loadRobloxUser() { try { return JSON.parse(localStorage.getItem(FR_ROBLOX_KEY) || 'null'); } catch { return null; } }
  function _saveRobloxUser(u) { try { localStorage.setItem(FR_ROBLOX_KEY, JSON.stringify(u)); } catch {} }

  /* ── Verified email (permanent — survives resets) ── */
  function _loadVerifiedEmail() { try { return localStorage.getItem(FR_VERIFIED_EMAIL) || ''; } catch { return ''; } }
  function _saveVerifiedEmail(e) { try { localStorage.setItem(FR_VERIFIED_EMAIL, e); localStorage.setItem('fr_guest_email', e); } catch {} }

  /* ── AI limit ── */
  function _loadAiLimit() {
    try {
      const raw = localStorage.getItem(AI_LIMIT_LS_KEY);
      if (!raw) return { count: 0, windowStart: Date.now() };
      const d = JSON.parse(raw);
      if (Date.now() - d.windowStart > AI_LIMIT_WINDOW) { const f = { count: 0, windowStart: Date.now() }; localStorage.setItem(AI_LIMIT_LS_KEY, JSON.stringify(f)); return f; }
      return d;
    } catch { return { count: 0, windowStart: Date.now() }; }
  }
  function _saveAiLimit(d) { try { localStorage.setItem(AI_LIMIT_LS_KEY, JSON.stringify(d)); } catch {} }
  function _incrementAiLimit() { const d = _loadAiLimit(); d.count++; _saveAiLimit(d); _aiReplyCount = d.count; return d; }
  function _isAiLimitReached() { const d = _loadAiLimit(); _aiReplyCount = d.count; return d.count >= AI_REPLY_LIMIT; }
  function _aiLimitResetMs() { const d = _loadAiLimit(); return Math.max(0, AI_LIMIT_WINDOW - (Date.now() - d.windowStart)); }
  function _fmt(ms) {
    const s = Math.ceil(ms / 1000);
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sc = s % 60;
    if (h > 0) return h + ':' + String(m).padStart(2,'0') + ':' + String(sc).padStart(2,'0');
    return m + ':' + String(sc).padStart(2,'0');
  }
  function _stopLimitTimer() { if (_limitTimer) { clearInterval(_limitTimer); _limitTimer = null; } }
  function _startLimitCountdown() {
    _stopLimitTimer();
    const notice = document.getElementById('wb3-limit-notice'); if (!notice) return;
    _limitTimer = setInterval(function () {
      const rem = _aiLimitResetMs();
      if (rem <= 0) { _stopLimitTimer(); _loadAiLimit(); _aiReplyCount = 0; _updateInputState(); notice.style.display = 'none'; return; }
      const cd = document.getElementById('wb3-limit-countdown'); if (cd) cd.textContent = _fmt(rem);
    }, 1000);
  }
  function _updateInputState() {
    const input = document.getElementById('ai-chat-input');
    const btn = document.getElementById('ai-send-btn');
    const notice = document.getElementById('wb3-limit-notice');
    if (!input || !btn) return;
    if (_mode === 'ai' && _isAiLimitReached()) {
      input.disabled = true; btn.disabled = true;
      if (notice) { notice.style.display = 'block'; const cd = document.getElementById('wb3-limit-countdown'); if (cd) cd.textContent = _fmt(_aiLimitResetMs()); _startLimitCountdown(); }
    } else { input.disabled = false; btn.disabled = !(input.value || '').trim(); if (notice) notice.style.display = 'none'; _stopLimitTimer(); }
  }

  /* ── escHtml helper (safe if already defined) ── */
  function _esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  /* ── Chat lock/unlock ── */
  var _chatLocked = false;
  function _setChatLock(locked) {
    _chatLocked = locked;
    const input = document.getElementById('ai-chat-input');
    const btn   = document.getElementById('ai-send-btn');
    if (!input || !btn) return;
    if (locked) {
      input.disabled = true;
      input.placeholder = 'Waiting for an agent to join…';
      btn.disabled = true;
    } else {
      input.disabled = false;
      input.placeholder = 'Message…';
      btn.disabled = !(input.value || '').trim();
    }
  }

  /* ── View switching: intake ↔ chat ── */
  function _showView(view) {
    const intake = document.getElementById('wb3-view-intake');
    const verify = document.getElementById('wb3-view-verify');
    const chat   = document.getElementById('wb3-view-chat');
    if (intake) intake.style.display = 'none';
    if (verify) { verify.style.display = 'none'; verify.classList.remove('active'); }
    if (chat)   chat.style.display   = 'none';
    if (view === 'intake') {
      if (intake) intake.style.display = '';
    } else if (view === 'verify') {
      if (verify) { verify.style.display = 'flex'; verify.classList.add('active'); }
    } else {
      if (chat) chat.style.display = 'flex';
    }
  }

  window.wb3BackToIntake = function() {
    if (_liveSessionId) { wb3ShowFeedback(); return; }
    _showView('intake');
  };

  /* ── Dynamic header updater ── */
  function _updateChatHeader(title, subtitle) {
    var t = document.getElementById('wb3-head-name');
    var s = document.getElementById('wb3-head-title');
    if (t && title    !== undefined) t.textContent = title;
    if (s && subtitle !== undefined) s.textContent = subtitle;
  }
  window._updateChatHeader = _updateChatHeader;

  /* ── Render quick-reply option buttons (AI suggestions) ── */
  var _YES_WORDS = ['yes','yep','yeah','yea','yas','yass','sure','correct','that is me','thats me','yup','ye','ok','okay','si'];
  var _NO_WORDS  = ['no','nah','nope','nop','no way','not me','wrong','incorrect','negative'];
  function _renderVerifyOptions(options, container) {
    var wrap = document.createElement('div');
    wrap.className = 'wb3-verify-options';
    options.forEach(function(opt) {
      var btn = document.createElement('button');
      btn.className = 'wb3-verify-btn';
      btn.textContent = opt;
      btn.onclick = function() {
        container.querySelectorAll('.wb3-verify-btn').forEach(function(b){ b.disabled = true; b.style.opacity = '0.5'; });
        if (_mode === 'live' && _liveSessionId) { _sendLiveMessage(opt); }
      };
      wrap.appendChild(btn);
    });
    container.appendChild(wrap);
  }

  /* ── Reply bar ── */
  function _setReply(msgId, text, author) {
    _wb3ReplyTo = { msgId: msgId, text: text, author: author };
    var bar = document.getElementById('ai-reply-quote-bar'); if (!bar) return;
    bar.style.display = 'flex';
    bar.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--ck-blue)" stroke-width="2.5" style="flex-shrink:0"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>'
      + '<div style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:0.75rem;color:var(--ck-text-sub);"><strong style="color:var(--ck-blue);">' + _esc(author) + ':</strong> ' + _esc(text.slice(0,80)) + '</div>'
      + '<button onclick="window._fr_clearReply()" style="background:none;border:none;cursor:pointer;color:var(--ck-text-muted);font-size:0.9rem;flex-shrink:0;padding:2px;" title="Clear reply">x</button>';
  }
  window._fr_clearReply = function () {
    _wb3ReplyTo = null;
    const bar = document.getElementById('ai-reply-quote-bar'); if (bar) { bar.style.display = 'none'; bar.innerHTML = ''; }
  };

  /* ── Append message ── */
  window._wb3AppendMsg = function (role, text, msgObj) {
    // Fire desktop notification for incoming messages (agent or bot, non-typing)
    if ((role === 'agent' || role === 'bot') && text && text !== '\u2026') {
      var senderName = (role === 'agent' && msgObj && msgObj.agentName)
        ? msgObj.agentName + ' \u00b7 Agent'
        : 'Friends Remover Support';
      if (typeof window._ckFireNotification === 'function') {
        window._ckFireNotification(senderName, text);
      }
    }
    const container = document.getElementById('ai-chat-messages'); if (!container) return;
    const div = document.createElement('div');
    const kvId = msgObj && (msgObj.messageId || msgObj.id);
    if (kvId) div.dataset.kvid = kvId;

    if (role === 'system') {
      div.className = 'ai-msg-system'; div.textContent = text;
      container.appendChild(div); container.scrollTop = container.scrollHeight; return div;
    }

    const isTyping = (text === '\u2026');
    var quoteHtml = '';
    if (msgObj && msgObj.replyTo && msgObj.replyTo.text) {
      var sender = msgObj.replyTo.sender || '';
      quoteHtml = '<div class="msg-reply-quote"><strong>' + _esc(sender) + '</strong>' + (sender ? ': ' : '') + _esc((msgObj.replyTo.text || '').slice(0, 80)) + '</div>';
    }
    var actionsHtml = '';
    if (kvId && !isTyping && (role === 'agent' || role === 'user')) {
      actionsHtml = '<div class="wb3-msg-actions"><button data-msgid="' + _esc(kvId) + '" data-body="' + _esc(text) + '" data-author="' + _esc((msgObj&&msgObj.agentName)||role) + '" class="fr-reply-trigger" style="background:none;border:none;cursor:pointer;font-size:0.65rem;color:var(--ck-text-sub);padding:0;font-family:inherit;" title="Reply">Reply</button></div>';
    }
    var typingDots = '<div class="ai-typing-indicator"><span class="ai-typing-dot"></span><span class="ai-typing-dot"></span><span class="ai-typing-dot"></span></div>';
    const bubbleContent = isTyping ? typingDots : _esc(text);

    if (role === 'agent') {
      div.className = 'ai-msg agent';
      var name = (msgObj && msgObj.agentName) || 'Support';
      var initials = name.slice(0,2).toUpperCase();
      var avatarUrl = (msgObj && msgObj.agentAvatarUrl) || '';
      var avatarEl = document.createElement('div');
      avatarEl.className = 'ai-msg-avatar';
      if (avatarUrl) {
        avatarEl.style.overflow = 'hidden';
        var avatarImg = document.createElement('img');
        avatarImg.src = avatarUrl;
        avatarImg.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius: 0;';
        avatarImg.onerror = function() { this.style.display = 'none'; avatarEl.textContent = initials; };
        avatarEl.appendChild(avatarImg);
      } else {
        avatarEl.textContent = initials;
      }
      var avatarHTML = avatarEl.outerHTML;
      var nameLabel = '<div style="font-size:0.68rem;color:var(--ck-text-sub);margin-bottom:3px;font-weight:700;">' + _esc(name) + ' &middot; Agent</div>';
      div.innerHTML = avatarHTML + '<div class="msg-wrap"><div class="ai-msg-bubble-wrap">' + nameLabel + quoteHtml + '<div class="ai-msg-bubble">' + bubbleContent + '</div>' + actionsHtml + '</div></div>';
    } else if (role === 'bot') {
      div.className = 'ai-msg bot';
      const bubbleWrap = document.createElement('div'); bubbleWrap.className = 'ai-msg-bubble-wrap';
      if (quoteHtml) bubbleWrap.innerHTML = quoteHtml;
      const bubble = document.createElement('div'); bubble.className = 'ai-msg-bubble';
      // Preserve newlines in bot messages
      bubble.innerHTML = isTyping ? typingDots : _esc(text).replace(/\n/g, '<br>');
      bubbleWrap.appendChild(bubble);
      // Render Yes/No (or any options) from meta.options
      if (msgObj && msgObj.meta && Array.isArray(msgObj.meta.options) && !isTyping) {
        // If this is a roblox ID confirmation, fetch and show headshot
        if (msgObj.meta.confirmType === 'roblox_id' && msgObj.meta.robloxId) {
          // Build standalone centered verify card (appended directly to message container)
          var verifyContainer = document.getElementById('ai-chat-messages');
          var card = document.createElement('div');
          card.className = 'ck-verify-card';
          // Label
          var verifyLabel = document.createElement('div');
          verifyLabel.className = 'ck-verify-label';
          verifyLabel.textContent = 'Is this you?';
          // Avatar
          var avatarDiv = document.createElement('div');
          avatarDiv.className = 'ck-verify-avatar';
          var vImg = document.createElement('img');
          vImg.alt = msgObj.meta.robloxUsername || 'Roblox user';
          vImg.src = msgObj.meta.robloxHeadshot || 'https://www.roblox.com/headshot-thumbnail/image?userId=' + msgObj.meta.robloxId + '&width=150&height=150&format=png';
          vImg.onerror = function() { this.style.display = 'none'; };
          vImg.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius: 0;';
          avatarDiv.appendChild(vImg);
          // Name
          var nameDiv = document.createElement('div');
          nameDiv.className = 'ck-verify-name';
          nameDiv.textContent = msgObj.meta.robloxUsername || ('ID: ' + msgObj.meta.robloxId);
          // ID
          var idDiv = document.createElement('div');
          idDiv.className = 'ck-verify-id';
          idDiv.textContent = 'ID: ' + msgObj.meta.robloxId;
          card.appendChild(verifyLabel);
          card.appendChild(avatarDiv);
          card.appendChild(nameDiv);
          card.appendChild(idDiv);
          // Hint text — user types their reply in the chat input
          var hintDiv = document.createElement('div');
          hintDiv.style.cssText = 'font-size:0.72rem;color:var(--ck-text-muted);margin-top:4px;';
          hintDiv.textContent = 'Type yes or no in the chat';
          card.appendChild(hintDiv);
          if (verifyContainer) { verifyContainer.appendChild(card); verifyContainer.scrollTop = verifyContainer.scrollHeight; }
          // Don't add to bubbleWrap — standalone card handles everything
          return div; // skip normal message rendering
        }
        _renderVerifyOptions(msgObj.meta.options, bubbleWrap);
      }
      div.innerHTML = '';
      // Bot avatar is always the FR brand — NEVER the user's Roblox headshot
      var avatarBotEl = document.createElement('div');
      avatarBotEl.className = 'ai-msg-avatar';
      avatarBotEl.textContent = 'FR';
      div.appendChild(avatarBotEl);
      const msgWrap = document.createElement('div'); msgWrap.className = 'msg-wrap';
      msgWrap.appendChild(bubbleWrap);
      div.appendChild(msgWrap);
    } else {
      div.className = 'ai-msg user';
      // Small verified name tag above user bubbles only (not bot bubbles)
      var userVerifiedLabel = '';
      if (_robloxUser && !isTyping) {
        userVerifiedLabel = '<div style="font-size:0.63rem;color:var(--ck-text-muted);margin-bottom:2px;text-align:right;font-weight:500;">'
          + '<span style="color:#22c55e;">✓</span> ' + _esc(_robloxUser.displayName) + '</div>';
      }
      div.innerHTML = '<div class="msg-wrap"><div class="ai-msg-bubble-wrap">' + userVerifiedLabel + quoteHtml + '<div class="ai-msg-bubble">' + bubbleContent + '</div>' + actionsHtml + '</div></div>';
    }

    div.querySelectorAll('.fr-reply-trigger').forEach(function(btn) {
      btn.addEventListener('click', function() { _setReply(btn.dataset.msgid, btn.dataset.body, btn.dataset.author); });
    });

    // Add timestamp
    if (!isTyping && role !== 'system') {
      var ts2 = (msgObj && (msgObj.timestamp || msgObj.createdAt)) ? new Date(msgObj.timestamp || msgObj.createdAt) : new Date();
      var tsStr = ts2.toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit' });
      var tsEl = document.createElement('div');
      tsEl.className = 'ai-msg-ts';
      tsEl.style.cssText = 'font-size:0.64rem;color:var(--ck-text-muted);margin-top:3px;display:block;';
      if (role === 'user') { tsEl.style.textAlign = 'right'; }
      tsEl.textContent = tsStr;
      var wrap2 = div.querySelector('.msg-wrap') || div;
      wrap2.appendChild(tsEl);
    }

    container.appendChild(div); container.scrollTop = container.scrollHeight;
    if ((role === 'bot' || role === 'agent') && document.getElementById('fr-chat-card')?.classList.contains('hidden')) {
      document.getElementById('fr-chat-badge-dot')?.classList.add('show');
    }
    // Read receipts: mark previous user messages as "Delivered", last agent reply triggers "Seen"
    if (role === 'agent' && _mode === 'live') {
      container.querySelectorAll('.ai-msg.user .wb3-read-receipt').forEach(function(el) {
        el.textContent = '✓✓ Seen';
        el.style.color = '#22c55e';
      });
    }
    if (role === 'user' && _mode === 'live') {
      // Remove old "last sent" receipt
      container.querySelectorAll('.wb3-read-receipt.sent-receipt').forEach(function(el) { el.remove(); });
      var receiptEl = document.createElement('div');
      receiptEl.className = 'wb3-read-receipt sent-receipt';
      receiptEl.style.cssText = 'font-size:0.6rem;color:var(--ck-text-muted);text-align:right;margin-top:1px;padding-right:2px;';
      receiptEl.textContent = '✓ Delivered';
      var msgWrapEl = div.querySelector('.msg-wrap') || div;
      msgWrapEl.appendChild(receiptEl);
    }
    return div;
  };

  function _appendOptionButtons(options) {
    const container = document.getElementById('ai-chat-messages'); if (!container || !options.length) return;
    const wrap = document.createElement('div'); wrap.className = 'wb3-options';
    options.forEach(function(opt) {
      const btn = document.createElement('button'); btn.className = 'wb3-option-btn'; btn.textContent = opt;
      btn.addEventListener('click', function() { wrap.remove(); window.wb3QuickSend(opt); });
      wrap.appendChild(btn);
    });
    container.appendChild(wrap); container.scrollTop = container.scrollHeight;
  }

  function _showEndSessionUI() {
    var container = document.getElementById('ai-chat-messages'); if (!container) return;
    var endDiv = document.createElement('div'); endDiv.className = 'ai-msg-system'; endDiv.textContent = 'Conversation ended.'; container.appendChild(endDiv);
    var btnWrap = document.createElement('div'); btnWrap.style.cssText = 'display:flex;justify-content:center;padding:10px 0 16px;';
    const btn = document.createElement('button'); btn.textContent = '+ Start new conversation';
    btn.style.cssText = 'background:var(--ck-blue);color:#fff;border:none;border-radius: 0;padding:9px 22px;font-size:0.82rem;font-weight:600;cursor:pointer;font-family:inherit;';
    btn.onclick = function() { _wb3FullReset(); };
    btnWrap.appendChild(btn); container.appendChild(btnWrap); container.scrollTop = container.scrollHeight;
    var inp = document.getElementById('ai-chat-input'); var snd = document.getElementById('ai-send-btn');
    if (inp) { inp.disabled = true; inp.placeholder = 'Start a new conversation above'; }
    if (snd) snd.disabled = true;
  }

  /* ── Roblox ID verification + display name fetch ── */
  var _verifyingRoblox = false;
  var _pendingRobloxInput = null;

  function _isRobloxIdStep() { return _verifyingRoblox; }

  async function _fetchRobloxDisplayName(userId) {
    try {
      // Route through our own worker to avoid CORS restrictions on Roblox APIs
      const res = await fetch(WB3_API + '/roblox/user/' + userId);
      if (!res.ok) return null;
      const d = await res.json();
      if (!d.username) return null;
      return {
        userId:      String(userId),
        displayName: d.displayName || d.username,
        username:    d.username,
        avatarUrl:   d.headshotUrl || null,
      };
    } catch { return null; }
  }

  async function _startRobloxVerification() {
    _verifyingRoblox = true;
    const input = document.getElementById('ai-chat-input');
    const stored = _loadRobloxUser();
    if (stored) {
      _robloxUser = stored;
      _verifyingRoblox = false;
      _updateChatHeader(stored.displayName + ' · @' + stored.username, 'Verified Roblox · AI Assistant');
      return true;
    }
    _updateChatHeader('Verify your Roblox account', 'Step 1 · enter your user ID');
    window._wb3AppendMsg('bot', "To help you better, please share your Roblox user ID. You can find it at roblox.com/users/YOUR_ID/profile — just enter the numeric ID below.");
    if (input) { input.placeholder = 'Enter your Roblox user ID…'; }
    return false;
  }

  async function _handleRobloxIdInput(text) {
    const input = document.getElementById('ai-chat-input');
    const idMatch = text.match(/(\d{1,13})/);
    if (!idMatch) {
      window._wb3AppendMsg('user', text);
      window._wb3AppendMsg('bot', "That doesn't look like a valid user ID. Please enter your numeric Roblox user ID.");
      return;
    }
    window._wb3AppendMsg('user', text);
    const typingEl = window._wb3AppendMsg('bot', '…');
    const robloxId = idMatch[1];
    const user = await _fetchRobloxDisplayName(robloxId);
    if (typingEl) typingEl.remove();
    if (!user) {
      window._wb3AppendMsg('bot', "I couldn't find that Roblox account. Please double-check your user ID and try again.");
      return;
    }

    // Show a confirm card with headshot + display name + yes/no buttons
    _robloxUser = user; // tentatively set so card can render
    var container = document.getElementById('ai-chat-messages');
    if (container) {
      var card = document.createElement('div');
      card.className = 'ck-verify-card';
      card.id = 'fr-roblox-confirm-card';

      var lbl = document.createElement('div');
      lbl.className = 'ck-verify-label';
      lbl.textContent = 'Is this you?';

      var av = document.createElement('div');
      av.className = 'ck-verify-avatar';
      if (user.avatarUrl) {
        var img = document.createElement('img');
        img.src = user.avatarUrl;
        img.alt = user.displayName;
        img.style.cssText = 'width:100%;height:100%;object-fit:cover;';
        img.onerror = function() { this.style.display = 'none'; av.textContent = user.displayName.slice(0,2).toUpperCase(); };
        av.appendChild(img);
      } else {
        av.textContent = user.displayName.slice(0,2).toUpperCase();
      }

      var nameEl = document.createElement('div');
      nameEl.className = 'ck-verify-name';
      nameEl.textContent = user.displayName;

      var unEl = document.createElement('div');
      unEl.className = 'ck-verify-id';
      unEl.textContent = '@' + user.username + '  ·  ID: ' + user.userId;

      // Yes / No buttons
      var btnRow = document.createElement('div');
      btnRow.style.cssText = 'display:flex;gap:8px;margin-top:10px;justify-content:center;';

      var yesBtn = document.createElement('button');
      yesBtn.textContent = 'Yes, that\'s me';
      yesBtn.style.cssText = 'background:var(--primary-color);color:#fff;border:none;padding:7px 18px;border-radius:6px;font-size:0.82rem;font-weight:700;cursor:pointer;font-family:inherit;';
      yesBtn.onclick = function() {
        card.remove();
        _robloxUser = user;
        _saveRobloxUser(user);
        _verifyingRoblox = false;
        if (input) { input.placeholder = 'Message…'; input.disabled = false; }
        _updateChatHeader(user.displayName + ' · @' + user.username, 'Verified Roblox · AI Assistant');
        window._wb3AppendMsg('user', 'Yes');
        window._wb3AppendMsg('bot', 'Perfect, ' + user.displayName + '! Let me help you with that.');
        // If there was an opening message waiting, send it to the AI now
        if (_pendingFirstMessage) {
          var pending = _pendingFirstMessage;
          _pendingFirstMessage = null;
          setTimeout(function() { _sendAiMessage(pending); }, 400);
        }
        _updateInputState();
      };

      var noBtn = document.createElement('button');
      noBtn.textContent = 'No, re-enter';
      noBtn.style.cssText = 'background:transparent;color:var(--ck-text-sub,#64748b);border:1px solid var(--ck-border,#e2e8f0);padding:7px 18px;border-radius:6px;font-size:0.82rem;font-weight:600;cursor:pointer;font-family:inherit;';
      noBtn.onclick = function() {
        card.remove();
        _robloxUser = null;
        // verifyingRoblox stays true so next message goes back through the ID flow
        if (input) { input.placeholder = 'Enter your Roblox user ID…'; input.focus(); }
        window._wb3AppendMsg('user', 'No');
        window._wb3AppendMsg('bot', 'No problem — please enter your correct Roblox user ID.');
      };

      btnRow.appendChild(yesBtn);
      btnRow.appendChild(noBtn);
      card.appendChild(lbl);
      card.appendChild(av);
      card.appendChild(nameEl);
      card.appendChild(unEl);
      card.appendChild(btnRow);
      container.appendChild(card);
      container.scrollTop = container.scrollHeight;
    }
  }

  /* ── AI send ── */
  async function _sendAiMessage(text) {
    if (_isAiLimitReached()) { _updateInputState(); return; }
    // Handle Roblox verification step
    if (_isRobloxIdStep()) { await _handleRobloxIdInput(text); return; }
    // Make sure chat view is visible
    _showView('chat');
    document.getElementById('fr-chat-card')?.classList.add('chat-active');
    _aiMessages.push({ role: 'user', content: text });
    _saveAiHistory(_aiMessages);
    window._wb3AppendMsg('user', text);
    window._wb3AppendMsg('bot', '\u2026');
    const msgs = document.getElementById('ai-chat-messages');
    const typingEl = msgs ? msgs.lastElementChild : null;
    // Build context with roblox user info if available
    var extraContext = FR_SYSTEM_CONTEXT;
    if (_robloxUser) extraContext += '\n[User is verified as Roblox user: ' + _robloxUser.displayName + ' (@' + _robloxUser.username + ', ID: ' + _robloxUser.userId + ')]';
    // Prepend context as a system message so the AI always has it
    var messagesWithContext = [{ role: 'user', content: extraContext }, { role: 'assistant', content: 'Understood. I am the Friends Remover support bot with full product knowledge. Ready to help.' }].concat(_aiMessages);
    try {
      const res = await fetch(WB3_API + '/chat/ai', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: messagesWithContext, aiReplyCount: _aiReplyCount }) });
      if (typingEl) typingEl.remove();
      if (!res.ok) { const err = await res.json().catch(function(){return{};}); window._wb3AppendMsg('bot', err.error || 'Something went wrong. Please try again.'); return; }
      const data = await res.json();
      let reply = data.reply || '';
      // Parse pipe-delimited options: [Opt1|Opt2|Opt3]
      const optMatch = reply.match(/\[([^\]]+)\]\s*$/);
      let options = [];
      if (optMatch && optMatch[1].includes('|')) {
        options = optMatch[1].split('|').map(function(s){return s.trim();}).filter(Boolean);
        reply = reply.slice(0, optMatch.index).trim();
      }
      // Also parse JSON options block: {"options":[...]}
      const jsonOptMatch = reply.match(/\{"options"\s*:\s*(\[[^\]]+\])\}/);
      if (jsonOptMatch) {
        try { const parsed = JSON.parse(jsonOptMatch[0]); if (Array.isArray(parsed.options)) options = parsed.options; } catch {}
        reply = reply.replace(jsonOptMatch[0], '').trim();
      }
      _aiMessages.push({ role: 'assistant', content: data.reply || reply });
      _saveAiHistory(_aiMessages);
      const ld = _incrementAiLimit(); _aiReplyCount = ld.count;
      window._wb3AppendMsg('bot', reply);
      if (options.length) _appendOptionButtons(options);
      if (data.liveAgent) { setTimeout(function(){ var lu = [..._aiMessages].reverse().find(function(m){return m.role==='user';}); _escalateToLive(lu ? lu.content : 'Hi, I need help.'); }, 600); return; }
      if (data.endSession) { setTimeout(function(){ _showEndSessionUI(); }, 600); }
    } catch { if (typingEl) typingEl.remove(); window._wb3AppendMsg('bot', 'Network error. Try our Discord for help.'); }
    finally { _updateInputState(); }
  }

  /* ── Live support (guest: email + message, no login required) ── */
  function _getStoredSession() { try { return JSON.parse(localStorage.getItem('fr_live_session') || 'null'); } catch { return null; } }
  function _saveStoredSession(d) { try { localStorage.setItem('fr_live_session', JSON.stringify(d)); } catch {} }
  function _clearStoredSession() { try { localStorage.removeItem('fr_live_session'); } catch {} }

  // ── Queue position polling (fallback + live updates) ──────────────────────
  var _queuePollInterval = null;
  var _queueStartTime    = null;

  function _startQueuePolling(sessionId) {
    _stopQueuePolling();
    _queueStartTime = Date.now();
    // Poll every 5s for position updates (Pusher is the fast path, this is the reliable path)
    _queuePollInterval = setInterval(async function() {
      if (!_liveSessionId) { _stopQueuePolling(); return; }
      try {
        const r = await fetch(WB3_API + '/chat/queue?sessionId=' + sessionId);
        if (!r.ok) return;
        const d = await r.json();
        if (d.position && d.position > 0) {
          _updateQueueUI(d.position);
        } else if (d.position === null) {
          // No longer in queue — agent joined or session changed
          _stopQueuePolling();
          _updateQueueUI(null);
        }
      } catch {}
    }, 5000);
    // Also do an immediate fetch so we don't wait 5s for the first real number
    setTimeout(async function() {
      if (!_liveSessionId) return;
      try {
        const r = await fetch(WB3_API + '/chat/queue?sessionId=' + sessionId);
        if (r.ok) { const d = await r.json(); if (d.position) _updateQueueUI(d.position); }
      } catch {}
    }, 800);
  }

  function _stopQueuePolling() {
    if (_queuePollInterval) { clearInterval(_queuePollInterval); _queuePollInterval = null; }
    _queueStartTime = null;
  }

  function _updateQueueUI(pos) {
    var overlay = document.getElementById('ck-queue-overlay');
    var msgs    = document.getElementById('ai-chat-messages');
    var sub     = document.getElementById('ck-queue-sub');
    var badge   = document.getElementById('ck-queue-badge');
    if (!overlay || !msgs) return;

    if (pos && pos > 0) {
      overlay.classList.add('visible');
      msgs.style.display = 'none';

      // Sub-text
      if (sub) sub.textContent = pos === 1
        ? "You're next! An agent will join you very shortly."
        : 'An agent will join you shortly. Thanks for your patience.';

      // Badge with live elapsed time
      if (badge) {
        badge.style.display = 'inline-flex';
        var estMin = Math.max(1, pos * 2);
        var elapsed = _queueStartTime ? Math.floor((Date.now() - _queueStartTime) / 1000) : 0;
        var elapsedStr = elapsed > 0
          ? ' &nbsp;·&nbsp; <span id="ck-queue-elapsed" style="opacity:0.75;">waiting ' + _fmtElapsed(elapsed) + '</span>'
          : '';
        badge.innerHTML =
          '<span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:#22c55e;'
          + 'margin-right:6px;animation:statusPulse 2s infinite;vertical-align:middle;flex-shrink:0;"></span>'
          + '<strong>#' + pos + '</strong>&nbsp;in queue'
          + '&nbsp;&nbsp;·&nbsp;&nbsp;Est. wait: ~' + estMin + ' min'
          + elapsedStr;
      }

      // Start the elapsed-time ticker if not already running
      _startElapsedTicker();

    } else {
      overlay.classList.remove('visible');
      msgs.style.display = '';
      _stopElapsedTicker();
      _stopQueuePolling();
    }
  }

  // ── Elapsed time ticker ────────────────────────────────────────────────────
  var _elapsedTickInterval = null;
  function _fmtElapsed(sec) {
    if (sec < 60) return sec + 's';
    return Math.floor(sec / 60) + 'm ' + (sec % 60) + 's';
  }
  function _startElapsedTicker() {
    if (_elapsedTickInterval) return;
    _elapsedTickInterval = setInterval(function() {
      var el = document.getElementById('ck-queue-elapsed');
      if (!el || !_queueStartTime) return;
      var sec = Math.floor((Date.now() - _queueStartTime) / 1000);
      el.textContent = 'waiting ' + _fmtElapsed(sec);
    }, 1000);
  }
  function _stopElapsedTicker() {
    if (_elapsedTickInterval) { clearInterval(_elapsedTickInterval); _elapsedTickInterval = null; }
  }
  function _showAgentJoinedCard(d) {
    // Dismiss queue overlay and reveal messages
    var overlay = document.getElementById('ck-queue-overlay');
    var msgs = document.getElementById('ai-chat-messages');
    if (overlay) overlay.classList.remove('visible');
    if (msgs) msgs.style.display = '';
    if (document.getElementById('ck-agent-joined-card')) return; // already shown
    var container = msgs; if (!container) return;

    var card = document.createElement('div');
    card.id = 'ck-agent-joined-card';
    card.className = 'ck-agent-joined-card';

    // Use the Roblox user's name + headshot (not the agent's)
    var displayName = (d && d.robloxUsername) || (d && d.agentName) || 'Support Agent';
    var robloxId    = d && d.robloxId;
    var headshotUrl = (d && d.robloxHeadshot) || null;

    // If no headshot yet, build the Roblox thumbnail URL directly
    if (!headshotUrl && robloxId) {
      headshotUrl = 'https://thumbs.roblox.com/v1/users/avatar-headshot?userIds=' + robloxId + '&size=420x420&format=Png&isCircular=false';
    }

    // Avatar
    var avDiv = document.createElement('div');
    avDiv.className = 'ck-agent-av-lg';
    avDiv.style.cssText = 'width:80px;height:80px;border-radius: 0;overflow:hidden;';

    if (headshotUrl) {
      var avImg = document.createElement('img');
      // Try direct image first; if it's the API endpoint, fetch and extract
      if (headshotUrl.indexOf('thumbs.roblox.com') !== -1 || headshotUrl.indexOf('thumbnails.roblox.com') !== -1) {
        // Fetch the API to get the real image URL
        fetch('https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=' + robloxId + '&size=420x420&format=Png&isCircular=false')
          .then(function(r){ return r.json(); })
          .then(function(data){
            var url = data && data.data && data.data[0] && data.data[0].imageUrl;
            if (url) { avImg.src = url; }
            else { avDiv.textContent = displayName.slice(0,2).toUpperCase(); }
          })
          .catch(function(){ avDiv.textContent = displayName.slice(0,2).toUpperCase(); });
      } else {
        avImg.src = headshotUrl;
      }
      avImg.alt = displayName;
      avImg.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius: 0;';
      avImg.onerror = function() { avDiv.textContent = displayName.slice(0,2).toUpperCase(); };
      avDiv.appendChild(avImg);
    } else {
      avDiv.textContent = displayName.slice(0,2).toUpperCase();
    }

    // Name
    var nameEl = document.createElement('div');
    nameEl.className = 'ck-agent-name';
    nameEl.textContent = displayName;

    // "joined the chat"
    var joinedEl = document.createElement('div');
    joinedEl.className = 'ck-agent-joined-label';
    joinedEl.textContent = 'joined the chat';

    // Timestamp
    var tsEl = document.createElement('div');
    tsEl.className = 'ck-agent-ts';
    var now = new Date();
    tsEl.textContent = now.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }) + ', ' + now.toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit' });

    card.appendChild(avDiv);
    card.appendChild(nameEl);
    card.appendChild(joinedEl);
    card.appendChild(tsEl);
    container.appendChild(card);
    container.scrollTop = container.scrollHeight;

    // Update header to show agent name
    _updateChatHeader(displayName + ' · Support Agent', 'Live Support · connected');
  }
  function _switchToLiveMode() {
    _mode = 'live';
    _showView('chat');
    document.getElementById('fr-chat-card')?.classList.add('chat-active');
    var aiNotice = document.getElementById('wb3-ai-notice'); if (aiNotice) aiNotice.style.display = 'none';
    var badge = document.getElementById('wb3-mode-badge');
    if (badge) { badge.textContent = 'LIVE'; badge.style.display = 'inline-flex'; badge.classList.add('live'); }
    var title = document.getElementById('wb3-head-name');
    if (title) {
      if (_robloxUser) {
        title.textContent = _robloxUser.displayName + ' — waiting for agent';
      } else {
        title.textContent = 'Waiting for an agent…';
      }
    }
    var hSub = document.getElementById('wb3-head-title');
    if (hSub) hSub.textContent = 'Live Support · connecting';
    // Show Roblox avatar in chat header if available
    var headerAvatar = document.querySelector('.fr-chat-avatar');
    if (headerAvatar && _robloxUser) {
      headerAvatar.style.overflow = 'hidden';
      headerAvatar.style.padding = '0';
      var hImg = document.createElement('img');
      hImg.src = 'https://www.roblox.com/headshot-thumbnail/image?userId=' + _robloxUser.userId + '&width=150&height=150&format=png';
      hImg.style.cssText = 'width:100%;height:100%;object-fit:cover;';
      hImg.onerror = function() { headerAvatar.textContent = _robloxUser.displayName.slice(0,2).toUpperCase(); };
      headerAvatar.innerHTML = '';
      headerAvatar.appendChild(hImg);
    }
    var cb = document.getElementById('wb3-close-btn'); if (cb) { cb.disabled = false; cb.style.opacity = ''; cb.style.cursor = ''; }
    var inputRow = document.getElementById('support-input-row'); if (inputRow) inputRow.style.display = '';
    _setChatLock(false);
    _updateInputState();
    _ckStartTimer();
    // Show queue overlay immediately while waiting for position
    var overlay = document.getElementById('ck-queue-overlay');
    var msgs = document.getElementById('ai-chat-messages');
    if (overlay && msgs) { overlay.classList.add('visible'); msgs.style.display = 'none'; }
    // Start polling for live queue position updates
    if (_liveSessionId) _startQueuePolling(_liveSessionId);
    // Generate a session ID for transcript
    if (!window._ckTranscriptId) window._ckTranscriptId = 'FR-' + Math.random().toString(36).slice(2,9).toUpperCase();
  }
  // _showIntakeForm removed — use _showView('intake') instead
  async function _fetchNewMessages(sessionId) {
    try {
      const res = await fetch(WB3_API + '/chat/session/' + sessionId + '/messages?since=' + _lastMsgTs); if (!res.ok) return;
      const data = await res.json();
      (data.messages || []).forEach(function(msg) {
        const ts = msg.timestamp || msg.createdAt || 0; const id = msg.messageId || msg.id;
        if (id && _renderedKvIds.has(id)) return;
        if (ts > _lastMsgTs) {
          if (id) _renderedKvIds.add(id);
          const role = msg.sender === 'user' ? 'user' : msg.sender === 'agent' ? 'agent' : msg.sender === 'system' ? 'system' : 'bot';
          // Show agent joined card on first agent message (fallback if agent-joined event missed)
          if (msg.sender === 'agent' && !document.getElementById('ck-agent-joined-card')) {
            _showAgentJoinedCard({ agentName: msg.agentName, agentAvatarUrl: msg.agentAvatarUrl });
            if (typeof window._ckFireAgentJoinedNotification === 'function') {
              window._ckFireAgentJoinedNotification(msg.agentName || null);
            }
          }
          window._wb3AppendMsg(role, msg.text || '', msg);
          _lastMsgTs = Math.max(_lastMsgTs, ts);
          // Apply lock/unlock from message meta
          if (msg.meta && msg.meta.locked === true) _setChatLock(true);
          if (msg.sender === 'agent' && !msg.meta?.locked) _setChatLock(false);
        }
      });
      if (data.status && data.status !== 'queued' && data.status !== 'closed') _updateQueueUI(null);
    } catch {}
  }
  async function _rehydrateMessages(sessionId) {
    try {
      const res = await fetch(WB3_API + '/chat/session/' + sessionId + '/messages?since=0'); if (!res.ok) return;
      const data = await res.json(); const container = document.getElementById('ai-chat-messages'); if (!container) return;
      container.innerHTML = ''; _renderedKvIds.clear();
      let shouldLock = false;
      (data.messages || []).forEach(function(msg) {
        const key = msg.messageId || msg.id; if (key && _renderedKvIds.has(key)) return; if (key) _renderedKvIds.add(key);
        const role = msg.sender === 'user' ? 'user' : msg.sender === 'agent' ? 'agent' : msg.sender === 'system' ? 'system' : 'bot';
        window._wb3AppendMsg(role, msg.text || '', msg);
        _lastMsgTs = Math.max(_lastMsgTs, msg.timestamp || msg.createdAt || 0);
        if (msg.meta && msg.meta.locked === true) shouldLock = true;
        if (msg.sender === 'agent') {
          shouldLock = false;
          // Show joined card if not already shown
          if (!document.getElementById('ck-agent-joined-card')) {
            _showAgentJoinedCard({ agentName: msg.agentName, agentAvatarUrl: msg.agentAvatarUrl });
          }
        }
      });
      _setChatLock(shouldLock);
    } catch {}
  }
  function _subscribePusher(sessionId) {
    if (typeof Pusher === 'undefined') return;
    try { if (_pusher) _pusher.disconnect(); } catch {}
    _pusher = new Pusher(WB3_PUSHER_KEY, { cluster: WB3_PUSHER_CLUSTER });
    _pusherChannel = _pusher.subscribe('xtero-session-' + sessionId);
    _pusherChannel.bind('new-message', function(d) {
      if (!d) return;
      // Apply lock state immediately
      if (typeof d.chatLocked === 'boolean') _setChatLock(d.chatLocked);
      // If Pusher payload includes the message text, render it instantly (no REST needed)
      if (d.text && d.sender && d.messageId) {
        var mid = d.messageId;
        if (_renderedKvIds.has(mid)) return; // already shown
        _renderedKvIds.add(mid);
        var role = d.sender === 'user' ? 'user' : d.sender === 'agent' ? 'agent' : d.sender === 'system' ? 'system' : 'bot';
        // Show agent joined card on first agent message
        if (d.sender === 'agent' && !document.getElementById('ck-agent-joined-card')) {
          _showAgentJoinedCard({ agentName: d.agentName, agentAvatarUrl: d.agentAvatarUrl });
          if (typeof window._ckFireAgentJoinedNotification === 'function') {
            window._ckFireAgentJoinedNotification(d.agentName || null);
          }
        }
        var msgObj = { messageId: mid, sender: d.sender, agentName: d.agentName, agentAvatarUrl: d.agentAvatarUrl,
          timestamp: d.timestamp, meta: d.meta || null, replyTo: d.replyTo || null };
        window._wb3AppendMsg(role, d.text, msgObj);
        _lastMsgTs = Math.max(_lastMsgTs, d.timestamp || d.updatedAt || 0);
        if (d.status && d.status !== 'queued' && d.status !== 'closed') _updateQueueUI(null);
      } else {
        // Fallback: fetch from REST if no text in payload
        _fetchNewMessages(sessionId);
      }
    });
    _pusherChannel.bind('queue-position', function(d) {
      if (d) _updateQueueUI(d.position);
      // If moved to position 1, ensure polling is active for fast updates
      if (d && d.position === 1 && _liveSessionId) _startQueuePolling(_liveSessionId);
    });
    _pusherChannel.bind('session-closed', function() {
      _clearStoredSession(); _liveSessionId = null;
      _stopQueuePolling(); _stopElapsedTicker();
      window._wb3AppendMsg('system', 'Support session has ended.');
      _updateQueueUI(null);
    });
    _pusherChannel.bind('agent-joined', function(d) {
      _stopQueuePolling(); _stopElapsedTicker();
      _showAgentJoinedCard(d);
      // Fire desktop notification so user knows their agent has arrived
      if (typeof window._ckFireAgentJoinedNotification === 'function') {
        window._ckFireAgentJoinedNotification((d && d.agentName) || null);
      }
    });
    _pusherChannel.bind('agent-typing', function(d) {
      var c = document.getElementById('ai-chat-messages'); if (!c) return;
      var ex = document.getElementById('fr-agent-typing'); if (ex) { clearTimeout(ex._t); ex.remove(); }
      var b = document.createElement('div'); b.id = 'fr-agent-typing'; b.className = 'ai-msg bot';
      var agentName = (d && d.agentName) ? _esc(d.agentName) : 'Agent';
      var agentAvatar = (d && d.agentAvatarUrl) ? d.agentAvatarUrl : '';
      var avatarHtml = agentAvatar
        ? '<div class="ai-msg-avatar" style="overflow:hidden;"><img src="' + _esc(agentAvatar) + '" style="width:100%;height:100%;object-fit:cover;" onerror="this.style.display=\'none\'"/></div>'
        : '<div class="ai-msg-avatar">' + agentName.slice(0,2).toUpperCase() + '</div>';
      b.innerHTML = avatarHtml + '<div class="msg-wrap"><div class="ai-msg-bubble-wrap"><div style="font-size:0.65rem;color:var(--ck-text-sub);margin-bottom:3px;font-weight:700;">' + agentName + ' &middot; typing</div><div class="ai-msg-bubble"><div class="ai-typing-indicator"><span class="ai-typing-dot"></span><span class="ai-typing-dot"></span><span class="ai-typing-dot"></span></div></div></div></div>';
      c.appendChild(b); c.scrollTop = c.scrollHeight; b._t = setTimeout(function(){ b.remove(); }, 5000);
    });
  }
  /* ── Email OTP state ── */
  var _otpEmail = '', _otpMsg = '', _otpResendTimer = null;

  function _initOTPInputs() {
    var digits = document.querySelectorAll('.wb3-otp-digit');
    digits.forEach(function(el, i) {
      el.addEventListener('input', function() {
        el.value = el.value.replace(/\D/g, '').slice(-1);
        el.classList.toggle('filled', el.value !== '');
        if (el.value && i < digits.length - 1) digits[i + 1].focus();
        _updateOTPSubmitBtn();
      });
      el.addEventListener('keydown', function(e) {
        if (e.key === 'Backspace' && !el.value && i > 0) {
          digits[i - 1].value = ''; digits[i - 1].classList.remove('filled'); digits[i - 1].focus();
        }
        if (e.key === 'Enter') { e.preventDefault(); wb3SubmitOTP(); }
      });
      el.addEventListener('paste', function(e) {
        e.preventDefault();
        var pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
        pasted.split('').forEach(function(ch, j) { if (digits[j]) { digits[j].value = ch; digits[j].classList.add('filled'); } });
        digits[Math.min(pasted.length, digits.length - 1)].focus();
        _updateOTPSubmitBtn();
      });
    });
  }
  function _updateOTPSubmitBtn() {
    var full = Array.from(document.querySelectorAll('.wb3-otp-digit')).every(function(d){ return d.value.length === 1; });
    var btn  = document.getElementById('wb3-otp-submit-btn');
    if (btn) btn.disabled = !full;
  }
  function _clearOTPInputs() {
    document.querySelectorAll('.wb3-otp-digit').forEach(function(d){ d.value = ''; d.classList.remove('filled','error'); });
    var err = document.getElementById('wb3-otp-error'); if (err) err.textContent = '';
    var btn = document.getElementById('wb3-otp-submit-btn'); if (btn) btn.disabled = true;
  }
  function _startResendCooldown(sec) {
    var btn = document.getElementById('wb3-otp-resend-btn');
    var timerEl = document.getElementById('wb3-otp-resend-timer');
    if (btn) btn.disabled = true;
    var rem = sec;
    if (timerEl) timerEl.textContent = ' (' + rem + 's)';
    clearInterval(_otpResendTimer);
    _otpResendTimer = setInterval(function() {
      rem--;
      if (rem <= 0) { clearInterval(_otpResendTimer); if (btn) btn.disabled = false; if (timerEl) timerEl.textContent = ''; }
      else { if (timerEl) timerEl.textContent = ' (' + rem + 's)'; }
    }, 1000);
  }
  window.wb3BackToIntakeFromVerify = function() {
    clearInterval(_otpResendTimer); _clearOTPInputs(); _otpEmail = ''; _otpMsg = ''; _showView('intake');
    var submitBtn = document.getElementById('wb3-intake-btn'); if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Start Conversation'; }
  };

  /* ── Guest intake form submission — sends OTP ── */
  window.wb3SubmitIntake = async function() {
    const emailEl = document.getElementById('wb3-intake-email');
    const msgEl   = document.getElementById('wb3-intake-msg');
    const errEl   = document.getElementById('wb3-intake-error');
    const btn     = document.getElementById('wb3-intake-btn');
    if (!emailEl || !msgEl) return;
    const email = emailEl.value.trim();
    const msg   = msgEl.value.trim();
    if (errEl) errEl.textContent = '';
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      if (errEl) errEl.textContent = 'Please enter a valid email address.'; return;
    }
    if (!msg) { if (errEl) errEl.textContent = 'Please enter a message.'; return; }

    // If this email is already verified — skip OTP, go straight to chat
    const verifiedEmail = _loadVerifiedEmail();
    if (verifiedEmail && verifiedEmail === email.toLowerCase()) {
      _otpEmail = email; _otpMsg = msg;
      try { localStorage.setItem('fr_guest_email', email); } catch {}
      _showView('chat');
      document.getElementById('fr-chat-card')?.classList.add('chat-active');
      window._wb3GreetingDone = true;
      if (_robloxUser) {
        _sendAiMessage(msg);
      } else {
        window._wb3AppendMsg('user', msg);
        _pendingFirstMessage = msg;
        _startRobloxVerification();
      }
      return;
    }

    // New email — send OTP
    if (btn) { btn.disabled = true; btn.textContent = 'Sending code…'; }
    try {
      const res = await fetch(EMAIL_VERIFY_API + '/api/send-verification', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, message: msg })
      });
      const data = await res.json();
      if (!data.success) {
        if (errEl) errEl.textContent = data.message || 'Could not send verification email. Please try again.';
        if (btn) { btn.disabled = false; btn.textContent = 'Start Conversation'; }
        return;
      }
      _otpEmail = email; _otpMsg = msg;
      try { localStorage.setItem('fr_guest_email', email); } catch {}
      const display = document.getElementById('wb3-verify-email-display');
      if (display) display.textContent = email;
      _clearOTPInputs();
      _showView('verify');
      _startResendCooldown(60);
      setTimeout(function() { document.getElementById('otp0')?.focus(); }, 120);
    } catch {
      if (errEl) errEl.textContent = 'Network error. Please try again.';
    } finally {
      if (btn && btn.textContent === 'Sending code…') { btn.disabled = false; btn.textContent = 'Start Conversation'; }
    }
  };

  window.wb3ResendOTP = async function() {
    if (!_otpEmail) return;
    var resendBtn = document.getElementById('wb3-otp-resend-btn');
    if (resendBtn) resendBtn.disabled = true;
    _clearOTPInputs();
    var errEl = document.getElementById('wb3-otp-error');
    try {
      const res = await fetch(EMAIL_VERIFY_API + '/api/send-verification', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: _otpEmail, message: _otpMsg })
      });
      const d = await res.json();
      if (!d.success) {
        if (errEl) errEl.textContent = d.message || 'Could not resend. Try again shortly.';
        if (resendBtn) resendBtn.disabled = false;
        return;
      }
      _startResendCooldown(60);
      setTimeout(function() { document.getElementById('otp0')?.focus(); }, 80);
    } catch {
      if (errEl) errEl.textContent = 'Network error. Try again.';
      if (resendBtn) resendBtn.disabled = false;
    }
  };

  window.wb3SubmitOTP = async function() {
    const digits = document.querySelectorAll('.wb3-otp-digit');
    const code   = Array.from(digits).map(function(d){ return d.value; }).join('');
    const errEl  = document.getElementById('wb3-otp-error');
    const submitBtn = document.getElementById('wb3-otp-submit-btn');
    if (code.length !== 6) return;
    if (errEl) errEl.textContent = '';
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Verifying…'; }
    try {
      const res = await fetch(EMAIL_VERIFY_API + '/api/verify', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: _otpEmail, code })
      });
      const data = await res.json();
      if (!data.success) {
        digits.forEach(function(d){ d.classList.add('error'); });
        setTimeout(function(){ digits.forEach(function(d){ d.classList.remove('error'); }); }, 400);
        if (errEl) errEl.textContent = data.message || 'Incorrect code. Please try again.';
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Verify & Continue'; }
        setTimeout(function() { _clearOTPInputs(); document.getElementById('otp0')?.focus(); }, 400);
        return;
      }
      clearInterval(_otpResendTimer);
      _saveVerifiedEmail(_otpEmail);
      if (submitBtn) submitBtn.textContent = 'Verified ✓';
      setTimeout(function() {
        _showView('chat');
        document.getElementById('fr-chat-card')?.classList.add('chat-active');
        _updateChatHeader('Friends Remover Support', 'AI Assistant');
        window._wb3GreetingDone = true;
        if (_robloxUser) {
          _sendAiMessage(_otpMsg);
        } else {
          window._wb3AppendMsg('user', _otpMsg);
          _pendingFirstMessage = _otpMsg;
          _startRobloxVerification();
        }
      }, 600);
    } catch {
      if (errEl) errEl.textContent = 'Network error. Please try again.';
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Verify & Continue'; }
    }
  };

  // Init OTP inputs on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', _initOTPInputs);
  } else {
    _initOTPInputs();
  }

  window.wb3CancelIntake = function() { frChatToggle(); };
  async function _escalateToLive(msg) {
    // Check if we already have an active live session
    const existingSession = _getStoredSession();
    if (existingSession && existingSession.sessionId) {
      _liveSessionId = existingSession.sessionId;
      _switchToLiveMode();
      _subscribePusher(existingSession.sessionId);
      await _rehydrateMessages(existingSession.sessionId);
      return;
    }
    // Try to get a saved email from the intake form submission
    let email = '';
    try { email = localStorage.getItem('fr_guest_email') || ''; } catch {}
    if (!email) {
      // No email on file — show intake form to collect it
      _showView('intake');
      const msgEl = document.getElementById('wb3-intake-msg');
      if (msgEl && msg) msgEl.value = msg;
      setTimeout(function(){ document.getElementById('wb3-intake-email')?.focus(); }, 80);
      return;
    }
    // Create the live session with the saved email
    window._wb3AppendMsg('bot', 'Connecting you with a live agent now…');
    try {
      const res = await fetch(WB3_API + '/chat/session', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          message: msg || 'I need help.',
          aiMessages: _aiMessages.slice(-8),
          robloxId: _robloxUser ? _robloxUser.userId : undefined,
          robloxDisplayName: _robloxUser ? _robloxUser.displayName : undefined,
        })
      });
      const data = await res.json();
      if (!res.ok) {
        window._wb3AppendMsg('bot', 'Could not connect to a live agent right now. Please try Discord: https://discord.com/invite/Z3Vqjb7SZc');
        return;
      }
      _liveSessionId = data.chatId;
      _saveStoredSession({ sessionId: data.chatId, userId: data.userId, token: data.guestToken, isGuest: true });
      _switchToLiveMode();
      _startQueuePolling(data.chatId);
      _subscribePusher(data.chatId);
      _updateQueueUI(data.position);
      await _rehydrateMessages(data.chatId);
    } catch {
      window._wb3AppendMsg('bot', 'Connection error. Please try Discord: https://discord.com/invite/Z3Vqjb7SZc');
    }
  }
  var _typingThrottle = null;
  window._onUserTyping = function() {
    if (!_liveSessionId || _typingThrottle) return;
    _typingThrottle = setTimeout(function(){ _typingThrottle = null; }, 2000);
    fetch(WB3_API + '/chat/session/' + _liveSessionId + '/typing', { method: 'POST', headers: { 'Content-Type': 'application/json' } }).catch(function(){});
  };
  async function _sendLiveMessage(text) {
    if (!_liveSessionId) return;
    const stored = _getStoredSession(); if (!stored || !stored.userId || !stored.token) return;
    // Normalise common yes/no variants so the server accepts them
    var normLower = text.trim().toLowerCase();
    if (_YES_WORDS.indexOf(normLower) !== -1) text = 'yes';
    if (_NO_WORDS.indexOf(normLower)  !== -1) text = 'no';
    const replyTo = _wb3ReplyTo ? { messageId: _wb3ReplyTo.msgId, text: _wb3ReplyTo.text, sender: _wb3ReplyTo.author } : null;
    window._fr_clearReply();
    try { await fetch(WB3_API + '/chat/session/' + _liveSessionId + '/message', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ userId: stored.userId, token: stored.token, body: text, replyTo }) }); } catch {}
  }
  async function _restoreLiveSession() {
    const stored = _getStoredSession(); if (!stored || !stored.sessionId) return;
    const sid = stored.sessionId;
    try {
      const res = await fetch(WB3_API + '/chat/session/' + sid); if (!res.ok) { _clearStoredSession(); return; }
      const data = await res.json();
      if (!data.session || data.session.status === 'closed') { _clearStoredSession(); return; }
      _liveSessionId = sid; _switchToLiveMode(); _showView('chat'); _subscribePusher(sid); await _rehydrateMessages(sid);
      if (data.session.status === 'queued') {
        const qr = await fetch(WB3_API + '/chat/queue?sessionId=' + sid);
        if (qr.ok) { const qd = await qr.json(); _updateQueueUI(qd.position); }
        _startQueuePolling(sid);
      }
    } catch { _clearStoredSession(); }
  }
  function _closeSessionNow(sid) {
    const stored = _getStoredSession(); if (!sid || !stored?.token) return;
    const payload = JSON.stringify({ userId: stored.userId, token: stored.token });
    const url = WB3_API + '/chat/session/' + sid + '/close';
    if (navigator.sendBeacon) navigator.sendBeacon(url, new Blob([payload], { type: 'application/json' }));
    else fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true }).catch(function(){});
  }

  function _wb3FullReset() {
    if (_liveSessionId) _closeSessionNow(_liveSessionId);
    _clearStoredSession(); _clearAiHistory(); _aiMessages = []; _aiReplyCount = _loadAiLimit().count;
    _liveSessionId = null; _renderedKvIds = new Set(); _wb3ReplyTo = null; _mode = 'ai';
    _robloxUser = null; _verifyingRoblox = false; _pendingFirstMessage = null;
    _otpEmail = ''; _otpMsg = ''; clearInterval(_otpResendTimer); _otpResendTimer = null;
    try { localStorage.removeItem(FR_ROBLOX_KEY); } catch {}
    // NOTE: FR_VERIFIED_EMAIL is intentionally kept — user never needs to re-verify
    // Only clear the session email, not the permanent verified email
    try { localStorage.removeItem('fr_guest_email'); } catch {}
    _stopQueuePolling(); _stopElapsedTicker();
    try { if (_pusherChannel) _pusherChannel.unbind_all(); } catch {}
    try { if (_pusher) _pusher.disconnect(); } catch {}
    _pusher = null; _pusherChannel = null;
    const msgs = document.getElementById('ai-chat-messages'); if (msgs) msgs.innerHTML = '';
    const aiNotice = document.getElementById('wb3-ai-notice'); if (aiNotice) aiNotice.style.display = 'none';
    // Clear and reset the intake form fields
    const emailEl = document.getElementById('wb3-intake-email'); if (emailEl) emailEl.value = '';
    const msgEl   = document.getElementById('wb3-intake-msg');   if (msgEl)   msgEl.value   = '';
    const errEl   = document.getElementById('wb3-intake-error'); if (errEl)   errEl.textContent = '';
    const btn     = document.getElementById('wb3-intake-btn');   if (btn)   { btn.disabled = false; btn.textContent = 'Start Conversation'; }
    // Reset misc UI state
    const inputRow = document.getElementById('support-input-row'); if (inputRow) inputRow.style.display = '';
    _setChatLock(false);
    _updateQueueUI(null);
    var badge2 = document.getElementById('wb3-mode-badge');
    if (badge2) { badge2.textContent = 'AI'; badge2.style.display = 'none'; badge2.classList.remove('live'); }
    var inp2 = document.getElementById('ai-chat-input'); if (inp2) { inp2.disabled = false; inp2.placeholder = 'What can we help you with?'; inp2.value = ''; }
    var cb2  = document.getElementById('wb3-close-btn'); if (cb2) { cb2.disabled = true; cb2.style.opacity = '0.35'; cb2.style.cursor = 'not-allowed'; }
    _updateInputState();
    window._wb3GreetingDone = false;
    // Always return to the intake (email entry) form — never skip ahead
    _updateChatHeader('Friends Remover Support', 'AI Assistant');
    _showView('intake');
    document.getElementById('fr-chat-card')?.classList.add('chat-active');
    setTimeout(function() { document.getElementById('wb3-intake-email')?.focus(); }, 80);
  }

  /* ── Public API ── */
  window.wb3ShowFeedback   = function() { document.getElementById('wb3-feedback-overlay')?.classList.add('open'); };
  window.wb3HideFeedback   = function() { document.getElementById('wb3-feedback-overlay')?.classList.remove('open'); };
  window.wb3SubmitFeedback = function(vote) {
    document.getElementById('wb3-thumb-up')?.classList.remove('selected-up','selected-down');
    document.getElementById('wb3-thumb-down')?.classList.remove('selected-up','selected-down');
    if (vote === 'up')   document.getElementById('wb3-thumb-up')?.classList.add('selected-up');
    if (vote === 'down') document.getElementById('wb3-thumb-down')?.classList.add('selected-down');
  };
  window.wb3ConfirmLeave   = function() { document.getElementById('wb3-feedback-overlay')?.classList.remove('open'); _wb3FullReset(); };

  /* ── Settings panel ── */
  var _ckSettingsOpen = false;
  var _ckMaximized = false;
  window.ckMaximize = function() {
    _ckMaximized = !_ckMaximized;
    var card = document.getElementById('fr-chat-card');
    var panel = document.querySelector('.fr-chat-panel-wrap');
    if (card) card.classList.toggle('chat-maximized', _ckMaximized);
    // No panel width override needed — card is fixed/fullscreen when maximized
    if (panel) panel.style.width = '';
    var lbl = document.getElementById('ck-maximize-label');
    if (lbl) lbl.textContent = _ckMaximized ? 'Restore window' : 'Maximize window';
  };
  window.ckToggleSettings = function() {
    _ckSettingsOpen = !_ckSettingsOpen;
    const panel = document.getElementById('ck-settings-panel');
    const btn = document.getElementById('ck-gear-btn');
    if (panel) panel.style.display = _ckSettingsOpen ? 'block' : 'none';
    if (btn) btn.style.background = _ckSettingsOpen ? 'rgba(255,255,255,0.22)' : '';
  };
  window.ckDownloadTranscript = function() {
    var msgs = document.getElementById('ai-chat-messages'); if (!msgs) return;
    var lines = [];
    var now = new Date();
    var dateStr = now.toLocaleDateString('en-US', {year:'numeric',month:'long',day:'numeric'});
    var timeStr = now.toLocaleTimeString('en-US', {hour:'2-digit',minute:'2-digit'});
    lines.push('Friends Remover Support - Chat Transcript');
    lines.push('Date: ' + dateStr + ' at ' + timeStr);
    lines.push('Session ID: ' + (window._ckTranscriptId || ('FR-' + Math.random().toString(36).slice(2,9).toUpperCase())));
    lines.push('='.repeat(50));
    lines.push('');
    msgs.querySelectorAll('.ai-msg').forEach(function(m) {
      var isUser = m.classList.contains('user');
      var isAgent = m.classList.contains('agent');
      var isSystem = m.classList.contains('system') || m.classList.contains('ai-msg-system');
      var bubble = m.querySelector('.ai-msg-bubble') || m;
      var text = bubble.textContent.trim();
      if (!text || text === '...' || text === '') return;
      var ts = m.querySelector('[data-ts]');
      var timePrefix = ts ? '[' + ts.getAttribute('data-ts') + '] ' : '';
      var speaker = isUser ? 'You' : isAgent ? 'Agent' : isSystem ? 'System' : 'Support Bot';
      lines.push(timePrefix + speaker + ': ' + text);
    });
    lines.push('');
    lines.push('='.repeat(50));
    lines.push('End of transcript - Friends Remover Support');
    var blob = new Blob([lines.join('\n')], { type: 'text/plain' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'friendsremover-chat-' + now.toISOString().slice(0,10) + '.txt';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
  };
  /* ── Notifications toggle ── */
  (function() {
    var _notifEnabled = false;
    var _notifSeq = 0; // unique tag counter — prevents notifications replacing each other

    function _syncToggleUI() {
      var btn = document.getElementById('ck-notif-toggle');
      if (!btn) return;
      var granted = ('Notification' in window) && Notification.permission === 'granted';
      _notifEnabled = granted;
      btn.classList.toggle('off', !granted);
    }

    window.ckToggleNotifications = function() {
      var btn = document.getElementById('ck-notif-toggle');
      if (!('Notification' in window)) {
        alert('Your browser does not support desktop notifications.');
        return;
      }
      if (Notification.permission === 'denied') {
        alert('Notifications are blocked by your browser.\n\nTo fix this:\n1. Click the lock/info icon in your browser address bar\n2. Find "Notifications" and set it to "Allow"\n3. Refresh the page and try again.');
        if (btn) btn.classList.add('off');
        return;
      }
      if (_notifEnabled) {
        _notifEnabled = false;
        if (btn) btn.classList.add('off');
        return;
      }
      Notification.requestPermission().then(function(result) {
        if (result === 'granted') {
          _notifEnabled = true;
          if (btn) btn.classList.remove('off');
          new Notification('Notifications enabled \u2713', {
            body: 'You will be alerted when a new chat message arrives.',
            icon: 'https://friendsremover.xyz/icon.png',
            tag: 'fr-notif-enable'
          });
        } else {
          _notifEnabled = false;
          if (btn) btn.classList.add('off');
          if (result === 'denied') {
            alert('Notifications were blocked.\n\nTo enable:\n1. Click the lock/info icon in your browser address bar\n2. Set Notifications to "Allow"\n3. Refresh the page and try again.');
          }
        }
      });
    };

    // Fire a desktop notification — each gets a unique tag so they don't replace each other
    window._ckFireNotification = function(senderName, messageText, opts) {
      if (!_notifEnabled) return;
      if (!('Notification' in window) || Notification.permission !== 'granted') return;
      // Only skip if the document is fully visible AND focused (user is actively on the tab)
      if (document.visibilityState === 'visible' && document.hasFocus()) return;
      try {
        var tag = (opts && opts.tag) ? opts.tag : ('fr-msg-' + (++_notifSeq));
        new Notification(senderName || 'Friends Remover Support', {
          body:  messageText || 'New message received.',
          icon:  'https://friendsremover.xyz/icon.png',
          tag:   tag,
          renotify: true // always show even if same tag
        });
      } catch(e) {}
    };

    // Agent-joined notification — always uses a fixed tag (only fires once per session)
    window._ckFireAgentJoinedNotification = function(agentName) {
      if (!_notifEnabled) return;
      if (!('Notification' in window) || Notification.permission !== 'granted') return;
      try {
        new Notification('\uD83D\uDC4B ' + (agentName || 'A support agent') + ' has joined!', {
          body:     'Your live support session has started. Tap to open.',
          icon:     'https://friendsremover.xyz/icon.png',
          tag:      'fr-agent-joined',
          renotify: true
        });
      } catch(e) {}
    };

    // Sync on load — handle case where DOMContentLoaded already fired
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', _syncToggleUI);
    } else {
      _syncToggleUI();
    }

    // Re-sync whenever settings panel opens
    var _origToggleSettings = window.ckToggleSettings;
    window.ckToggleSettings = function() {
      if (_origToggleSettings) _origToggleSettings();
      _syncToggleUI();
    };
  })();

  /* ── Header timer ── */
  var _ckTimerStart = null, _ckTimerInterval = null;
  function _ckStartTimer() {
    if (_ckTimerInterval) return; // already running
    _ckTimerStart = Date.now();
    _ckTimerInterval = setInterval(function() {
      const el = document.getElementById('wb3-head-title'); if (!el) return;
      const s = Math.floor((Date.now() - _ckTimerStart) / 1000);
      const h = String(Math.floor(s/3600)).padStart(2,'0');
      const m = String(Math.floor((s%3600)/60)).padStart(2,'0');
      const sc = String(s%60).padStart(2,'0');
      el.textContent = h+':'+m+':'+sc;
    }, 1000);
  }
  window.wb3InputChange    = function() { const v = (document.getElementById('ai-chat-input')?.value||'').trim(); const btn = document.getElementById('ai-send-btn'); if (btn) btn.disabled = !v; };
  window.wb3Send           = function() {
    const input = document.getElementById('ai-chat-input'); if (!input) return;
    const text = input.value.trim(); if (!text) return;
    input.value = ''; _updateInputState();
    if (_mode === 'live') _sendLiveMessage(text); else _sendAiMessage(text);
  };
  window.wb3QuickSend      = function(txt) { const inp = document.getElementById('ai-chat-input'); if (inp) inp.value = txt; setTimeout(wb3Send, 60); };
  // Legacy stubs kept so any inline onclick references don't throw
  window.wb3ConfirmEscalate = function() { const lu = [..._aiMessages].reverse().find(function(m){return m.role==='user';}); _escalateToLive(lu ? lu.content : ''); };
  window.wb3CancelEscalate  = function() { window.wb3CancelIntake(); };

  /* ── Init ── */
  window.addEventListener('beforeunload', function() { if (_liveSessionId) _closeSessionNow(_liveSessionId); });
  window.addEventListener('load', function() {
    _loadAiLimit();
    _robloxUser = _loadRobloxUser();

    // Restore persisted AI history
    const savedHistory = _loadAiHistory();
    if (savedHistory.length > 0) { _aiMessages = savedHistory; }

    const storedSession  = _getStoredSession();
    const hasLiveSession = storedSession && storedSession.sessionId;
    const hasAiHistory   = _aiMessages.length > 0;
    const verifiedEmail  = _loadVerifiedEmail();

    // Auto-fill intake form with last verified email if shown
    if (verifiedEmail) {
      const emailEl = document.getElementById('wb3-intake-email');
      if (emailEl) emailEl.value = verifiedEmail;
    }

    document.getElementById('fr-chat-card')?.classList.add('chat-active');

    if (hasLiveSession) {
      _showView('chat');
      _updateChatHeader('Reconnecting…', 'Restoring your session');
    } else if (hasAiHistory) {
      _showView('chat');
      if (!window._wb3GreetingDone) {
        _aiMessages.forEach(function(m) {
          if (m.role === 'user') window._wb3AppendMsg('user', m.content);
          else if (m.role === 'assistant') window._wb3AppendMsg('bot', m.content);
        });
        var name = _robloxUser ? _robloxUser.displayName : null;
        _updateChatHeader(name ? name + ' — welcome back!' : 'Welcome back!', 'AI Assistant · chat resumed');
        window._wb3AppendMsg('bot', (name ? 'Welcome back, ' + name + '! ' : 'Welcome back! ') + 'How can I help you?');
        window._wb3GreetingDone = true;
      }
    } else if (verifiedEmail) {
      _otpEmail = verifiedEmail;
      try { localStorage.setItem('fr_guest_email', verifiedEmail); } catch {}
      _showView('chat');
      document.getElementById('fr-chat-card')?.classList.add('chat-active');
      if (!window._wb3GreetingDone) {
        var vName = _robloxUser ? _robloxUser.displayName : null;
        _updateChatHeader(vName ? vName + ' — welcome back!' : 'Friends Remover Support', vName ? 'Verified · AI Assistant' : 'AI Assistant');
        window._wb3AppendMsg('bot', (vName ? 'Welcome back, ' + vName + '! ' : 'Welcome back! ') + "What can I help you with today?");
        if (!_robloxUser) setTimeout(function() { _startRobloxVerification(); }, 800);
        window._wb3GreetingDone = true;
      }
    } else {
      // First visit — show intake form
      _showView('intake');
    }

    _restoreLiveSession();
  });
})();
</script>

<!-- ═══ GLOBAL FIXED CHAT LAUNCHER ═══ -->
