          ';--x1:' + (ltr ? '110vw' : '-10vw') + ';--wob:' + (Math.random() * 12 - 6).toFixed(1) + 'vh;animation-duration:9s;opacity:.8">' + batSVG(34) + '</span>';
        document.body.appendChild(box);
        setTimeout(() => box.remove(), 9500);
      }
      setInterval(ambientBat, 30000);

      // Watches the clock; fires the sequence for everyone at the same moment.
      function watch() {
        if (enabled || counting || testing || now() >= HALLOWEEN_END_MS) return;
        const rem = HALLOWEEN_LAUNCH_MS - now();
        if (rem > 2900) return;
        if (rem > -2000) startCountdown(HALLOWEEN_LAUNCH_MS);
        else applyHalloween();                       // page was open/backgrounded well past launch
      }

      // ── Boot ──
      const remAtBoot = HALLOWEEN_LAUNCH_MS - now();
      let previewing = false;
      if (now() >= HALLOWEEN_END_MS) {
        disableAccent();                             // season is over
        if (store.get('fr-halloween-applied') || store.get('fr-accent') === 'halloween') endHalloween(false, true);
      } else if (remAtBoot <= -2000) {
        enableAccent();
        if (!store.get('fr-halloween-applied')) applyHalloween();   // first visit since launch
        else { enabled = true; applyAccentColor(store.get('fr-accent') || 'halloween'); }
      } else if (store.get('fr-accent') === 'halloween') {
        applyAccentColor('green');                   // locked: no Halloween before launch
        store.del('fr-halloween-applied');
      }
      ['halloween-header.webp', 'halloween-compact-frame.webp'].forEach(src => { try { new Image().src = src; } catch (e) {} });
      syncClock();
      setInterval(syncClock, 300000);
      // Runs until the end date: starts the launch at 6:00 PM Oct 16, switches Halloween off when Nov 5 begins.
      const poll = setInterval(() => {
        if (previewing) return;
        if (now() >= HALLOWEEN_END_MS) {
          if (enabled || currentAccent === 'halloween' || store.get('fr-halloween-applied')) endHalloween(true);
          clearInterval(poll);
          return;
        }
        watch();
      }, 500);

      // ── TEST HOOK (temporary — delete this block when done testing) ──
      window.FRHalloween = {
        preview() { previewing = true; testing = true; startCountdown(now() + 2900, { test: true }); },
        endPreview() { endHalloween(true, true); },   // test the Nov 5 switch-off
        reset() { previewing = false; resetLook(); },
        sound(on) { soundOn = on !== false; if (soundOn) unlockAudio(); return 'sound ' + (soundOn ? 'on' : 'off'); }
      };
    })();

    // Hamburger menu (desktop fallback only)
    const hamburger = document.getElementById('hamburger');
    const mobileMenu = document.getElementById('mobileMenu');
    if (hamburger) {
      hamburger.addEventListener('click', () => {
        const open = mobileMenu.classList.toggle('open');
        hamburger.classList.toggle('open', open);
        document.body.style.overflow = open ? 'hidden' : '';
      });
    }
    function closeMobileMenu() {
      if (mobileMenu) mobileMenu.classList.remove('open');
      if (hamburger) hamburger.classList.remove('open');
      document.body.style.overflow = '';
    }
    // Page switching
    let currentPage = 'home';
    const siteHeaderEl = document.querySelector('.site-header');
    function showPage(id, pushState = true) {
      // Support tab → show under construction notice
      if (id === 'support') {
        var existing = document.getElementById('fr-support-construction-notice');
        if (existing) existing.remove();
        var notice = document.createElement('div');
        notice.id = 'fr-support-construction-notice';
        notice.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--bg-primary);border:1px solid var(--border-color);box-shadow:0 8px 32px rgba(0,0,0,0.18);padding:16px 24px;z-index:99999;display:flex;align-items:center;gap:12px;font-family:Inter,sans-serif;max-width:360px;width:calc(100% - 48px);';
        notice.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" style="flex-shrink:0"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><div><div style="font-size:0.88rem;font-weight:700;color:var(--text-primary);margin-bottom:2px;">AI Support Under Construction</div><div style="font-size:0.78rem;color:var(--text-muted);">Chat support is coming soon. For help, join our Discord.</div></div><button onclick="this.parentElement.remove();" style="margin-left:auto;background:none;border:none;cursor:pointer;color:var(--text-muted);padding:0;flex-shrink:0;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';
        document.body.appendChild(notice);
