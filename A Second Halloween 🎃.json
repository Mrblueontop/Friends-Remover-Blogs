                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3H10z"/><path d="M17 2h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17"/></svg>
              </button>
            </div>
            <div id="wb3-feedback-actions">
              <button class="wb3-feedback-go-back" onclick="wb3HideFeedback()">Go Back</button>
              <button class="wb3-feedback-leave" onclick="wb3ConfirmLeave()">End Chat</button>
            </div>
            <div id="wb3-feedback-note">Ending the chat will close this session.</div>
          </div>
        </div>
      </div><!-- end wb3-view-chat -->

    </div><!-- end fr-chat-card -->
  </div><!-- end fr-chat-panel-wrap -->
</div><!-- end fr-global-chat-wrap -->

