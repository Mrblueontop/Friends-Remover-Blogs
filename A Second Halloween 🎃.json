              ${tocBadgeHTML(i)}
            </a>`;
          });
          tocHtml += '</div>';
          tocInline.innerHTML = tocHtml;
        } else {
          // Fallback: just add ids to headings
          headings.forEach(function(h, i) {
            h.id = 'art-h-' + i;
            if (i > 0) {
              const hr = document.createElement('div');
              hr.style.cssText = 'height:1px;background:var(--border-color);margin:28px 0 24px;';
              h.parentNode.insertBefore(hr, h);
