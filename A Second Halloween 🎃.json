        tocWidget && tocWidget.classList.add('visible');

        // Scroll spy
        const articlePage = document.getElementById('page-article');
        function artScrollSpy() {
          if (!articlePage.classList.contains('active')) return;
          let current = 0;
          headings.forEach(function(h, i) {
            if (h.getBoundingClientRect().top <= 260) current = i;
          });
          document.querySelectorAll('.article-toc-link').forEach(function(b, i) {
            b.classList.toggle('active', i === current);
          });
        }
        window.removeEventListener('scroll', window._artScrollSpy);
        window._artScrollSpy = artScrollSpy;
        window.addEventListener('scroll', artScrollSpy, { passive: true });
        // Set first item active on load
        if (tocLinks && tocLinks.firstChild) tocLinks.firstChild.classList.add('active');
      }, 50);
    }

    function buildFilterButtons(articles) {
      const row = document.getElementById('blogFilterRow');
      if (!row) return;
      // Collect unique categories, sorted by fixed priority order
      const CAT_ORDER = ['Announcements', 'Updates', 'Mobile', 'Dev Notes'];
      const present = new Set();
      articles.forEach(function(a) { if (a.cat) present.add(a.cat); });
      const seen = CAT_ORDER.filter(c => present.has(c));
      // Append any unrecognized cats at the end
      present.forEach(function(c) { if (!seen.includes(c)) seen.push(c); });
      // Remove any previously injected category buttons (keep "All" which is first)
      Array.from(row.querySelectorAll('.blog-filter-btn:not([data-all])')).forEach(function(b) { b.remove(); });
      seen.forEach(function(cat) {
        const btn = document.createElement('button');
        btn.className = 'blog-filter-btn';
        btn.textContent = cat;
        btn.onclick = function() { setBlogCat(btn, cat); };
        row.appendChild(btn);
      });
      // Mark the All button
      const allBtn = row.querySelector('.blog-filter-btn');
      if (allBtn) allBtn.setAttribute('data-all', '1');
    }

    function setBlogCat(btn, cat) {
      blogActiveCat = cat;
      document.querySelectorAll('.blog-filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterBlog();
    }

    function filterBlog() {
      const query = (document.getElementById('blogSearch')?.value || '').toLowerCase().trim();
      const cards = document.querySelectorAll('#blogGrid .blog-card');
      let visible = 0;

      cards.forEach(card => {
        const cat = card.dataset.cat || '';
        const title = (card.dataset.title || '').toLowerCase();
        const excerpt = (card.dataset.excerpt || '').toLowerCase();
        const catMatch = blogActiveCat === 'all' || cat === blogActiveCat;
        const queryMatch = !query || title.includes(query) || excerpt.includes(query) || cat.toLowerCase().includes(query);

        if (catMatch && queryMatch) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      // no-results state
      const existing = document.getElementById('blogNoResults');
      if (visible === 0) {
        if (!existing) {
          const el = document.createElement('div');
          el.id = 'blogNoResults';
          el.className = 'blog-no-results';
          el.innerHTML = '<div class="blog-no-results-icon">🔍</div><p class="blog-no-results-title">No articles found</p><p>Try a different search or category.</p>';
          document.getElementById('blogGrid').appendChild(el);
        }
      } else {
        if (existing) existing.remove();
      }

      const bar = document.getElementById('blogCountBar');
      if (bar) bar.textContent = visible + (visible === 1 ? ' article found' : ' articles found');
    }

    /* ── Chat UI guard (no-op — HTML is static in the page) ── */
    function ensureChatUI() {
      // Chat widget HTML is static in the page — nothing to rebuild.
      return document.getElementById('fr-global-chat-wrap');
    }

    window.frChatToggle = function frChatToggle() {
      const card     = document.getElementById('fr-chat-card');
      const launcher = document.getElementById('fr-chat-launcher');
      const badge    = document.getElementById('fr-chat-badge-dot');
      if (!card) return;
      const isOpen = !card.classList.contains('hidden');
      if (isOpen) {
        card.classList.add('hidden');
        card.classList.remove('chat-maximized');
        launcher.classList.remove('open');
        if (window.innerWidth <= 768) {
          const wrap = document.getElementById('fr-global-chat-wrap');
          const panel = card.closest('.fr-chat-panel-wrap') || card.parentElement;
          if (wrap) wrap.removeAttribute('style');
          if (panel) panel.removeAttribute('style');
          card.removeAttribute('style');
        }
      } else {
        card.classList.remove('hidden');
        launcher.classList.add('open');
        if (badge) badge.classList.remove('show');
        setTimeout(function() { document.getElementById('ai-chat-input')?.focus(); }, 80);
      }
    };

